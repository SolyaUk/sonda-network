// Network infrastructure per city comes from infrastructure.json records (each carries
// role + geolocation.provider/city, backend 2026-09-24), so the attribution is exact and the
// Jito family can be split by service.
async function loadCityNet(cluster, provider, asns) {
  cityNet = new Map();
  try {
    const infra = await fetchInfrastructure(cluster);
    const asnToProvider = new Map(asns.map(a => [a, provider]));
    const { byProviderCity } = networkInfraFromRecords(infra?.records || [], asnToProvider);
    cityNet = byProviderCity.get(provider) || new Map();
  } catch (e) { console.warn('[SONDA] infrastructure.json:', e); }
}
const NET_LABELS = [
  ['bam_nodes', 'BAM node', 'BAM nodes', 'Jito BAM nodes running in this city at this provider'],
  ['block_engines', 'block engine', 'block engines', 'Jito block engines here'],
  ['shred_receivers', 'shred receiver', 'shred receivers', 'Jito shred receivers here'],
  ['ntp', 'NTP', 'NTP', 'Jito NTP servers here'],
  ['harmonic', 'Harmonic', 'Harmonic', 'Harmonic endpoints here'],
  ['dz_devices', 'DZ device', 'DZ devices', 'DoubleZero devices here'],
  ['solana', 'RPC', 'RPC', 'Official Solana RPC / entrypoints here'],
];
function cityNetBadges(c) {
  const n = cityNet.get(`${c.city}|${c.cc || '??'}`);
  if (!n) return '';
  const out = NET_LABELS.filter(([k]) => n[k] > 0).map(([k, one, many, tip]) => `<span class="vbadge vbadge-net" data-tip="${esc(netBadgeTip(n, k, tip))}"><b>${fmt(n[k])}</b> ${n[k] === 1 ? one : many}</span>`);
  return out.length ? `<div class="vbadges">${out.join('')}</div>` : '';
}
function renderCountries(e) {
