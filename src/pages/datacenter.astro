---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import StatusStrip from '../components/StatusStrip.astro';
import ClusterBanner from '../components/ClusterBanner.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Datacenter · SONDA" description="Validators hosted by one provider: stake, locations, infrastructure participation and performance.">
  <Header activePage="datacenters" />
  <StatusStrip />
  <ClusterBanner />

  <div class="dev-banner">
    <div class="dev-banner-inner">
      <span class="dev-badge">BETA</span>
      <span class="dev-text">SONDA is under active development. Some sections are incomplete.</span>
      <a href="https://github.com/SolyaUk/sonda-network" target="_blank" rel="noopener" class="dev-link">View on GitHub</a>
    </div>
  </div>

  <main class="page-main">
    <a href="/datacenters" class="back-link" id="back-link">&larr; Back to datacenters</a>

    <div id="dc-loading" class="page-loading">Loading provider…</div>
    <div id="dc-error" class="page-error" style="display:none"></div>

    <div id="dc-content" style="display:none">
      <section class="dc-head">
        <div class="dc-head-main">
          <div class="dc-logo dc-big-logo" id="dc-logo" data-initial="?"></div>
          <div class="dc-head-text">
            <div class="dc-head-tag" id="dc-head-tag">Network provider</div>
            <h1 class="dc-name" id="dc-name">—</h1>
            <div class="dc-sub" id="dc-sub"></div>
            <div class="vbadges dc-tags" id="dc-tags"></div>
            <div class="dc-asns" id="dc-asns"></div>
          </div>
        </div>
        <div class="dc-head-side" id="dc-head-side"></div>
      </section>

      <div class="dc-scope" id="dc-scope" style="display:none"></div>

      <div class="dc-stats" id="dc-stats"></div>

      <section class="dc-card dc-cities-card" id="dc-cities-card">
        <div class="story-tag cluster-tag">Locations</div>
        <div class="dc-card-head">
          <h2 class="dc-card-title" id="dc-cities-title">Cities</h2>
          <div class="dc-countries" id="dc-countries"></div>
        </div>
        <div class="dc-card-hint">click a country or a city to filter the validators below; several combine, click again to remove</div>
        <div class="dc-cities-grid" id="dc-cities-grid"></div>
        <div class="dc-cities-foot" id="dc-cities-foot"></div>
      </section>

      <section class="dc-vals">
        <div class="dc-vals-head">
          <div class="story-tag cluster-tag">Validators</div>
          <h2 class="dc-card-title" id="dc-vals-title">Validators</h2>
        </div>
        <div class="filters-bar">
          <div class="active-filters" id="dc-active-filters"></div>
          <button class="filter-clear" id="dc-clear" type="button" style="display:none">Clear all filters &times;</button>
        </div>
        <div class="results-bar">
          <div class="result-count" id="dc-vals-count">—</div>
          <div class="sort-controls">
            <select id="dc-sort-select" hidden aria-hidden="true"><option value="rank-asc" selected>TVC rank, best first</option></select>
            <div id="dc-sort-menu"></div>
          </div>
        </div>
        <div class="vtable-wrap" id="dc-vtable-wrap">
          <table class="vtable" id="dc-vtable"><tbody id="dc-vals-body"></tbody></table>
        </div>
        <div class="vcards-wrap" id="dc-vcards"></div>
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style is:global>
  /* BETA banner (same as the other pages) */
  .dev-banner { background: rgba(59,130,246,0.08); border-bottom: 1px solid rgba(59,130,246,0.2); font-size: 0.78rem; color: var(--text-secondary); }
  .dev-banner-inner { max-width: 1280px; margin: 0 auto; padding: 0.5rem 1.5rem; display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
  .dev-badge { font-family: var(--font-mono); font-size: 0.65rem; font-weight: 600; background: var(--accent-blue); color: #fff; padding: 0.15rem 0.45rem; border-radius: 4px; letter-spacing: 0.08em; flex-shrink: 0; }
  .dev-link { color: var(--accent-blue); text-decoration: none; margin-left: auto; }

  .page-main { max-width: 1400px; margin: 0 auto; padding: 1.5rem 2rem 4rem; }
  .back-link { display: inline-block; color: var(--text-muted); font-size: 0.85rem; text-decoration: none; margin-bottom: 1.2rem; }
  .back-link:hover { color: var(--cluster-accent); }
  .page-loading, .page-error { text-align: center; color: var(--text-muted); padding: 4rem 1rem; }
  .page-error { color: var(--status-critical); }
  /* not-found state, same look as the validator page */
  .nf-block { max-width: 580px; margin: 2rem auto; text-align: center; background: var(--bg-card); border: 1px solid var(--border); border-radius: 14px; padding: 2.2rem 1.8rem; }
  .nf-title { font-family: var(--font-display); font-size: clamp(1.1rem, 2.5vw, 1.4rem); font-weight: 600; color: var(--text-primary); margin-bottom: 0.85rem; }
  .nf-id { margin-bottom: 1rem; }
  .nf-id code { font-family: var(--font-mono); font-size: 0.78rem; color: var(--text-secondary); background: var(--bg-secondary); border: 1px solid var(--border); padding: 0.25rem 0.55rem; border-radius: 5px; word-break: break-all; text-transform: capitalize; }
  .nf-message { color: var(--text-secondary); font-size: 0.92rem; line-height: 1.55; margin: 0 0 1.4rem; }
  .nf-linked { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1.5rem; }
  .nf-linked:empty { display: none; }
  .nf-linked-card { display: grid; grid-template-columns: 100px 1fr auto; align-items: center; gap: 0.8rem; padding: 0.75rem 1rem; background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 8px; text-decoration: none; transition: border-color 0.15s, background 0.15s; }
  .nf-linked-card:hover { background: var(--bg-card-hover); border-color: var(--c-accent, var(--cluster-accent)); }
  .nf-linked-card.cluster-mainnet { --c-accent: #3b82f6; }
  .nf-linked-card.cluster-testnet { --c-accent: #e879f9; }
  .nf-linked-card.cluster-devnet { --c-accent: #fbbf24; }
  .nf-linked-card.cluster-alpenglow { --c-accent: #fb7185; }
  .nf-linked-card .nf-linked-cluster { color: var(--c-accent, var(--cluster-accent)); }
  .nf-linked-card .nf-linked-arrow { color: var(--c-accent, var(--cluster-accent)); }
  .nf-linked-cluster { font-family: var(--font-mono); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; text-align: left; font-weight: 600; }
  .nf-linked-name { color: var(--text-primary); font-weight: 600; text-align: left; }
  .nf-linked-arrow { font-size: 1.1rem; }
  .nf-actions { display: flex; gap: 0.6rem; justify-content: center; flex-wrap: wrap; }
  .nf-btn { background: var(--cluster-accent); color: white; border: 1px solid var(--cluster-accent); padding: 0.55rem 1.1rem; border-radius: 8px; font-size: 0.88rem; text-decoration: none; }
  .nf-btn:hover { opacity: 0.9; }
  .nf-btn-ghost { background: transparent; color: var(--text-primary); border-color: var(--border); }
  .nf-btn-ghost:hover { border-color: var(--cluster-accent); }
  /* presence chips: the provider on every cluster it exists on, in cluster colours */
  .dc-presence { display: flex; align-items: center; gap: 0.35rem; flex-wrap: wrap; justify-content: flex-end; margin-top: 0.4rem; }
  .dc-presence-l { font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted); margin-right: 0.2rem; }
  .dc-presence-wait { color: var(--text-muted); font-size: 0.8rem; }
  .dc-cluster-chip { display: inline-flex; align-items: center; gap: 0.35rem; font-family: var(--font-mono); font-size: 0.7rem; text-decoration: none; border: 1px solid; border-radius: 999px; padding: 0.2rem 0.6rem; color: var(--c-accent); border-color: color-mix(in srgb, var(--c-accent) 45%, transparent); background: color-mix(in srgb, var(--c-accent) 8%, transparent); }
  .dc-cluster-chip .n { color: var(--text-secondary); }
  .dc-cluster-chip:hover { background: color-mix(in srgb, var(--c-accent) 20%, transparent); }
  .dc-cluster-chip.is-current { background: var(--c-accent); color: #fff; }
  .dc-cluster-chip.is-current .n { color: rgba(255,255,255,0.85); }
  .dc-cluster-chip.cluster-mainnet { --c-accent: #3b82f6; }
  .dc-cluster-chip.cluster-testnet { --c-accent: #e879f9; }
  .dc-cluster-chip.cluster-devnet { --c-accent: #fbbf24; }
  .dc-cluster-chip.cluster-alpenglow { --c-accent: #fb7185; }

  /* header */
  .dc-head { display: flex; justify-content: space-between; gap: 1.2rem; align-items: flex-start; flex-wrap: wrap; background: var(--bg-card); border: 1px solid var(--border); border-radius: 14px; padding: 1.4rem 1.5rem; margin-bottom: 1.2rem; }
  .dc-head-main { display: flex; gap: 1.1rem; align-items: flex-start; min-width: 0; flex: 1; }
  .dc-big-logo { width: 72px; height: 72px; flex-shrink: 0; }
  .dc-big-logo::before { font-size: 1.6rem; }
  .dc-head-text { min-width: 0; display: flex; flex-direction: column; gap: 0.45rem; }
  .dc-head-tag { font-family: var(--font-mono); font-size: 0.64rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--cluster-accent); }
  .dc-name { font-family: var(--font-display); font-size: 1.9rem; font-weight: 700; margin: 0; display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; line-height: 1.15; }
  .dc-name-text { min-width: 0; overflow-wrap: anywhere; }
  .dc-name-actions { display: inline-flex; gap: 0.4rem; flex-shrink: 0; }
  .dc-site { max-width: 100%; }
  .dc-site span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 240px; }
  .dc-sub { font-size: 0.86rem; color: var(--text-secondary); }
  .dc-sub b { color: var(--text-primary); font-family: var(--font-mono); font-weight: 600; }
  .dc-sub .sep { color: var(--text-muted); margin: 0 0.35rem; }
  /* two distinct actions: copy the name (copy icon) and share the SONDA link (link icon) */
  .dc-act { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 7px; border: 1px solid var(--border); background: var(--bg-primary); color: var(--text-secondary); cursor: pointer; padding: 0; }
  .dc-act:hover { border-color: var(--cluster-accent); color: var(--cluster-accent); }
  .dc-act.is-share { color: var(--cluster-accent); border-color: color-mix(in srgb, var(--cluster-accent) 45%, transparent); }
  .dc-act.copy-btn { opacity: 1; }
  .dc-tags { gap: 0.3rem; align-items: center; }
  .dc-site { display: inline-flex; align-items: center; gap: 0.35rem; font-family: var(--font-body); font-size: 0.8rem; font-weight: 500; color: var(--cluster-accent); text-decoration: none; border: 1px solid color-mix(in srgb, var(--cluster-accent) 45%, transparent); background: color-mix(in srgb, var(--cluster-accent) 8%, transparent); border-radius: 6px; padding: 0.18rem 0.55rem; cursor: pointer; }
  .dc-site:hover { text-decoration: underline; background: color-mix(in srgb, var(--cluster-accent) 16%, transparent); }
  .dc-site svg { width: 12px; height: 12px; }
  .dc-tags .copy-btn { width: 22px; height: 22px; }
  .dc-asns { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.2rem; }
  .dc-asn { display: inline-flex; align-items: center; gap: 0.4rem; font-family: var(--font-mono); font-size: 0.74rem; color: var(--text-secondary); border: 1px solid var(--border); border-radius: 8px; padding: 0.3rem 0.55rem; background: var(--bg-primary); cursor: pointer; transition: border-color 0.12s, background 0.12s; }
  .dc-asn:hover { border-color: color-mix(in srgb, var(--cluster-accent) 60%, transparent); }
  .dc-asn.is-active { border-color: var(--cluster-accent); background: color-mix(in srgb, var(--cluster-accent) 12%, var(--bg-primary)); }
  .dc-asn.is-dim { opacity: 0.45; }
  .dc-asn, .dc-country, .dc-city-head { position: relative; }
  .dc-asn .vagg-not, .dc-country .vagg-not { position: static; transform: none; margin-left: 0.2rem; }
  .dc-city-head .vagg-not { right: 0; }
  .dc-asn:hover .vagg-not, .dc-country:hover .vagg-not, .dc-city:hover .dc-city-head .vagg-not { display: inline-flex; }
  .dc-asn.is-excluded, .dc-country.is-excluded, .dc-city.is-excluded { border-style: dashed; border-color: color-mix(in srgb, var(--status-critical) 55%, transparent); }
  .dc-asn.is-excluded b, .dc-country.is-excluded b, .dc-city.is-excluded .dc-city-name { text-decoration: line-through; color: var(--text-muted); }
  .dc-asn.is-excluded .vagg-not, .dc-country.is-excluded .vagg-not, .dc-city.is-excluded .vagg-not { display: inline-flex; color: var(--status-critical); }
  .dc-asn b { color: var(--text-primary); font-weight: 600; }
  .dc-asn .muted { color: var(--text-muted); }
  .dc-asn-flags { display: inline-flex; gap: 2px; }
  .dc-asn .copy-btn { margin-left: 0.1rem; }
  .dc-head-side { display: flex; flex-direction: column; align-items: flex-end; gap: 0.5rem; }
  .dc-level { display: inline-flex; flex-direction: column; align-items: flex-end; gap: 0.15rem; }
  .dc-level-badge { font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 700; border: 1px solid; border-radius: 999px; padding: 0.35rem 0.8rem; }
  .dc-level-critical { color: var(--status-critical); border-color: rgba(239,68,68,0.5); background: rgba(239,68,68,0.1); }
  .dc-level-warning { color: var(--accent-amber); border-color: rgba(251,191,36,0.5); background: rgba(251,191,36,0.08); }
  .dc-level-ok { color: var(--status-good); border-color: rgba(34,197,94,0.45); background: rgba(34,197,94,0.08); }
  .dc-level-sub { font-size: 0.72rem; color: var(--text-muted); }

  /* stat cards: one row of six, they follow the current selection */
  .dc-stats { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 0.6rem; margin-bottom: 1.2rem; }
  .dc-stats.is-5 { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  .dc-stats.is-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .dc-stat { background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; padding: 0.8rem 0.9rem; min-width: 0; }
  .dc-stat-l { font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.4rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .dc-stat-v { font-family: var(--font-mono); font-size: 1.25rem; font-weight: 700; color: var(--text-primary); line-height: 1; white-space: nowrap; }
  .dc-stat-v small { font-size: 0.66rem; font-weight: 500; color: var(--text-muted); margin-left: 0.25rem; }
  .dc-stat-v .dim { color: var(--text-muted); font-weight: 500; font-size: 0.9rem; margin-left: 0.3rem; }
  .dc-stat-s { font-size: 0.7rem; color: var(--text-muted); margin-top: 0.4rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .dc-stat-s .crit { color: var(--status-critical); }
  @media (max-width: 1100px) { .dc-stats, .dc-stats.is-5, .dc-stats.is-4 { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .dc-stats, .dc-stats.is-5, .dc-stats.is-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  /* cards */
  .dc-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 14px; padding: 1.2rem 1.35rem 1.3rem; margin-bottom: 1.2rem; }
  .dc-card-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem; flex-wrap: wrap; margin-bottom: 0.9rem; }
  .dc-card > .story-tag { display: block; width: 100%; box-sizing: border-box; }
  /* context strip: how the reader got here (a flag on the list) and how to leave */
  .dc-scope { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; margin: -0.4rem 0 1rem; padding: 0.6rem 0.9rem; border-radius: 10px; background: color-mix(in srgb, var(--cluster-accent) 10%, var(--bg-card)); border: 1px solid color-mix(in srgb, var(--cluster-accent) 45%, transparent); font-size: 0.86rem; color: var(--text-primary); }
  .dc-scope .vflag-circle { flex-shrink: 0; }
  .dc-scope b { font-weight: 600; }
  .dc-scope .muted { color: var(--text-secondary); }
  .dc-scope .filter-clear { margin-left: auto; }
  .dc-card-title { font-family: var(--font-display); font-size: 1.15rem; font-weight: 600; margin: 0.5rem 0 0; }
  .dc-card-hint { font-size: 0.74rem; color: var(--text-muted); margin: -0.5rem 0 0.8rem; }
  /* country chips: every country of the provider, multi-select, in sync with the scope strip */
  .dc-countries { display: flex; flex-wrap: wrap; gap: 0.3rem; justify-content: flex-end; }
  .dc-country { display: inline-flex; align-items: center; gap: 0.35rem; font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-secondary); border: 1px solid var(--border); border-radius: 999px; padding: 0.2rem 0.55rem 0.2rem 0.3rem; background: var(--bg-primary); cursor: pointer; }
  .dc-country:hover { border-color: color-mix(in srgb, var(--cluster-accent) 60%, transparent); color: var(--text-primary); }
  .dc-country.is-active { border-color: var(--cluster-accent); background: color-mix(in srgb, var(--cluster-accent) 14%, var(--bg-primary)); color: var(--text-primary); }
  .dc-country b { font-weight: 600; }
  .dc-cities-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(215px, 1fr)); gap: 0.55rem; }
  .dc-city { display: block; background: var(--bg-primary); border: 1px solid var(--border); border-radius: 10px; padding: 0.65rem 0.8rem; cursor: pointer; transition: border-color 0.15s, background 0.15s; min-width: 0; }
  .dc-city:hover { border-color: var(--border-accent); }
  .dc-city.is-active { border-color: var(--cluster-accent); background: color-mix(in srgb, var(--cluster-accent) 10%, var(--bg-primary)); }
  .dc-city.is-dim { opacity: 0.45; }
  .dc-city.is-extra { display: none; }
  .dc-cities-card.is-expanded .dc-city.is-extra { display: block; }
  .dc-city-head { display: flex; align-items: center; gap: 0.45rem; min-width: 0; }
  .dc-city-name { font-family: var(--font-display); font-size: 0.95rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  .dc-city-cc { font-family: var(--font-mono); font-size: 0.64rem; color: var(--text-muted); flex-shrink: 0; }
  .dc-city-line { display: flex; align-items: baseline; gap: 0.4rem; margin-top: 0.4rem; font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-secondary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .dc-city-line b { color: var(--text-primary); font-weight: 600; }
  .dc-city .vbadges { margin-top: 0.45rem; }
  .dc-city .vbadge { font-size: 0.58rem; padding: 0.1rem 0.32rem; }
  .dc-cities-foot { margin-top: 0.7rem; }
  .vagg-more { background: none; border: 0; color: var(--cluster-accent); font-size: 0.82rem; cursor: pointer; padding: 0; font-family: inherit; }
  @media (max-width: 640px) { .dc-cities-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.4rem; } .dc-city { padding: 0.5rem 0.6rem; } .dc-city .vbadges { display: none; } }

  /* validators section: count and sort above the table, like /validators */
  .dc-vals { margin-top: 0.4rem; }
  .dc-vals-head { margin-bottom: 0.7rem; }
  .filters-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; margin-bottom: 0.6rem; }
  .active-filters { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .filter-chip { display: inline-flex; align-items: center; gap: 0.35rem; background: color-mix(in srgb, var(--cluster-accent) 12%, transparent); border: 1px solid color-mix(in srgb, var(--cluster-accent) 45%, transparent); color: var(--text-primary); border-radius: 999px; padding: 0.25rem 0.6rem; font-size: 0.76rem; }
  .filter-chip .chip-x { cursor: pointer; color: var(--text-muted); font-size: 0.9rem; line-height: 1; }
  .filter-chip .chip-x:hover { color: var(--text-primary); }
  .filter-clear { background: color-mix(in srgb, var(--cluster-accent) 12%, transparent); border: 1px solid color-mix(in srgb, var(--cluster-accent) 55%, transparent); color: var(--text-primary); border-radius: 999px; padding: 0.35rem 0.8rem; font-size: 0.76rem; font-weight: 600; cursor: pointer; font-family: inherit; }
  .results-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.8rem; gap: 1rem; }
  .result-count { font-size: 0.85rem; color: var(--text-muted); }
  .sort-controls { display: flex; align-items: center; gap: 0.5rem; }
  @media (max-width: 900px) {
    .page-main { padding: 0.85rem 1rem 3rem; }
    .dc-head { flex-direction: column; padding: 1rem 1.1rem; }
    .dc-head-main { width: 100%; gap: 0.8rem; }
    .dc-head-side { width: 100%; align-items: flex-start; border-top: 1px solid var(--border); padding-top: 0.8rem; }
    .dc-level { align-items: flex-start; }
    .dc-presence { justify-content: flex-start; }
    .dc-name { font-size: 1.45rem; }
    .dc-big-logo { width: 56px; height: 56px; }
    .dc-asns { gap: 0.3rem; }
  }
  @media (max-width: 640px) {
    .dc-countries { justify-content: center; width: 100%; }
    .dc-card-head { flex-direction: column; align-items: stretch; }
    .dc-presence { flex-direction: row; }
    .dc-presence-l { width: 100%; margin: 0 0 0.1rem; }
  }
</style>

<script>
import { bootstrapCluster, getCluster, fetchValidators, fetchSummary, fetchInfrastructure, computeTvcRanks, sortValidators, isValidatorRecord, providerOf } from '../lib/data.js';
import { aggregateProviders, findProvider, networkInfraFromRecords, netTotal, providerPresence, networkOnlyProviders, netBadgeTip, CLUSTER_ORDER, CLUSTER_SHORT } from '../lib/providers.js';
