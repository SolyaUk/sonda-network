    `<button type="button" class="dc-act is-share copy-btn" data-copy="${esc(link)}" data-copy-label="SONDA link to this provider" data-tip="Copy link to this page on SONDA" aria-label="Copy link to this page on SONDA">${LINK_ICON}</button></span>`;
  document.getElementById('dc-sub').innerHTML = `<b>${fmt(e.cities.length)}</b> cit${e.cities.length === 1 ? 'y' : 'ies'}<span class="sep">·</span><b>${fmt(e.countries.length)}</b> countr${e.countries.length === 1 ? 'y' : 'ies'}<span class="sep">·</span><b>${fmt(e.asns.length)}</b> network${e.asns.length === 1 ? '' : 's'}`;
  const tags = e.tags.map(t => `<span class="vbadge vbadge-tag vbadge-tag-${esc(t).replace(/[^a-z-]/gi, '')}" data-tip="${esc(TAG_TIP[t] || t)}">${esc(t)}</span>`);
  if (e.website) {
    const host = e.website.replace(/^https?:\/\//, '').replace(/\/$/, '');
    tags.push(`<a class="dc-site" href="${esc(e.website)}" target="_blank" rel="noopener" data-tip="Provider website, opens in a new tab"><span>${esc(host)}</span>${EXT_ICON}</a>${copyButtonHtml(e.website, 'Copy website URL')}`);
  }
  document.getElementById('dc-tags').innerHTML = tags.join('');
  // ASN chips: countries the ASN is seen in, node count, copy; a click filters the table
  const asnCountries = new Map();
  for (const r of allProviderRecords) { const g = r.geolocation || {}; if (!g.asn) continue; const set = asnCountries.get(g.asn) || new Map(); if (g.country_code && g.country_code !== '??') set.set(g.country_code, (set.get(g.country_code) || 0) + 1); asnCountries.set(g.asn, set); }
  document.getElementById('dc-asns').innerHTML = e.asns.map(a => {
    const cs = [...(asnCountries.get(a.asn) || new Map()).entries()].sort((x, y) => y[1] - x[1]).slice(0, 4);
    const flags = cs.map(([cc, n]) => circleFlagSvg(cc.toLowerCase(), { size: 14, tip: `${cc}: ${n}` })).join('');
    const st = fState('asn', a.asn);
    return `<span class="dc-asn${st === 'include' ? ' is-active' : ''}${st === 'exclude' ? ' is-excluded' : ''}" data-asn="${esc(a.asn)}" data-tip="${esc(`${a.asn}${a.name && a.name !== e.provider ? ` (${a.name})` : ''}\n${a.count} validators, ${fmtStakeSol(a.stake_lamports)} SOL\nclick to filter the validators below`)}"><span class="dc-asn-flags">${flags}</span><b>${esc(a.asn)}</b><span class="muted">${fmt(a.count)}</span>${copyButtonHtml(a.asn, 'Copy ASN')}${NOT_BUTTON}</span>`;
  }).join('');
  document.querySelectorAll('.dc-asn').forEach(el => el.addEventListener('click', (ev) => {
    if (ev.target instanceof Element && ev.target.closest('[data-copy]')) return;
    toggleFilter('asn', el.dataset.asn, ev.target instanceof Element && ev.target.closest('.vagg-not') ? 'exclude' : 'include');
  }));
  const asnHost = document.getElementById('dc-asns');
  if (asnHost && !asnHost.dataset.lp) { asnHost.dataset.lp = '1'; initLongPress(asnHost, '.dc-asn', (t) => toggleFilter('asn', t.dataset.asn, 'exclude')); }
  const lvl = e.level;
  document.getElementById('dc-head-side').innerHTML = (e.net_only
    ? `<div class="dc-level"><span class="dc-level-badge dc-level-ok" style="color:var(--text-secondary);border-color:var(--border);background:transparent">Network infrastructure only</span><span class="dc-level-sub">no validators rent here</span></div>`
    : `<div class="dc-level"><span class="dc-level-badge dc-level-${lvl}">${lvl === 'critical' ? 'Critical concentration' : lvl === 'warning' ? 'Elevated concentration' : 'Healthy concentration'}</span><span class="dc-level-sub">${pct(e.stake_pct, 2)} of cluster stake · SFDP threshold 25%</span></div>`) + `<div class="dc-presence" id="dc-presence"></div>`;
  renderPresence(e, getCluster());
}

// "Available on: mainnet / testnet / devnet / alpenglow": the same provider on other
// clusters, each chip in its cluster colour and a link; resolved in the background.
async function renderPresence(e, cluster) {
  const host = document.getElementById('dc-presence');
  if (!host) return;
  const chip = (c, count, current) => `<a class="dc-cluster-chip cluster-${c.replace(/-beta|-community/g, '')}${current ? ' is-current' : ''}" href="/datacenter?provider=${esc(e.slug)}&cluster=${c}" data-tip="${esc(e.provider)} on ${CLUSTER_SHORT[c]}: ${fmt(count)} validator${count === 1 ? '' : 's'}${current ? ' (this page)' : ''}">${CLUSTER_SHORT[c]}<span class="n">${fmt(count)}</span></a>`;
  host.innerHTML = `<span class="dc-presence-l">Available on</span>${chip(cluster, e.count, true)}<span class="dc-presence-wait">…</span>`;
  const others = await providerPresence(e.slug, cluster);
  if (getCluster() !== cluster) return;
  const all = CLUSTER_ORDER.map(c => (c === cluster ? { cluster: c, count: e.count } : others.find(o => o.cluster === c))).filter(Boolean);
  host.innerHTML = `<span class="dc-presence-l">Available on</span>${all.map(o => chip(o.cluster, o.count, o.cluster === cluster)).join('')}`;
}

function renderStats(s, total) {
  if (entry?.net_only) {
    const n = entry.net;
    const cards = [
      { l: 'Validators', v: '0', s: 'network infrastructure only' },
      { l: 'Network nodes', v: fmt(entry.net_total), s: [n.bam_nodes ? `${n.bam_nodes} BAM` : '', n.block_engines ? `${n.block_engines} block engines` : '', n.shred_receivers ? `${n.shred_receivers} shred receivers` : '', n.harmonic ? `${n.harmonic} Harmonic` : '', n.dz_devices ? `${n.dz_devices} DZ devices` : '', n.solana ? `${n.solana} RPC` : ''].filter(Boolean).join(' · ') },
      { l: 'Locations', v: `${fmt(entry.cities.length)}<small>cit${entry.cities.length === 1 ? 'y' : 'ies'}</small>`, s: `${fmt(entry.countries.length)} countr${entry.countries.length === 1 ? 'y' : 'ies'} · ${fmt(entry.asns.length)} ASN${entry.asns.length === 1 ? '' : 's'}` },
    ];
    const el = document.getElementById('dc-stats');
    el.className = `dc-stats is-${cards.length}`;
    el.innerHTML = cards.map(c => `<div class="dc-stat"><div class="dc-stat-l">${c.l}</div><div class="dc-stat-v">${c.v}</div><div class="dc-stat-s">${c.s}</div></div>`).join('');
    return;
  }
  const inView = s.count !== total.count;
  const cards = [
    { l: 'Validators', v: `${fmt(s.count)}${inView ? `<span class="dim">of ${fmt(total.count)}</span>` : ''}`, s: `${fmt(s.count - s.delinquent)} active${s.delinquent ? ` · <span class="crit">${fmt(s.delinquent)} delinquent</span>` : ''}` },
    { l: 'Stake', v: `${fmtStakeSol(s.stake_lamports)}<small>SOL</small>`, s: `${pct(s.stake_pct, 2)} of cluster` },
    { l: 'Performance', v: s.rank_median != null ? `#${fmt(Math.round(s.rank_median))}` : '—', s: `median TVC${s.rank_best != null ? ` · best #${fmt(s.rank_best)}` : ''}${s.skip_avg != null ? ` · skip ${s.skip_avg.toFixed(2)}%` : ''}` },
  ];
  if (dcAvail?.connections) {
    cards.push({ l: 'DoubleZero', v: fmt(s.dz), s: `${fmt(s.multicast)} multicast publishers` });
    cards.push({ l: 'Jito BAM', v: fmt(s.bam), s: s.count ? `${pct((s.bam / s.count) * 100, 0)} of validators here` : '' });
  }
  if (dcAvail?.sfdp) cards.push({ l: 'SFDP approved', v: fmt(s.sfdp), s: s.count ? `${pct((s.sfdp / s.count) * 100, 0)} of validators here` : '' });
  if (!dcAvail?.connections) cards.push({ l: 'Locations', v: `${fmt(s.cities)}<small>cit${s.cities === 1 ? 'y' : 'ies'}</small>`, s: `${fmt(s.countries)} countr${s.countries === 1 ? 'y' : 'ies'}` });
  const el = document.getElementById('dc-stats');
  el.className = `dc-stats is-${cards.length}`;
  el.innerHTML = cards.map(c => `<div class="dc-stat"><div class="dc-stat-l">${c.l}</div><div class="dc-stat-v">${c.v}</div><div class="dc-stat-s">${c.s}</div></div>`).join('');
}

const CITIES_VISIBLE = () => (window.innerWidth <= 640 ? 6 : 12);
function renderCities(e) {
  const grid = document.getElementById('dc-cities-grid');
  const card = document.getElementById('dc-cities-card');
  document.getElementById('dc-cities-title').textContent = `${fmt(e.cities.length)} cit${e.cities.length === 1 ? 'y' : 'ies'} where ${e.provider} hosts validators`;
  const visible = CITIES_VISIBLE();
  // counts inside a city follow the other filters (asn, country), not the city selection
  const byCity = new Map();
  for (const r of allProviderRecords) {
    const g = r.geolocation || {};
    if (!passes(r, ['asn', 'country'])) continue;
    const k = `${g.city || 'Unknown'}|${g.country_code || '??'}`;
    const x = byCity.get(k) || { count: 0, delinquent: 0, stake: 0, dz: 0, mc: 0, bam: 0, sfdp: 0 };
    x.count++; if (r.delinquent) x.delinquent++; x.stake += r.activated_stake_lamports || 0; if (r.dz_connected) x.dz++; if (r.dz_multicast_publisher) x.mc++; if (r.bam_node) x.bam++; if (r.sfdp_state === 'Approved') x.sfdp++;
    byCity.set(k, x);
  }
  grid.innerHTML = e.cities.map((c, i) => {
    const k = `${c.city}|${c.cc || '??'}`;
    const x = byCity.get(k) || { count: 0, delinquent: 0, stake: 0, dz: 0, mc: 0, bam: 0, sfdp: 0 };
    const st = fState('city', c.city);
    const active = st === 'include';
    const badges = [];
    if (x.dz) badges.push(`<span class="vbadge vbadge-dz" data-tip="${x.dz} validators here connected to DoubleZero">DZ ${fmt(x.dz)}</span>`);
    if (x.mc) badges.push(`<span class="vbadge vbadge-mc" data-tip="${x.mc} validators here publish DoubleZero multicast">MC ${fmt(x.mc)}</span>`);
    if (x.bam) badges.push(`<span class="vbadge vbadge-bam" data-tip="${x.bam} validators here connected to Jito BAM">BAM ${fmt(x.bam)}</span>`);
    if (x.sfdp) badges.push(`<span class="vbadge vbadge-sfdp" data-tip="${x.sfdp} SFDP-approved validators here">SFDP ${fmt(x.sfdp)}</span>`);
    if (c.asns.length > 1) badges.push(`<span class="vbadge vbadge-comm" data-tip="${esc(c.asns.join(', '))}">${c.asns.length} ASNs</span>`);
    if (x.delinquent) badges.push(`<span class="vbadge vbadge-del">${fmt(x.delinquent)} delinquent</span>`);
    return `<div class="dc-city${active ? ' is-active' : ''}${st === 'exclude' ? ' is-excluded' : ''}${x.count === 0 && !st && !e.net_only ? ' is-dim' : ''}${i >= visible ? ' is-extra' : ''}" data-city="${esc(c.city)}" role="button" tabindex="0">
      <div class="dc-city-head">${c.cc ? pinFlagSvg(c.cc.toLowerCase(), { tip: c.country }) : '<span class="vpin-none">?</span>'}<span class="dc-city-name" data-tip-ellipsis>${esc(c.city)}</span><span class="dc-city-cc">${esc(c.cc || '')}</span>${NOT_BUTTON}</div>
      ${e.net_only
        ? `<div class="dc-city-line"><b>${fmt(c.nodes || 0)}</b> network node${(c.nodes || 0) === 1 ? '' : 's'}</div>`
        : `<div class="dc-city-line"><b>${fmt(x.count)}</b> validators<span class="vcard-sep"></span><b>${fmtStakeSol(x.stake)}</b> SOL<span class="vcard-sep"></span><span data-tip="${esc(e.provider)}'s validators in this city as a share of the whole cluster stake">${pct((x.stake / (dcClusterStake || 1)) * 100, 2)}</span></div>`}
      ${badges.length ? `<div class="vbadges">${badges.join('')}</div>` : ''}${cityNetBadges(c)}
    </div>`;
  }).join('');
  card.classList.toggle('is-expanded', citiesExpanded);
  const foot = document.getElementById('dc-cities-foot');
  foot.innerHTML = e.cities.length > visible ? `<button class="vagg-more" type="button">${citiesExpanded ? 'Show less' : `Show all ${e.cities.length} cities`}</button>` : '';
  if (e.cities.length <= visible) card.classList.remove('is-expanded');
  foot.querySelector('.vagg-more')?.addEventListener('click', () => { citiesExpanded = !citiesExpanded; renderCities(e); });
  grid.querySelectorAll('.dc-city').forEach(el => {
    el.addEventListener('click', (ev) => toggleFilter('city', el.dataset.city, ev.target instanceof Element && ev.target.closest('.vagg-not') ? 'exclude' : 'include'));
    el.addEventListener('keydown', (ev) => { if (ev.key === 'Enter' || ev.key === ' ') { ev.preventDefault(); toggleFilter('city', el.dataset.city); } });
  });
  if (!grid.dataset.lp) { grid.dataset.lp = '1'; initLongPress(grid, '.dc-city', (t) => toggleFilter('city', t.dataset.city, 'exclude')); }
}

function renderChips() {
  const chips = [];
  const push = (k, v, label) => { const not = v.startsWith('!'); const raw = not ? v.slice(1) : v; chips.push({ k, raw, not, label: label(raw) }); };
  filters.city.forEach(v => push('city', v, r => r));
  filters.country.forEach(v => push('country', v, r => `Country: ${r}`));
  filters.asn.forEach(v => push('asn', v, r => r));
  document.getElementById('dc-active-filters').innerHTML = chips.map(c => `<span class="filter-chip${c.not ? ' is-not' : ''}">${c.not ? '<span class="chip-not">not</span>' : ''}${esc(c.label)}<span class="chip-x" data-k="${c.k}" data-v="${esc(c.raw)}">&times;</span></span>`).join('');
  document.getElementById('dc-clear').style.display = chips.length ? 'inline-block' : 'none';
  document.querySelectorAll('#dc-active-filters .chip-x').forEach(x => x.addEventListener('click', () => { filters[x.dataset.k] = filters[x.dataset.k].filter(v => v !== x.dataset.v && v !== `!${x.dataset.v}`); syncUrl(); renderAll(); }));
}

function renderDcTable(records) {
  const cluster = getCluster();
  const list = sortValidators(records, dcSort.key, dcSort.dir);
  const from = `provider:${entry.slug}`;
  const ctx = (i) => ({ cluster, pos: i + 1, tiers: dcStakeTiers, summary: dcSummary, avail: dcAvail, from, bands: dcBands });
  const tbody = document.getElementById('dc-vals-body');
  const cards = document.getElementById('dc-vcards');
  tbody.innerHTML = list.map((r, i) => renderRow(r, ctx(i))).join('');
  tbody.querySelectorAll('tr[data-href]').forEach(tr => tr.addEventListener('click', (e) => {
    if (e.target instanceof Element && e.target.closest('[data-copy]')) return;
    window.location.href = tr.dataset.href;
  }));
  cards.innerHTML = list.map((r, i) => renderCard(r, ctx(i))).join('');
  cards.querySelectorAll('.vcard').forEach(card => card.addEventListener('click', (e) => {
    if (e.target instanceof Element && e.target.closest('.vcard-go, [data-copy]')) return;
    const go = card.querySelector('.vcard-go');
    if (go) window.location.href = go.getAttribute('href');
  }));
  markSortedHeader(document.getElementById('dc-vtable'), dcSort.key, dcSort.dir);
  document.getElementById('dc-vals-count').textContent = `${fmt(list.length)} validator${list.length === 1 ? '' : 's'}${list.length !== allProviderRecords.length ? ` of ${fmt(allProviderRecords.length)}` : ''}`;
  document.getElementById('dc-vals-title').textContent = list.length === allProviderRecords.length ? `All ${fmt(list.length)} validators at ${entry.provider}` : `${fmt(list.length)} of ${fmt(allProviderRecords.length)} validators at ${entry.provider}`;
}

function renderScope() {
  const el = document.getElementById('dc-scope');
  const incC = incOf('country');
  if (!incC.length) { el.style.display = 'none'; el.innerHTML = ''; return; }
  const names = incC.map(cc => entry.countries.find(c => c.cc === cc)?.country || cc);
  const inCountry = allProviderRecords.filter(r => incC.includes(r.geolocation?.country_code));
  const cities = new Set(inCountry.map(r => r.geolocation?.city)).size;
  el.style.display = 'flex';
  el.innerHTML = `${incC.map(cc => circleFlagSvg(cc.toLowerCase(), { size: 20 })).join('')}<span>Showing <b>${esc(entry.provider)}</b> in <b>${esc(names.join(', '))}</b><span class="muted">: ${fmt(inCountry.length)} validator${inCountry.length === 1 ? '' : 's'} in ${fmt(cities)} cit${cities === 1 ? 'y' : 'ies'}</span></span><button type="button" class="filter-clear" id="dc-scope-clear">Show all countries &times;</button>`;
  el.querySelector('#dc-scope-clear').addEventListener('click', () => { filters.country = []; syncUrl(); renderAll(); });
}

function renderAll() {
  renderScope();
  renderCountries(entry);
  const sel = selected();
  renderStats(scopeOf(sel), scopeOf(allProviderRecords));
  renderCities(entry);
  renderChips();
  // ASN chips: active when selected, dimmed when the other filters leave no validator on that ASN
  const asnAlive = new Set(allProviderRecords.filter(r => passes(r, ['city', 'country'])).map(r => r.geolocation?.asn));
  document.querySelectorAll('.dc-asn').forEach(el => {
    const st = fState('asn', el.dataset.asn);
    el.classList.toggle('is-active', st === 'include');
    el.classList.toggle('is-excluded', st === 'exclude');
    el.classList.toggle('is-dim', !asnAlive.has(el.dataset.asn) && !st);
  });
  renderDcTable(sel);
}

function initDcTableHead() {
  const table = document.getElementById('dc-vtable');
  if (table.querySelector('thead')) return;
  table.insertAdjacentHTML('afterbegin', tableHeadHtml());
  const select = document.getElementById('dc-sort-select');
  dcSortMenu = initSortMenu(document.getElementById('dc-sort-menu'), select, { avail: dcAvail || {} });
  select.addEventListener('change', () => { const [key, dir] = (select.value || 'rank-asc').split('-'); dcSort = { key, dir }; renderDcTable(selected()); });
  initHeaderSort(table, () => dcSort, (key, dir) => dcSortMenu.set(key, dir));
  document.getElementById('dc-clear').addEventListener('click', clearFilters);
}

async function loadAndRender() {
  const cluster = getCluster();
  document.getElementById('back-link').href = `/datacenters?cluster=${cluster}`;
  if (window.sondaSetClusterBanner) window.sondaSetClusterBanner(cluster);
  if (!providerParam) {
    document.getElementById('dc-loading').style.display = 'none';
    document.getElementById('dc-error').style.display = 'block';
    document.getElementById('dc-error').textContent = 'No provider specified. Open one from the datacenters list.';
    return;
  }
  try {
    const [data, summary] = await Promise.all([fetchValidators(cluster), fetchSummary(cluster).catch(() => null)]);
    if (summary && window.sondaUpdateStrip) window.sondaUpdateStrip(summary);
    lastSnapshotTs = data?.meta?.timestamp || null;
    dcSummary = summary;
    const records = (data?.records || []).filter(isValidatorRecord);
    computeTvcRanks(records);
    dcStakeTiers = computeStakeTiers(records);
    dcBands = computePerfBands(records);
    dcAvail = tableAvailability(records);
    dcClusterStake = records.reduce((s, r) => s + (r.activated_stake_lamports || 0), 0);
    applyAvailability(document.getElementById('dc-vtable-wrap'), dcAvail);
    if (dcSortMenu) dcSortMenu.update(dcAvail);
    let providers = aggregateProviders(records, summary);
    entry = findProvider(providers, providerParam);
    if (!entry) {
      // maybe a carrier with network nodes but no validators (Cogent, Zayo, Tata)
      try {
        const infra = await fetchInfrastructure(cluster);
        const asnToProvider = new Map();
        for (const e of providers) for (const a of e.asns) asnToProvider.set(a.asn, e.provider);
        providers = providers.concat(networkOnlyProviders(providers, infra?.records || [], summary, asnToProvider));
        entry = findProvider(providers, providerParam);
      } catch (e) { /* no infrastructure file: fall through to not-found */ }
    }
    if (!entry) {
      // Same state as the validator page: the provider is not in this cluster; list the
      // clusters where it is (canonical order, cluster colours), one click to go there.
      const pretty = providerParam.replace(/-/g, ' ');
      const clusterName = CLUSTER_SHORT[cluster] || cluster;
      document.getElementById('dc-loading').style.display = 'none';
      const err = document.getElementById('dc-error');
      err.style.display = 'block';
      err.innerHTML = `<div class="nf-block">
        <div class="nf-title">This provider has no validators in the selected cluster</div>
        <div class="nf-id"><code>${esc(pretty)}</code></div>
        <p class="nf-message" id="nf-message">Checking the other clusters…</p>
        <div class="nf-linked" id="nf-linked"></div>
        <div class="nf-actions"><a href="/datacenters?cluster=${esc(cluster)}" class="nf-btn">Back to datacenters in ${esc(clusterName)}</a><a href="/" class="nf-btn nf-btn-ghost">Overview</a></div>
      </div>`;
      const found = await providerPresence(providerParam, cluster);
      const msg = document.getElementById('nf-message');
      const linked = document.getElementById('nf-linked');
      if (!msg || !linked) return;
      if (found.length) {
        msg.textContent = 'It is present on the cluster(s) listed below. Click to view it there.';
        linked.innerHTML = found.map(f => `<a class="nf-linked-card cluster-${f.cluster.replace(/-beta|-community/g, '')}" href="/datacenter?provider=${esc(f.slug)}&cluster=${f.cluster}"><div class="nf-linked-cluster">${CLUSTER_SHORT[f.cluster]}</div><div class="nf-linked-name">${fmt(f.count)} validator${f.count === 1 ? '' : 's'} · ${pct(f.stake_pct, 1)} of stake</div><div class="nf-linked-arrow">&#8594;</div></a>`).join('');
      } else {
        msg.textContent = 'It has no validators on the other clusters either right now.';
      }
      return;
    }
    // legacy asn= links: keep the ASN as a filter, normalise the URL to the slug
    if (!params.get('provider') && params.get('asn') && !filters.asn.includes(params.get('asn'))) filters.asn.push(params.get('asn'));
    const url = new URL(window.location.href); url.searchParams.set('provider', entry.slug); window.history.replaceState(null, '', url.toString());
    allProviderRecords = records.filter(r => r.geolocation && providerOf(r) === entry.provider);
    if (entry.net_only) cityNet = entry.net_cities || new Map();
    else if (entry.net_total > 0) await loadCityNet(cluster, entry.provider, entry.asns.map(a => a.asn));
    document.querySelector('.dc-vals').style.display = entry.net_only ? 'none' : '';
    document.getElementById('dc-head-tag').textContent = entry.net_only ? 'Network infrastructure host' : 'Network provider';
    renderHeader(entry);
    initDcTableHead();
    renderAll();
    document.getElementById('dc-loading').style.display = 'none';
    document.getElementById('dc-content').style.display = 'block';
    document.title = `${entry.provider} · SONDA`;
  } catch (e) {
    console.error('datacenter:', e);
    document.getElementById('dc-loading').style.display = 'none';
    document.getElementById('dc-error').style.display = 'block';
    document.getElementById('dc-error').textContent = 'Could not load this provider.';
  }
}

async function refreshDatacenter() {
  const cluster = getCluster();
  const data = await fetchValidators(cluster);
  const ts = data?.meta?.timestamp || null;
  if (!data?.records || (ts && ts === lastSnapshotTs) || getCluster() !== cluster) return;
  await preserveScroll(() => loadAndRender());
}

document.addEventListener('DOMContentLoaded', () => {
  bootstrapCluster();
  loadAndRender();
  // Cluster switch keeps the provider (its slug is cluster-independent); filters are
  // cluster-specific and are dropped. A provider absent there gets the fallback below.
  window.addEventListener('sonda:cluster-change', () => {
    const slug = entry?.slug || providerParam;
    window.location.href = slug ? `/datacenter?provider=${encodeURIComponent(slug)}&cluster=${getCluster()}` : `/datacenters?cluster=${getCluster()}`;
  });
  startAutoRefresh(refreshDatacenter, { intervalMs: 60000 });
});
</script>
