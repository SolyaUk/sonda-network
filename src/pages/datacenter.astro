  host.innerHTML = e.countries.map(c => { const st = fState('country', c.cc); return `<span class="dc-country${st === 'include' ? ' is-active' : ''}${st === 'exclude' ? ' is-excluded' : ''}" data-cc="${esc(c.cc)}" data-tip="${esc(c.country)}: ${c.count} validators, ${fmtStakeSol(c.stake_lamports)} SOL\nclick to filter">${circleFlagSvg(c.cc.toLowerCase(), { size: 16 })}<b>${esc(c.cc)}</b>${fmt(c.count)}${NOT_BUTTON}</span>`; }).join('');
  host.querySelectorAll('.dc-country').forEach(el => el.addEventListener('click', (ev) => toggleFilter('country', el.dataset.cc, ev.target instanceof Element && ev.target.closest('.vagg-not') ? 'exclude' : 'include')));
  if (!host.dataset.lp) { host.dataset.lp = '1'; initLongPress(host, '.dc-country', (t) => toggleFilter('country', t.dataset.cc, 'exclude')); }
}

function esc(v) { return String(v ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
const TAG_TIP = {
  isp: 'Internet access provider: validators here run on residential or office connections, not in a datacenter',
  transit: 'Backbone carrier that owns the IP range but rents no servers; the datacenter is unknown',
  private: 'The validator operator\'s own network (own ASN)',
  'solana-focused': 'Solana-focused hosting provider',
  'DZ-partner': 'DoubleZero partner',
  banned: 'Listed as banned for SFDP delegation',
};
const LINK_ICON = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.5 1.5"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.5-1.5"/></svg>';
const EXT_ICON = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6"/><path d="M20 4L10 14"/><path d="M18 14v6H4V6h6"/></svg>';

function syncUrl() {
  const url = new URL(window.location.href);
  for (const k of ['city', 'asn', 'country']) {
    if (filters[k].length) url.searchParams.set(k, filters[k].join(',')); else url.searchParams.delete(k);
  }
  window.history.replaceState(null, '', url.toString());
}
// mode 'include' (click) or 'exclude' (the "not" button, long press); values with a "!"
// prefix are exclusions, same convention as the list pages
function toggleFilter(k, v, mode = 'include') {
  filters[k] = nextListValues(filters[k], v, mode);
  syncUrl(); renderAll();
}
function fState(k, v) { return listValueState(filters[k], v); }
const incOf = (k) => splitFilterValues(filters[k]).inc;
function clearFilters() { filters.city = []; filters.asn = []; filters.country = []; syncUrl(); renderAll(); }

function passes(r, keys) {
  const g = r.geolocation || {};
  const val = { city: g.city, asn: g.asn, country: g.country_code };
  for (const k of keys) {
    const { inc, exc } = splitFilterValues(filters[k]);
    if (inc.length && !inc.includes(val[k])) return false;
    if (exc.length && exc.includes(val[k])) return false;
  }
  return true;
}
function selected() { return allProviderRecords.filter(r => passes(r, ['city', 'asn', 'country'])); }
function scopeOf(records) {
  const clusterStake = dcClusterStake || 1;
  const nums = (fn) => records.map(fn).filter(v => v != null).sort((a, b) => a - b);
  const med = (a) => (a.length ? (a.length % 2 ? a[(a.length - 1) / 2] : (a[a.length / 2 - 1] + a[a.length / 2]) / 2) : null);
  const skips = records.map(r => r.skip_rate).filter(v => v != null);
  const stake = records.reduce((s, r) => s + (r.activated_stake_lamports || 0), 0);
  return {
    count: records.length,
    delinquent: records.filter(r => r.delinquent).length,
    stake_lamports: stake,
    stake_pct: (stake / clusterStake) * 100,
    dz: records.filter(r => r.dz_connected).length,
    multicast: records.filter(r => r.dz_multicast_publisher).length,
    bam: records.filter(r => r.bam_node).length,
    sfdp: records.filter(r => r.sfdp_state === 'Approved').length,
    skip_avg: skips.length ? skips.reduce((s, v) => s + v, 0) / skips.length : null,
    rank_median: med(nums(r => r._tvc_rank)),
    rank_best: records.reduce((m, r) => (r._tvc_rank != null && (m == null || r._tvc_rank < m) ? r._tvc_rank : m), null),
    ibrl_median: med(nums(r => r.ibrl?.ibrl_score)),
    cities: new Set(records.map(r => `${r.geolocation?.city}|${r.geolocation?.country_code}`)).size,
    countries: new Set(records.map(r => r.geolocation?.country_code).filter(Boolean)).size,
  };
}
let dcClusterStake = 0;

function providerHref() { return sharedProviderHref(entry.provider, getCluster()); }

