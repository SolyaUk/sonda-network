  logo.dataset.initial = e.provider.charAt(0).toUpperCase();
  logo.innerHTML = e.logo ? `<img src="${esc(e.logo)}" alt="" onerror="this.remove()">` : '';
  const link = `${location.origin}${providerHref()}`;
  document.getElementById('dc-name').innerHTML = `<span class="dc-name-text">${esc(e.provider)}</span><span class="dc-name-actions">` +
