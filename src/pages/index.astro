/* Stacked bar (clients/versions) */
.stacked-bar { position: relative; height: 38px; border-radius: 6px; background: var(--bg-secondary); margin: 0.5rem 0; }
.stacked-bar-inner { display: flex; height: 100%; width: 100%; border-radius: 6px; overflow: hidden; }
.stacked-segment {
