.donut-wrap { display: grid; grid-template-columns: auto 1fr; gap: 1rem; align-items: center; margin-top: 0.5rem; flex: 1; }
.donut-svg { width: 130px; height: 130px; flex-shrink: 0; }
.donut-svg svg { width: 100%; height: 100%; display: block; }

/* 2-column legend with shared grid alignment.
   Six tracks: [dot] [label] [num]   [dot] [label] [num]
   Items use display:contents so their three children flow directly into the
   parent grid. Result: all dots align, all labels start at same x and END at
   the longest-label width, all percents align right after labels. No more big
   gaps between short names and their percentages. */
.donut-legend-2col {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto auto minmax(0, 1fr) auto;
  column-gap: 0.4rem;
  row-gap: 0.32rem;
  align-items: center;
  font-size: 0.74rem;
  min-width: 0;
}
.donut-legend-2col .donut-legend-item { display: contents; }
/* Base item style for non-2col contexts (RPC summary). */
.donut-legend-item { display: flex; align-items: center; gap: 0.4rem; min-width: 0; }
/* Add visual breathing room between the two legend columns by indenting the
   second column's dot. Only applies when there's actually a 2nd column item. */
.donut-legend-2col > .donut-legend-item:nth-child(even) > .donut-legend-dot {
  margin-left: 0.7rem;
}

.donut-legend-dot { width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0; }
.donut-legend-label {
  color: var(--text-secondary);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  min-width: 0;
}
.donut-legend-num {
  color: var(--text-muted); font-family: var(--font-mono); font-size: 0.7rem;
  white-space: nowrap;
}

@media (max-width: 480px) {
  /* Single visual column on narrow screens. Three sub-tracks. */
  .donut-legend-2col {
    grid-template-columns: auto minmax(0, 1fr) auto;
  }
  .donut-legend-2col > .donut-legend-item:nth-child(even) > .donut-legend-dot {
    margin-left: 0;
  }
  .donut-svg { width: 110px; height: 110px; }
}

/* SFDP linked card content (testnet 4th slot) */
.sfdp-linked-content { display: flex; flex-direction: column; gap: 0.55rem; flex: 1; }
.sfdp-linked-num { font-size: 2rem; font-weight: 700; color: var(--accent-blue); line-height: 1; }
.sfdp-linked-states { display: flex; flex-direction: column; gap: 0.25rem; padding-top: 0.5rem; border-top: 1px solid var(--border); }

/* Infra status grid */
.infra-status-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.75rem; margin-bottom: 0.75rem; }
@media (max-width: 768px) { .infra-status-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 480px) { .infra-status-grid { grid-template-columns: 1fr; } }
.infra-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; padding: 1rem; display: flex; flex-direction: column; gap: 0.4rem; transition: border-color 0.15s; }
.infra-card.healthy { border-color: rgba(34,197,94,0.25); }
.infra-card.degraded { border-color: rgba(249,115,22,0.4); }
.infra-card.down { border-color: rgba(239,68,68,0.4); }
.infra-card.absent { opacity: 0.55; }
.infra-card-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.2rem; }
.infra-card-name { font-size: 0.85rem; font-weight: 600; color: var(--text-primary); }
.infra-card-status-dot { width: 8px; height: 8px; border-radius: 50%; }
.infra-card-status-dot.ok { background: var(--status-good); box-shadow: 0 0 6px var(--status-good); }
.infra-card-status-dot.warn { background: var(--status-warning); }
.infra-card-status-dot.bad { background: var(--status-critical); }
.infra-card-status-dot.neutral { background: var(--text-muted); }
.infra-card-main { font-family: var(--font-mono); font-size: 1.4rem; font-weight: 600; color: var(--text-primary); line-height: 1; }
.infra-card-sub { font-size: 0.75rem; color: var(--text-muted); }

/* Infra summary lines (DZ + RPC) — side-by-side on desktop */
.infra-summary-grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;
  align-items: stretch;
}
@media (max-width: 900px) { .infra-summary-grid { grid-template-columns: 1fr; } }

.infra-summary-line { background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; padding: 0.95rem 1.1rem; }
.infra-summary-line.absent { opacity: 0.55; }
.infra-summary-head { display: flex; align-items: center; gap: 0.8rem; flex-wrap: wrap; }
.infra-summary-label { font-size: 0.85rem; font-weight: 600; }
.infra-summary-stats {
  font-size: 0.75rem;
  color: var(--text-secondary);
  /* Allow the stats line to wrap on narrow widths instead of overflowing
     when long compositions (e.g. "X public RPCs (Y on validators) ·
     Z/W official reachable · K on DoubleZero") exceed available space. */
  display: inline;
  word-spacing: 0.02em;
}

/* DZ link issues — compact aggregated row (v2.6) + chips with rounded loss values */
.dz-issues-summary {
  margin-top: 0.55rem;
  display: flex; flex-wrap: wrap; gap: 0.4rem 1rem;
  font-size: 0.78rem; color: var(--text-secondary);
}
.dz-issues-col .dz-issues-summary { margin-top: 0; }
.dz-issues-summary .dz-summ-tag { font-family: var(--font-mono); font-weight: 600; }
.dz-issues-summary .dz-summ-tag.warn { color: var(--status-warning); }
.dz-issues-summary .dz-summ-tag.bad  { color: var(--status-critical); }
.dz-issues-summary .dz-summ-tag.muted { color: var(--text-muted); }
.dz-issues-summary .dz-summ-tag.ok   { color: var(--status-good); }
.dz-issues { margin-top: 0.45rem; display: flex; flex-wrap: wrap; gap: 0.35rem 0.45rem; font-size: 0.7rem; font-family: var(--font-mono); }
.dz-issue { color: var(--status-warning); padding: 0.18rem 0.45rem; background: rgba(249,115,22,0.1); border-radius: 4px; }
.dz-issue.bad { color: var(--status-critical); background: rgba(239,68,68,0.1); }
.dz-issue.muted { color: var(--text-muted); background: rgba(140,137,163,0.1); }
.dz-issue.more { color: var(--text-muted); background: transparent; padding: 0.18rem 0.2rem; }

/* Generic mini-donut + universal legend grid pattern (v2.6).
   Used by every donut on the homepage:
   - RPC ASN + RPC countries (mainnet) on RPC summary card
   - DZ device-ASN (mainnet) on DZ summary card
   - Solana / Jito endpoints (testnet/devnet) on Endpoints distribution card
   - Devnet validators-by-stake story
   The .donut-legend uses display:grid with auto max-content auto so the legend
   width naturally fits the longest label, all numbers right-align in their own column,
   and short labels do NOT create stretched empty space. On narrow viewports the
   middle column collapses to minmax(0,1fr) with ellipsis. */
.rpc-summary-text { display: flex; flex-direction: column; }
.rpc-stats-row { display: flex; gap: 0.4rem 1.4rem; flex-wrap: wrap; font-size: 0.78rem; color: var(--text-secondary); margin-top: 0.5rem; }
.rpc-stat-item { display: flex; align-items: baseline; gap: 0.35rem; }
.rpc-stat-val { font-family: var(--font-mono); font-weight: 600; color: var(--text-primary); }
/* DZ-only inline tag in the testnet/devnet stats row — sits next to country/city/provider counts */
.dz-mainnet-only {
  font-size: 0.74rem; color: var(--text-muted);
  padding: 0.05rem 0.55rem; border: 1px dashed var(--border); border-radius: 6px;
  align-self: center;
}

/* Two-donut row inside RPC card; one donut inside DZ; donuts row for Endpoints distribution */
.rpc-donuts-row,
.dz-donuts-row {
  display: grid; gap: 1.1rem 2rem;
  margin-top: auto; padding-top: 0.85rem;
  border-top: 1px solid var(--border);
}
.rpc-donuts-row { grid-template-columns: 1fr 1fr; }
.dz-donuts-row  { grid-template-columns: 1fr; }
.dz-donuts-row.cols-2 { grid-template-columns: 1fr 1fr; }
.dz-donuts-row.cols-3 { grid-template-columns: repeat(3, 1fr); }
@media (max-width: 760px) {
  .rpc-donuts-row,
  .dz-donuts-row.cols-2,
  .dz-donuts-row.cols-3 { grid-template-columns: 1fr; gap: 1rem; }
}

/* DZ card content row (mainnet only): donut column on the left, issues column on the right.
   Two equal columns keep DZ card height close to RPC card height (which has two donuts side-by-side).
   Spacing (margin-top: 0 + padding-top: 0.85rem + border-top) matches .rpc-donuts-row exactly,
   so the separator line sits at the same vertical distance from the stats row in both cards. */
.dz-content-row {
  display: grid; grid-template-columns: 1fr 1fr; gap: 1rem 1.5rem;
  margin-top: 0; padding-top: 0.85rem;
  border-top: 1px solid var(--border);
  align-items: start;
}
@media (max-width: 760px) {
  .dz-content-row { grid-template-columns: 1fr; gap: 0.75rem; }
}
.dz-issues-col { display: flex; flex-direction: column; gap: 0.4rem; min-width: 0; }
.dz-issues-col .dz-issues-summary { margin: 0; }
.dz-issues-col .dz-issues { margin: 0; }

.donut-block {
  display: flex; flex-direction: column; gap: 0.5rem; min-width: 0;
  padding: 0.7rem 0.85rem 0.8rem;
  background: var(--bg-card-hover);
  border: 1px solid var(--border);
  border-radius: 10px;
}
/* Title gets a soft underline so the heading reads as the cap of the mini-card,
   not as a separate label floating above. min-height keeps the title strip
   the same vertical size for one- vs two-line titles, which keeps adjacent
   donut bodies horizontally aligned. */
.donut-block-title {
  font-size: 0.7rem; color: var(--text-muted);
  text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;
  min-height: 2.1em;
  display: flex; align-items: flex-end;
  padding-bottom: 0.45rem;
  border-bottom: 1px solid var(--border);
}
.donut-block-body { display: flex; align-items: center; gap: 0.7rem; min-width: 0; }
.donut-block-body .donut-mini { flex-shrink: 0; }
.donut-mini { width: 84px; height: 84px; }
.donut-mini svg { width: 100%; height: 100%; display: block; }

/* Universal legend grid: one parent grid, items use display:contents.
   3 columns: dot (auto) | label (max-content with truncation fallback) | num (auto, right). */
.donut-legend {
  flex: 1 1 auto; min-width: 0;
  display: grid;
  /* minmax(0, max-content) on the middle column: labels take natural width when room allows,
     and gracefully shrink with ellipsis when the legend's natural width exceeds its container
     (e.g. narrow cards with long ASN names like "LIMESTONENETWORKS"). Without the min:0 floor,
     max-content stays rigid and the right-aligned percentages overflow the card edge. */
  grid-template-columns: auto minmax(0, max-content) auto;
  column-gap: 0.45rem; row-gap: 0.32rem;
  /* width: fit-content prevents the grid from stretching across the entire flex parent.
     With auto+max-content+auto, the columns are sized by their content, so any extra space
     in the flex parent would otherwise sit BETWEEN columns as visible gaps. fit-content
     pins the grid to its natural content width (= dot + longest label + widest number). */
  width: fit-content;
  max-width: 100%;
  min-width: 0;
  font-size: 0.74rem;
  align-items: center;
}
.donut-legend .donut-legend-item { display: contents; }
.donut-legend .donut-legend-dot {
  width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0;
  align-self: center;
}
.donut-legend .donut-legend-label {
  color: var(--text-secondary);
  white-space: nowrap;
  overflow: hidden; text-overflow: ellipsis;
  min-width: 0;
}
.donut-legend .donut-legend-num {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  color: var(--text-muted);
  font-variant-numeric: tabular-nums;
  text-align: right;
  white-space: nowrap;
}
/* On narrow viewports (mobile, narrow card columns), where the legend's natural width
   would overflow its parent, switch to a flex-fill middle column with ellipsis truncation. */
@media (max-width: 520px) {
  .donut-legend {
    grid-template-columns: auto minmax(0, 1fr) auto;
    width: 100%;
  }
}
.donut-mini-compact { width: 72px; height: 72px; }

/* DZ footnote (testnet/devnet): "DoubleZero is mainnet-only" small caption */
.dz-footnote {
  font-size: 0.68rem; color: var(--text-muted); margin-top: 0.45rem;
  font-style: italic; opacity: 0.85;
}

@media (max-width: 600px) {
  .donut-mini { width: 76px; height: 76px; }
  .donut-mini-compact { width: 64px; height: 64px; }
}

/* PATH */
.path-list { display: flex; flex-direction: column; gap: 0.85rem; }
.path-item { background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; padding: 1rem 1.25rem; }
.path-item-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.5rem; flex-wrap: wrap; gap: 0.5rem; }
.path-name { font-size: 0.95rem; font-weight: 600; color: var(--text-primary); display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
.path-met-badge {
  font-family: var(--font-mono); font-size: 0.62rem; font-weight: 600;
  background: rgba(34,197,94,0.15); color: var(--status-good);
  padding: 0.18rem 0.5rem; border-radius: 4px;
  text-transform: uppercase; letter-spacing: 0.06em;
  display: inline-flex; align-items: center; gap: 0.3rem;
}
.path-current { font-family: var(--font-mono); font-size: 1rem; font-weight: 700; }
.path-current.warn { color: var(--status-warning); }
.path-current.crit { color: var(--status-critical); }
.path-current.good { color: var(--status-good); }
.path-bar-container { position: relative; height: 10px; background: var(--bg-primary); border: 1px solid var(--border); border-radius: 5px; overflow: visible; margin: 0.6rem 0 0.4rem; }
.path-bar-target { position: absolute; height: 100%; background: rgba(34,197,94,0.18); border-right: 2px solid var(--status-good); border-radius: 5px 0 0 5px; left: 0; top: 0; }
.path-bar-current { position: absolute; height: 100%; border-radius: 5px; left: 0; top: 0; transition: width 0.4s; opacity: 0.75; }
.path-bar-current.warn { background: var(--status-warning); }
.path-bar-current.crit { background: var(--status-critical); }
.path-bar-current.good { background: var(--status-good); opacity: 0.55; }
/* v2.6: bright green vertical tick marker on target threshold. Sits above .path-bar-current
   so it's visible regardless of bar color. Slight glow to draw the eye. */
.path-bar-target-tick {
  position: absolute;
  top: -3px; bottom: -3px;
  width: 3px;
  background: var(--status-good);
  border-radius: 1.5px;
  transform: translateX(-1.5px);
  box-shadow: 0 0 6px 1px rgba(34,197,94,0.55);
  pointer-events: none;
  z-index: 2;
}
.path-explainer { font-size: 0.82rem; color: var(--text-secondary); margin-top: 0.4rem; }
.path-target-line { font-size: 0.72rem; color: var(--text-muted); margin-top: 0.2rem; }

/* GEO bar list */
.geo-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
@media (max-width: 768px) { .geo-grid { grid-template-columns: 1fr; } }
.geo-block { background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; padding: 1.25rem; }
.card-label { font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.07em; margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.3rem; }
.geo-chart { display: flex; flex-direction: column; gap: 0.5rem; }
.geo-row { display: grid; grid-template-columns: 75px 1fr 50px 70px; align-items: center; gap: 0.6rem; }
.geo-country { display: flex; align-items: center; gap: 0.35rem; min-width: 0; }
.geo-flag { font-size: 0.95rem; line-height: 1; }
.geo-cc { font-size: 0.72rem; color: var(--text-muted); font-family: var(--font-mono); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.geo-bar-wrap { height: 6px; background: var(--bg-primary); border: 1px solid var(--border); border-radius: 3px; overflow: hidden; }
.geo-bar { height: 100%; border-radius: 3px; min-width: 1px; }
.geo-bar.normal { background: var(--accent-blue); }
.geo-bar.warn { background: var(--status-warning); }
.geo-bar.crit { background: var(--status-critical); }
.geo-count { font-size: 0.78rem; color: var(--text-primary); text-align: right; font-family: var(--font-mono); }
.geo-stake { font-size: 0.72rem; color: var(--text-muted); text-align: right; font-family: var(--font-mono); }
@media (max-width: 480px) {
  .geo-row { grid-template-columns: 60px 1fr 45px; }
  .geo-stake { display: none; }
}

/* ACADEMIC METRICS — 5 cards. HHI gets more width (its "BY COUNTRY" / "BY ASN"
   labels were wrapping). Nakamoto trimmed slightly to compensate. */
.academic-grid { display: grid; grid-template-columns: 1.3fr 1fr 1fr 1.4fr 1.5fr; gap: 0.75rem; align-items: stretch; }
@media (max-width: 1100px) { .academic-grid { grid-template-columns: 1fr 1fr 1fr; } }
@media (max-width: 700px) { .academic-grid { grid-template-columns: 1fr 1fr; } }
@media (max-width: 480px) { .academic-grid { grid-template-columns: 1fr; } }

.academic-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; padding: 1rem; display: flex; flex-direction: column; gap: 0.75rem; }
.academic-label { font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.07em; display: flex; align-items: center; gap: 0.3rem; }
.academic-tile-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; flex: 1; }
.academic-tile-grid-1 { grid-template-columns: 1fr; }
.academic-tile { display: flex; flex-direction: column; gap: 0.3rem; padding: 0.55rem 0.7rem; background: var(--bg-secondary); border-radius: 6px; justify-content: space-between; position: relative; cursor: help; }
.academic-tile-row { display: flex; align-items: baseline; justify-content: space-between; gap: 0.4rem; }
.academic-tile-label { font-size: 0.62rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.06em; }
.academic-tile-num { font-size: 1.4rem; font-weight: 700; color: var(--text-primary); line-height: 1; }
.academic-tile-num.small { font-size: 1rem; }
.academic-tile-num.good { color: var(--status-good); }
.academic-tile-num.warning { color: var(--status-warning); }
.academic-tile-num.critical { color: var(--status-critical); }
.academic-tile-num.neutral { color: var(--text-secondary); }

/* HHI/Gini/Shannon scales */
.academic-scale { position: relative; height: 10px; margin-top: 0.4rem; cursor: help; }
.academic-scale.academic-scale-thin { height: 7px; margin-top: 0.25rem; }
.academic-scale-track { display: flex; height: 100%; border-radius: 4px; overflow: hidden; }
.academic-scale-seg { height: 100%; }
.academic-scale-seg.good { background: var(--status-good); opacity: 0.45; }
.academic-scale-seg.warn { background: var(--status-warning); opacity: 0.45; }
.academic-scale-seg.crit { background: var(--status-critical); opacity: 0.45; }
.academic-scale-pin { position: absolute; top: -3px; width: 3px; height: 16px; background: var(--text-primary); border-radius: 1.5px; transform: translateX(-50%); box-shadow: 0 0 4px rgba(0,0,0,0.6); transition: left 0.4s ease; pointer-events: none; }
.academic-scale.academic-scale-thin .academic-scale-pin { top: -3px; height: 13px; }

/* Floating tooltip for academic tiles (positioned by JS using viewport coords).
   Uses position:fixed so clientX/clientY map directly without scroll offset issues. */
.academic-tip {
  pointer-events: none; position: fixed; z-index: 1000;
  background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 6px;
  padding: 0.5rem 0.7rem; font-size: 0.76rem; color: var(--text-primary);
  white-space: nowrap; box-shadow: 0 4px 16px rgba(0,0,0,0.4);
  text-shadow: none; opacity: 0; transition: opacity 0.12s;
  font-family: var(--font-body); font-weight: 400; letter-spacing: 0;
  text-transform: none; left: 0; top: 0;
}
.academic-tip.show { opacity: 1; }
.academic-tip strong { color: var(--text-primary); font-weight: 600; }
.academic-tip .tip-rating { display: block; font-size: 0.7rem; color: var(--text-muted); margin-top: 0.2rem; }

/* Nakamoto donuts grid */
.nak-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; flex: 1; }
.nak-tile {
  display: flex; align-items: center; justify-content: space-between;
  padding: 0.55rem 0.7rem; background: var(--bg-secondary); border-radius: 6px; gap: 0.5rem;
}
.nak-tile-text { display: flex; flex-direction: column; gap: 0.2rem; min-width: 0; }
.nak-donut { width: 60px; height: 60px; flex-shrink: 0; }
.nak-donut svg { width: 100%; height: 100%; display: block; }

/* Superminority */
.sm-stack { display: flex; flex-direction: column; gap: 0.5rem; flex: 1; }
.sm-block { display: flex; flex-direction: column; gap: 0.3rem; padding: 0.55rem 0.7rem; background: var(--bg-secondary); border-radius: 6px; }
.sm-block-vals { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.3rem; align-items: baseline; }
.sm-mini { display: flex; flex-direction: column; gap: 0.05rem; }
.sm-tag { font-size: 0.6rem; color: var(--text-muted); text-transform: uppercase; }

/* About + Roadmap */
.about-roadmap-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 14px; padding: 1.75rem; }
.about-roadmap-grid { display: grid; grid-template-columns: 1fr 1.15fr; gap: 2rem; align-items: start; }
@media (max-width: 900px) { .about-roadmap-grid { grid-template-columns: 1fr; gap: 2rem; } }
.about-roadmap-title { font-family: var(--font-display); font-size: 1.25rem; font-weight: 600; color: var(--text-primary); margin: 0; }
.about-roadmap-title-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.1rem; flex-wrap: wrap; gap: 0.5rem; }

.about-block { display: flex; flex-direction: column; gap: 0.75rem; }
.about-header { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.25rem; }
.about-logo { width: 36px; height: 36px; border-radius: 8px; }
.about-block .about-text { font-size: 0.9rem; color: var(--text-secondary); line-height: 1.7; margin: 0; }

/* About — 3 cluster rows (mainnet / testnet / devnet) in their own colors.
   Grid layout aligns all rows: tag column, validators column, countries column,
   providers column. Each row's numbers are tinted by its cluster's accent. */
.about-clusters {
  display: grid;
  grid-template-columns: auto auto auto auto;
  column-gap: 1.5rem;
  row-gap: 0.55rem;
  padding: 0.85rem 0;
  margin: 0.25rem 0;
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  align-items: baseline;
}
.about-cluster-row { display: contents; }

.about-cluster-tag {
  font-family: var(--font-mono); font-size: 0.62rem; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.08em;
  padding: 0.2rem 0.55rem; border-radius: 4px;
