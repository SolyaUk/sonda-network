</style>


<script>
import { fetchSummary, fetchValidators, fetchValidatorsCached, fetchMainnetSummaryCached, bootstrapCluster } from '../lib/data.js';
import { fmt, pct, flag, fmtTimestamp, hhiRating, giniRating, nakRating, smRating, shannonRating, versionColor } from '../lib/formatters.js';
import { savePreviousFetch } from '../lib/compare.js';

// ───────── Constants ─────────

const CLIENT_COLORS: Record<string, string> = {
  'Jito_BAM': '#22d3ee', 'Jito_Labs': '#3b82f6', 'Frankendancer': '#a78bfa',
  'Harmonic': '#06b6d4', 'FD_Harmonic': '#0891b2', 'Harmonic_Major': '#0e7490',
  'Firedancer': '#f97316', 'Rakurai': '#eab308', 'Agave': '#6b7280',
};

const PIE_PALETTE = ['#3b82f6', '#a78bfa', '#22d3ee', '#f97316', '#22c55e', '#eab308', '#ef4444', '#e879f9', '#06b6d4', '#fbbf24', '#8b5cf6', '#10b981'];

// Different palettes per donut type so they don't all look identical at a glance.
// Stake palette leads with violet+amber+green (matches "asset" feel).
// RPC palette leads with cyan+blue+orange (matches "endpoint/network" feel).
// RPC-SECONDARY: same palette set but rotated leading order — used for the country donut
//   that sits next to the ASN donut on the RPC summary card. Two adjacent donuts must look
//   visually distinct or they read as duplicates.
// DZ palette leads with violet (matches DoubleZero accent identity).
// JITO palette leads with cyan (matches Jito BAM accent identity).
const PIE_PALETTE_STAKE = ['#a78bfa', '#fbbf24', '#22c55e', '#3b82f6', '#e879f9', '#10b981', '#f97316', '#06b6d4', '#eab308', '#8b5cf6'];
const PIE_PALETTE_RPC           = ['#22d3ee', '#3b82f6', '#f97316', '#a78bfa', '#22c55e', '#ef4444', '#fbbf24', '#06b6d4', '#e879f9', '#10b981'];
const PIE_PALETTE_RPC_SECONDARY = ['#a78bfa', '#fbbf24', '#10b981', '#06b6d4', '#e879f9', '#3b82f6', '#22c55e', '#f97316', '#ef4444', '#22d3ee'];
const PIE_PALETTE_DZ            = ['#a78bfa', '#22d3ee', '#fbbf24', '#22c55e', '#3b82f6', '#f97316', '#e879f9', '#06b6d4', '#10b981', '#ef4444'];
const PIE_PALETTE_JITO          = ['#22d3ee', '#a78bfa', '#fbbf24', '#3b82f6', '#22c55e', '#f97316', '#ef4444', '#06b6d4', '#e879f9', '#10b981'];

function pickPalette(kind: 'stake' | 'rpc' | 'rpc-secondary' | 'dz' | 'jito' | 'default'): string[] {
  if (kind === 'stake')         return PIE_PALETTE_STAKE;
  if (kind === 'rpc')           return PIE_PALETTE_RPC;
  if (kind === 'rpc-secondary') return PIE_PALETTE_RPC_SECONDARY;
  if (kind === 'dz')            return PIE_PALETTE_DZ;
  if (kind === 'jito')          return PIE_PALETTE_JITO;
  return PIE_PALETTE;
}

// ───────── Helpers ─────────

function getClientColor(name: string): string {
  const base = name.replace(/\s*\(\d+\)\s*$/, '').trim();
  return CLIENT_COLORS[base] || '#6b7280';
}
function cleanClientName(name: string): string {
  return name.replace(/\s*\(\d+\)\s*$/, '').trim();
}
function setText(id: string, val: string) {
  const el = document.getElementById(id);
  if (!el) return;
  el.textContent = val;
  el.classList.remove('sk-val');
}
function setTextColored(id: string, val: string, cls: string) {
  const el = document.getElementById(id);
  if (!el) return;
  el.textContent = val;
  el.classList.remove('sk-val');
  el.classList.remove('good', 'warning', 'critical', 'neutral');
  if (cls) el.classList.add(cls);
}
function setPin(id: string, leftPct: number) {
  const el = document.getElementById(id);
  if (!el) return;
  el.style.left = `${Math.max(0, Math.min(100, leftPct))}%`;
}
function escapeHtml(s: any): string {
  return String(s).replace(/[&<>"']/g, c =>
    ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c] || c));
}
function infoIcon(): string {
  return `<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>`;
}

// ───────── Pulse ─────────

// Detects which consensus algorithm a cluster currently runs by checking whether
// SIMD-0326 (the Alpenglow consensus proposal) is in the inactive-features list.
// Works on every cluster (since the features list itself is universal): if SIMD-0326
// is still listed as inactive, Tower BFT is live; if it's gone from inactive, Alpenglow
// has been activated. Searches the description field (not the id, which is just a
// random-looking key like "mustRekeyVm2QHYB...").
function detectConsensus(d: any): 'Tower BFT' | 'Alpenglow' | null {
  const features = d?.features;
  if (!features) return null;
  const inactive = features.inactive || [];
  const hasSimd0326Inactive = inactive.some((f: any) =>
    typeof f?.description === 'string' && f.description.includes('SIMD-0326')
  );
  return hasSimd0326Inactive ? 'Tower BFT' : 'Alpenglow';
}

function renderPulse(d: any, records: any[], cluster: string) {
  const m = d?.metrics || {};
  const v = m.validators || {};
  const ch = m.cluster_health || {};
  const dz = m.doublezero;

  let items: { num: string; label: string; emoji?: string }[] = [];
  if (cluster === 'mainnet-beta') {
    items = [
      { num: fmt(v.total), label: 'active validators' },
      { num: pct(ch.average_stake_weighted_skip_rate, 2), label: 'stake-weighted skip' },
      { num: dz?.multicast_publishers?.stake_percent != null ? pct(dz.multicast_publishers.stake_percent, 1) : '—', label: 'stake on DZ multicast' },
      { num: fmt(v.decentralization?.current?.superminority_validator_33?.value), label: 'superminority validators' },
    ];
  } else if (cluster === 'alpenglow-community') {
    // Alpenglow pulse: validators / skip / delinquent stake / current consensus.
    // Consensus in the 4th slot is the showpiece — captures the historic moment
    // when SIMD-0326 flips from inactive to active.
    const consensus = detectConsensus(d);
    const delinqStakePct = ch.delinquent_stake_percent;
    items = [
      { num: fmt(v.total), label: 'active validators' },
      { num: pct(ch.average_stake_weighted_skip_rate, 2), label: 'stake-weighted skip' },
      { num: delinqStakePct != null ? pct(delinqStakePct, 1) : '—', label: 'delinquent stake' },
      { num: consensus || '—', label: 'consensus', emoji: consensus === 'Alpenglow' ? '🏔' : undefined },
    ];
  } else {
    const active = records.filter(r => !r.delinquent);
    const delinq = records.length - active.length;
    const countries = new Set<string>();
    records.forEach(r => {
      const cc = r.geolocation?.country_code;
      if (cc && cc !== '??') countries.add(cc);
    });
    items = [
      { num: fmt(active.length), label: 'active validators' },
      { num: pct(ch.average_stake_weighted_skip_rate, 2), label: 'stake-weighted skip' },
      { num: fmt(delinq), label: 'delinquent validators' },
      { num: fmt(countries.size), label: 'countries' },
    ];
  }

  const row = document.getElementById('pulse-row');
  if (!row) return;
  const html: string[] = [];
  items.forEach((item, i) => {
    if (i > 0) html.push('<div class="pulse-divider"></div>');
    // Consensus slot renders text + optional emoji at smaller size so it visually
    // matches the layout of numeric slots.
    const isText = /[A-Za-z]/.test(item.num);
    const numCls = isText ? 'pulse-num mono pulse-num-text' : 'pulse-num mono';
    const emojiHtml = item.emoji ? `<span class="pulse-num-emoji">${item.emoji}</span>` : '';
    html.push(`<div class="pulse-item"><div class="${numCls}">${emojiHtml}${escapeHtml(item.num)}</div><div class="pulse-label">${escapeHtml(item.label)}</div></div>`);
  });
  row.innerHTML = html.join('');
}

// ───────── Donut renderer (generic) ─────────
// Used by: devnet validators-by-stake, RPC summary mini-donut, future donuts.
// items: { label, value, color? }[]
function renderDonut(items: { label: string; value: number; color?: string }[], opts: { size?: number; ringR?: number; innerR?: number } = {}): { svg: string; legend: string } {
  if (items.length === 0) return { svg: '<div style="color:var(--text-muted); font-size:0.78rem;">No data</div>', legend: '' };
  const total = items.reduce((s, it) => s + it.value, 0) || 1;
  const size = opts.size ?? 130;
  const cx = size/2, cy = size/2;
  const r = opts.ringR ?? 56;
  const ir = opts.innerR ?? 36;
  let angle = -Math.PI/2;
  const segs: string[] = [];
  const legendItems: string[] = [];
  items.forEach((it, i) => {
    const frac = it.value / total;
    if (frac === 0) return;
    let pathD: string;
    if (frac >= 0.999) {
      pathD = `M ${cx} ${cy - r} A ${r} ${r} 0 1 1 ${cx - 0.001} ${cy - r} L ${cx - 0.001} ${cy - ir} A ${ir} ${ir} 0 1 0 ${cx} ${cy - ir} Z`;
    } else {
      const a2 = angle + frac * Math.PI * 2;
      const x1 = cx + r * Math.cos(angle), y1 = cy + r * Math.sin(angle);
      const x2 = cx + r * Math.cos(a2), y2 = cy + r * Math.sin(a2);
      const ix1 = cx + ir * Math.cos(a2), iy1 = cy + ir * Math.sin(a2);
      const ix2 = cx + ir * Math.cos(angle), iy2 = cy + ir * Math.sin(angle);
      const large = frac > 0.5 ? 1 : 0;
      pathD = `M ${x1} ${y1} A ${r} ${r} 0 ${large} 1 ${x2} ${y2} L ${ix1} ${iy1} A ${ir} ${ir} 0 ${large} 0 ${ix2} ${iy2} Z`;
      angle = a2;
    }
    const color = it.color || PIE_PALETTE[i % PIE_PALETTE.length];
    segs.push(`<path d="${pathD}" fill="${color}"><title>${escapeHtml(it.label)}: ${fmt(it.value)} (${(frac*100).toFixed(1)}%)</title></path>`);
    legendItems.push(`<div class="donut-legend-item">
      <span class="donut-legend-dot" style="background:${color}"></span>
      <span class="donut-legend-label">${it.label}</span>
      <span class="donut-legend-num">${(frac*100).toFixed(1)}%</span>
    </div>`);
  });
  return {
    svg: `<svg viewBox="0 0 ${size} ${size}" xmlns="http://www.w3.org/2000/svg">${segs.join('')}</svg>`,
    legend: legendItems.join(''),
  };
}

// ───────── Nakamoto donut (multi-ring concentric) ─────────
// n ≤ 10: single ring. n 11-20: 2 rings. n 21-30: 3 rings. n > 30: 3 rings + "+N" label.
function renderNakDonut(n: number | null, dim: string): string {
  if (n == null || n < 1) {
    return `<svg viewBox="0 0 60 60"><circle cx="30" cy="30" r="22" fill="none" stroke="var(--text-muted)" stroke-width="5" opacity="0.2"/></svg>`;
  }
  const rating = nakRating(dim, n);
  const color = rating.cls === 'good' ? 'var(--status-good)'
              : rating.cls === 'warning' ? 'var(--status-warning)'
              : rating.cls === 'critical' ? 'var(--status-critical)'
              : 'var(--text-muted)';

  const size = 60, cx = size/2, cy = size/2;
  // Determine ring count and per-ring counts
  const PER_RING = 10;
  let rings: number[] = []; // segment count for each ring (outer to inner)
  let extraLabel = '';

  if (n <= PER_RING) {
    rings = [n];
  } else if (n <= 2 * PER_RING) {
    rings = [PER_RING, n - PER_RING];
  } else if (n <= 3 * PER_RING) {
    rings = [PER_RING, PER_RING, n - 2 * PER_RING];
  } else {
    rings = [PER_RING, PER_RING, PER_RING];
    extraLabel = `+${n - 3 * PER_RING}`;
  }

  // n=1 special case
  if (n === 1) {
    return `<svg viewBox="0 0 ${size} ${size}">
      <circle cx="${cx}" cy="${cy}" r="22" fill="none" stroke="var(--bg-primary)" stroke-width="6" opacity="0.25"/>
      <circle cx="${cx}" cy="${cy}" r="22" fill="none" stroke="${color}" stroke-width="5"/>
    </svg>`;
  }

  // Geometry: rings spaced by ~7px radii, stroke ~4px
  const ringRadii = [22, 15, 8].slice(0, rings.length);
  const strokeW = 4;
  const ringEls: string[] = [];

  rings.forEach((segCount, idx) => {
    const r = ringRadii[idx];
    const circ = 2 * Math.PI * r;
    const gap = segCount >= 8 ? 1.6 : 2.5;
    const segLen = (circ / segCount) - gap;

    if (segLen <= 0) {
      ringEls.push(`<circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="${color}" stroke-width="${strokeW}"/>`);
    } else {
      ringEls.push(`<circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="var(--bg-primary)" stroke-width="${strokeW + 1}" opacity="0.35"/>`);
      ringEls.push(`<circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="${color}" stroke-width="${strokeW}"
        stroke-dasharray="${segLen} ${gap}" transform="rotate(-90 ${cx} ${cy})" stroke-linecap="butt"/>`);
    }
  });

  const labelEl = extraLabel
    ? `<text x="${cx}" y="${cy}" text-anchor="middle" dominant-baseline="central" font-family="var(--font-mono)" font-size="9" fill="${color}" font-weight="700">${extraLabel}</text>`
    : '';

  return `<svg viewBox="0 0 ${size} ${size}">${ringEls.join('')}${labelEl}</svg>`;
}

// ───────── Stories — cluster-aware ─────────

async function renderStories(d: any, records: any[], cluster: string) {
  const grid = document.getElementById('stories-grid');
  if (!grid) return;

  // Layout variants:
  //  - mainnet: 4-col grid, 1+1+2 / 2+2 (Multicast / BAM / Coverage Matrix / Software / SFDP)
  //  - alpenglow: 4-col grid, 2+1+1 / 2+2 (What is Alpenglow / Feature readiness / BLS adoption / Software / Validators by stake)
  //  - testnet/devnet: 2x2 default
  grid.classList.remove('mainnet-layout', 'alpenglow-layout');
  if (cluster === 'mainnet-beta') {
    grid.classList.add('mainnet-layout');
    grid.innerHTML = renderMainnetStories(records, d);
    setupStackedBarTooltip('.stacked-bar', '#stacked-tooltip-clients');
  } else if (cluster === 'alpenglow-community') {
    grid.classList.add('alpenglow-layout');
    grid.innerHTML = renderAlpenglowStories(records, d);
    setupStackedBarTooltip('.stacked-bar', '#stacked-tooltip-versions');
  } else if (cluster === 'testnet') {
    grid.innerHTML = renderTestnetDevnetStories(records, d, 'testnet', /* sfdpPlaceholder */ true);
    setupStackedBarTooltip('.stacked-bar', '#stacked-tooltip-versions');
    renderTestnetSfdpLinkedCard(records).catch(e => console.warn('[SONDA] SFDP cross-cluster:', e));
  } else {
    grid.innerHTML = renderTestnetDevnetStories(records, d, 'devnet', false);
    setupStackedBarTooltip('.stacked-bar', '#stacked-tooltip-versions');
  }
}

function renderMainnetStories(records: any[], d: any): string {
  const m = d?.metrics || {};
  const dz = m.doublezero;
  const dzInfo = dz?.multicast_publishers || {};
  const mcCount = dzInfo.total ?? 0;
  const mcStake = dzInfo.stake_percent ?? 0;

  const dzConnected = records.filter(r => r?.dz_connected);
  const ibrlMc = dzConnected.filter(r => r?.dz_connection_type === 'ibrl+multicast').length;
  const mcOnly = dzConnected.filter(r => r?.dz_connection_type === 'multicast').length;
  const ibrlOnly = dzConnected.filter(r => r?.dz_connection_type === 'ibrl').length;
  const dzTotal = Math.max(1, dzConnected.length);

  // Matrix — active only
  const active = records.filter(r => !r.delinquent);
  let both = 0, bam = 0, dz_only = 0, neither = 0;
  for (const r of active) {
    const hb = !!r.bam_node, hd = !!r.dz_connected;
    if (hb && hd) both++;
    else if (hb) bam++;
    else if (hd) dz_only++;
    else neither++;
  }

  // Jito BAM card data (mainnet-only — bam metrics live in network_summary).
  // Bar-rows aggregate BAM-connected validators by global region (continent),
  // not by individual country — gives a 3-row picture that fits the bar layout
  // and reads more meaningfully (e.g. Europe vs Americas vs APAC) than top-3 nations.
  const bamMetrics = m.bam || {};
  const bamConnectedTotal = bamMetrics.total_connected_validators ?? 0;
  const bamStakePct = bamMetrics.stake_percentage ?? 0;
  const bamNodes = bamMetrics.node_count ?? 0;
  const bamCountryDist: Record<string, number> = bamMetrics.validator_geo?.country_distribution || {};
  // Aggregate by region
  const regionCounts: Record<string, number> = {};
  for (const [cc, count] of Object.entries(bamCountryDist)) {
    if (cc === '??' || cc === 'OFFLINE') continue;
    const region = getRegion(cc);
    regionCounts[region] = (regionCounts[region] || 0) + (count as number);
  }
  const bamRegionEntries = Object.entries(regionCounts)
    .sort((a, b) => (b[1] as number) - (a[1] as number))
    .slice(0, 3);
  const bamConnectedSafe = Math.max(1, bamConnectedTotal);
  // BAM adoption color: ≥30% good (green) — strong adoption; 15–30% caution (amber);
  // <15% crit (red) — low adoption signal. Higher BAM adoption is good for the network.
  const bamStakeCls = bamStakePct >= 30 ? 'good' : (bamStakePct >= 15 ? 'warn' : 'crit');

  // SFDP
  const sfdp = records.filter(r => r?.sfdp_state === 'Approved');
  const approved = sfdp.length;
  const dzCount = sfdp.filter(r => r.dz_connected).length;
  const bamCount = sfdp.filter(r => r.bam_node).length;
  const sfdpMc = sfdp.filter(r => r.dz_multicast_publisher).length;
  const sfdpCountries = new Set<string>();
  const sfdpAsns = new Set<string>();
  for (const r of sfdp) {
    const geo = r.geolocation || {};
    if (geo.country_code && geo.country_code !== '??') sfdpCountries.add(geo.country_code);
    if (geo.asn_name && geo.asn_name !== 'Unknown') sfdpAsns.add(geo.asn_name);
  }
  const retired = records.filter(r => r?.sfdp_state === 'Retired').length;
  const onboarded = records.filter(r => r?.sfdp_state === 'TestnetOnboarded').length;
  const rejected = records.filter(r => r?.sfdp_state === 'Rejected').length;

  // Client distribution (stacked bar)
  const clientCounts: Record<string, number> = {};
  let totalClient = 0;
  for (const r of records) {
    if (!r?.client_type) continue;
    const name = cleanClientName(r.client_type);
    clientCounts[name] = (clientCounts[name] || 0) + 1;
    totalClient++;
  }
  const sortedClients = Object.entries(clientCounts).sort((a, b) => b[1] - a[1]);
  const clientSegments = sortedClients.map(([name, count]) => {
    const w = (count / totalClient) * 100;
    const color = getClientColor(name);
    const showLabel = w >= 8;
    return `<div class="stacked-segment" data-seg-name="${escapeHtml(name)}" data-seg-count="${count}" data-seg-pct="${w.toFixed(1)}" style="width:${w}%; background:${color};">${showLabel ? `${w.toFixed(0)}%` : ''}</div>`;
  }).join('');
  const clientLegend = sortedClients.map(([name, count]) => {
    const w = (count / totalClient) * 100;
    const color = getClientColor(name);
    return `<span class="stacked-legend-item">
      <span class="stacked-legend-dot" style="background:${color};"></span>
      <span class="stacked-legend-name">${escapeHtml(name)}</span>
      <span class="stacked-legend-stat">${count} · ${w.toFixed(1)}%</span>
    </span>`;
  }).join('');

  return `
    <!-- DZ multicast (span-1, 25%) -->
    <div class="story span-1 story-dz tint-dz">
      <div class="story-header">
        <span class="story-tag dz-tag">DoubleZero</span>
        <span class="tooltip-wrap">
          <span class="tooltip-icon" aria-label="info">${infoIcon()}</span>
          <span class="tooltip-box">Multicast lets a validator broadcast new block fragments (shreds) to many peers at once over DoubleZero's private fiber. Faster propagation, less wasted bandwidth.</span>
        </span>
      </div>
      <div class="story-title">Validators broadcasting shreds via multicast</div>
      <div class="story-big mono violet">${fmt(mcCount)}</div>
      <div class="story-sub">${pct(mcStake, 1)} of network stake</div>
      <div class="bar-rows-wrap with-divider">
        <div class="bar-row">
          <span class="bar-row-label" title="ibrl + multicast">ibrl + multicast</span>
          <div class="bar-row-track"><div class="bar-row-fill violet" style="width:${(ibrlMc/dzTotal*100)}%"></div></div>
          <span class="bar-row-num">${fmt(ibrlMc)}</span>
        </div>
        <div class="bar-row">
          <span class="bar-row-label" title="multicast only">multicast only</span>
          <div class="bar-row-track"><div class="bar-row-fill violet" style="width:${(mcOnly/dzTotal*100)}%"></div></div>
          <span class="bar-row-num">${fmt(mcOnly)}</span>
        </div>
        <div class="bar-row">
          <span class="bar-row-label" title="ibrl only (not publishing)">ibrl only (not publishing)</span>
          <div class="bar-row-track"><div class="bar-row-fill violet-dim" style="width:${(ibrlOnly/dzTotal*100)}%"></div></div>
          <span class="bar-row-num">${fmt(ibrlOnly)}</span>
        </div>
      </div>
      <a href="/endpoints" data-stub class="story-link">DoubleZero infrastructure →</a>
    </div>

    <!-- Jito BAM connectivity (span-1, 25%) -->
    <div class="story span-1 story-bam tint-bam">
      <div class="story-header">
        <span class="story-tag bam-tag">Jito BAM</span>
        <span class="tooltip-wrap">
          <span class="tooltip-icon" aria-label="info">${infoIcon()}</span>
          <span class="tooltip-box">Jito BAM (Block Assembly Marketplace) is Jito's auction-based block-building system. Connected validators delegate block construction to BAM nodes for higher MEV capture and reduced inclusion latency.</span>
        </span>
      </div>
      <div class="story-title">Validators connected to Jito BAM block-builder</div>
      <div class="story-big mono cyan">${fmt(bamConnectedTotal)}</div>
      <div class="story-sub"><span class="bam-stake ${bamStakeCls}">${pct(bamStakePct, 2)}</span> of network stake · ${fmt(bamNodes)} BAM nodes</div>
      <div class="bar-rows-wrap with-divider">
        ${bamRegionEntries.length > 0 ? bamRegionEntries.map(([region, count], i) => {
          const c = count as number;
          const widthPct = (c / bamConnectedSafe) * 100;
          const fillCls = i === 0 ? 'cyan' : (i === 1 ? 'cyan' : 'cyan-dim');
          return `
        <div class="bar-row">
          <span class="bar-row-label" title="BAM-validator region">${escapeHtml(region)}</span>
          <div class="bar-row-track"><div class="bar-row-fill ${fillCls}" style="width:${widthPct}%"></div></div>
          <span class="bar-row-num">${fmt(c)}</span>
        </div>`;
        }).join('') : '<div style="font-size:0.78rem; color:var(--text-muted);">No BAM data</div>'}
      </div>
      <a href="/endpoints" data-stub class="story-link">Jito BAM endpoints →</a>
    </div>

    <!-- Coverage matrix (span-2, 50%) -->
    <div class="story span-2 tint-both">
      <div class="story-header">
        <span class="story-tag both-tag">Coverage Matrix</span>
        <span class="tooltip-wrap">
          <span class="tooltip-icon" aria-label="info">${infoIcon()}</span>
          <span class="tooltip-box">Active validators grouped by Jito BAM and DoubleZero adoption. Both together is the cutting-edge configuration. Counts active validators only.</span>
        </span>
      </div>
      <div class="story-title">BAM × DoubleZero adoption</div>
      <div class="matrix-grid">
        <div class="matrix-cell" data-cell="both"><div class="matrix-num mono">${fmt(both)}</div><div class="matrix-cell-label">Both</div></div>
        <div class="matrix-cell" data-cell="bam"><div class="matrix-num mono">${fmt(bam)}</div><div class="matrix-cell-label">BAM only</div></div>
        <div class="matrix-cell" data-cell="dz"><div class="matrix-num mono">${fmt(dz_only)}</div><div class="matrix-cell-label">DZ only</div></div>
        <div class="matrix-cell" data-cell="neither"><div class="matrix-num mono">${fmt(neither)}</div><div class="matrix-cell-label">Neither</div></div>
      </div>
      <a href="/validators" data-stub class="story-link">View all validators →</a>
    </div>

    <!-- Software (clients) (span-2, 50%) -->
    <div class="story span-2">
      <div class="story-header">
        <span class="story-tag neutral-tag">Software</span>
        <span class="tooltip-wrap">
          <span class="tooltip-icon" aria-label="info">${infoIcon()}</span>
          <span class="tooltip-box">Most validator clients are based on Agave (originally Solana Labs, now maintained by Anza). Jito, BAM, Frankendancer, Rakurai, and Harmonic are forks adding specific features. Firedancer is the only fully independent implementation, by Jump Crypto.</span>
        </span>
      </div>
      <div class="story-title">Validator client distribution</div>
      <div class="stacked-bar"><div class="stacked-bar-inner">${clientSegments}</div><div class="stacked-tooltip" id="stacked-tooltip-clients"></div></div>
      <div class="stacked-legend">${clientLegend}</div>
    </div>

    <!-- SFDP (span-2, 50%) -->
    <div class="story span-2 tint-sfdp">
      <div class="story-header">
        <span class="story-tag sfdp-tag">SFDP</span>
        <span class="tooltip-wrap">
          <span class="tooltip-icon" aria-label="info">${infoIcon()}</span>
          <span class="tooltip-box">Solana Foundation Delegation Program. Validators in Approved status receive delegation from the Foundation. The TestnetOnboarded queue is now closed but some who completed it are still active on mainnet.</span>
        </span>
      </div>
      <div class="story-title">Foundation delegation state</div>
      <div class="sfdp-grid">
        <div class="sfdp-item">
          <div class="sfdp-num mono">${fmt(approved)}</div>
          <div class="sfdp-sub">approved validators</div>
        </div>
        <div class="sfdp-geo">across <span class="sfdp-geo-num">${fmt(sfdpCountries.size)}</span> countries and <span class="sfdp-geo-num">${fmt(sfdpAsns.size)}</span> network providers</div>
        <div class="sfdp-overlap">
          <div class="sfdp-overlap-row"><span class="sfdp-overlap-label">DoubleZero connected</span><span class="sfdp-overlap-val violet">${fmt(dzCount)} / ${fmt(approved)}</span></div>
          <div class="sfdp-overlap-row"><span class="sfdp-overlap-label">Multicast publishers</span><span class="sfdp-overlap-val violet">${fmt(sfdpMc)} / ${fmt(approved)}</span></div>
          <div class="sfdp-overlap-row"><span class="sfdp-overlap-label">Jito BAM</span><span class="sfdp-overlap-val cyan">${fmt(bamCount)} / ${fmt(approved)}</span></div>
        </div>
        <div class="sfdp-other">Other: ${retired} retired · ${onboarded} from former testnet queue · ${rejected} rejected</div>
      </div>
    </div>
  `;
}

// ───────── Performance brackets (Variant D) ─────────
// Top: ≥97% of max credits | Mid: 65–97% | Lagging: <65%
function computePerformanceBrackets(records: any[]) {
  const active = records.filter(r => !r.delinquent);
  const credits = active.map(r => r.epoch_credits || 0).filter(c => c > 0);
  if (credits.length === 0) return { top: 0, mid: 0, lagging: 0, max: 0, total: active.length, delinq: records.length - active.length };
  const max = Math.max(...credits);
  let top = 0, mid = 0, lagging = 0;
  for (const c of credits) {
    const ratio = c / max;
    if (ratio >= 0.97) top++;
    else if (ratio >= 0.65) mid++;
    else lagging++;
  }
  return { top, mid, lagging, max, total: active.length, delinq: records.length - active.length };
}

function renderTestnetDevnetStories(records: any[], d: any, cluster: 'testnet' | 'devnet', sfdpPlaceholder: boolean): string {
  const overall = d?.metrics?.overall || {};
  const totalNodes = (overall.total ?? 0) - (d?.record_counts?.['unknown-node'] ?? 0);
  const activeValidators = d?.metrics?.validators?.total ?? records.filter(r => !r.delinquent).length;
  const activeRpcs = d?.metrics?.rpc?.total ?? 0;

  const perf = computePerformanceBrackets(records);
  const perfTotal = perf.top + perf.mid + perf.lagging;
  const perfTopW = perfTotal ? (perf.top / perfTotal) * 100 : 0;
  const perfMidW = perfTotal ? (perf.mid / perfTotal) * 100 : 0;
  const perfLagW = perfTotal ? (perf.lagging / perfTotal) * 100 : 0;

  // Software versions — use cluster_health.stake_by_version for full picture (count + stake share).
  // Bar segments are sized by validator count (more informative on testnet/devnet where stake is artificial),
  // but legend shows stake share too — important context (one version may dominate stake while others test fixes).
  const sbv = d?.metrics?.cluster_health?.stake_by_version || {};
  const totalActiveStake = d?.metrics?.cluster_health?.total_active_stake || 0;
  const versionRows = Object.entries(sbv).map(([v, info]: [string, any]) => ({
    version: v,
    current: info.currentValidators || 0,
    stake: info.currentActiveStake || 0,
  })).filter(r => r.current > 0).sort((a, b) => b.current - a.current);

  // Fallback to record-based counting if cluster_health not available
  const versionsForRender = versionRows.length > 0 ? versionRows : (() => {
    const counts: Record<string, number> = {};
    records.forEach(r => { const v = r.version || 'unknown'; counts[v] = (counts[v] || 0) + 1; });
    return Object.entries(counts).sort((a, b) => b[1] - a[1])
      .map(([version, current]) => ({ version, current, stake: 0 }));
  })();

  const totalVer = versionsForRender.reduce((s, r) => s + r.current, 0) || 1;
  const versionSegments = versionsForRender.map(r => {
    const w = (r.current / totalVer) * 100;
    const color = versionColor(r.version);
    const showLabel = w >= 10;
    const stakePct = totalActiveStake ? (r.stake / totalActiveStake) * 100 : 0;
    return `<div class="stacked-segment" data-seg-name="${escapeHtml(r.version)}" data-seg-count="${r.current}" data-seg-pct="${w.toFixed(1)}" data-seg-stake="${stakePct.toFixed(2)}" style="width:${w}%; background:${color};">${showLabel ? `${w.toFixed(0)}%` : ''}</div>`;
  }).join('');
  const versionLegend = versionsForRender.slice(0, 8).map(r => {
    const w = (r.current / totalVer) * 100;
    const color = versionColor(r.version);
    const stakePct = totalActiveStake ? (r.stake / totalActiveStake) * 100 : 0;
    // Legend: 2 numbers (count + stake%). The bar already shows count-share visually,
    // and stake% reveals dominance — e.g. one version may run on a few validators
    // but hold most of the stake. Tooltip on hover keeps all three.
    const secondary = totalActiveStake ? `${stakePct.toFixed(1)}% stake` : `${w.toFixed(1)}%`;
    return `<span class="stacked-legend-item">
      <span class="stacked-legend-dot" style="background:${color};"></span>
      <span class="stacked-legend-name">${escapeHtml(r.version)}</span>
      <span class="stacked-legend-stat">${r.current} · ${secondary}</span>
    </span>`;
  }).join('');

  const whatIsTitle = cluster === 'testnet' ? 'What is testnet?' : 'What is devnet?';
  const whatIsText = cluster === 'testnet'
    ? 'Solana testnet is where new client releases get stress-tested before reaching mainnet. SFDP-approved validators are required to run a testnet node alongside their mainnet one. Stake here has no real economic value.'
    : 'Solana devnet is a sandbox for application developers. It runs the same protocol as mainnet but with simulated activity and no real value. Network resets and chain forks are possible. Validators here support the developer ecosystem.';

  // 4th card content depends on cluster
  let fourthCard: string;
  if (cluster === 'testnet') {
    fourthCard = sfdpPlaceholder
      ? `<div class="story tint-sfdp" id="testnet-sfdp-card">
           <div class="story-header">
             <span class="story-tag sfdp-tag">SFDP linked</span>
             <span class="tooltip-wrap">
               <span class="tooltip-icon" aria-label="info">${infoIcon()}</span>
               <span class="tooltip-box">Cross-cluster lookup. Maps testnet validators to mainnet SFDP identities through the testnet_pubkey field.</span>
             </span>
           </div>
           <div class="story-title">Testnet validators linked to SFDP mainnet identities</div>
           <div class="sfdp-linked-content">
             <div class="sk-line" style="width:60%; height:32px"></div>
             <div class="sk-line" style="width:80%"></div>
             <div class="sk-line" style="width:70%"></div>
           </div>
         </div>`
      : '';
  } else {
    // Devnet — Validators by stake donut (top 7 + Other)
    const valsSorted = [...records].sort((a, b) => (b.activated_stake_lamports || 0) - (a.activated_stake_lamports || 0));
    const TOP_N = 7;
    const top = valsSorted.slice(0, TOP_N);
    const rest = valsSorted.slice(TOP_N);
    const totalLamports = valsSorted.reduce((s, v) => s + (v.activated_stake_lamports || 0), 0) || 1;
    const items: { label: string; value: number; color?: string }[] = top.map((v, i) => ({
      // Names if present, otherwise 10-char pubkey prefix (was 6, too aggressive)
      label: v.name || (v.identity_pubkey ? v.identity_pubkey.slice(0, 10) + '…' : 'Unknown'),
      value: v.activated_stake_lamports || 0,
      color: pickPalette('stake')[i % pickPalette('stake').length],
    }));
    if (rest.length > 0) {
      const otherStake = rest.reduce((s, v) => s + (v.activated_stake_lamports || 0), 0);
      items.push({ label: `Other (${rest.length})`, value: otherStake, color: 'var(--text-muted)' });
    }
    const donut = renderDonut(items);
    fourthCard = `<div class="story tint-cluster">
      <div class="story-header">
        <span class="story-tag cluster-tag">Stake distribution</span>
        <span class="tooltip-wrap">
          <span class="tooltip-icon" aria-label="info">${infoIcon()}</span>
          <span class="tooltip-box">Stake share by validator. Top ${TOP_N} are shown individually, the rest aggregated as Other.</span>
        </span>
      </div>
      <div class="story-title">Validators by stake</div>
      <div class="donut-wrap">
        <div class="donut-svg">${donut.svg}</div>
        <div class="donut-legend-2col">${donut.legend}</div>
      </div>
    </div>`;
  }

  return `
    <!-- What is -->
    <div class="story tint-cluster">
      <div class="story-header">
        <span class="story-tag cluster-tag">About</span>
      </div>
      <div class="story-title">${whatIsTitle}</div>
      <p class="whatis-text">${whatIsText}</p>
      <div class="whatis-stat-row">
        <div class="whatis-stat"><div class="whatis-stat-num mono">${fmt(totalNodes)}</div><div class="whatis-stat-label">total nodes</div></div>
        <div class="whatis-stat"><div class="whatis-stat-num mono">${fmt(activeValidators)}</div><div class="whatis-stat-label">active validators</div></div>
        <div class="whatis-stat"><div class="whatis-stat-num mono">${fmt(activeRpcs)}</div><div class="whatis-stat-label">public RPCs</div></div>
      </div>
    </div>

    <!-- Performance (Variant D — brackets) -->
    <div class="story">
      <div class="story-header">
        <span class="story-tag cluster-tag">Performance</span>
        <span class="tooltip-wrap">
          <span class="tooltip-icon" aria-label="info">${infoIcon()}</span>
          <span class="tooltip-box">Validators bracketed by epoch credits earned, relative to the cluster maximum. Top: at least 97% of the leader. Mid: 65–97%. Lagging: under 65%. Delinquent: not voting.</span>
        </span>
      </div>
      <div class="story-title">Network performance</div>
      <div class="perf-grid">
        <div class="perf-tile"><div class="perf-tile-num good">${fmt(perf.top)}</div><div class="perf-tile-label">top performers</div></div>
        <div class="perf-tile"><div class="perf-tile-num neutral">${fmt(perf.mid)}</div><div class="perf-tile-label">mid</div></div>
        <div class="perf-tile"><div class="perf-tile-num crit">${fmt(perf.lagging)}</div><div class="perf-tile-label">lagging</div></div>
        <div class="perf-tile"><div class="perf-tile-num muted">${fmt(perf.delinq)}</div><div class="perf-tile-label">delinquent</div></div>
      </div>
      <div class="perf-bar">
        <div class="perf-bar-seg good" style="width:${perfTopW}%"></div>
        <div class="perf-bar-seg neutral" style="width:${perfMidW}%"></div>
        <div class="perf-bar-seg crit" style="width:${perfLagW}%"></div>
      </div>
      <div class="perf-bar-legend">
        <span><span class="perf-bar-legend-dot" style="background:var(--status-good)"></span>≥97% of max</span>
        <span><span class="perf-bar-legend-dot" style="background:var(--text-muted); opacity:0.6"></span>65–97%</span>
        <span><span class="perf-bar-legend-dot" style="background:var(--status-critical)"></span>&lt;65%</span>
      </div>
    </div>

    <!-- Software (versions stacked bar) -->
    <div class="story">
      <div class="story-header">
        <span class="story-tag neutral-tag">Software</span>
        <span class="tooltip-wrap">
          <span class="tooltip-icon" aria-label="info">${infoIcon()}</span>
          <span class="tooltip-box">${cluster === 'testnet' ? 'Validator versions on testnet. Variety here is expected — testnet is where new releases get tested.' : 'Validator versions on devnet. Often runs the most recent betas, release candidates, or experimental builds.'}</span>
        </span>
      </div>
      <div class="story-title">Validator versions</div>
      <div class="stacked-bar"><div class="stacked-bar-inner">${versionSegments}</div><div class="stacked-tooltip" id="stacked-tooltip-versions"></div></div>
      <div class="stacked-legend">${versionLegend}</div>
    </div>

    ${fourthCard}
  `;
}

// ───────── Alpenglow stories (5 cards: 2+1+1 / 2+2) ─────────

function renderAlpenglowStories(records: any[], d: any): string {
  const m = d?.metrics || {};
  const v = m.validators || {};
  const activeValidators = v.total ?? records.filter(r => !r.delinquent).length;
  const activeRpcs = m.rpc?.total ?? 0;
  const epochPct = d?.epoch_completed_percent ?? 0;
  const consensus = detectConsensus(d);

  // ── Card: What is Alpenglow (span-2) ──
  // Plain-language description plus the three live stat tiles at the bottom.

  // ── Card: Feature readiness (span-1) ──
  // Total / active / pending counts from features block.
  // Note: features.inactive_count is an alias for features.pending_count (kept for
  // backward compat). Treating them as one — `pending` is the canonical name.
  const features = d?.features || {};
  const featTotal   = features.total_count   ?? 0;
  const featActive  = features.active_count  ?? 0;
  const featPending = features.pending_count ?? features.inactive_count ?? 0;
  const featDenom = Math.max(1, featTotal);
  const featActiveW  = (featActive  / featDenom) * 100;
  const featPendingW = (featPending / featDenom) * 100;
  const featPctText = featTotal > 0 ? `${(featActive / featTotal * 100).toFixed(1)}% activated` : 'no data';
  // Top-3 pending feature descriptions (fall back to inactive list for backward compat).
  const pendingList = Array.isArray(features.pending) && features.pending.length > 0
    ? features.pending.slice(0, 3)
    : (Array.isArray(features.inactive) ? features.inactive.slice(0, 3) : []);

  // ── Card: BLS pubkey adoption (span-1) ──
  // Calculated from validators.json records — count those with non-null bls_pubkey.
  const blsTotal = records.length;
  const blsAdopted = records.filter(r => r?.bls_pubkey != null && r.bls_pubkey !== '').length;
  const blsPending = blsTotal - blsAdopted;
  const blsDenom = Math.max(1, blsTotal);
  const blsAdoptedW = (blsAdopted / blsDenom) * 100;
  const blsPendingW = (blsPending / blsDenom) * 100;
  const blsPctText = blsTotal > 0 ? `${(blsAdopted / blsTotal * 100).toFixed(1)}% adopted` : 'no data';

  // ── Card: Software versions (span-2) ── (same pattern as testnet/devnet)
  const sbv = m.cluster_health?.stake_by_version || {};
  const totalActiveStake = m.cluster_health?.total_active_stake || 0;
  const versionRows = Object.entries(sbv).map(([ver, info]: [string, any]) => ({
    version: ver,
    current: info.currentValidators || 0,
    stake: info.currentActiveStake || 0,
  })).filter(r => r.current > 0).sort((a, b) => b.current - a.current);
  const versionsForRender = versionRows.length > 0 ? versionRows : (() => {
    const counts: Record<string, number> = {};
    records.forEach(r => { const vr = r.version || 'unknown'; counts[vr] = (counts[vr] || 0) + 1; });
    return Object.entries(counts).sort((a, b) => b[1] - a[1])
      .map(([version, current]) => ({ version, current, stake: 0 }));
  })();
  const totalVer = versionsForRender.reduce((s, r) => s + r.current, 0) || 1;
  const versionSegments = versionsForRender.map(r => {
    const w = (r.current / totalVer) * 100;
    const color = versionColor(r.version);
    const showLabel = w >= 10;
    const stakePct = totalActiveStake ? (r.stake / totalActiveStake) * 100 : 0;
    return `<div class="stacked-segment" data-seg-name="${escapeHtml(r.version)}" data-seg-count="${r.current}" data-seg-pct="${w.toFixed(1)}" data-seg-stake="${stakePct.toFixed(2)}" style="width:${w}%; background:${color};">${showLabel ? `${w.toFixed(0)}%` : ''}</div>`;
  }).join('');
  const versionLegend = versionsForRender.slice(0, 8).map(r => {
    const w = (r.current / totalVer) * 100;
    const color = versionColor(r.version);
    const stakePct = totalActiveStake ? (r.stake / totalActiveStake) * 100 : 0;
    const secondary = totalActiveStake ? `${stakePct.toFixed(1)}% stake` : `${w.toFixed(1)}%`;
    return `<span class="stacked-legend-item">
      <span class="stacked-legend-dot" style="background:${color};"></span>
      <span class="stacked-legend-name">${escapeHtml(r.version)}</span>
      <span class="stacked-legend-stat">${r.current} · ${secondary}</span>
    </span>`;
  }).join('');

  // ── Card: Validators by stake (span-2) ── donut top-7 + Other (same as devnet)
  const TOP_N = 7;
  const stakeSorted = records
    .filter(r => !r.delinquent && (r.activated_stake_lamports ?? 0) > 0)
    .sort((a, b) => (b.activated_stake_lamports ?? 0) - (a.activated_stake_lamports ?? 0));
  const topStake = stakeSorted.slice(0, TOP_N);
  const restStake = stakeSorted.slice(TOP_N);
  const stakeItems = topStake.map((r, i) => ({
    label: r.name || (r.identity_pubkey ? r.identity_pubkey.slice(0, 4) + '…' + r.identity_pubkey.slice(-4) : 'unknown'),
    value: r.activated_stake_lamports ?? 0,
    color: pickPalette('stake')[i % pickPalette('stake').length],
  }));
  if (restStake.length > 0) {
    const otherSum = restStake.reduce((s, r) => s + (r.activated_stake_lamports ?? 0), 0);
    stakeItems.push({ label: `Other (${restStake.length})`, value: otherSum, color: 'var(--text-muted)' });
  }
  const stakeDonut = renderDonut(stakeItems, { size: 130, ringR: 56, innerR: 36 });

  // Consensus badge shown on Software card across all clusters (mainnet/testnet/devnet/alpenglow)
  // is appended here for alpenglow consistency.
  const consensusBadge = consensus
    ? `<span class="consensus-badge ${consensus === 'Alpenglow' ? 'is-alpenglow' : ''}">${consensus === 'Alpenglow' ? '🏔 ' : ''}Consensus: ${escapeHtml(consensus)}</span>`
    : '';

  return `
    <!-- What is Alpenglow (span-2) -->
    <div class="story span-2 tint-cluster">
      <div class="story-header">
        <span class="story-tag cluster-tag">Alpenglow</span>
      </div>
      <div class="story-title">Experimental community cluster</div>
      <p class="whatis-text">
        Public testbed for Anza's new consensus algorithm (SIMD-0326), designed to replace Tower BFT on Solana. The new design targets sub-150ms block finalization through a two-stage voting model (Votor + Rotor) and BLS aggregate signatures. Validators here help stress-test the implementation before rollout to devnet, testnet, and eventually mainnet.
      </p>
      <div class="whatis-stat-row">
        <div class="whatis-stat"><div class="whatis-stat-num mono">${fmt(activeValidators)}</div><div class="whatis-stat-label">active validators</div></div>
        <div class="whatis-stat"><div class="whatis-stat-num mono">${fmt(activeRpcs)}</div><div class="whatis-stat-label">public RPCs</div></div>
        <div class="whatis-stat"><div class="whatis-stat-num mono">${consensus || '—'}</div><div class="whatis-stat-label">current consensus</div></div>
      </div>
    </div>

    <!-- Feature readiness (span-1) -->
    <div class="story span-1">
      <div class="story-header">
        <span class="story-tag neutral-tag">Features</span>
        <span class="tooltip-wrap">
          <span class="tooltip-icon" aria-label="info">${infoIcon()}</span>
          <span class="tooltip-box">Activated features control protocol behavior. Pending features have an on-chain account but are not yet activated. SIMD-0326 in this list means Alpenglow consensus is not yet live.</span>
        </span>
      </div>
      <div class="story-title">Protocol features</div>
      <div class="story-big mono">${fmt(featActive)} <span class="story-big-denom">/ ${fmt(featTotal)}</span></div>
      <div class="story-sub">${escapeHtml(featPctText)}</div>
      <div class="bar-rows-wrap with-divider">
        <div class="bar-row">
          <span class="bar-row-label">active</span>
          <div class="bar-row-track"><div class="bar-row-fill good" style="width:${featActiveW}%"></div></div>
          <span class="bar-row-num">${fmt(featActive)}</span>
        </div>
        <div class="bar-row">
          <span class="bar-row-label">pending</span>
          <div class="bar-row-track"><div class="bar-row-fill warn" style="width:${featPendingW}%"></div></div>
          <span class="bar-row-num">${fmt(featPending)}</span>
        </div>
      </div>
      ${pendingList.length > 0 ? `<div class="feat-inactive-hint">Next: ${pendingList.map((f: any) => {
        const desc = (f?.description || '').toString();
        const simd = desc.match(/SIMD-\d+/);
        return simd ? simd[0] : (desc ? (desc.slice(0, 18) + (desc.length > 18 ? '…' : '')) : 'feature ' + (f?.id || '').slice(0, 6));
      }).join(', ')}</div>` : ''}
    </div>

    <!-- BLS pubkey adoption (span-1) -->
    <div class="story span-1 tint-bam">
      <div class="story-header">
        <span class="story-tag bam-tag">Cryptography</span>
        <span class="tooltip-wrap">
          <span class="tooltip-icon" aria-label="info">${infoIcon()}</span>
          <span class="tooltip-box">BLS aggregate signatures are required for Alpenglow consensus. Validators must register a BLS pubkey in their vote account (SIMD-0387). 100% adoption signals the network is upgrade-ready.</span>
        </span>
      </div>
      <div class="story-title">BLS pubkey adoption</div>
      <div class="story-big mono cyan">${fmt(blsAdopted)} <span class="story-big-denom">/ ${fmt(blsTotal)}</span></div>
      <div class="story-sub">${escapeHtml(blsPctText)}</div>
      <div class="bar-rows-wrap with-divider">
        <div class="bar-row">
          <span class="bar-row-label">registered</span>
          <div class="bar-row-track"><div class="bar-row-fill cyan" style="width:${blsAdoptedW}%"></div></div>
          <span class="bar-row-num">${fmt(blsAdopted)}</span>
        </div>
        <div class="bar-row">
          <span class="bar-row-label">missing</span>
          <div class="bar-row-track"><div class="bar-row-fill cyan-dim" style="width:${blsPendingW}%"></div></div>
          <span class="bar-row-num">${fmt(blsPending)}</span>
        </div>
      </div>
    </div>

    <!-- Software (span-2) -->
    <div class="story span-2">
      <div class="story-header">
        <span class="story-tag neutral-tag">Software</span>
        <span class="tooltip-wrap">
          <span class="tooltip-icon" aria-label="info">${infoIcon()}</span>
          <span class="tooltip-box">Validator clients on Alpenglow run a custom 0.3.x build line that implements the Alpenglow consensus algorithm. Versions diverge as new releases land.</span>
        </span>
        ${consensusBadge}
      </div>
      <div class="story-title">Validator versions</div>
      <div class="stacked-bar"><div class="stacked-bar-inner">${versionSegments}</div><div class="stacked-tooltip" id="stacked-tooltip-versions"></div></div>
      <div class="stacked-legend">${versionLegend}</div>
    </div>

    <!-- Validators by stake (span-2) -->
    <div class="story span-2 tint-cluster">
      <div class="story-header">
        <span class="story-tag cluster-tag">Stake distribution</span>
        <span class="tooltip-wrap">
          <span class="tooltip-icon" aria-label="info">${infoIcon()}</span>
          <span class="tooltip-box">Stake share by validator. Top ${TOP_N} are shown individually, the rest aggregated as Other.</span>
        </span>
      </div>
      <div class="story-title">Validators by stake</div>
      <div class="donut-wrap">
        <div class="donut-svg">${stakeDonut.svg}</div>
        <div class="donut-legend-2col">${stakeDonut.legend}</div>
      </div>
    </div>
  `;
}

// ───────── SFDP linked card (testnet, async cross-cluster) ─────────

async function renderTestnetSfdpLinkedCard(testnetRecords: any[]) {
  const card = document.getElementById('testnet-sfdp-card');
  if (!card) return;

  let mainnetData: any;
  try {
    mainnetData = await fetchValidatorsCached('mainnet-beta');
  } catch (e) {
    card.innerHTML = `<div class="story-header"><span class="story-tag sfdp-tag">SFDP linked</span></div>
      <div class="story-title">Testnet validators linked to SFDP mainnet identities</div>
      <div class="whatis-text" style="color:var(--text-muted);">Could not load mainnet data for cross-cluster lookup.</div>`;
    return;
  }

  const mainnetRecords = (mainnetData?.records || []).filter((r: any) => r != null);
  const testnetPubkeyToMain = new Map<string, any>();
  for (const m of mainnetRecords) {
    if (m.testnet_pubkey && m.sfdp_state) {
      testnetPubkeyToMain.set(m.testnet_pubkey, m);
    }
  }

  const linkedPairs: { testnet: any; mainnet: any }[] = [];
  for (const t of testnetRecords) {
    const main = testnetPubkeyToMain.get(t.identity_pubkey);
    if (main) linkedPairs.push({ testnet: t, mainnet: main });
  }

  if (linkedPairs.length === 0) {
    card.innerHTML = `<div class="story-header"><span class="story-tag sfdp-tag">SFDP linked</span></div>
      <div class="story-title">Testnet validators linked to SFDP mainnet identities</div>
      <div class="whatis-text" style="color:var(--text-muted);">No cross-cluster matches found.</div>`;
    return;
  }

  const linkedCount = linkedPairs.length;
  const approvedLinked = linkedPairs.filter(p => p.mainnet.sfdp_state === 'Approved').length;

  const countries = new Set<string>();
  const asns = new Set<string>();
  for (const { testnet } of linkedPairs) {
    const geo = testnet.geolocation || {};
    if (geo.country_code && geo.country_code !== '??') countries.add(geo.country_code);
    if (geo.asn_name && geo.asn_name !== 'Unknown') asns.add(geo.asn_name);
  }

  const stateCounts: Record<string, number> = {};
  for (const { mainnet } of linkedPairs) {
    const s = mainnet.sfdp_state || 'Unknown';
    stateCounts[s] = (stateCounts[s] || 0) + 1;
  }
  const stateOrder = ['Approved', 'TestnetOnboarded', 'Retired', 'Rejected', 'Unknown'];
  const stateLabels: Record<string, string> = {
    'Approved': 'Approved on mainnet',
    'TestnetOnboarded': 'Former testnet queue',
    'Retired': 'Retired on mainnet',
    'Rejected': 'Rejected on mainnet',
    'Unknown': 'Unknown',
  };
  const stateClass: Record<string, string> = {
    'Approved': 'good', 'TestnetOnboarded': 'info', 'Retired': 'muted', 'Rejected': 'crit', 'Unknown': 'muted',
  };

  const statesHtml = stateOrder.filter(s => stateCounts[s]).map(s => {
    const c = stateCounts[s];
    const w = (c / linkedCount) * 100;
    return `<div class="bar-row">
      <span class="bar-row-label" title="${escapeHtml(stateLabels[s])}">${escapeHtml(stateLabels[s])}</span>
      <div class="bar-row-track"><div class="bar-row-fill ${stateClass[s]}" style="width:${w}%"></div></div>
      <span class="bar-row-num">${c}</span>
    </div>`;
  }).join('');

  card.innerHTML = `
    <div class="story-header">
      <span class="story-tag sfdp-tag">SFDP linked</span>
      <span class="tooltip-wrap">
        <span class="tooltip-icon" aria-label="info">${infoIcon()}</span>
        <span class="tooltip-box">Cross-cluster lookup: testnet validators whose identity_pubkey matches the testnet_pubkey field on a mainnet SFDP record. The mainnet sfdp_state shows where each one currently stands.</span>
      </span>
    </div>
    <div class="story-title">Testnet validators linked to mainnet SFDP identities</div>
    <div class="sfdp-linked-content">
      <div style="display:flex; align-items:baseline; gap:0.6rem;">
        <span class="sfdp-linked-num mono">${fmt(approvedLinked)}</span>
        <span class="sfdp-sub">approved on mainnet, also active on testnet</span>
      </div>
      <div class="sfdp-geo">across <span class="sfdp-geo-num">${fmt(countries.size)}</span> countries and <span class="sfdp-geo-num">${fmt(asns.size)}</span> network providers</div>
      <div class="sfdp-linked-states">${statesHtml}</div>
      <div class="sfdp-other">${linkedCount} total linked · ${approvedLinked} currently in good standing</div>
    </div>
  `;
}

// ───────── Stacked bar tooltip setup ─────────

function setupStackedBarTooltip(barSelector: string, tooltipSelector: string) {
  const bar = document.querySelector(barSelector);
  const tooltip = document.querySelector(tooltipSelector) as HTMLElement | null;
  if (!bar || !tooltip) return;

  const segments = bar.querySelectorAll('.stacked-segment');
  segments.forEach(seg => {
    seg.addEventListener('mouseenter', (e) => {
      const el = e.currentTarget as HTMLElement;
      const name = el.dataset.segName || '';
      const count = el.dataset.segCount || '';
      const pctV = el.dataset.segPct || '';
      const stakeV = el.dataset.segStake;
      const stakeStr = (stakeV && parseFloat(stakeV) > 0) ? ` · ${stakeV}% stake` : '';
      tooltip.innerHTML = `<strong>${escapeHtml(name)}</strong> · ${count} (${pctV}%)${stakeStr}`;
      tooltip.classList.add('show');
      const segRect = el.getBoundingClientRect();
      const barRect = (bar as HTMLElement).getBoundingClientRect();
      const left = segRect.left - barRect.left + segRect.width / 2;
      tooltip.style.left = `${left}px`;
    });
    seg.addEventListener('mouseleave', () => {
      tooltip.classList.remove('show');
    });
  });
}

// ───────── INFRA ─────────

function renderInfra(d: any) {
  const ep = d?.metrics?.endpoints || {};
  const dz = d?.metrics?.doublezero;
  const bam = d?.metrics?.bam;
  const cluster = d?.cluster ?? 'mainnet-beta';
  const grid = document.getElementById('infra-grid');
  if (!grid) return;

  const cards: any[] = [];

  if (cluster === 'alpenglow-community') {
    // Alpenglow top-row replaces BAM/Jito/Harmonic (never deployed here) with
    // alpenglow-specific operational + upgrade-pipeline indicators.
    // All values come from network_summary alone — no validators.json dependency,
    // so renderInfra can run before records load without "—" placeholders.

    // Card 1 — Solana RPC (named endpoints, with footnote describing composition)
    if (ep.solana && ep.solana.total != null) {
      const e = ep.solana;
      const entrypoints = d?.record_counts?.['solana-entrypoint'] ?? 0;
      const namedRpcs   = d?.record_counts?.['solana-rpc'] ?? 0;
      // Compact footnote: "2 entrypoints + 2 named RPCs · 1 down" — explains what
      // these 4 endpoints are without overloading "official endpoints" terminology.
      const composition = (entrypoints > 0 || namedRpcs > 0)
        ? `${fmt(entrypoints)} entrypoints + ${fmt(namedRpcs)} named RPCs`
        : '';
      const downPart = e.unreachable > 0 ? `${fmt(e.unreachable)} down` : 'all operational';
      const subParts = [composition, downPart].filter(Boolean);
      cards.push({
        name: 'Solana RPC',
        main: `${fmt(e.reachable)} / ${fmt(e.total)}`,
        sub: subParts.join(' · '),
        status: e.unreachable > 0 ? (e.unreachable >= e.total / 2 ? 'bad' : 'warn') : 'ok',
        cls: e.unreachable > 0 ? 'degraded' : 'healthy',
      });
    } else {
      cards.push({ name: 'Solana RPC', main: '—', sub: 'no data', status: 'neutral', cls: 'absent' });
    }

    // Card 2 — Active validators (voting health)
    const v = d?.metrics?.validators;
    const ch = d?.metrics?.cluster_health;
    if (v && v.total != null) {
      const totalAll = v.total_all ?? v.total;
      const delinqCount = v.offline ?? Math.max(0, totalAll - (v.total ?? 0));
      const delinqStake = ch?.delinquent_stake_percent;
      // Status thresholds tuned for experimental clusters: alpenglow regularly sees
      // higher delinquency than mainnet because of regenesis events and node restarts.
      let st = 'ok' as 'ok' | 'warn' | 'bad';
      if (delinqStake != null) {
        if (delinqStake >= 15) st = 'bad';
        else if (delinqStake >= 5) st = 'warn';
      }
      const cls = st === 'bad' ? 'down' : (st === 'warn' ? 'degraded' : 'healthy');
      cards.push({
        name: 'Active validators',
        main: fmt(v.total),
        sub: `${fmt(delinqCount)} delinquent · ${fmt(totalAll)} total`,
        status: st, cls,
      });
    } else {
      cards.push({ name: 'Active validators', main: '—', sub: 'no data', status: 'neutral', cls: 'absent' });
    }

    // Card 3 — Pending features (protocol upgrade pipeline)
    const features = d?.features;
    if (features && features.total_count != null) {
      const pending = features.pending_count ?? features.inactive_count ?? 0;
      const pendingList: any[] = (features.pending && features.pending.length > 0)
        ? features.pending
        : (Array.isArray(features.inactive) ? features.inactive : []);
      // Extract top SIMD identifier for sub-line context. If the first pending has no
      // description we just say "in queue", letting the headline number do the work.
      let topSimdLabel = '';
      if (pendingList.length > 0) {
        const d0 = (pendingList[0]?.description || '').toString();
        const simd = d0.match(/SIMD-\d+/);
        topSimdLabel = simd ? `${simd[0]} next` : 'in queue';
      }
      const subText = pending === 0 ? 'protocol fully activated' : (topSimdLabel || `${fmt(pending)} in queue`);
      cards.push({
        name: 'Pending features',
        main: fmt(pending),
        sub: subText,
        // 0 pending = good (cluster fully caught up); >0 = informational, not bad
        status: pending === 0 ? 'ok' : 'neutral',
        cls: 'healthy',
      });
    } else {
      cards.push({ name: 'Pending features', main: '—', sub: 'no data', status: 'neutral', cls: 'absent' });
    }

    // Card 4 — Dominant software version + share. "3 versions" was non-obvious;
    // showing the actual leading version with adoption share is immediately readable.
    const sbv = d?.metrics?.cluster_health?.stake_by_version || {};
    const versionRows = Object.entries(sbv).map(([ver, info]: [string, any]) => ({
      version: ver,
      current: info?.currentValidators || 0,
    })).filter(r => r.current > 0 && r.version !== 'unknown').sort((a, b) => b.current - a.current);
    const totalKnownVer = versionRows.reduce((s, r) => s + r.current, 0);
    if (versionRows.length > 0 && totalKnownVer > 0) {
      const dominantRow = versionRows[0];
      const dominantShare = (dominantRow.current / totalKnownVer) * 100;
      // Status: good if dominant version covers ≥90% (fleet aligned),
      // warn 50-90% (rollout in progress), bad <50% (fragmented).
      const st = dominantShare >= 90 ? 'ok' : (dominantShare >= 50 ? 'warn' : 'bad');
      const cls = st === 'ok' ? 'healthy' : (st === 'warn' ? 'degraded' : 'down');
      cards.push({
        name: 'Dominant version',
        main: dominantRow.version,
        sub: `${fmt(dominantRow.current)} / ${fmt(totalKnownVer)} validators`,
        status: st, cls,
      });
    } else {
      cards.push({ name: 'Dominant version', main: '—', sub: 'no data', status: 'neutral', cls: 'absent' });
    }
  } else {
    // Default top-row: BAM / Jito Endpoints / Solana RPC / Harmonic (mainnet/testnet/devnet)
    if (bam && bam.node_count != null) {
      cards.push({ name: 'Jito BAM', main: `${fmt(bam.node_count)} nodes`,
        sub: `${fmt(bam.total_connected_validators ?? 0)} validators · ${pct(bam.stake_percentage, 1)} stake`,
        status: 'ok', cls: 'healthy' });
    } else {
      cards.push({ name: 'Jito BAM', main: '—', sub: 'not deployed on this cluster', status: 'neutral', cls: 'absent' });
    }

    if (ep.jito && ep.jito.total != null) {
      const e = ep.jito;
      const status = e.unreachable > 0 ? (e.unreachable >= 3 ? 'bad' : 'warn') : 'ok';
      const cls = e.unreachable > 0 ? (e.unreachable >= 3 ? 'down' : 'degraded') : 'healthy';
      cards.push({ name: 'Jito Endpoints', main: `${fmt(e.reachable)} / ${fmt(e.total)}`,
        sub: `${fmt(e.unreachable ?? 0)} down · ${fmt(e.unverifiable ?? 0)} unverified`, status, cls });
    } else {
      cards.push({ name: 'Jito Endpoints', main: '—', sub: 'no data', status: 'neutral', cls: 'absent' });
    }

    if (ep.solana && ep.solana.total != null) {
      const e = ep.solana;
      cards.push({ name: 'Solana RPC', main: `${fmt(e.reachable)} / ${fmt(e.total)}`,
        sub: e.unreachable === 0 ? 'all operational' : `${fmt(e.unreachable)} down`,
        status: e.unreachable > 0 ? 'bad' : 'ok', cls: e.unreachable > 0 ? 'down' : 'healthy' });
    } else {
      cards.push({ name: 'Solana RPC', main: '—', sub: 'no data', status: 'neutral', cls: 'absent' });
    }

    if (ep.harmonic && ep.harmonic.total != null) {
      const e = ep.harmonic;
      cards.push({ name: 'Harmonic', main: `${fmt(e.reachable)} / ${fmt(e.total)}`,
        sub: `${fmt(e.unverifiable ?? 0)} unverified`, status: e.unreachable > 0 ? 'warn' : 'ok', cls: 'healthy' });
    } else {
      cards.push({ name: 'Harmonic', main: '—', sub: 'not deployed on this cluster', status: 'neutral', cls: 'absent' });
    }
  }


  grid.innerHTML = cards.map(c => `
    <div class="infra-card ${c.cls}">
      <div class="infra-card-head"><span class="infra-card-name">${escapeHtml(c.name)}</span><span class="infra-card-status-dot ${c.status}"></span></div>
      <div class="infra-card-main">${c.main}</div>
      <div class="infra-card-sub">${escapeHtml(c.sub)}</div>
    </div>`).join('');

  // DZ summary line (mainnet) / Endpoints distribution (testnet/devnet) — both share the same
  // card slot but differ in inner layout. Both get a 2-line header (label+summary, then stats row)
  // matching the RPC card's structure for visual symmetry.
  // (cluster is already declared at the top of renderInfra)
  const dzCard = document.getElementById('dz-summary-card');
  const dzLabel = document.getElementById('dz-summary-label');
  const dzStatsRow = document.getElementById('dz-stats-row');
  const dzInner = document.getElementById('dz-inner');

  // Always reset the right card content before re-rendering. This prevents stale
  // content from a previous cluster bleeding through on cluster switches and is
  // a safety net if a branch later in this function exits early or throws.
  if (dzInner) dzInner.innerHTML = '';
  if (dzStatsRow) dzStatsRow.innerHTML = '';
  setText('dz-summary-stats', '');

  if (cluster === 'mainnet-beta' && dz && dz.network_health) {
    // ── Mainnet: DZ network health ──
    if (dzCard) dzCard.classList.remove('absent');
    if (dzLabel) {
      dzLabel.textContent = 'DoubleZero network';
      dzLabel.style.color = 'var(--accent-violet)';
    }
    const nh = dz.network_health;
    setText('dz-summary-stats', `${fmt(nh.devices_reporting)}/${fmt(nh.devices_total)} devices · ${fmt(nh.links_healthy)}/${fmt(nh.links_total)} links healthy`);
    const stMain = document.getElementById('dz-summary-stats');
    if (stMain) stMain.style.fontStyle = '';

    // 2nd line stats: devices · multicast groups · contributors
    const dzDevices = dz.devices ?? 0;
    const mcGroupsArr = Array.isArray(dz.multicast_groups) ? dz.multicast_groups : [];
    const mcGroupsCount = mcGroupsArr.length;
    const contribsCount = Array.isArray(dz.contributors) ? dz.contributors.length : 0;
    if (dzStatsRow) {
      dzStatsRow.innerHTML = `
        <span class="rpc-stat-item"><span class="rpc-stat-val mono">${fmt(dzDevices)}</span> devices</span>
        <span class="rpc-stat-item"><span class="rpc-stat-val mono">${fmt(mcGroupsCount)}</span> multicast groups</span>
        <span class="rpc-stat-item"><span class="rpc-stat-val mono">${fmt(contribsCount)}</span> contributors</span>
      `;
    }

    const linkIssues = nh.link_issues || [];
    const devIssues = nh.devices_issues || [];

    const unavailable = linkIssues.filter((i: any) => i.quality === 'unavailable');
    const degraded    = linkIssues.filter((i: any) => i.quality !== 'unavailable');
    const noTelemetry = devIssues.filter((i: any) => i.status === 'no_telemetry');
    const otherDev    = devIssues.filter((i: any) => i.status !== 'no_telemetry');

    const summParts: string[] = [];
    if (unavailable.length > 0) summParts.push(`<span class="dz-summ-tag bad">${unavailable.length} unavailable</span>`);
    if (degraded.length > 0)    summParts.push(`<span class="dz-summ-tag warn">${degraded.length} degraded</span>`);
    if (noTelemetry.length > 0) summParts.push(`<span class="dz-summ-tag muted">${noTelemetry.length} no telemetry</span>`);
    if (otherDev.length > 0)    summParts.push(`<span class="dz-summ-tag warn">${otherDev.length} device issues</span>`);
    const summHtml = summParts.length > 0
      ? summParts.join('')
      : `<span class="dz-summ-tag ok">All systems operational</span>`;

    const allDetail = [
      ...unavailable.map((i: any) => ({ kind: 'bad' as const, txt: `${i.source_target}: unavailable${i.packet_loss != null ? ` (${Number(i.packet_loss).toFixed(1)}% loss)` : ''}` })),
      ...degraded.map((i: any) => ({ kind: '' as const, txt: `${i.source_target}: ${i.quality}${i.packet_loss != null ? ` (${Number(i.packet_loss).toFixed(1)}% loss)` : ''}` })),
      ...otherDev.map((i: any) => ({ kind: 'bad' as const, txt: `${i.device_id} (${i.location}): ${i.status}` })),
      ...noTelemetry.map((i: any) => ({ kind: 'muted' as const, txt: `${i.device_id} (${i.location}): no_telemetry` })),
    ];
    const VISIBLE = 5;
    const visible = allDetail.slice(0, VISIBLE);
    const hidden = allDetail.length - visible.length;
    const chipsHtml = visible.map(it => `<span class="dz-issue ${it.kind}">${escapeHtml(it.txt)}</span>`).join('')
      + (hidden > 0 ? `<span class="dz-issue more">+${hidden} more</span>` : '');

    const asn = dz.device_geo?.asn_distribution || {};
    let donutHtml = '';
    if (Object.keys(asn).length > 0) {
      const items = makeDonutItems(asn, 5, pickPalette('dz'));
      const donut = renderDonut(items, { size: 84, ringR: 36, innerR: 22 });
      donutHtml = `
        <div class="donut-block">
          <div class="donut-block-title">DZ devices by network provider</div>
          <div class="donut-block-body">
            <div class="donut-mini">${donut.svg}</div>
            <div class="donut-legend">${donut.legend}</div>
          </div>
        </div>`;
    }

    // Order: donut LEFT, issues RIGHT. Issues sit at the card edge, donut closer to center.
    if (dzInner) {
      dzInner.innerHTML = `
        <div class="dz-content-row">
          <div class="dz-donut-col">${donutHtml}</div>
          <div class="dz-issues-col">
            <div class="dz-issues-summary">${summHtml}</div>
            <div class="dz-issues">${chipsHtml}</div>
          </div>
        </div>`;
    }
  } else if (cluster === 'alpenglow-community') {
    // ── alpenglow: card repurposed as "Validators distribution".
    // Only 2 entrypoints on alpenglow, so endpoint geography is uninformative.
    // Instead surface validator geography directly — same data we already have in
    // metrics.validators.{country,asn,city}_distribution.
    if (dzCard) dzCard.classList.remove('absent');
    if (dzLabel) {
      dzLabel.textContent = 'Validators distribution';
      dzLabel.style.color = 'var(--cluster-accent)';
    }
    setText('dz-summary-stats', '');
    const stEl = document.getElementById('dz-summary-stats');
    if (stEl) stEl.style.fontStyle = '';

    const vMetrics = d?.metrics?.validators || {};
    const vCountry = vMetrics.country_distribution || {};
    const vAsn     = vMetrics.asn_distribution || {};
    const vCity    = vMetrics.city_distribution || {};
    const vCountries = Object.keys(vCountry).length;
    const vCities    = Object.keys(vCity).length;
    const vAsns      = Object.keys(vAsn).length;

    if (dzStatsRow) {
      const statsParts: string[] = [];
      if (vCountries > 0) statsParts.push(`<span class="rpc-stat-item"><span class="rpc-stat-val mono">${fmt(vCountries)}</span> countries</span>`);
      if (vCities > 0)    statsParts.push(`<span class="rpc-stat-item"><span class="rpc-stat-val mono">${fmt(vCities)}</span> cities</span>`);
      if (vAsns > 0)      statsParts.push(`<span class="rpc-stat-item"><span class="rpc-stat-val mono">${fmt(vAsns)}</span> providers</span>`);
      dzStatsRow.innerHTML = statsParts.join('');
    }

    const blocks: string[] = [];
    if (Object.keys(vCountry).length > 0) {
      const items1 = makeDonutItems(vCountry, 5, pickPalette('rpc'));
      const d1 = renderDonut(items1, { size: 80, ringR: 34, innerR: 22 });
      blocks.push(`
        <div class="donut-block">
          <div class="donut-block-title">Validators by country</div>
          <div class="donut-block-body">
            <div class="donut-mini">${d1.svg}</div>
            <div class="donut-legend">${d1.legend}</div>
          </div>
        </div>`);
    }
    if (Object.keys(vAsn).length > 0) {
      const items2 = makeDonutItems(vAsn, 5, pickPalette('rpc-secondary'));
      const d2 = renderDonut(items2, { size: 80, ringR: 34, innerR: 22 });
      blocks.push(`
        <div class="donut-block">
          <div class="donut-block-title">Validators by ASN</div>
          <div class="donut-block-body">
            <div class="donut-mini">${d2.svg}</div>
            <div class="donut-legend">${d2.legend}</div>
          </div>
        </div>`);
    }

    let cols = '';
    if (blocks.length === 2) cols = ' cols-2';
    else if (blocks.length === 3) cols = ' cols-3';
    if (dzInner) {
      dzInner.innerHTML = `<div class="dz-donuts-row${cols}">${blocks.join('')}</div>`;
    }
  } else {
    // ── testnet/devnet: repurpose card as Endpoints distribution ──
    if (dzCard) dzCard.classList.remove('absent');
    if (dzLabel) {
      dzLabel.textContent = 'Endpoints distribution';
      dzLabel.style.color = 'var(--cluster-accent)';
    }
    setText('dz-summary-stats', '');
    const stEl = document.getElementById('dz-summary-stats');
    if (stEl) stEl.style.fontStyle = '';

    const sol = ep.solana || {};
    const jito = ep.jito || {};

    // 2nd line stats: solana endpoints geography summary + DoubleZero is mainnet-only note
    const solCountries = Object.keys(sol.country_distribution || {}).length;
    const solCities    = Object.keys(sol.city_distribution || {}).length;
    const solAsns      = Object.keys(sol.asn_distribution || {}).length;
    if (dzStatsRow) {
      const statsParts: string[] = [];
      if (solCountries > 0) statsParts.push(`<span class="rpc-stat-item"><span class="rpc-stat-val mono">${fmt(solCountries)}</span> countries</span>`);
      if (solCities > 0)    statsParts.push(`<span class="rpc-stat-item"><span class="rpc-stat-val mono">${fmt(solCities)}</span> cities</span>`);
      if (solAsns > 0)      statsParts.push(`<span class="rpc-stat-item"><span class="rpc-stat-val mono">${fmt(solAsns)}</span> providers</span>`);
      statsParts.push(`<span class="dz-mainnet-only">DoubleZero is mainnet-only</span>`);
      dzStatsRow.innerHTML = statsParts.join('');
    }

    const blocks: string[] = [];

    const solCountry = sol.country_distribution || {};
    const solAsn     = sol.asn_distribution || {};
    const jitoCity   = jito.city_distribution || {};

    const hasJitoCity = Object.keys(jitoCity).length > 0;

    // testnet: drop Solana country donut (data too sparse — usually just 2 countries),
    //   keep ASN donut (renamed to "Solana endpoints by ASN") + Jito endpoints by city.
    // devnet: keep both Solana country and Solana ASN (no Jito on devnet).
    if (cluster === 'devnet') {
      if (Object.keys(solCountry).length > 0) {
        const items1 = makeDonutItems(solCountry, 4, pickPalette('rpc'));
        const d1 = renderDonut(items1, { size: 80, ringR: 34, innerR: 22 });
        blocks.push(`
          <div class="donut-block">
            <div class="donut-block-title">Solana endpoints by country</div>
            <div class="donut-block-body">
              <div class="donut-mini">${d1.svg}</div>
              <div class="donut-legend">${d1.legend}</div>
            </div>
          </div>`);
      }
      if (Object.keys(solAsn).length > 0) {
        const items2 = makeDonutItems(solAsn, 4, pickPalette('rpc-secondary'));
        const d2 = renderDonut(items2, { size: 80, ringR: 34, innerR: 22 });
        blocks.push(`
          <div class="donut-block">
            <div class="donut-block-title">Solana endpoints by ASN</div>
            <div class="donut-block-body">
              <div class="donut-mini">${d2.svg}</div>
              <div class="donut-legend">${d2.legend}</div>
            </div>
          </div>`);
      }
    } else {
      // testnet
      if (Object.keys(solAsn).length > 0) {
        const items2 = makeDonutItems(solAsn, 4, pickPalette('rpc-secondary'));
        const d2 = renderDonut(items2, { size: 80, ringR: 34, innerR: 22 });
        blocks.push(`
          <div class="donut-block">
            <div class="donut-block-title">Solana endpoints by ASN</div>
            <div class="donut-block-body">
              <div class="donut-mini">${d2.svg}</div>
              <div class="donut-legend">${d2.legend}</div>
            </div>
          </div>`);
      }
      if (hasJitoCity) {
        const items3 = makeDonutItems(jitoCity, 4, pickPalette('jito'));
        const d3 = renderDonut(items3, { size: 80, ringR: 34, innerR: 22 });
        blocks.push(`
          <div class="donut-block">
            <div class="donut-block-title">Jito endpoints by city</div>
            <div class="donut-block-body">
              <div class="donut-mini">${d3.svg}</div>
              <div class="donut-legend">${d3.legend}</div>
            </div>
          </div>`);
      }
    }

    let cols = '';
    if (blocks.length === 2) cols = ' cols-2';
    else if (blocks.length === 3) cols = ' cols-3';

    if (dzInner) {
      dzInner.innerHTML = `<div class="dz-donuts-row${cols}">${blocks.join('')}</div>`;
    }
  }
}

// Build top-N donut items from a {label: count} distribution.
// Filters out '??' (unknown country) and 'OFFLINE' from non-rpc data; keeps them but renamed for rpc.
// Shortens overly-long ASN/provider names so they fit cleanly in donut legends.
// Curated mapping for known long names; fallback truncation with ellipsis for the rest.
const LABEL_SHORT: Record<string, string> = {
  'GOOGLE-CLOUD-PLATFORM': 'Google Cloud',
  'AMAZON-02': 'Amazon AWS',
  'AMAZON-AES': 'Amazon AES',
  'DTI-DC-PEERING': 'DTI-DC',
  'CHERRYSERVERS5-AS': 'CherryServers',
  'CHERRYSERVERS6-AS': 'CherryServers',
  'CHERRYSERVERS1-AS': 'CherryServers',
  'CHERRYSERVERS2-AS': 'CherryServers',
  'MOMENTUM-ACCESS': 'MomentumAccess',
  'TELECOM ITALIA SPARKLE S.p.A.': 'Telecom Italia',
  'Cogent Communications, LLC': 'Cogent',
  'COGENT-174': 'Cogent',
  'TERASWITCH': 'TeraSwitch',
  'GOOGLE-CLOUD-PL...': 'Google Cloud',
  'LIMESTONENETWORKS': 'Limestone',
  'LIMESTONE-NETWORKS-INC': 'Limestone',
  'LIMESTONENETWORKS-INC': 'Limestone',
  'DIGITALOCEAN-ASN': 'DigitalOcean',
  'AS-CHOOPA': 'Vultr',
  'AS-VULTR': 'Vultr',
};
function shortenLabel(name: string): string {
  if (LABEL_SHORT[name]) return LABEL_SHORT[name];
  if (name.length > 17) return name.slice(0, 16) + '…';
  return name;
}

// Map ISO 3166-1 alpha-2 country code → high-level region. Used in Insights BAM card
// to aggregate validators by continent/region (Europe / Americas / Asia-Pacific / etc.)
// instead of by individual country.
const REGION_MAP: Record<string, string> = {};
const _addRegion = (region: string, codes: string[]) => { for (const c of codes) REGION_MAP[c] = region; };
_addRegion('Europe', ['AD','AL','AM','AT','AZ','BA','BE','BG','BY','CH','CY','CZ','DE','DK','EE','ES','FI','FO','FR','GB','GE','GI','GR','HR','HU','IE','IM','IS','IT','JE','LI','LT','LU','LV','MC','MD','ME','MK','MT','NL','NO','PL','PT','RO','RS','RU','SE','SI','SK','SM','UA','VA','XK']);
_addRegion('Asia-Pacific', ['AF','AU','BD','BN','BT','CN','FJ','HK','ID','IN','JP','KH','KP','KR','KZ','LA','LK','MM','MN','MO','MV','MY','NC','NP','NZ','PG','PH','PK','SG','TH','TL','TW','UZ','VN','TJ','TM','KG']);
_addRegion('Americas', ['AG','AR','BB','BO','BR','BS','BZ','CA','CL','CO','CR','CU','DM','DO','EC','GT','GY','HN','HT','JM','KN','LC','MX','NI','PA','PE','PR','PY','SR','SV','TT','UY','US','VC','VE']);
_addRegion('Middle East / Africa', ['AE','AO','BH','BJ','BW','CD','CG','CI','CM','DJ','DZ','EG','ER','ET','GA','GH','GN','GQ','IL','IQ','IR','JO','KE','KW','LB','LR','LY','MA','MG','ML','MR','MU','MW','MZ','NE','NG','OM','PS','QA','RW','SA','SC','SD','SL','SN','SO','SY','TG','TN','TR','TZ','UG','YE','ZA','ZM','ZW']);
function getRegion(cc: string): string {
  return REGION_MAP[cc] || 'Other';
}

function makeDonutItems(
  dist: Record<string, number>,
  topN: number,
  palette: string[],
): { label: string; value: number; color?: string }[] {
  const entries = Object.entries(dist).sort((a, b) => (b[1] as number) - (a[1] as number));
  const top = entries.slice(0, topN);
  const rest = entries.slice(topN);
  const items = top.map(([k, v], i) => ({
    label: k === '??' ? 'Unknown' : shortenLabel(k),
    value: v as number,
    color: palette[i % palette.length],
  }));
  if (rest.length > 0) {
    const otherTotal = rest.reduce((s, [, c]) => s + (c as number), 0);
    items.push({ label: `Other (${rest.length})`, value: otherTotal, color: 'var(--text-muted)' });
  }
  return items;
}

// ───────── RPC summary line ─────────

function renderRpcSummary(d: any) {
  const rpc = d?.metrics?.rpc;
  const sol = d?.metrics?.endpoints?.solana;
  const dzRpcConnected = d?.metrics?.doublezero?.rpc;
  const card = document.getElementById('rpc-summary-card');
  if (!card) return;

  if (!rpc || rpc.total == null) {
    card.classList.add('absent');
    setText('rpc-summary-stats', 'no public RPC data on this cluster');
    const sr = document.getElementById('rpc-stats-row');
    if (sr) sr.innerHTML = '';
    const dr = document.getElementById('rpc-donuts-row');
    if (dr) dr.innerHTML = '';
    return;
  }

  card.classList.remove('absent');

  const total = rpc.total;
  const officialReachable = sol?.reachable ?? 0;
  const officialTotal = sol?.total ?? 0;
  const countries = Object.keys(rpc.country_distribution || {}).length;
  const cities = Object.keys(rpc.city_distribution || {}).length;
  const uniqueAsns = Object.keys(rpc.asn_distribution || {}).length;

  // Validator-hosted RPC count: metrics.rpc.total counts every node that exposes an RPC
  // port (dedicated rpc-role nodes AND validators that opened :8899). record_counts.rpc
  // is the dedicated-only subset. The difference is validators-hosting-rpc.
  const dedicatedRpc = d?.record_counts?.rpc ?? 0;
  const validatorHosted = Math.max(0, total - dedicatedRpc);

  // Header line: total + (validator-hosted inline) + official reachable + DZ-connected (when present).
  let summaryStr = `${fmt(total)} public RPCs`;
  if (validatorHosted > 0) {
    summaryStr += ` (${fmt(validatorHosted)} on validators)`;
  }
  if (officialTotal > 0) {
    summaryStr += ` · ${fmt(officialReachable)}/${fmt(officialTotal)} official reachable`;
  }
  if (typeof dzRpcConnected === 'number' && dzRpcConnected > 0) {
    summaryStr += ` · ${fmt(dzRpcConnected)} on DoubleZero`;
  }
  setText('rpc-summary-stats', summaryStr);

  const statsRow = document.getElementById('rpc-stats-row');
  if (statsRow) {
    statsRow.innerHTML = `
      <span class="rpc-stat-item"><span class="rpc-stat-val mono">${fmt(countries)}</span> countries</span>
      <span class="rpc-stat-item"><span class="rpc-stat-val mono">${fmt(cities)}</span> cities</span>
      <span class="rpc-stat-item"><span class="rpc-stat-val mono">${fmt(uniqueAsns)}</span> network providers</span>
    `;
  }

  // Two donuts side-by-side: ASN distribution (left) + Country distribution (right)
  // Different palette ordering on the two donuts so they read as visually distinct.
  const asnItems = makeDonutItems(rpc.asn_distribution || {}, 5, pickPalette('rpc'));
  const cyItems  = makeDonutItems(rpc.country_distribution || {}, 5, pickPalette('rpc-secondary'));

  const dAsn = renderDonut(asnItems, { size: 88, ringR: 38, innerR: 24 });
  const dCy  = renderDonut(cyItems,  { size: 88, ringR: 38, innerR: 24 });

  const wrap = document.getElementById('rpc-donuts-row');
  if (wrap) {
    wrap.innerHTML = `
      <div class="donut-block">
        <div class="donut-block-title">RPC nodes by ASN</div>
        <div class="donut-block-body">
          <div class="donut-mini">${dAsn.svg}</div>
          <div class="donut-legend">${dAsn.legend}</div>
        </div>
      </div>
      <div class="donut-block">
        <div class="donut-block-title">RPC nodes by country</div>
        <div class="donut-block-body">
          <div class="donut-mini">${dCy.svg}</div>
          <div class="donut-legend">${dCy.legend}</div>
        </div>
      </div>
    `;
  }
}

// ───────── Path to decentralization ─────────

function renderPath(d: any) {
  const v = d?.metrics?.validators || {};
  const stakeByAsn = v.stake_by_asn || {};
  const stakeByCountry = v.stake_by_country || {};
  const stakeByCity = v.stake_by_city || {};

  const list = document.getElementById('path-list');
  if (!list) return;

  if (Object.keys(stakeByAsn).length === 0) {
    list.innerHTML = '<div class="path-item"><div class="path-explainer" style="color:var(--text-muted);">No distribution data available for this cluster.</div></div>';
    return;
  }

  const topAsnEntries = Object.entries(stakeByAsn).filter(([k]) => k !== 'OFFLINE').sort((a, b) => (b[1] as number) - (a[1] as number));
  const topAsn = topAsnEntries[0];
  const topAsnName = topAsn ? topAsn[0] : '--';
  const topAsnPct = topAsn ? Number(topAsn[1]) : 0;

  const topCountries = Object.entries(stakeByCountry).filter(([k]) => k !== 'OFFLINE').sort((a, b) => (b[1] as number) - (a[1] as number)).slice(0, 3);
  const top3CountryPct = topCountries.reduce((acc, [, val]) => acc + Number(val), 0);
  const top3CountryNames = topCountries.map(([cc]) => cc).join(' + ');

  const topCities = Object.entries(stakeByCity).filter(([k]) => k !== 'OFFLINE').sort((a, b) => (b[1] as number) - (a[1] as number)).slice(0, 2);
  const top2CityPct = topCities.reduce((acc, [, val]) => acc + Number(val), 0);
  const top2CityNames = topCities.map(([c]) => c.split(',')[0]).join(' + ');

  const items = [
    {
      name: `${topAsnName} concentration`, current: topAsnPct, target: 25,
      severity: topAsnPct > 25 ? 'crit' : topAsnPct > 15 ? 'warn' : 'good',
      explainer: topAsnPct > 25
        ? `${(topAsnPct - 25).toFixed(1)}% of network stake would need to migrate from ${topAsnName} to other providers.`
        : `Within healthy threshold. To stay safe as the network grows, keep ASN concentration below 25%.`,
      target_label: 'SFDP threshold (May 2026): under 25%',
    },
    {
      name: `Top 3 countries combined`, current: top3CountryPct, target: 50,
      severity: top3CountryPct > 50 ? 'warn' : 'good',
      explainer: top3CountryPct > 50
        ? `${(top3CountryPct - 50).toFixed(1)}% of network stake would need to relocate from ${top3CountryNames} to other countries.`
        : `Within reasonable diversification range.`,
      target_label: 'Target: under 50% (geographic diversification)',
    },
    {
      name: `Top 2 cities combined`, current: top2CityPct, target: 25,
      severity: top2CityPct > 25 ? 'crit' : top2CityPct > 15 ? 'warn' : 'good',
      explainer: top2CityPct > 25
        ? `${(top2CityPct - 25).toFixed(1)}% of network stake would need to relocate out of ${top2CityNames}.`
        : `Distribution across cities is healthy.`,
      target_label: 'Target: under 25%',
    },
  ];

  list.innerHTML = items.map(item => {
    const currentW = Math.min(item.current, 100);
    const targetW = Math.min(item.target, 100);
    // v2.6: badge "within target" shows whenever current ≤ target, not only severity==='good'.
    // This makes the warn-but-still-within state read clearly.
    const withinTarget = item.current <= item.target;
    const metBadge = withinTarget ? `<span class="path-met-badge">✓ within target</span>` : '';
    // v2.6: bright vertical tick at the exact target percentage on the bar.
    const tickMarker = `<div class="path-bar-target-tick" style="left:${targetW}%"></div>`;
    return `<div class="path-item">
      <div class="path-item-header">
        <span class="path-name">${escapeHtml(item.name)}${metBadge}</span>
        <span class="path-current ${item.severity}">${item.current.toFixed(1)}%</span>
      </div>
      <div class="path-bar-container">
        <div class="path-bar-target" style="width:${targetW}%"></div>
        <div class="path-bar-current ${item.severity}" style="width:${currentW}%"></div>
        ${tickMarker}
      </div>
      <div class="path-explainer">${escapeHtml(item.explainer)}</div>
      <div class="path-target-line">${escapeHtml(item.target_label)}</div>
    </div>`;
  }).join('');
}

// ───────── Geographic distribution ─────────

function renderGeo(d: any) {
  const v = d?.metrics?.validators || {};

  const countries = Object.entries(v.country_distribution || {})
    .filter(([cc]) => cc !== '??').slice(0, 10);
  const maxC = Math.max(1, ...countries.map(e => e[1] as number));
  const geoCountries = document.getElementById('geo-countries');
  if (geoCountries) {
    if (countries.length === 0) {
      geoCountries.innerHTML = '<span style="color:var(--text-muted); font-size:0.85rem;">No data</span>';
    } else {
      geoCountries.innerHTML = countries.map(([cc, count]) => {
        const w = Math.round((count as number / maxC) * 100);
        const stake = v.stake_by_country?.[cc as string];
        return `<div class="geo-row">
          <div class="geo-country"><span class="geo-flag">${flag(cc as string)}</span><span class="geo-cc">${escapeHtml(cc as string)}</span></div>
          <div class="geo-bar-wrap"><div class="geo-bar normal" style="width:${w}%"></div></div>
          <div class="geo-count">${fmt(count)}</div>
          <div class="geo-stake">${stake != null ? pct(Number(stake), 1) : ''}</div>
        </div>`;
      }).join('');
    }
  }

  const asns = Object.entries(v.asn_distribution || {}).slice(0, 10);
  const maxA = Math.max(1, ...asns.map(e => e[1] as number));
  const geoAsns = document.getElementById('geo-asns');
  if (geoAsns) {
    if (asns.length === 0) {
      geoAsns.innerHTML = '<span style="color:var(--text-muted); font-size:0.85rem;">No data</span>';
    } else {
      geoAsns.innerHTML = asns.map(([asn, count]) => {
        const stake = v.stake_by_asn?.[asn as string];
        const stakeNum = stake ? Number(stake) : 0;
        const cls = stakeNum > 25 ? 'crit' : stakeNum > 15 ? 'warn' : 'normal';
        const w = Math.round((count as number / maxA) * 100);
        return `<div class="geo-row">
          <div class="geo-country"><span class="geo-cc" title="${escapeHtml(asn as string)}">${escapeHtml(asn as string)}</span></div>
          <div class="geo-bar-wrap"><div class="geo-bar ${cls}" style="width:${w}%"></div></div>
          <div class="geo-count">${fmt(count)}</div>
          <div class="geo-stake">${stake != null ? pct(stakeNum, 1) : ''}</div>
        </div>`;
      }).join('');
    }
  }

  const geoDesc = document.getElementById('geo-desc');
  if (geoDesc) {
    const cc = Object.keys(v.country_distribution || {}).filter(c => c !== '??').length;
    const an = Object.keys(v.asn_distribution || {}).length;
    geoDesc.textContent = `${fmt(cc)} countries and ${fmt(an)} network providers represented.`;
  }
}

// ───────── Decentralization metrics (5 cards) ─────────

function renderAcademic(d: any) {
  const dec = d?.metrics?.validators?.decentralization?.current;
  if (!dec) return;

  const hhic = dec.hhi_country?.value;
  const hhia = dec.hhi_asn?.value;
  const gini = dec.gini_validators?.value;

  setTextColored('hhi-country', hhic != null ? hhic.toFixed(0) : '--', hhiRating(hhic).cls);
  setTextColored('hhi-asn', hhia != null ? hhia.toFixed(0) : '--', hhiRating(hhia).cls);
  setTextColored('gini-val', gini != null ? gini.toFixed(3) : '--', giniRating(gini).cls);

  if (hhic != null) setPin('hhi-country-pin', (hhic / 10000) * 100);
  if (hhia != null) setPin('hhi-asn-pin', (hhia / 10000) * 100);
  if (gini != null) setPin('gini-pin', gini * 100);

  // Shannon (3 dimensions)
  const shc = dec.shannon_country?.normalized;
  const sha = dec.shannon_asn?.normalized;
  const shv = dec.shannon_validator?.normalized;
  setTextColored('shannon-country', shc != null ? shc.toFixed(2) : '--', shannonRating(shc).cls);
  setTextColored('shannon-asn', sha != null ? sha.toFixed(2) : '--', shannonRating(sha).cls);
  setTextColored('shannon-validator', shv != null ? shv.toFixed(2) : '--', shannonRating(shv).cls);
  if (shc != null) setPin('shannon-country-pin', shc * 100);
  if (sha != null) setPin('shannon-asn-pin', sha * 100);
  if (shv != null) setPin('shannon-validator-pin', shv * 100);

  // Nakamoto donuts
  const nakDims = [
    { id: 'nak-asn', val: dec.nakamoto_asn?.value, dim: 'asn' },
    { id: 'nak-country', val: dec.nakamoto_country?.value, dim: 'country' },
    { id: 'nak-city', val: dec.nakamoto_city?.value, dim: 'city' },
    { id: 'nak-validator', val: dec.nakamoto_validator?.value, dim: 'validator' },
  ];
  for (const { id, val, dim } of nakDims) {
    const r = nakRating(dim, val);
    setTextColored(id, val != null ? String(val) : '--', r.cls);
    const donutEl = document.getElementById(`${id}-donut`);
    if (donutEl) donutEl.innerHTML = renderNakDonut(val, dim);
  }

  // Superminority
  setTextColored('sm33-v', fmt(dec.superminority_validator_33?.value), smRating(dec.superminority_validator_33?.value, 'validator'));
  setTextColored('sm33-c', fmt(dec.superminority_country_33?.value), smRating(dec.superminority_country_33?.value, 'country'));
  setTextColored('sm33-a', fmt(dec.superminority_asn_33?.value), smRating(dec.superminority_asn_33?.value, 'asn'));
  setTextColored('sm50-v', fmt(dec.superminority_validator_50?.value), smRating(dec.superminority_validator_50?.value, 'validator'));
  setTextColored('sm50-c', fmt(dec.superminority_country_50?.value), smRating(dec.superminority_country_50?.value, 'country'));
  setTextColored('sm50-a', fmt(dec.superminority_asn_50?.value), smRating(dec.superminority_asn_50?.value, 'asn'));

  // Setup floating tooltips for HHI/Gini/Shannon tiles
  setupAcademicTooltips(dec);
}

// Floating tooltip on HHI/Gini/Shannon tiles
let _academicTip: HTMLElement | null = null;

function ensureAcademicTip(): HTMLElement {
  if (_academicTip) return _academicTip;
  const tip = document.createElement('div');
  tip.className = 'academic-tip';
  document.body.appendChild(tip);
  _academicTip = tip;
  return tip;
}

function setupAcademicTooltips(dec: any) {
  const tip = ensureAcademicTip();
  const tiles = document.querySelectorAll('.academic-tile[data-scale-tip]');

  const tipDataMap: Record<string, () => string> = {
    'hhi-country': () => {
      const v = dec.hhi_country?.value;
      const r = hhiRating(v);
      return v != null ? `<strong>HHI by country: ${v.toFixed(0)}</strong><span class="tip-rating">${r.label} · scale 0–10000</span>` : '<strong>No data</strong>';
    },
    'hhi-asn': () => {
      const v = dec.hhi_asn?.value;
      const r = hhiRating(v);
      return v != null ? `<strong>HHI by ASN: ${v.toFixed(0)}</strong><span class="tip-rating">${r.label} · scale 0–10000</span>` : '<strong>No data</strong>';
    },
    'gini': () => {
      const v = dec.gini_validators?.value;
      const r = giniRating(v);
      return v != null ? `<strong>Gini: ${v.toFixed(3)}</strong><span class="tip-rating">${r.label} · scale 0–1</span>` : '<strong>No data</strong>';
    },
    'shannon-country': () => {
      const v = dec.shannon_country?.normalized;
      const r = shannonRating(v);
      return v != null ? `<strong>Shannon (country): ${v.toFixed(3)}</strong><span class="tip-rating">${r.label} · scale 0–1</span>` : '<strong>No data</strong>';
    },
    'shannon-asn': () => {
      const v = dec.shannon_asn?.normalized;
      const r = shannonRating(v);
      return v != null ? `<strong>Shannon (ASN): ${v.toFixed(3)}</strong><span class="tip-rating">${r.label} · scale 0–1</span>` : '<strong>No data</strong>';
    },
    'shannon-validator': () => {
      const v = dec.shannon_validator?.normalized;
      const r = shannonRating(v);
      return v != null ? `<strong>Shannon (validator): ${v.toFixed(3)}</strong><span class="tip-rating">${r.label} · scale 0–1</span>` : '<strong>No data</strong>';
    },
  };

  tiles.forEach(tile => {
    const key = (tile as HTMLElement).dataset.scaleTip || '';
    const getContent = tipDataMap[key];
    if (!getContent) return;

    tile.addEventListener('mouseenter', () => {
      tip.innerHTML = getContent();
      tip.classList.add('show');
    });
    tile.addEventListener('mousemove', (e) => {
      const ev = e as MouseEvent;
      // position:fixed → clientX/clientY map directly to viewport coords
      const tipW = tip.offsetWidth || 220;
      const tipH = tip.offsetHeight || 60;
      let x = ev.clientX + 14;
      let y = ev.clientY + 14;
      if (x + tipW > window.innerWidth - 8) x = ev.clientX - tipW - 14;
      if (y + tipH > window.innerHeight - 8) y = ev.clientY - tipH - 14;
      if (x < 8) x = 8;
      if (y < 8) y = 8;
      tip.style.left = `${x}px`;
      tip.style.top = `${y}px`;
    });
    tile.addEventListener('mouseleave', () => {
      tip.classList.remove('show');
    });
  });
}

// ───────── About epoch (always mainnet) ─────────

async function renderAboutEpoch() {
  const el = document.getElementById('about-epoch-count');
  if (!el) return;
  try {
    const mainnet = await fetchMainnetSummaryCached();
    const epoch = mainnet?.epoch;
    if (epoch != null) {
      const bucketed = Math.floor((epoch - 200) / 50) * 50;
      el.textContent = `${bucketed}+`;
      el.classList.remove('sk-val');
    }
  } catch (e) { console.warn('[SONDA] mainnet epoch fetch:', e); }
}

// About stats — cluster rows in their own colors. Independent of selected cluster.
// Fetches all summaries in parallel; each cell falls back to "—" if a fetch fails.
// The alpenglow row auto-hides if its summary is missing or has zero validators
// (regenesis events, downed RPC, etc. — preserving "no broken UI" principle).
async function renderAboutStats() {
  const fillRow = (prefix: string, summary: any) => {
    const v = summary?.metrics?.validators;
    const valEl = document.getElementById(`ac-${prefix}-validators`);
    const ccEl = document.getElementById(`ac-${prefix}-countries`);
    const asnEl = document.getElementById(`ac-${prefix}-asns`);
    if (v) {
      const validators = v.total ?? 0;
      const countries = Object.keys(v.country_distribution || {}).filter(c => c !== '??').length;
      const asns = Object.keys(v.asn_distribution || {}).length;
      if (valEl) { valEl.textContent = fmt(validators); valEl.classList.remove('sk-val'); }
      if (ccEl)  { ccEl.textContent = fmt(countries);  ccEl.classList.remove('sk-val'); }
      if (asnEl) { asnEl.textContent = fmt(asns);      asnEl.classList.remove('sk-val'); }
      return validators > 0;
    }
    return false;
  };

  try {
    const [m, t, d, ag] = await Promise.all([
      fetchMainnetSummaryCached().catch(() => null),
      fetchSummary('testnet').catch(() => null),
      fetchSummary('devnet').catch(() => null),
      fetchSummary('alpenglow-community').catch(() => null),
    ]);
    fillRow('mn', m);
    fillRow('tn', t);
    fillRow('dn', d);

    // Alpenglow row: only show if we got real data (validators > 0). Cluster restarts
    // during the experimental phase can wipe the snapshot temporarily.
    const agOk = fillRow('ag', ag);
    const agRow = document.getElementById('about-row-alpenglow');
    if (agRow) agRow.style.display = agOk ? '' : 'none';
  } catch (e) {
    console.warn('[SONDA] about stats:', e);
  }
}

// ───────── Hero / strip / watermark ─────────

let lastSnapshotMs: number | null = null;

function updateFooterTs() {
  const el = document.getElementById('footer-ts');
  if (!el || !lastSnapshotMs) return;
  const sec = Math.floor((Date.now() - lastSnapshotMs) / 1000);
  let txt: string;
  if (sec < 5) txt = 'just now';
  else if (sec < 60) txt = `${sec}s ago`;
  else if (sec < 3600) txt = `${Math.floor(sec/60)}m ago`;
  else txt = `${Math.floor(sec/3600)}h ago`;
  el.textContent = txt;
}
setInterval(updateFooterTs, 5000);

function renderHeroAndStrip(d: any) {
  if ((window as any).sondaUpdateStrip) (window as any).sondaUpdateStrip(d);
  if ((window as any).sondaSetUpdateTime) (window as any).sondaSetUpdateTime(d.timestamp);

  if (d?.timestamp) {
    lastSnapshotMs = new Date(d.timestamp).getTime();
    updateFooterTs();
  }

  const tsShort = new Date(d.timestamp).toISOString().slice(0, 16).replace('T', ' ');
  const isMobile = window.innerWidth <= 600;
  const clusterShort = d.cluster === 'mainnet-beta' ? 'mainnet' : d.cluster;
  const wmText = isMobile
    ? `SONDA · epoch ${d.epoch} · ${clusterShort} · ${tsShort.slice(11)} UTC`
    : `SONDA · sonda.network · epoch ${d.epoch} · ${d.cluster} · ${tsShort} UTC`;
  document.querySelectorAll<HTMLElement>('.watermark').forEach(el => {
    el.textContent = wmText;
  });
}

// ───────── Main load ─────────

// Reset persistent academic/scale elements to placeholder before fetching new cluster.
// Without this, on cluster switch the OLD values briefly carry the NEW color (the
// global cluster-accent variable changes instantly, the data fetch takes ~200ms),
// which reads as misleading. Stories/Pulse/Geo are fully replaced via innerHTML,
// they don't need explicit reset.
function resetDynamicValues() {
  const ids = [
    'hhi-country', 'hhi-asn', 'gini-val',
    'shannon-country', 'shannon-asn', 'shannon-validator',
    'nak-asn', 'nak-country', 'nak-city', 'nak-validator',
    'sm33-v', 'sm33-c', 'sm33-a', 'sm50-v', 'sm50-c', 'sm50-a',
    // about epoch — but NOT about cluster stats: those don't change on cluster switch
    'about-epoch-count',
  ];
  for (const id of ids) {
    const el = document.getElementById(id);
    if (!el) continue;
    el.textContent = '—';
    el.classList.remove('good', 'warning', 'critical', 'neutral');
    el.classList.add('sk-val');
  }
  // Reset scale pins to 0
  ['hhi-country-pin', 'hhi-asn-pin', 'gini-pin',
   'shannon-country-pin', 'shannon-asn-pin', 'shannon-validator-pin'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.style.left = '0%';
  });
  // Reset Nakamoto donuts to neutral empty state
  ['nak-asn-donut', 'nak-country-donut', 'nak-city-donut', 'nak-validator-donut'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.innerHTML = `<svg viewBox="0 0 60 60"><circle cx="30" cy="30" r="22" fill="none" stroke="var(--text-muted)" stroke-width="5" opacity="0.15"/></svg>`;
  });
}

async function loadAll(cluster: string, isClusterChange: boolean = false) {
  console.log('[SONDA] loading data for cluster:', cluster, isClusterChange ? '(cluster switch)' : '');

  // Reset persistent values only on cluster switch — not on periodic refresh,
  // since steady-state refresh should update smoothly without a flash to placeholders.
  if (isClusterChange) resetDynamicValues();

  // Cluster banner (sticky, separately managed component)
  if ((window as any).sondaSetClusterBanner) {
    (window as any).sondaSetClusterBanner(cluster);
  }

  let summary: any = null;
  try {
    summary = await fetchSummary(cluster);
    renderHeroAndStrip(summary);
    try { renderInfra(summary); } catch (e) { console.warn('renderInfra:', e); }
    try { renderRpcSummary(summary); } catch (e) { console.warn('renderRpcSummary:', e); }
    try { renderPath(summary); } catch (e) { console.warn('renderPath:', e); }
    try { renderGeo(summary); } catch (e) { console.warn('renderGeo:', e); }
    try { renderAcademic(summary); } catch (e) { console.warn('renderAcademic:', e); }
    savePreviousFetch(cluster, summary);
  } catch (e) {
    console.warn('[SONDA] summary fetch failed:', e);
  }

  try {
    const validatorsData = await fetchValidators(cluster);
    const records = (validatorsData?.records || []).filter((r: any) => r != null);
    try { renderPulse(summary, records, cluster); } catch (e) { console.warn('renderPulse:', e); }
    try { await renderStories(summary, records, cluster); } catch (e) { console.warn('renderStories:', e); }
  } catch (e) {
    console.warn('[SONDA] validators fetch failed:', e);
  }

  // About epoch (always mainnet, cached) + about stats for ALL 3 clusters
  try { await renderAboutEpoch(); } catch (e) { console.warn('renderAboutEpoch:', e); }
  try { await renderAboutStats(); } catch (e) { console.warn('renderAboutStats:', e); }
}

let currentCluster = bootstrapCluster();
let refreshInterval: ReturnType<typeof setInterval> | null = null;

function startLoop() {
  loadAll(currentCluster);
  if (refreshInterval) clearInterval(refreshInterval);
  refreshInterval = setInterval(() => loadAll(currentCluster), 30000);
}

window.addEventListener('sonda:cluster-change', (e: Event) => {
  const newCluster = (e as CustomEvent).detail.cluster;
  console.log('[SONDA] cluster-change:', newCluster);
  currentCluster = newCluster;
  loadAll(currentCluster, /* isClusterChange */ true);
  if (refreshInterval) clearInterval(refreshInterval);
  refreshInterval = setInterval(() => loadAll(currentCluster), 30000);
});

document.addEventListener('DOMContentLoaded', () => {
  startLoop();
  // Production overlay disabled (v2.4): the BETA dev-banner at the top of the page
  // is sufficient signaling that we're still in active development. The full-screen
  // "IN DEVELOPMENT" overlay was blocking sonda.network visitors from the dashboard,
  // which is no longer the right tradeoff once Phase 1 stories are live.

  setupMobileTooltips();
  setupStubLinks();
});

// Prevent navigation on links pointing to pages that don't exist yet.
// Event delegation catches dynamic links inside Stories too.
function setupStubLinks() {
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const link = target.closest('[data-stub]');
    if (link) {
      e.preventDefault();
      e.stopPropagation();
    }
  });
}

// Mobile tooltip behavior:
// - tabindex on every .tooltip-icon (existing AND future ones inside Stories
//   that get rendered later via innerHTML) so taps focus them.
// - On focus (mobile only), measure the tooltip and position via JS so it
//   sits near the icon AND stays fully on-screen. CSS-only positioning kept
//   anchoring to fixed top/bottom and was either off-card or off-screen
//   depending on icon position; JS clamping is the only reliable approach.
// - On blur, reset inline styles so CSS retakes control.
// - On scroll (>6px), blur any focused icon to dismiss.
function setupMobileTooltips() {
  const annotateIcons = () => {
    document.querySelectorAll<HTMLElement>('.tooltip-icon').forEach(el => {
      if (!el.hasAttribute('tabindex')) el.setAttribute('tabindex', '0');
    });
  };
  annotateIcons();
  // Re-annotate after Stories render (innerHTML wipes attributes)
  const obs = new MutationObserver(() => annotateIcons());
  const grid = document.getElementById('stories-grid');
  if (grid) obs.observe(grid, { childList: true, subtree: true });

  // Position tooltip via JS on mobile focus
  document.addEventListener('focusin', (e) => {
    if (window.innerWidth > 600) return;
    const target = e.target as HTMLElement;
    if (!target.classList?.contains('tooltip-icon')) return;
    const wrap = target.closest('.tooltip-wrap') as HTMLElement;
    if (!wrap) return;
    const tooltip = wrap.querySelector('.tooltip-box') as HTMLElement;
    if (!tooltip) return;

    // Tooltip is now visible via :focus-within. Measure and position.
    requestAnimationFrame(() => {
      const iconRect = target.getBoundingClientRect();
      const tipW = tooltip.offsetWidth;
      const tipH = tooltip.offsetHeight;

      // Center tooltip horizontally on icon, then clamp into viewport.
      let left = iconRect.left + iconRect.width / 2 - tipW / 2;
      left = Math.max(8, Math.min(window.innerWidth - 8 - tipW, left));

      // Prefer above icon; if not enough room, place below.
      let top = iconRect.top - tipH - 10;
      if (top < 8) top = iconRect.bottom + 10;

      tooltip.style.position = 'fixed';
      tooltip.style.left = `${left}px`;
      tooltip.style.top = `${top}px`;
      tooltip.style.right = 'auto';
      tooltip.style.bottom = 'auto';
      tooltip.style.transform = 'none';
      tooltip.style.maxWidth = 'calc(100vw - 1rem)';
    });
  });

  document.addEventListener('focusout', (e) => {
    const target = e.target as HTMLElement;
    if (!target.classList?.contains('tooltip-icon')) return;
    const wrap = target.closest('.tooltip-wrap') as HTMLElement;
    const tooltip = wrap?.querySelector('.tooltip-box') as HTMLElement;
    if (tooltip) tooltip.style.cssText = '';
  });

  // Scroll dismisses focused tooltip (otherwise hover-via-tap state sticks)
  let lastScrollY = window.scrollY;
  window.addEventListener('scroll', () => {
    const dy = Math.abs(window.scrollY - lastScrollY);
    lastScrollY = window.scrollY;
    if (dy < 6) return;
    const a = document.activeElement;
    if (a instanceof HTMLElement && a.classList.contains('tooltip-icon')) {
      a.blur();
    }
  }, { passive: true });
}

// Re-render watermark on resize (mobile vs desktop)
let _resizeT: any;
window.addEventListener('resize', () => {
  clearTimeout(_resizeT);
  _resizeT = setTimeout(() => {
    // Trigger watermark refresh via reading the latest summary from cache (skip — just re-trigger loadAll if needed)
  }, 300);
});
</script>