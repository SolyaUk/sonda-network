---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import StatusStrip from '../components/StatusStrip.astro';
import ClusterBanner from '../components/ClusterBanner.astro';
---

<BaseLayout>
  <Header activePage="overview" />
  <StatusStrip />
  <ClusterBanner />

  <div class="dev-banner">
    <div class="dev-banner-inner">
      <span class="dev-badge">BETA</span>
      Dashboard is under active development. Some sections are incomplete.
      <a href="https://github.com/SolyaUk/sonda-network" target="_blank" rel="noopener" class="dev-link">View on GitHub</a>
    </div>
  </div>

  <main class="main-content">
    <div class="container">

      <section class="hero-compact">
        <div>
          <h1 class="hero-title">SONDA: Solana Observatory for Network Decentralization Analysis</h1>
        </div>
      </section>

      <!-- PULSE -->
      <section class="pulse-row" id="pulse-row">
        <div class="pulse-item"><div class="pulse-num mono sk-val">--</div><div class="pulse-label">loading</div></div>
        <div class="pulse-divider"></div>
        <div class="pulse-item"><div class="pulse-num mono sk-val">--</div><div class="pulse-label">loading</div></div>
        <div class="pulse-divider"></div>
        <div class="pulse-item"><div class="pulse-num mono sk-val">--</div><div class="pulse-label">loading</div></div>
        <div class="pulse-divider"></div>
        <div class="pulse-item"><div class="pulse-num mono sk-val">--</div><div class="pulse-label">loading</div></div>
      </section>

      <!-- LIVE INFRASTRUCTURE -->
      <section class="section">
        <div class="section-header">
          <div>
            <h2 class="section-title">Live infrastructure status</h2>
            <p class="section-desc">Reachability of critical Solana infrastructure endpoints</p>
          </div>
          <a href="/endpoints" data-stub class="section-link">Explore all endpoints →</a>
        </div>
        <div class="infra-status-grid" id="infra-grid">
          <div class="infra-card sk-card"><div class="sk-line" style="width:60%"></div><div class="sk-line" style="width:40%"></div></div>
          <div class="infra-card sk-card"><div class="sk-line" style="width:60%"></div><div class="sk-line" style="width:40%"></div></div>
          <div class="infra-card sk-card"><div class="sk-line" style="width:60%"></div><div class="sk-line" style="width:40%"></div></div>
          <div class="infra-card sk-card"><div class="sk-line" style="width:60%"></div><div class="sk-line" style="width:40%"></div></div>
        </div>

        <!-- RPC + DZ (mainnet) / Endpoints distribution (testnet/devnet) summary cards. -->
        <div class="infra-summary-grid">
          <div class="infra-summary-line" id="rpc-summary-card">
            <div class="rpc-summary-text">
              <div class="infra-summary-head">
                <span class="infra-summary-label" style="color: var(--accent-blue);">Public RPC nodes</span>
                <span class="infra-summary-stats" id="rpc-summary-stats">loading...</span>
              </div>
              <div class="rpc-stats-row" id="rpc-stats-row"></div>
            </div>
            <div class="rpc-donuts-row" id="rpc-donuts-row"></div>
          </div>

          <div class="infra-summary-line" id="dz-summary-card">
            <div class="infra-summary-head">
              <span class="infra-summary-label" id="dz-summary-label" style="color: var(--accent-violet);">DoubleZero network</span>
              <span class="infra-summary-stats" id="dz-summary-stats">loading...</span>
            </div>
            <!-- 2nd line of header stats — mirrors RPC card's rpc-stats-row.
                 mainnet: "X devices · Y multicast groups · Z contributors"
                 testnet/devnet: "X countries · Y cities · Z providers · DoubleZero is mainnet-only" -->
            <div class="rpc-stats-row dz-stats-row" id="dz-stats-row"></div>
            <!-- DZ inner area is fully rendered by JS:
                 - mainnet: 2-col row (donut left, issues right)
                 - testnet/devnet: donuts row -->
            <div class="dz-inner" id="dz-inner"></div>
          </div>
        </div>
      </section>

      <!-- INSIGHTS -->
      <section class="section">
        <div class="section-header">
          <div>
            <h2 class="section-title">Insights</h2>
            <p class="section-desc">Network signals at a glance</p>
          </div>
          <div class="watermark mono" id="watermark-insights"></div>
        </div>
        <div class="stories-grid" id="stories-grid">
          <div class="story sk-card"><div class="sk-line" style="width:60%"></div><div class="sk-line" style="width:40%"></div></div>
          <div class="story sk-card"><div class="sk-line" style="width:60%"></div><div class="sk-line" style="width:40%"></div></div>
          <div class="story sk-card"><div class="sk-line" style="width:60%"></div><div class="sk-line" style="width:40%"></div></div>
          <div class="story sk-card"><div class="sk-line" style="width:60%"></div><div class="sk-line" style="width:40%"></div></div>
        </div>
      </section>

      <!-- DECENTRALIZATION METRICS — 5 cards now -->
      <section class="section">
        <div class="section-header">
          <div>
            <h2 class="section-title">Decentralization metrics</h2>
            <p class="section-desc">Academic indicators of network distribution</p>
          </div>
        </div>

        <div class="academic-grid" id="academic-grid">

          <!-- HHI -->
          <div class="academic-card">
            <div class="academic-label">
              HHI
              <span class="tooltip-wrap">
                <span class="tooltip-icon" aria-label="info"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg></span>
                <span class="tooltip-box">Herfindahl-Hirschman Index measures concentration on a 0–10000 scale. Below 1500 is competitive (green), 1500–2500 moderate (orange), above 2500 highly concentrated (red).</span>
              </span>
            </div>
            <div class="academic-tile-grid">
              <div class="academic-tile" data-scale-tip="hhi-country">
                <div class="academic-tile-label">by country</div>
                <div class="academic-tile-num mono" id="hhi-country">--</div>
                <div class="academic-scale">
                  <div class="academic-scale-track">
                    <div class="academic-scale-seg good" style="width:15%"></div>
                    <div class="academic-scale-seg warn" style="width:10%"></div>
                    <div class="academic-scale-seg crit" style="width:75%"></div>
                  </div>
                  <div class="academic-scale-pin" id="hhi-country-pin"></div>
                </div>
              </div>
              <div class="academic-tile" data-scale-tip="hhi-asn">
                <div class="academic-tile-label">by ASN</div>
                <div class="academic-tile-num mono" id="hhi-asn">--</div>
                <div class="academic-scale">
                  <div class="academic-scale-track">
                    <div class="academic-scale-seg good" style="width:15%"></div>
                    <div class="academic-scale-seg warn" style="width:10%"></div>
                    <div class="academic-scale-seg crit" style="width:75%"></div>
                  </div>
                  <div class="academic-scale-pin" id="hhi-asn-pin"></div>
                </div>
              </div>
            </div>
          </div>

          <!-- GINI -->
          <div class="academic-card">
            <div class="academic-label">
              Gini
              <span class="tooltip-wrap">
                <span class="tooltip-icon" aria-label="info"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg></span>
                <span class="tooltip-box">Gini coefficient measures stake inequality across validators on a 0–1 scale. 0 means all validators equal, 1 means one holds everything.</span>
              </span>
            </div>
            <div class="academic-tile-grid academic-tile-grid-1">
              <div class="academic-tile" data-scale-tip="gini">
                <div class="academic-tile-label">across validators</div>
                <div class="academic-tile-num mono" id="gini-val">--</div>
                <div class="academic-scale">
                  <div class="academic-scale-track">
                    <div class="academic-scale-seg good" style="width:40%"></div>
                    <div class="academic-scale-seg warn" style="width:20%"></div>
                    <div class="academic-scale-seg crit" style="width:40%"></div>
                  </div>
                  <div class="academic-scale-pin" id="gini-pin"></div>
                </div>
              </div>
            </div>
          </div>

          <!-- SHANNON (NEW) -->
          <div class="academic-card">
            <div class="academic-label">
              Shannon
              <span class="tooltip-wrap">
                <span class="tooltip-icon" aria-label="info"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg></span>
                <span class="tooltip-box">Shannon entropy measures information-theoretic diversity. Normalized to 0–1: above 0.8 high diversity (green), 0.5–0.8 moderate, below 0.5 low diversity (red).</span>
              </span>
            </div>
            <div class="academic-tile-grid academic-tile-grid-1" style="gap: 0.4rem;">
              <div class="academic-tile" data-scale-tip="shannon-country">
                <div class="academic-tile-row">
                  <span class="academic-tile-label">country</span>
                  <span class="academic-tile-num mono small" id="shannon-country">--</span>
                </div>
                <div class="academic-scale academic-scale-thin">
                  <div class="academic-scale-track">
                    <div class="academic-scale-seg crit" style="width:50%"></div>
                    <div class="academic-scale-seg warn" style="width:30%"></div>
                    <div class="academic-scale-seg good" style="width:20%"></div>
                  </div>
                  <div class="academic-scale-pin" id="shannon-country-pin"></div>
                </div>
              </div>
              <div class="academic-tile" data-scale-tip="shannon-asn">
                <div class="academic-tile-row">
                  <span class="academic-tile-label">ASN</span>
                  <span class="academic-tile-num mono small" id="shannon-asn">--</span>
                </div>
                <div class="academic-scale academic-scale-thin">
                  <div class="academic-scale-track">
                    <div class="academic-scale-seg crit" style="width:50%"></div>
                    <div class="academic-scale-seg warn" style="width:30%"></div>
                    <div class="academic-scale-seg good" style="width:20%"></div>
                  </div>
                  <div class="academic-scale-pin" id="shannon-asn-pin"></div>
                </div>
              </div>
              <div class="academic-tile" data-scale-tip="shannon-validator">
                <div class="academic-tile-row">
                  <span class="academic-tile-label">validator</span>
                  <span class="academic-tile-num mono small" id="shannon-validator">--</span>
                </div>
                <div class="academic-scale academic-scale-thin">
                  <div class="academic-scale-track">
                    <div class="academic-scale-seg crit" style="width:50%"></div>
                    <div class="academic-scale-seg warn" style="width:30%"></div>
                    <div class="academic-scale-seg good" style="width:20%"></div>
                  </div>
                  <div class="academic-scale-pin" id="shannon-validator-pin"></div>
                </div>
              </div>
            </div>
          </div>

          <!-- NAKAMOTO -->
          <div class="academic-card">
            <div class="academic-label">
              Nakamoto
              <span class="tooltip-wrap">
                <span class="tooltip-icon" aria-label="info"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg></span>
                <span class="tooltip-box">Minimum number of independent entities that together control 33% of stake. Each ring shows the value as equal segments. Multiple concentric rings appear when the number exceeds 10. Higher is more decentralized.</span>
              </span>
            </div>
            <div class="nak-grid">
              <div class="nak-tile" data-dim="asn">
                <div class="nak-tile-text">
                  <div class="academic-tile-label">ASN</div>
                  <div class="academic-tile-num mono" id="nak-asn">--</div>
                </div>
                <div class="nak-donut" id="nak-asn-donut"></div>
              </div>
              <div class="nak-tile" data-dim="country">
                <div class="nak-tile-text">
                  <div class="academic-tile-label">country</div>
                  <div class="academic-tile-num mono" id="nak-country">--</div>
                </div>
                <div class="nak-donut" id="nak-country-donut"></div>
              </div>
              <div class="nak-tile" data-dim="city">
                <div class="nak-tile-text">
                  <div class="academic-tile-label">city</div>
                  <div class="academic-tile-num mono" id="nak-city">--</div>
                </div>
                <div class="nak-donut" id="nak-city-donut"></div>
              </div>
              <div class="nak-tile" data-dim="validator">
                <div class="nak-tile-text">
                  <div class="academic-tile-label">validator</div>
                  <div class="academic-tile-num mono" id="nak-validator">--</div>
                </div>
                <div class="nak-donut" id="nak-validator-donut"></div>
              </div>
            </div>
          </div>

          <!-- SUPERMINORITY -->
          <div class="academic-card">
            <div class="academic-label">
              Superminority
              <span class="tooltip-wrap">
                <span class="tooltip-icon" aria-label="info"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg></span>
                <span class="tooltip-box">Number of entities holding the given percent of stake. The 33% line is the liveness threshold (enough to halt the network), the 50% line is the safety threshold (enough to censor).</span>
              </span>
            </div>
            <div class="sm-stack">
              <div class="sm-block">
                <div class="academic-tile-label">controls 33%</div>
                <div class="sm-block-vals">
                  <div class="sm-mini"><span class="academic-tile-num mono" id="sm33-v">--</span><span class="sm-tag">validators</span></div>
                  <div class="sm-mini"><span class="academic-tile-num mono" id="sm33-c">--</span><span class="sm-tag">countries</span></div>
                  <div class="sm-mini"><span class="academic-tile-num mono" id="sm33-a">--</span><span class="sm-tag">ASNs</span></div>
                </div>
              </div>
              <div class="sm-block">
                <div class="academic-tile-label">controls 50%</div>
                <div class="sm-block-vals">
                  <div class="sm-mini"><span class="academic-tile-num mono" id="sm50-v">--</span><span class="sm-tag">validators</span></div>
                  <div class="sm-mini"><span class="academic-tile-num mono" id="sm50-c">--</span><span class="sm-tag">countries</span></div>
                  <div class="sm-mini"><span class="academic-tile-num mono" id="sm50-a">--</span><span class="sm-tag">ASNs</span></div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </section>

      <!-- PATH -->
      <section class="section">
        <div class="section-header">
          <div>
            <h2 class="section-title">Path to better decentralization</h2>
            <p class="section-desc">How much stake would need to migrate to reach healthier thresholds</p>
          </div>
          <div class="watermark mono" id="watermark-path"></div>
        </div>
        <div class="path-list" id="path-list">
          <div class="sk-line" style="width:80%; height:48px"></div>
          <div class="sk-line" style="width:80%; height:48px"></div>
          <div class="sk-line" style="width:80%; height:48px"></div>
        </div>
      </section>

      <!-- GEOGRAPHIC -->
      <section class="section">
        <div class="section-header">
          <div>
            <h2 class="section-title">Geographic distribution</h2>
            <p class="section-desc" id="geo-desc">Validator count and stake share.</p>
          </div>
          <a href="/validators" data-stub class="section-link">All validators →</a>
        </div>
        <div class="geo-grid">
          <div class="geo-block">
            <div class="card-label">By country</div>
            <div class="geo-chart" id="geo-countries">
              <div class="sk-line" style="width:100%"></div>
              <div class="sk-line" style="width:80%"></div>
            </div>
          </div>
          <div class="geo-block">
            <div class="card-label">
              By network provider (ASN)
              <span class="tooltip-wrap">
                <span class="tooltip-icon" aria-label="info"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg></span>
                <span class="tooltip-box">SFDP requires validators to avoid ASNs holding more than 25% of stake (effective May 2026). ASNs above this threshold are highlighted.</span>
              </span>
            </div>
            <div class="geo-chart" id="geo-asns">
              <div class="sk-line" style="width:100%"></div>
              <div class="sk-line" style="width:60%"></div>
            </div>
          </div>
        </div>
      </section>

      <!-- ABOUT + ROADMAP -->
      <section class="section" id="about" style="scroll-margin-top: 110px;">
        <div class="about-roadmap-card">
          <div class="about-roadmap-grid">

            <div class="about-block">
              <div class="about-header">
                <img src="/logo-500.png" alt="SONDA" class="about-logo" />
                <h2 class="about-roadmap-title">About SONDA</h2>
              </div>
              <p class="about-text">
                SONDA is an open-source observatory for the Solana network. It tracks where validators run, which infrastructure layers they use, and what decentralization looks like in practice. Live across mainnet, testnet, and devnet.
              </p>
              <p class="about-text">
                Validators here are not just IPs. Each record cross-references geolocation across four independent providers (with discrepancies flagged), pulls staking and performance from Solana RPC, infrastructure participation from DoubleZero and Jito BAM, delegation status from the Solana Foundation, and historical movements from Jito Kobe and SFDP archives. Validator location history reaches back to 2021, across <span class="mono" id="about-epoch-count">700+</span> epochs.
              </p>
              <p class="about-text">
                Built for assessing network effects and problems: the health of critical infrastructure layers, monitoring and research of datacenters, and a fresh look at decentralization. Data refreshes every <span class="mono">~60 seconds</span> across all four clusters and is free to use under attribution.
              </p>
              <div class="about-clusters" id="about-clusters">
                <div class="about-cluster-row" data-cluster-color="mainnet-beta">
                  <span class="about-cluster-tag">MAINNET</span>
                  <span class="about-cluster-stat"><span class="num mono" id="ac-mn-validators">—</span><span class="lbl">validators</span></span>
                  <span class="about-sep">·</span>
                  <span class="about-cluster-stat"><span class="num mono" id="ac-mn-countries">—</span><span class="lbl">countries</span></span>
                  <span class="about-sep">·</span>
                  <span class="about-cluster-stat"><span class="num mono" id="ac-mn-asns">—</span><span class="lbl">providers</span></span>
                </div>
                <div class="about-cluster-row" data-cluster-color="testnet">
                  <span class="about-cluster-tag">TESTNET</span>
                  <span class="about-cluster-stat"><span class="num mono" id="ac-tn-validators">—</span><span class="lbl">validators</span></span>
                  <span class="about-sep">·</span>
                  <span class="about-cluster-stat"><span class="num mono" id="ac-tn-countries">—</span><span class="lbl">countries</span></span>
                  <span class="about-sep">·</span>
                  <span class="about-cluster-stat"><span class="num mono" id="ac-tn-asns">—</span><span class="lbl">providers</span></span>
                </div>
                <div class="about-cluster-row" data-cluster-color="devnet">
                  <span class="about-cluster-tag">DEVNET</span>
                  <span class="about-cluster-stat"><span class="num mono" id="ac-dn-validators">—</span><span class="lbl">validators</span></span>
                  <span class="about-sep">·</span>
                  <span class="about-cluster-stat"><span class="num mono" id="ac-dn-countries">—</span><span class="lbl">countries</span></span>
                  <span class="about-sep">·</span>
                  <span class="about-cluster-stat"><span class="num mono" id="ac-dn-asns">—</span><span class="lbl">providers</span></span>
                </div>
                <div class="about-cluster-row" data-cluster-color="alpenglow-community" id="about-row-alpenglow" style="display:none;">
                  <span class="about-cluster-tag">ALPENGLOW</span>
                  <span class="about-cluster-stat"><span class="num mono" id="ac-ag-validators">—</span><span class="lbl">validators</span></span>
                  <span class="about-sep">·</span>
                  <span class="about-cluster-stat"><span class="num mono" id="ac-ag-countries">—</span><span class="lbl">countries</span></span>
                  <span class="about-sep">·</span>
                  <span class="about-cluster-stat"><span class="num mono" id="ac-ag-asns">—</span><span class="lbl">providers</span></span>
                </div>
              </div>
              <div class="about-tags">
                <span class="about-tag">Open source</span>
                <span class="about-tag">Free to use</span>
                <span class="about-tag">Attribution appreciated</span>
              </div>
              <p class="about-built-by">
                Built by the <a href="https://solya.studio" target="_blank" rel="noopener" class="link">Solya validator</a> team.
              </p>
            </div>

            <div class="roadmap-block">
              <div class="about-roadmap-title-row">
                <h2 class="about-roadmap-title">Roadmap</h2>
                <a href="https://t.me/sonda_network_events" target="_blank" rel="noopener" class="tg-cta">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M9.78 18.65l.28-4.23 7.68-6.92c.34-.31-.07-.46-.52-.19L7.74 13.3 3.64 12c-.88-.25-.89-.86.2-1.3l15.97-6.16c.73-.33 1.43.18 1.15 1.3l-2.72 12.81c-.19.91-.74 1.13-1.5.71L12.6 16.3l-1.99 1.93c-.23.23-.42.42-.83.42z"/></svg>
                  Live network events
                </a>
              </div>

              <div class="phases-list">

                <div class="phase-block done">
                  <div class="phase-block-head">
                    <div class="phase-block-title-group">
                      <span class="phase-name">Phase 0</span>
                      <span class="phase-status-tag good">Done</span>
                    </div>
                    <span class="phase-date mono">2023–Mar 2026</span>
                  </div>
                  <div class="phase-block-bar">
                    <div class="phase-block-bar-fill" style="width:100%; background: var(--status-good);"></div>
                  </div>
                  <div class="phase-block-desc">
                    <strong>Backend pipeline.</strong> Validator analyzer with multi-source geolocation cross-verification, R2 distribution, automated snapshots, Telegram bot for live network events.
                  </div>
                </div>

                <div class="phase-block done">
                  <div class="phase-block-head">
                    <div class="phase-block-title-group">
