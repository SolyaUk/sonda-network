  .vcard-pill-del { background: rgba(239, 68, 68, 0.15); color: var(--status-critical); border: 1px solid rgba(239, 68, 68, 0.4); }
  .vcard-pill-dz { background: rgba(167, 139, 250, 0.15); color: var(--accent-violet); border: 1px solid rgba(167, 139, 250, 0.4); }
  .vcard-pill-mc { background: rgba(232, 121, 249, 0.15); color: var(--accent-magenta); border: 1px solid rgba(232, 121, 249, 0.4); }
  .vcard-pill-bam { background: rgba(6, 182, 212, 0.15); color: var(--accent-cyan); border: 1px solid rgba(6, 182, 212, 0.4); }
  .vcard-pill-sm { background: rgba(239, 68, 68, 0.15); color: var(--status-critical); border: 1px solid rgba(239, 68, 68, 0.3); }
  .vcard-pill-sfdp { background: rgba(59, 130, 246, 0.15); color: var(--accent-blue); border: 1px solid rgba(59, 130, 246, 0.4); }
  .vcard-pill-gossip { background: transparent; color: var(--text-muted); border: 1px dashed var(--border); }
