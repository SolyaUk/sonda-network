function renderMobileCard(r, pos) {
  const cluster = getCluster();
  const voteHref = `/validator?id=${r.vote_account || r.identity_pubkey}&cluster=${cluster}`;
  const geo = r.geolocation || {};
  const cc = (geo.country_code || '??').toLowerCase();
  const flagSrc = cc !== '??' ? `https://flagcdn.com/w40/${cc}.png` : '';
  const stakeSol = fmtStakeShort(r.activated_stake_lamports);
  const initial = (r.name && r.name.trim()[0]) || (r.identity_pubkey && r.identity_pubkey[0]) || '?';
  const seedHash = (s) => { let h=0; for (let i=0;i<s.length;i++) h=((h<<5)-h+s.charCodeAt(i))|0; return Math.abs(h); };
  const h = seedHash(r.identity_pubkey || r.name || 'unknown');
  const hue = h % 360, sat = 35 + ((h >> 8) % 20);

  const inGossip = isInGossip(r);
  const skipDisp = r.skip_rate != null ? r.skip_rate.toFixed(2) + '%' : '—';
  const commission = r.commission != null ? r.commission + '%' : '—';
  const mev = r.mev_commission != null ? (r.mev_commission / 100).toFixed(2) + '%' : null;
  const clientInfo = inGossip ? displayClient(r.client_type, r.client_id_raw) : { label: '', tip: null };
  const client = clientInfo.label;
  const cColor = clientColor(r.client_type);
  const creditsTxt = r.epoch_credits != null ? fmtCompact(r.epoch_credits) : '0';
  const rankTxt = r._tvc_rank != null ? ` · rank #${r._tvc_rank}` : '';

  // Visual badges shown inline in collapsed card
  const cardBadges = [];
  if (r.delinquent) cardBadges.push('<span class="vcard-pill vcard-pill-del">Delinquent</span>');
  if (r.dz_connected) cardBadges.push('<span class="vcard-pill vcard-pill-dz">DZ</span>');
  if (r.dz_multicast_publisher) cardBadges.push('<span class="vcard-pill vcard-pill-mc">DZ Multicast</span>');
  if (r.bam_node) cardBadges.push('<span class="vcard-pill vcard-pill-bam">BAM</span>');
  if (r.is_superminority) cardBadges.push('<span class="vcard-pill vcard-pill-sm">SM</span>');
  if (r.sfdp_state === 'Approved') cardBadges.push('<span class="vcard-pill vcard-pill-sfdp">SFDP</span>');
  if (!inGossip) cardBadges.push('<span class="vcard-pill vcard-pill-gossip">No gossip</span>');

  let connectionsTxt = [];
  if (r.dz_connected) connectionsTxt.push(`DZ ${r.dz_device_name || ''}`.trim());
  if (r.dz_multicast_publisher) connectionsTxt.push('DZ Multicast');
  if (r.bam_node) connectionsTxt.push(`BAM ${bamRegionCode(r.bam_region || r.bam_node) || r.bam_node}`.trim());
  const connectionsStr = connectionsTxt.length > 0 ? connectionsTxt.join(', ') : 'none';

  return `
    <div class="vcard" data-vote="${r.vote_account || r.identity_pubkey}" data-id="${r.identity_pubkey}">
      <div class="vcard-head">
        <span class="vcard-icon-wrap" style="display:inline-block;width:38px;height:38px;border-radius:50%;overflow:hidden;background:hsl(${hue},${sat}%,45%);position:relative;flex-shrink:0">
          ${r.icon_url ? `<img src="${r.icon_url}" width="38" height="38" loading="lazy" referrerpolicy="no-referrer" style="width:100%;height:100%;object-fit:cover;display:block" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"/>` : ''}
          <span style="${r.icon_url ? 'display:none;' : 'display:flex;'}width:100%;height:100%;align-items:center;justify-content:center;color:white;font-weight:600;font-size:1em;font-family:var(--font-display)">${initial.toUpperCase()}</span>
        </span>
        <div class="vcard-main">
          <div class="vcard-name${r.name ? '' : ' is-id'}">${r.name || shortenIdentity(r.identity_pubkey, 6, 6)}</div>
          <div class="vcard-meta">
            ${flagSrc ? `<span style="display:inline-block;width:13px;height:13px;border-radius:50%;overflow:hidden;border:1px solid var(--border);vertical-align:middle;margin-right:0.25rem"><img src="${flagSrc}" width="13" height="13" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block"/></span>` : ''}
            <span class="vcard-stake-inline">${stakeSol} SOL</span>
            <span class="vcard-meta-sep">·</span>
            <span>${inGossip ? (geo.city || '?') : 'not in gossip'}</span>
            ${client ? `<span class="vcard-meta-sep">·</span><span style="color:${cColor}">${client}</span>` : ''}
          </div>
          ${cardBadges.length > 0 ? `<div class="vcard-badges">${cardBadges.join('')}</div>` : ''}
        </div>
        <a class="vcard-go" href="${voteHref}" onclick="event.stopPropagation()" data-tip="Open details" aria-label="Open validator details">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </a>
      </div>
      <div class="vcard-body">
        <div class="vcard-body-row"><span class="vcard-body-label">Vote</span><span class="vcard-body-val" style="font-family:var(--font-mono);font-size:0.72rem">${shortenIdentity(r.vote_account, 6, 6)}</span></div>
        <div class="vcard-body-row"><span class="vcard-body-label">Version</span><span class="vcard-body-val">${inGossip ? (r.version || '—') : '—'}</span></div>
        <div class="vcard-body-row"><span class="vcard-body-label">Commission</span><span class="vcard-body-val">${commission}${mev ? ' · mev ' + mev : ''}</span></div>
        <div class="vcard-body-row"><span class="vcard-body-label">Location</span><span class="vcard-body-val">${inGossip ? `${geo.city || 'Unknown'}, ${geo.country_code || '??'} · ${shortAsnName(geo.asn_name || geo.asn || '')}` : 'Not in gossip'}</span></div>
        <div class="vcard-body-row"><span class="vcard-body-label">Connections</span><span class="vcard-body-val">${connectionsStr}</span></div>
        <div class="vcard-body-row"><span class="vcard-body-label">Performance</span><span class="vcard-body-val">credits ${creditsTxt}${rankTxt} · skip ${skipDisp}</span></div>
      </div>
    </div>
  `;
}

function applyAndRender(opts = {}) {
  const sortVal = document.getElementById('sort-select').value;
  const [sortKey, sortDir] = sortVal.split('-');
  filtered = sortValidators(filterValidators(allRecords, params), sortKey, sortDir);
  const keep = opts.keepCount ? Math.max(PAGE_SIZE, renderedCount) : PAGE_SIZE;
  renderedCount = 0;
  document.getElementById('vtable-body').innerHTML = '';
  document.getElementById('vcards-wrap').innerHTML = '';
  renderNext(keep);
  document.getElementById('result-count').textContent =
    `${filtered.length} validator${filtered.length === 1 ? '' : 's'}`;
  renderFilterChips();
  renderAggCards(allRecords, filtered, getCluster(), latestSummary);
}

function renderNext(count = PAGE_SIZE) {
  const end = Math.min(renderedCount + count, filtered.length);
  const slice = filtered.slice(renderedCount, end);

  const tbody = document.getElementById('vtable-body');
  tbody.insertAdjacentHTML('beforeend', slice.map((r, i) => renderTableRow(r, renderedCount + i + 1)).join(''));

  const cwrap = document.getElementById('vcards-wrap');
  cwrap.insertAdjacentHTML('beforeend', slice.map((r, i) => renderMobileCard(r, renderedCount + i + 1)).join(''));

  renderedCount = end;
  const loadMore = document.getElementById('load-more');
  loadMore.style.display = renderedCount < filtered.length ? 'inline-block' : 'none';

  // Wire up new row clicks (desktop)
  tbody.querySelectorAll('tr').forEach(tr => {
    if (tr.dataset.wired) return;
    tr.dataset.wired = '1';
    tr.addEventListener('click', (e) => {
      if (e.target instanceof Element && e.target.closest('[data-copy]')) return;
      window.location.href = tr.dataset.href;
    });
  });
  // Wire up mobile card head toggle
  cwrap.querySelectorAll('.vcard').forEach(card => {
    if (card.dataset.wired) return;
    card.dataset.wired = '1';
    card.querySelector('.vcard-head').addEventListener('click', e => {
      if (e.target.closest('.vcard-go')) return;
      card.classList.toggle('open');
    });
  });
}

// ----- Version status (F-18) -----
// Backend rates versions inside each client family: current / outdated / ancient / null.
function versionStatusInfo(status) {
  if (status === 'outdated') return { key: 'outdated', tip: 'Outdated: a newer release of this client family is current' };
  if (status === 'ancient') return { key: 'ancient', tip: 'Ancient: two or more releases behind the current one for this client' };
  return null;
}

// ----- One-line cluster summary -----
function renderSummaryLine(records) {
  const el = document.getElementById('vsummary-line');
  if (!el) return;
  const total = records.length;
  const active = records.filter(r => !r.delinquent).length;
  const delinq = total - active;
  const noGossip = records.filter(r => !isInGossip(r)).length;
  const totalStake = records.reduce((s, r) => s + (r.activated_stake_lamports || 0), 0);
  const countries = new Set(records.map(r => r.geolocation?.country_code).filter(c => c && c !== '??')).size;
  const cities = new Set(records.map(r => r.geolocation?.city).filter(c => c && c !== 'Unknown')).size;
  const asns = new Set(records.map(r => providerOf(r)).filter(Boolean)).size;
  const parts = [
    `<b>${fmt(total)}</b> validators`,
    `<b>${fmt(active)}</b> voting`,
    `<span class="${delinq > 0 ? 'vsl-warn' : ''}"><b>${fmt(delinq)}</b> delinquent</span>`,
  ];
  if (noGossip > 0) parts.push(`<span data-tip="${NO_GOSSIP_TIP}"><b>${fmt(noGossip)}</b> not in gossip</span>`);
  parts.push(`<b>${fmtStakeShort(totalStake)}</b> SOL`, `<b>${fmt(countries)}</b> countries`, `<b>${fmt(cities)}</b> cities`, `<b>${fmt(asns)}</b> providers`);
  el.innerHTML = parts.join('<span class="vsl-sep">·</span>');
}

// ----- Breakdown cards (F-A.1 + F-A.2) -----
// Registry: each card groups the validator universe (all vote accounts, same as the table)
// into segments {key, label, count, delinquent, stake, marker, special, status} via build(). Cards are
// rendered only for clusters in AGG_CARDS_CLUSTERS (rollout gate) and only when the card's
// `clusters` allows it ('*' = every cluster). Groups: 'software' (stacked bars, homepage
// Software-card layout) and 'decentralization' (big donuts). Every entry is a click filter:
// its key/value toggles a URL param (country=NL,DE), the table and the other cards
// re-aggregate on the filtered set, entries with nothing left are dimmed.
const AGG_CARDS_CLUSTERS = ['mainnet-beta', 'testnet', 'devnet', 'alpenglow-community'];
const AGG_ROWS_VISIBLE = 6;
const SEQ_PALETTE = ['#a78bfa', '#22d3ee', '#4ade80', '#fbbf24', '#f472b6', '#60a5fa', '#fb923c', '#2dd4bf', '#e879f9', '#facc15', '#38bdf8', '#a3e635'];
const NOT_IN_GOSSIP_KEY = '__nogossip';
const UNRESOLVED_KEY = '__unresolved';

// Cards the user expanded with "Show all": a filter click re-renders every card, and the
// expansion must survive that.
const expandedCards = new Set();

const CARD_GROUPS = [
  { id: 'software', title: 'Validator software' },
  { id: 'decentralization', title: 'Validator decentralization' },
];

function seqColor(i) { return SEQ_PALETTE[i % SEQ_PALETTE.length]; }

function escapeAttr(v) {
  return String(v ?? '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
}

// Generic grouping: keyFn(record) -> key or null (null = skipped); decorate(key) adds
// label/marker/special. Special keys are listed last regardless of stake.
function groupRecords(records, keyFn, decorate) {
  const map = new Map();
  for (const r of records) {
    const key = keyFn(r);
    if (key == null) continue;
    if (!map.has(key)) map.set(key, { key, count: 0, delinquent: 0, stake: 0 });
    const g = map.get(key);
    g.count++;
    if (r.delinquent) g.delinquent++;
    g.stake += r.activated_stake_lamports || 0;
  }
  return [...map.values()].map(g => Object.assign(g, decorate(g.key, g)));
}

const specialRow = (label, filter) => ({ label, special: true, marker: { type: 'muted' }, filter: filter || null });
const NOT_IN_GOSSIP_ROW = () => specialRow('Not in gossip', { key: 'gossip', val: 'no' });

const VALIDATOR_CARDS = [
  {
    id: 'clients', group: 'software', tag: 'Clients', title: 'Validator clients', clusters: '*',
    fkey: 'client', view: 'stacked', stat: 'share',
    build(records) {
      return groupRecords(records,
        r => (isInGossip(r) ? (clientLabel(r) || 'Unknown') : NOT_IN_GOSSIP_KEY),
        key => key === NOT_IN_GOSSIP_KEY ? NOT_IN_GOSSIP_ROW() : { label: key, marker: { type: 'dot', color: clientColor(key) } });
    },
  },
  {
    id: 'versions', group: 'software', tag: 'Versions', title: 'Client versions', clusters: '*',
    fkey: 'version', view: 'stacked', stat: 'stake',
    build(records) {
      const status = new Map();
      records.forEach(r => { if (r.version && r.version !== 'unknown' && r.version_status) status.set(r.version, r.version_status); });
      return groupRecords(records,
        r => (isInGossip(r) && r.version && r.version !== 'unknown' ? r.version : NOT_IN_GOSSIP_KEY),
        key => key === NOT_IN_GOSSIP_KEY ? NOT_IN_GOSSIP_ROW() : { label: key, marker: { type: 'dot', color: versionColor(key) }, status: versionStatusInfo(status.get(key)) });
    },
  },
  {
    // Status flags as click filters for the boolean keys. SFDP row appears only where the
    // cluster carries sfdp_state (mainnet; testnet once the backend links it).
    id: 'status', group: 'software', tag: 'Status', title: 'Validator status', clusters: '*',
    fkey: null, view: 'status',
    build(records) {
      const has = (fn) => records.some(fn);
      const rows = [
        { key: 'superminority', label: 'Superminority', filter: { key: 'superminority', val: 'true' }, fill: 'warn', count: records.filter(r => r.is_superminority).length },
        { key: 'delinquent', label: 'Delinquent', filter: { key: 'delinquent', val: 'true' }, fill: 'crit', count: records.filter(r => r.delinquent).length },
        { key: 'gossip', label: 'Not in gossip', filter: { key: 'gossip', val: 'no' }, fill: 'neutral', count: records.filter(r => !isInGossip(r)).length },
      ];
      if (has(r => r.sfdp_state)) rows.unshift({ key: 'sfdp', label: 'SFDP approved', filter: { key: 'sfdp', val: 'Approved' }, fill: 'cluster', count: records.filter(r => r.sfdp_state === 'Approved').length });
      return rows.map(r => Object.assign(r, { delinquent: 0, stake: 0, special: true }));
    },
  },
  {
    id: 'countries', group: 'decentralization', tag: 'Countries', title: 'Validators by country', clusters: '*',
    fkey: 'country', view: 'donut',
    build(records) {
      const names = new Map();
      records.forEach(r => { const g = r.geolocation; if (g?.country_code && g.country) names.set(g.country_code, g.country); });
      return groupRecords(records,
        r => (!r.geolocation ? NOT_IN_GOSSIP_KEY : (r.geolocation.country_code && r.geolocation.country_code !== '??' ? r.geolocation.country_code : UNRESOLVED_KEY)),
        key => key === NOT_IN_GOSSIP_KEY ? NOT_IN_GOSSIP_ROW()
          : key === UNRESOLVED_KEY ? specialRow('Unresolved location')
          : { label: names.get(key) || key, marker: { type: 'flag', cc: key } });
    },
  },
  {
    id: 'cities', group: 'decentralization', tag: 'Cities', title: 'Validators by city', clusters: '*',
    fkey: 'city', view: 'donut',
    build(records) {
      const cc = new Map();
      records.forEach(r => { const g = r.geolocation; if (g?.city && g.city !== 'Unknown' && g.country_code) cc.set(g.city, g.country_code); });
      return groupRecords(records,
        r => (!r.geolocation ? NOT_IN_GOSSIP_KEY : (r.geolocation.city && r.geolocation.city !== 'Unknown' ? r.geolocation.city : UNRESOLVED_KEY)),
        key => key === NOT_IN_GOSSIP_KEY ? NOT_IN_GOSSIP_ROW()
          : key === UNRESOLVED_KEY ? specialRow('Unresolved city')
          : { label: key, marker: { type: 'pin', cc: cc.get(key) || '' }, tip: cc.get(key) ? `${key}, ${cc.get(key)}` : key });
    },
  },
  {
    // Provider level (R11.2): the company the node is rented from, which may run several
    // ASNs (Cherry Servers: 7). The ASN list shows under each provider when the card is
    // expanded; the logo comes from the provider's most common ASN.
    id: 'providers', group: 'decentralization', tag: 'Providers', title: 'Validators by network provider', clusters: '*',
    fkey: 'provider', view: 'donut',
    build(records, ctx) {
      const asnNames = ctx?.summary?.metrics?.asn_names || {};
      const nameOf = (a) => asnNames[a.asn] || a.name || a.asn;
      const segs = aggregateByProvider(records).map(e => e.provider === 'unknown'
        ? Object.assign({ key: NOT_IN_GOSSIP_KEY, count: e.count, delinquent: e.delinquent, stake: e.stake_lamports }, NOT_IN_GOSSIP_ROW())
        : {
            key: e.provider, label: e.provider, count: e.count, delinquent: e.delinquent, stake: e.stake_lamports,
            // ASN details and provider tags (v3.12 metrics.providers) live in the tooltip only
            tip: [
              e.asns.length > 1
                ? `${e.provider}: ${e.asns.length} networks\n${e.asns.map(a => `${a.asn}${nameOf(a) !== e.provider ? ` ${nameOf(a)}` : ''} · ${a.count}`).join('\n')}`
                : (e.asns[0] ? `${e.provider} (${e.asns[0].asn}${nameOf(e.asns[0]) !== e.provider ? ` ${nameOf(e.asns[0])}` : ''})` : e.provider),
              ...providerTagsText(ctx?.summary, e.provider),
            ].join('\n'),
            marker: { type: 'logo', src: providerLogoUrl(ctx?.summary, e.provider, e.primary_asn), initial: (e.provider || '?').charAt(0).toUpperCase() },
          });
      return segs.filter(x => !x.special).concat(segs.filter(x => x.special));
    },
  },
];

function markerHtml(m) {
  if (!m) return '<span></span>';
  if (m.type === 'dot') return `<span class="vagg-dot" style="background:${m.color}"></span>`;
  if (m.type === 'flag') return `<span class="vagg-flag"><img src="https://flagcdn.com/w40/${m.cc.toLowerCase()}.png" alt="" loading="lazy"></span>`;
  if (m.type === 'pin') return m.cc ? `<span class="vagg-pin"><img src="https://flagcdn.com/w40/${m.cc.toLowerCase()}.png" alt="" loading="lazy"></span>` : '<span class="vagg-pin"></span>';
  if (m.type === 'logo') return `<span class="dc-logo" data-initial="${escapeAttr(m.initial)}">${m.src ? `<img src="${m.src}" alt="" loading="lazy" onerror="this.remove()">` : ''}</span>`;
  return '<span class="vagg-marker-muted"></span>';
}

function segmentColor(seg, i) {
  if (seg.special) return 'var(--text-muted)';
  if (seg.marker?.type === 'dot') return seg.marker.color;
  return seqColor(i);
}

// Merge full-universe entries (labels, markers, order of existence) with counts from the
// filtered set. Entries absent from the filtered set keep zero counts and get dimmed.
function mergeSegments(all, filteredSegs) {
  const f = new Map(filteredSegs.map(x => [x.key, x]));
  const merged = all.map(seg => {
    const m = f.get(seg.key);
    return Object.assign({}, seg, { count: m ? m.count : 0, delinquent: m ? m.delinquent : 0, stake: m ? m.stake : 0 });
  });
  merged.sort((a, b) => (a.special === b.special ? (b.stake - a.stake || b.count - a.count) : (a.special ? 1 : -1)));
  return merged;
}

function delinqHtml(seg, withTip = true) {
  if (!(seg.delinquent > 0)) return '';
  return `<span class="vagg-delinq"${withTip ? ` data-tip="${seg.delinquent} of ${seg.count} delinquent"` : ''}>${seg.delinquent}</span>`;
}

// Filter pair for an entry: the card key by default, an explicit pair for special rows
// (Not in gossip -> gossip=no); null means the entry is not clickable.
function entryFilter(card, seg) {
  if (seg.special) return seg.filter || null;
  return { key: card.fkey, val: String(seg.key) };
}
function fattr(card, seg) {
  const f = entryFilter(card, seg);
  return f ? ` data-fkey="${f.key}" data-fval="${escapeAttr(f.val)}"` : '';
}
function rowClasses(card, seg) {
  const cls = [];
  const f = entryFilter(card, seg);
  if (f && isFilterActive(f.key, f.val)) cls.push('is-selected');
  else if (seg.count === 0) cls.push('is-dim');
  if (seg.special) cls.push('is-special');
  return cls.join(' ');
}

const SOFT_ROWS_VISIBLE = 8;

// Software cards (clients, versions): stacked bar and legend are stake-weighted, so one
// large validator on its own build counts as much as its stake says. Legend shows
// count|delinquent and the stake share; the top 8 entries plus an "Other" row are
// visible, "Show all" reveals the rest in a scrolling legend.
function renderSoftwareCard(card, segs, totals) {
  const { total, totalStake } = totals;
  const stakePct = seg => (totalStake > 0 ? (seg.stake / totalStake) * 100 : 0);
  const sharePct = seg => (total > 0 ? (seg.count / total) * 100 : 0);
  const live = segs.filter(x => !x.special);
  const specials = segs.filter(x => x.special);
  const top = live.slice(0, SOFT_ROWS_VISIBLE);
  const rest = live.slice(SOFT_ROWS_VISIBLE);
  const restAgg = { key: '__other', label: `Other (${rest.length})`, count: rest.reduce((a, x) => a + x.count, 0), delinquent: rest.reduce((a, x) => a + x.delinquent, 0), stake: rest.reduce((a, x) => a + x.stake, 0) };

  const segTip = (seg) => `${seg.label}: ${seg.count} validators (${sharePct(seg).toFixed(1)}%), ${stakePct(seg).toFixed(1)}% of stake`;
  const segHtml = (seg, color) => {
    const w = stakePct(seg);
    return w > 0 ? `<div class="stacked-segment" data-tip="${escapeAttr(segTip(seg))}" style="width:${w}%; background:${color};">${w >= 8 ? `${w.toFixed(0)}%` : ''}</div>` : '';
  };
  const barHtml = top.map((seg, i) => segHtml(seg, segmentColor(seg, i))).join('')
    + (rest.length ? segHtml(restAgg, '#4b4f63') : '')
    + specials.map(seg => segHtml(seg, 'var(--text-muted)')).join('');

  // Legend rows show the count only (stake share lives in the bar and the tooltip), which
  // keeps mainnet's 14+ versions readable. One tooltip per row carries everything.
  const rowTip = (seg) => `${seg.label}: ${seg.count} validators (${sharePct(seg).toFixed(1)}%)${seg.delinquent ? `, ${seg.delinquent} delinquent` : ''}, ${stakePct(seg).toFixed(1)}% of stake${seg.status ? `\n${seg.status.tip}` : ''}`;
  const item = (seg, i, extraCls, clickable) => {
    const status = seg.status ? ` ver-${seg.status.key}` : '';
    const fa = clickable ? fattr(card, seg) : '';
    const cls = clickable ? rowClasses(card, seg) : (seg.special ? 'is-special' : '');
    return `<span class="stacked-legend-item ${cls}${extraCls}"${fa} data-tip="${escapeAttr(rowTip(seg))}">
      <span class="stacked-legend-dot" style="background:${i == null ? 'var(--text-muted)' : segmentColor(seg, i)};"></span>
      <span class="stacked-legend-name${status}">${escapeAttr(seg.label)}</span>
      <span class="legend-leader"></span>
      <span class="stacked-legend-stat">${fmt(seg.count)}${delinqHtml(seg, false)}</span>
    </span>`;
  };
  const legend = top.map((seg, i) => item(seg, i, '', true)).join('')
    + rest.map((seg, i) => item(seg, SOFT_ROWS_VISIBLE + i, ' is-extra', true)).join('')
    + (rest.length ? `<span class="stacked-legend-item is-special vagg-other" data-more="1" data-tip="${escapeAttr(rowTip(restAgg))}. Click to show all"><span class="stacked-legend-dot" style="background:#4b4f63;"></span><span class="stacked-legend-name">${restAgg.label}</span><span class="legend-leader"></span><span class="stacked-legend-stat">${fmt(restAgg.count)}${delinqHtml(restAgg, false)}</span></span>` : '')
    + specials.map(seg => item(seg, null, '', true)).join('');
  const more = rest.length ? `<button class="vagg-more" type="button" data-more="${live.length}">Show all ${live.length}</button>` : '';

  return `<div class="story vagg-card vagg-view-stacked" data-card="${card.id}">
    <div class="story-header">
      <span class="story-tag cluster-tag">${card.tag}</span>
      <span class="vagg-meta">${fmt(segs.length)} ${segs.length === 1 ? 'entry' : 'entries'} · by stake</span>
    </div>
    <div class="story-title">${card.title}</div>
    <div class="stacked-bar"><div class="stacked-bar-inner">${barHtml || '<div class="stacked-segment" style="width:100%;background:var(--bg-card-hover)"></div>'}</div></div>
    <div class="stacked-legend">${legend}</div>
    <div class="vagg-foot">${more}</div>
  </div>`;
}

function renderDonutCard(card, segs, totals) {
  const { total, totalStake } = totals;
  const stakePct = seg => (totalStake > 0 ? (seg.stake / totalStake) * 100 : 0);
  const live = segs.filter(x => !x.special && x.count > 0);
  const top = live.slice(0, AGG_ROWS_VISIBLE);
  const rest = live.slice(AGG_ROWS_VISIBLE);
  const restStake = rest.reduce((a, x) => a + x.stake, 0);
  const restCount = rest.reduce((a, x) => a + x.count, 0);
  const items = top.map((seg, i) => ({ label: seg.label, value: seg.stake, color: segmentColor(seg, i), title: `${seg.label}: ${seg.count} validators, ${stakePct(seg).toFixed(1)}% stake` }));
  if (restStake > 0) items.push({ label: 'Other', value: restStake, color: '#4b4f63', title: `Other (${rest.length}): ${restCount} validators, ${((restStake / totalStake) * 100).toFixed(1)}% stake` });
  const donut = items.length > 0 ? renderDonut(items, { size: 150, ringR: 70, innerR: 44 }).svg : '<div class="vagg-empty">no match</div>';
  const colorOf = new Map(top.map((seg, i) => [seg.key, segmentColor(seg, i)]));

  const rowsHtml = segs.map((seg, i) => {
    const name = `<span class="vagg-name"><span${seg.tip ? ` data-tip="${escapeAttr(seg.tip)}"` : ' data-tip-ellipsis'}>${escapeAttr(seg.label)}</span><span class="legend-leader"></span></span>`;
    return `<div class="vagg-row ${rowClasses(card, seg)}${i >= AGG_ROWS_VISIBLE ? ' is-extra' : ''}"${fattr(card, seg)}>
      ${markerHtml(seg.marker)}
      ${name}
      <span class="vagg-count">${fmt(seg.count)}${delinqHtml(seg)}</span>
      <span class="vagg-stake"${colorOf.has(seg.key) ? ` style="color:${colorOf.get(seg.key)}"` : ''}>${stakePct(seg).toFixed(1)}%</span>
    </div>`;
  }).join('');
  const more = segs.length > AGG_ROWS_VISIBLE ? `<button class="vagg-more" type="button" data-more="${segs.length}">Show all ${segs.length}</button>` : '';
  return `<div class="story vagg-card vagg-view-donut" data-card="${card.id}">
    <div class="story-header">
      <span class="story-tag cluster-tag">${card.tag}</span>
      <span class="vagg-meta">${fmt(segs.length)} ${segs.length === 1 ? 'entry' : 'entries'}</span>
    </div>
    <div class="story-title">${card.title}</div>
    <div class="vagg-donut"><div class="donut-svg">${donut}</div><div class="vagg-rows">${rowsHtml}</div></div>
    <div class="vagg-foot">${more}</div>
  </div>`;
}

function renderStatusCard(card, rowsAll, rowsFiltered, totals) {
  const f = new Map(rowsFiltered.map(x => [x.key, x]));
  const denom = Math.max(1, totals.total);
  // Bars are relative to the largest row, like the DZ/BAM cards on the homepage: the
  // rows compare with each other, the share of all validators is in the tooltip.
  const maxRow = Math.max(1, ...rowsAll.map(r => f.get(r.key)?.count ?? 0));
  const rows = rowsAll.map(row => {
    const cur = f.get(row.key)?.count ?? 0;
    const active = isFilterActive(row.filter.key, row.filter.val);
    const cls = active ? 'is-selected' : (cur === 0 ? 'is-dim' : '');
    const numCls = (row.fill === 'crit' || row.fill === 'cluster') ? row.fill : '';
    return `<div class="bar-row ${cls}" data-fkey="${row.filter.key}" data-fval="${escapeAttr(row.filter.val)}" data-tip="${row.label}: ${cur} of ${totals.total} validators in view (${((cur / denom) * 100).toFixed(1)}%)">
      <div class="bar-row-label">${row.label}</div>
      <div class="bar-row-track"><div class="bar-row-fill ${row.fill}" style="width:${cur > 0 ? Math.max(3, (cur / maxRow) * 100) : 0}%"></div></div>
      <div class="bar-row-num ${numCls}">${fmt(cur)}</div>
    </div>`;
  }).join('');
  return `<div class="story vagg-card vagg-view-status" data-card="${card.id}">
    <div class="story-header">
      <span class="story-tag cluster-tag">${card.tag}</span>
    </div>
    <div class="story-title">${card.title}</div>
    <div class="vagg-status-head"><span class="story-big mono">${fmt(totals.total)}</span><span class="story-sub">validators in view</span></div>
    <div class="bar-rows-wrap with-divider">${rows}</div>
  </div>`;
}

function renderAggCards(records, filteredRecords, cluster, summary) {
  const section = document.getElementById('vagg');
  if (!section) return;
  const grids = CARD_GROUPS.map(g => document.getElementById(`vagg-group-${g.id}`));
  if (!AGG_CARDS_CLUSTERS.includes(cluster) || records.length === 0) {
    section.hidden = true;
    grids.forEach(g => { if (g) g.innerHTML = ''; });
    return;
  }
  const ctx = { summary, cluster };
  const totals = { total: filteredRecords.length, totalStake: filteredRecords.reduce((s, r) => s + (r.activated_stake_lamports || 0), 0) };
  const cards = VALIDATOR_CARDS.filter(c => c.clusters === '*' || c.clusters.includes(cluster));
  CARD_GROUPS.forEach((g, gi) => {
    const grid = grids[gi];
    if (!grid) return;
    const html = cards.filter(c => c.group === g.id).map(card => {
      if (card.view === 'status') return renderStatusCard(card, card.build(records, ctx), card.build(filteredRecords, ctx), totals);
      const segs = mergeSegments(card.build(records, ctx), card.build(filteredRecords, ctx));
      return card.view === 'donut' ? renderDonutCard(card, segs, totals) : renderSoftwareCard(card, segs, totals);
    }).join('');
    grid.innerHTML = html;
    const block = grid.closest('.vagg-block');
    if (block) block.hidden = html === '';
  });
  const setExpanded = (cardEl, expanded) => {
    cardEl.classList.toggle('is-expanded', expanded);
    const btn = cardEl.querySelector('.vagg-more');
    if (btn) btn.textContent = expanded ? 'Show less' : `Show all ${btn.dataset.more}`;
    if (expanded) expandedCards.add(cardEl.dataset.card); else expandedCards.delete(cardEl.dataset.card);
  };
  const toggleExpand = (cardEl) => setExpanded(cardEl, !cardEl.classList.contains('is-expanded'));
  section.querySelectorAll('.vagg-card').forEach(cardEl => { if (expandedCards.has(cardEl.dataset.card)) setExpanded(cardEl, true); });
  section.querySelectorAll('.vagg-more, .vagg-other').forEach(el => {
    el.addEventListener('click', (e) => { e.stopPropagation(); toggleExpand(el.closest('.vagg-card')); });
  });
  section.hidden = false;
}

// One delegated click handler for every filterable entry in the cards.
function initAggFilterClicks() {
  const section = document.getElementById('vagg');
  if (!section) return;
  section.addEventListener('click', (e) => {
    const t = e.target instanceof Element ? e.target.closest('[data-fkey]') : null;
    if (!t || !section.contains(t)) return;
    toggleFilterValue(t.dataset.fkey, t.dataset.fval);
  });
}

// Block toggles (software / decentralization), remembered per block.
function initAggBlockToggles() {
  document.querySelectorAll('.vagg-block').forEach(block => {
    const btn = block.querySelector('.vagg-block-title');
    if (!btn) return;
    const key = `sonda-vcards-block-${block.dataset.group}`;
    const apply = (open) => { block.classList.toggle('is-collapsed', !open); btn.setAttribute('aria-expanded', String(open)); };
    apply(localStorage.getItem(key) !== '0');
    btn.addEventListener('click', () => {
      const nowOpen = block.classList.contains('is-collapsed');
      apply(nowOpen);
      localStorage.setItem(key, nowOpen ? '1' : '0');
    });
  });
}

// Section toggle: remembered per browser; default open on desktop, collapsed on mobile.
function initAggToggle() {
  const section = document.getElementById('vagg');
  const btns = [document.getElementById('vagg-toggle'), document.getElementById('vagg-toggle-pill')].filter(Boolean);
  if (!section || btns.length === 0) return;
  const txt = section.querySelector('.vagg-toggle-txt');
  const apply = (open) => {
    section.classList.toggle('is-collapsed', !open);
    btns.forEach(b => b.setAttribute('aria-expanded', String(open)));
    if (txt) txt.textContent = open ? 'Hide' : 'Show';
  };
  // Narrow screens always start collapsed (the list is what a phone user came for);
  // on desktop the last choice is remembered.
  const stored = localStorage.getItem('sonda-vcards-open');
  apply(window.innerWidth <= 900 ? false : (stored != null ? stored === '1' : true));
  btns.forEach(b => b.addEventListener('click', () => {
    const nowOpen = section.classList.contains('is-collapsed');
    apply(nowOpen);
    localStorage.setItem('sonda-vcards-open', nowOpen ? '1' : '0');
  }));
}

async function loadAndRender() {
  document.getElementById('result-count').textContent = 'Loading…';
  const cluster = getCluster();

  // Activate cluster banner (sticky, top of page)
  if (window.sondaSetClusterBanner) window.sondaSetClusterBanner(cluster);

  // Clear cluster-specific summary and cards right away: stale cards recoloured in the new
  // accent and then vanishing was disorienting when switching clusters.
  const aggSection = document.getElementById('vagg');
  if (aggSection) { aggSection.hidden = true; aggSection.querySelectorAll('.vagg-grid').forEach(g => { g.innerHTML = ''; }); }
  latestSummary = null;
  const sumLine = document.getElementById('vsummary-line');
  if (sumLine) sumLine.textContent = 'Loading cluster summary…';

  // Summary fetch in parallel with validators: feeds StatusStrip/footer/header pill via
  // sondaUpdateStrip and provides metrics.asn_names for the breakdown cards.
  const summaryPromise = fetchSummary(cluster).then(s => {
    if (s && window.sondaUpdateStrip) window.sondaUpdateStrip(s);
    return s;
  }).catch(() => null);

  try {
    const data = await fetchValidators(cluster);
    allRecords = (data?.records || []).filter(isValidatorRecord);
    lastSnapshotTs = data?.meta?.timestamp || null;
    computeTvcRanks(allRecords);

    // Compute cluster-aware visibility flags
    const hasConnections = allRecords.some(r => r.dz_connected || r.bam_node || r.dz_multicast_publisher);
    const hasIbrl = allRecords.some(r => r.ibrl?.ibrl_score != null);
    const wrap = document.getElementById('vtable-wrap');
    const cards = document.getElementById('vcards-wrap');
    wrap.classList.toggle('hide-connections', !hasConnections);
    wrap.classList.toggle('hide-ibrl', !hasIbrl);
    cards.classList.toggle('hide-connections', !hasConnections);
    cards.classList.toggle('hide-ibrl', !hasIbrl);

    // Hide sort options for metrics that aren't present in this cluster
    const hasSlot = allRecords.some(r => r.slot_duration_median != null);
    const hasVlat = allRecords.some(r => r.median_vote_latency != null);
    const sortSel = document.getElementById('sort-select');
    sortSel.querySelectorAll('.sort-opt-slot').forEach(o => o.style.display = hasSlot ? '' : 'none');
    sortSel.querySelectorAll('.sort-opt-vlat').forEach(o => o.style.display = hasVlat ? '' : 'none');
    sortSel.querySelectorAll('.sort-opt-ibrl').forEach(o => o.style.display = hasIbrl ? '' : 'none');
    // If selected option became hidden, fall back to stake-desc
    const cur = sortSel.value;
    if ((cur.startsWith('slot') && !hasSlot) || (cur.startsWith('vlat') && !hasVlat) || (cur.startsWith('ibrl') && !hasIbrl)) {
      sortSel.value = 'rank-asc';
    }

    // Summary line + breakdown cards
    renderSummaryLine(allRecords);
    // Cards need metrics.asn_names (analyzer v3.11) for provider labels when available;
    // the summary fetch runs in parallel, wait for it here (small file) before the first render.
    latestSummary = await summaryPromise;
    applyAndRender();
  } catch (e) {
    document.getElementById('result-count').textContent = 'Failed to load data.';
    console.error('fetchValidators failed:', e);
  }
}

// In-place refresh (F-6): fetch again, skip if the snapshot did not change, otherwise
// re-render the same number of rows at the same scroll position and glow the rows whose
// key fields changed (delinquent, version, client, stake, location, DZ/BAM, SFDP).
async function refreshValidators() {
  const cluster = getCluster();
  const [data, summary] = await Promise.all([
    fetchValidators(cluster),
    fetchSummary(cluster).catch(() => null),
  ]);
  if (summary && window.sondaUpdateStrip) window.sondaUpdateStrip(summary);
  const ts = data?.meta?.timestamp || null;
  if (!data?.records || (ts && ts === lastSnapshotTs)) return;
  if (getCluster() !== cluster) return;   // cluster switched while fetching
  const before = signatureMap(allRecords);
  allRecords = data.records.filter(isValidatorRecord);
  lastSnapshotTs = ts;
  computeTvcRanks(allRecords);
  if (summary) latestSummary = summary;
  const changed = changedIdentities(before, signatureMap(allRecords));
  preserveScroll(() => {
    renderSummaryLine(allRecords);
    applyAndRender({ keepCount: true });
  });
  if (changed.size > 0) {
    document.querySelectorAll('#vtable-body tr[data-id], #vcards-wrap .vcard[data-id]').forEach(el => {
      if (changed.has(el.getAttribute('data-id'))) el.classList.add('is-changed');
    });
  }
}

document.addEventListener('DOMContentLoaded', () => {
  initAggToggle();
  initAggBlockToggles();
  initAggFilterClicks();
  bootstrapCluster();
  startAutoRefresh(refreshValidators, { intervalMs: 60000 });

  // Pre-fill search from URL
  const q = params.get('q') || '';
  document.getElementById('filter-search').value = q;

  // Pre-fill sort from URL
  const sortFromUrl = params.get('sort');
  if (sortFromUrl) {
    const opt = [...document.getElementById('sort-select').options].find(o => o.value === sortFromUrl);
    if (opt) document.getElementById('sort-select').value = sortFromUrl;
  }

  document.getElementById('filter-search').addEventListener('input', e => {
    const v = e.target.value.trim();
    if (v) params.set('q', v); else params.delete('q');
    setUrlParam('q', v || null);
    applyAndRender();
  });

  document.getElementById('sort-select').addEventListener('change', e => {
    const v = e.target.value;
    setUrlParam('sort', v);
    applyAndRender();
  });

  document.getElementById('load-more').addEventListener('click', () => renderNext());

  ['filter-clear', 'filter-clear-top'].forEach(id => {
    const b = document.getElementById(id);
    if (b) b.addEventListener('click', clearAllFilters);
  });

  loadAndRender();

  // Re-fetch on cluster change
  window.addEventListener('sonda:cluster-change', loadAndRender);
});
</script>
