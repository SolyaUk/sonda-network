  /* Group 8: flags */
  /* Badges are as wide as their text and wrap into rows (Viktor: two per row when they fit) */
  .cell-flags { display: flex; flex-wrap: wrap; gap: 0.25rem; align-items: flex-start; align-content: flex-start; }
