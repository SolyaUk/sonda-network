  .cell-geo-city.is-muted { color: var(--text-muted); font-weight: 400; font-style: italic; }
  .cell-name-id { font-family: var(--font-mono); font-size: 0.82rem; color: var(--text-secondary); font-weight: 500; letter-spacing: -0.01em; }

  /* Custom fast tooltip — shows on hover with no delay.
     Applied via data-tip="..." attribute. Native title="" has ~1.5s delay. */
