---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import StatusStrip from '../components/StatusStrip.astro';
import ClusterBanner from '../components/ClusterBanner.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Validators · SONDA">
  <Header activePage="validators" />
  <StatusStrip />
  <ClusterBanner />

  <div class="dev-banner">
    <div class="dev-banner-inner">
      <span class="dev-badge">BETA</span>
      SONDA is under active development. Some sections are incomplete.
      <a href="https://github.com/SolyaUk/sonda-network" target="_blank" rel="noopener" class="dev-link">View on GitHub</a>
    </div>
  </div>

  <main class="page-main">
    <a href="/" class="back-link" id="back-link">← Back to overview</a>

    <section class="page-hero">
      <h1 class="page-title">Validators</h1>
    </section>

    <!-- One-line cluster summary (replaced the 4 KPI tiles on 2026-09-10, F-A.1). -->
    <div class="vsummary-line" id="vsummary-line">Loading cluster summary…</div>

    <!-- Breakdown: aggregate cards in the homepage Insights language (story card, stacked
         stake bar, legend rows). Card set comes from VALIDATOR_CARDS in the script below and
         depends on the cluster. Hidden until data arrives; rolled out cluster by cluster
         (AGG_CARDS_CLUSTERS). Rows carry data-fkey/data-fval for the phase 2 filters. -->
    <section class="vagg" id="vagg" hidden>
      <div class="vagg-head">
        <button class="vagg-toggle" id="vagg-toggle" type="button" aria-expanded="true" aria-controls="vagg-grid">
          <span class="vagg-title">Breakdown</span>
          <span class="vagg-hint">click an entry to filter the table, click again to remove; filters combine</span>
        </button>
        <button class="filter-clear vagg-clear" id="filter-clear-top" type="button" style="display:none">Clear all filters &times;</button>
        <button class="vagg-toggle-pill" id="vagg-toggle-pill" type="button" aria-expanded="true" aria-controls="vagg-grid"><span class="vagg-toggle-txt">Hide</span><svg class="vagg-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg></button>
      </div>
      <div id="vagg-grid" class="vagg-body">
        <div class="vagg-block" data-group="software">
          <button class="vagg-block-title" type="button" aria-expanded="true"><svg class="vagg-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>Validator software</button>
          <div class="vagg-grid vagg-grid-software" id="vagg-group-software"></div>
        </div>
        <div class="vagg-block" data-group="decentralization">
          <button class="vagg-block-title" type="button" aria-expanded="true"><svg class="vagg-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>Validator decentralization</button>
          <div class="vagg-grid vagg-grid-3" id="vagg-group-decentralization"></div>
        </div>
      </div>
    </section>

    <!-- Filter bar -->
    <section class="filters-bar">
      <div class="filter-search-wrap">
        <input type="search" class="filter-search" id="filter-search" placeholder="Search name, identity or vote account…" />
      </div>
      <div class="filter-chips" id="active-filters"></div>
      <button class="filter-clear" id="filter-clear" style="display:none">Clear all filters &times;</button>
    </section>

    <!-- Active filter / sort indicator -->
    <div class="result-line">
      <span id="result-count">Loading…</span>
      <div class="sort-controls">
        <label class="sort-label" for="sort-select">Sort by:</label>
        <select id="sort-select" class="sort-select">
          <option value="rank-asc" selected>TVC rank (best first)</option>
          <option value="stake-desc">Stake (high to low)</option>
          <option value="delinquent-desc">Delinquent first</option>
          <option value="sfdp-asc">SFDP approved first</option>
          <option value="client-asc">Client (A to Z)</option>
          <option value="version-desc">Version (newest first)</option>
          <option value="stake-asc">Stake (low to high)</option>
          <option value="name-asc">Name (A–Z)</option>
          <option value="city-asc">City (A–Z)</option>
          <option value="credits-desc">Credits (high to low)</option>
          <option value="credits-asc">Credits (low to high)</option>
          <option value="slot-asc" class="sort-opt-slot">Slot time (fast to slow)</option>
          <option value="slot-desc" class="sort-opt-slot">Slot time (slow to fast)</option>
          <option value="vlat-asc" class="sort-opt-vlat">Vote latency (low to high)</option>
          <option value="vlat-desc" class="sort-opt-vlat">Vote latency (high to low)</option>
          <option value="ibrl-desc" class="sort-opt-ibrl">IBRL (high to low)</option>
          <option value="ibrl-asc" class="sort-opt-ibrl">IBRL (low to high)</option>
        </select>
      </div>
    </div>

    <!-- Desktop table -->
    <div class="vtable-wrap" id="vtable-wrap">
      <table class="vtable">
        <thead>
          <tr>
            <th class="col-icon"></th>
            <th class="col-identity">Identity</th>
            <th class="col-version">Version</th>
            <th class="col-stake">Stake / Commission</th>
            <th class="col-geo">Location</th>
            <th class="col-infra">Connections</th>
            <th class="col-perf">Performance</th>
            <th class="col-flags">Flags</th>
          </tr>
        </thead>
        <tbody id="vtable-body"></tbody>
      </table>
    </div>

    <!-- Mobile cards (collapsed by default) -->
    <div class="vcards-wrap" id="vcards-wrap"></div>

    <div class="load-more-wrap">
      <button class="load-more" id="load-more" style="display:none">Load more</button>
    </div>

    <p class="page-footnote">
      Recent changes (delinquency events, IP moves, version updates) and a synthetic centralization score
      are coming soon, derived from the backend timeseries.
    </p>
  </main>
  <Footer />
</BaseLayout>

<style is:global>
  .page-main {
    max-width: 1380px;
    margin: 0 auto;
    padding: 1rem 1.5rem 4rem;
  }
  .back-link {
    color: var(--text-muted);
    font-size: 0.85rem;
    text-decoration: none;
    display: inline-block;
    margin-bottom: 0.8rem;
  }
  .back-link:hover { color: var(--cluster-accent); }
  .dev-banner { background: rgba(59,130,246,0.08); border-bottom: 1px solid rgba(59,130,246,0.2); font-size: 0.78rem; color: var(--text-secondary); }
  .dev-banner-inner { max-width: 1280px; margin: 0 auto; padding: 0.5rem 1.5rem; display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
  .dev-badge { font-family: var(--font-mono); font-size: 0.65rem; font-weight: 600; background: var(--accent-blue); color: #fff; padding: 0.15rem 0.45rem; border-radius: 4px; letter-spacing: 0.08em; flex-shrink: 0; }
  .dev-link { color: var(--accent-blue); text-decoration: none; margin-left: auto; }
  .page-hero { margin-bottom: 1.5rem; }
  .page-title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--text-primary);
    margin: 0.5rem 0 0.4rem;
  }
  .page-sub {
    color: var(--text-secondary);
    font-size: 0.95rem;
    max-width: 760px;
    line-height: 1.5;
    margin: 0;
  }

  /* One-line cluster summary (same pattern as the stat rows on homepage cards) */
  .vsummary-line {
    margin: 1.25rem 0 1rem;
    font-size: 0.82rem;
    color: var(--text-muted);
    line-height: 1.7;
  }
  .vsummary-line b {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--text-primary);
  }
  .vsummary-line .vsl-sep { margin: 0 0.45rem; opacity: 0.6; }
  .vsummary-line .vsl-warn b { color: var(--status-critical); }

  /* Breakdown section: collapsible grid of story cards */
  .vagg { margin: 0 0 1.4rem; }
  .vagg-head { display: flex; align-items: center; gap: 0.6rem; margin: 0 0 0.6rem; }
  .vagg-toggle {
    display: flex; align-items: center; gap: 0.6rem; flex: 1 1 auto; min-width: 0;
    background: none; border: 0; padding: 0.35rem 0; margin: 0;
    color: var(--text-primary); cursor: pointer; text-align: left; font-family: inherit;
  }
  .vagg-clear { flex-shrink: 0; }
  .vagg-title { font-family: var(--font-display); font-size: 1.05rem; font-weight: 700; }
  .vagg-hint { font-size: 0.74rem; color: var(--text-muted); font-weight: 400; }
  @media (max-width: 760px) { .vagg-hint { display: none; } }
  .vagg-toggle-pill {
    flex-shrink: 0; display: inline-flex; align-items: center; gap: 0.35rem;
    padding: 0.28rem 0.7rem; border: 1px solid var(--border); border-radius: 999px;
    background: var(--bg-card); color: var(--text-secondary); font-size: 0.74rem; font-weight: 500;
    cursor: pointer; font-family: inherit;
    transition: border-color 0.15s, color 0.15s;
  }
  .vagg-toggle:hover ~ .vagg-toggle-pill, .vagg-toggle-pill:hover { border-color: var(--border-accent); color: var(--text-primary); }
  .vagg-chevron { color: var(--text-muted); transition: transform 0.2s ease; }
  .vagg.is-collapsed .vagg-chevron { transform: rotate(-90deg); }
  .vagg.is-collapsed .vagg-body { display: none; }
  .vagg-block { margin-bottom: 0.9rem; }
  .vagg-block.is-collapsed { margin-bottom: 0.4rem; }
  .vagg-block-title {
    display: inline-flex; align-items: center; gap: 0.4rem;
    background: none; border: 0; padding: 0.15rem 0; margin: 0 0 0.45rem 0; cursor: pointer;
    font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted);
  }
  .vagg-block-title:hover { color: var(--text-secondary); }
  .vagg-block.is-collapsed .vagg-block-title .vagg-chevron { transform: rotate(-90deg); }
  .vagg-block.is-collapsed .vagg-grid { display: none; }
  .vagg-grid { display: grid; gap: 0.85rem; align-items: stretch; }
  /* software: two wide cards + narrow status card (~22%) */
  .vagg-grid-software { grid-template-columns: minmax(0, 1.75fr) minmax(0, 1.75fr) minmax(0, 1fr); }
  .vagg-grid-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  @media (max-width: 1100px) { .vagg-grid-3, .vagg-grid-software { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .vagg-grid-software, .vagg-grid-3 { grid-template-columns: 1fr; } }

  /* Status card: big number (validators in view) + bar rows, the DZ/BAM-card language.
     Track = share of validators in view; number and fill take the flag's own colour. */
  /* Compact: number and caption share a line so the card is no taller than its neighbours */
  .vagg-status-head { display: flex; align-items: baseline; gap: 0.45rem; margin-top: 0.1rem; }
  .vagg-view-status .story-big { font-size: 1.7rem; line-height: 1; margin: 0; }
  .vagg-view-status .story-sub { margin: 0; }
  .vagg-view-status .bar-rows-wrap.with-divider { padding-top: 0.45rem; margin-top: 0.5rem; gap: 0.15rem; }
  .vagg-view-status .bar-row { grid-template-columns: minmax(0, 1fr) 72px 34px; cursor: pointer; padding: 0.18rem 0.3rem; margin: 0 -0.3rem; border-radius: 6px; }
  .vagg-view-status .bar-row .bar-row-label { color: var(--text-primary); }
  .vagg-view-status .bar-row.is-dim { opacity: 0.38; }
  .vagg-view-status .bar-row-fill.crit { background: var(--status-critical); }
  .vagg-view-status .bar-row-fill.cluster { background: var(--cluster-accent); }
  .vagg-view-status .bar-row-fill.warn { background: var(--accent-amber); }
  .vagg-view-status .bar-row-fill.neutral { background: var(--text-muted); opacity: 0.7; }
  .vagg-view-status .bar-row-num.crit { color: var(--status-critical); }
  .vagg-view-status .bar-row-num.cluster { color: var(--cluster-accent); }

  /* Click-to-filter states (F-A.2) */
  .vagg-card [data-fkey] { cursor: pointer; border-radius: 6px; transition: background 0.12s, opacity 0.12s; }
  .vagg-card [data-fkey]:hover { background: var(--bg-card-hover); }
  .vagg-card [data-fkey].is-selected { background: color-mix(in srgb, var(--cluster-accent) 14%, transparent); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--cluster-accent) 45%, transparent); }
  .vagg-card [data-fkey].is-dim { opacity: 0.38; }
  .vagg-card [data-fkey].is-dim:hover { opacity: 0.7; }
  .vagg-card .stacked-legend-item[data-fkey] { padding: 0.1rem 0.3rem; margin: 0 -0.3rem; }
  .vagg-card .vagg-row[data-fkey] { padding: 0.15rem 0.3rem; margin: 0 -0.3rem; }

  .vagg-card { gap: 0.4rem; padding: 1rem 1.05rem 0.9rem; }
  .vagg-card .story-title { font-size: 0.9rem; }
  .vagg-meta { font-family: var(--font-mono); font-size: 0.66rem; color: var(--text-muted); white-space: nowrap; }
  .vagg-card .stacked-bar { height: 28px; margin: 0.35rem 0 0.2rem; }
  .vagg-card .stacked-segment { font-size: 0.68rem; }

  .vagg-rows { display: flex; flex-direction: column; gap: 0.2rem; margin-top: 0.3rem; }
  /* Expanded lists scroll inside the card instead of stretching the whole grid */
  .vagg-card.is-expanded .vagg-rows { max-height: 330px; overflow-y: auto; padding: 0 0.3rem; margin-left: -0.3rem; margin-right: -0.3rem; scrollbar-width: thin; }
  .vagg-foot { margin-top: auto; padding-top: 0.45rem; min-height: 1.6rem; display: flex; align-items: center; }
  .vagg-row {
    display: grid; grid-template-columns: 18px minmax(0, 1fr) auto auto;
    gap: 0.4rem; align-items: center;
    font-size: 0.78rem; padding: 0.15rem 0; min-width: 0;
  }
  .vagg-name .legend-leader { margin-right: 0; }
  .vagg-row.has-bar { grid-template-columns: 18px minmax(0, 1fr) 56px auto auto; }
  .vagg-track { height: 5px; background: var(--bg-primary); border: 1px solid var(--border); border-radius: 3px; overflow: hidden; }
  .vagg-track-fill { height: 100%; border-radius: 2px; background: var(--cluster-accent); min-width: 1px; }
  .vagg-row.is-special .vagg-track-fill { background: var(--text-muted); opacity: 0.5; }
  .vagg-row.is-extra { display: none; }
  .vagg-card.is-expanded .vagg-row.is-extra { display: grid; }
  /* Donut view: bigger and thicker than the homepage donuts, rows to the right */
  /* align-items: start keeps the donut in place when "Show all" grows the row list */
  .vagg-donut { display: grid; grid-template-columns: 150px minmax(0, 1fr); gap: 0.9rem; align-items: start; margin-top: 0.35rem; }
  .vagg-donut .donut-svg { margin-top: 0.4rem; }
  .vagg-donut .donut-svg { width: 150px; height: 150px; }
  .vagg-donut .vagg-rows { margin-top: 0; }
  .vagg-donut .vagg-row { grid-template-columns: 18px minmax(0, 1fr) auto auto; gap: 0.4rem; }
  @media (max-width: 480px) { .vagg-donut { grid-template-columns: 1fr; } .vagg-donut .donut-svg { margin: 0 auto; } }
  /* City marker: map-pin shape with the country flag inside (circle is the country marker) */
  .vagg-pin { width: 17px; height: 17px; border-radius: 50% 50% 50% 0; transform: rotate(-45deg); overflow: hidden; border: 1px solid var(--border); background: var(--bg-card-hover); flex-shrink: 0; margin: 0 1px 2px 0; }
  .vagg-pin img { width: 100%; height: 100%; object-fit: cover; display: block; transform: rotate(45deg) scale(1.4); }
  /* Software cards reuse the homepage legend; version status colours the name (as in the table) */
  .vagg-card .stacked-legend { margin-top: 0.6rem; }
  .vagg-card .stacked-legend-item.is-extra { display: none; }
  .vagg-card.is-expanded .stacked-legend-item.is-extra { display: flex; }
  .vagg-card.is-expanded .vagg-other { display: none; }
  /* Scrolling lists clip at their box; the row highlight extends 0.3rem to the left, so give
     the scroll box that much padding and pull it back with a margin. */
  .vagg-card.is-expanded .stacked-legend { max-height: 260px; overflow-y: auto; padding: 0 0.3rem; margin-left: -0.3rem; margin-right: -0.3rem; scrollbar-width: thin; }
  .vagg-card .vagg-other { cursor: pointer; }
  .vagg-card .stacked-legend-name.ver-outdated { color: var(--accent-amber); }
  .vagg-card .stacked-legend-name.ver-ancient { color: var(--status-critical); }
  .vagg-card .stacked-legend-item.is-special .stacked-legend-name { color: var(--text-muted); font-style: italic; font-weight: 400; }
  .vagg-card .stacked-legend-stat .vagg-delinq { margin-right: 0.35rem; }
  .vagg-row.is-special .vagg-name { color: var(--text-muted); font-style: italic; }
  .vagg-name { color: var(--text-primary); font-weight: 500; min-width: 0; display: flex; align-items: center; gap: 0.35rem; }
  .vagg-name > span:first-child { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; flex: 0 1 auto; }
  .vagg-count { font-family: var(--font-mono); font-size: 0.74rem; color: var(--text-secondary); text-align: right; white-space: nowrap; display: inline-flex; align-items: baseline; justify-content: flex-end; }
  /* Delinquent part of a count: thin red divider instead of a dot (35 | 3 reads as two numbers, 35.3 read as a decimal) */
  .vagg-delinq { color: var(--status-critical); font-size: 0.66rem; margin-left: 0.3rem; padding-left: 0.3rem; border-left: 1px solid color-mix(in srgb, var(--status-critical) 55%, transparent); line-height: 1; cursor: help; }
  .vagg-stake { font-family: var(--font-mono); font-size: 0.74rem; color: var(--text-primary); font-weight: 600; text-align: right; min-width: 3.4em; }

  /* Row markers: colour dot, round flag, round provider logo with initial as fallback */
  .vagg-dot { width: 9px; height: 9px; border-radius: 2px; margin: 0 auto; }
  .vagg-flag {
    width: 18px; height: 18px; border-radius: 50%; overflow: hidden; position: relative;
    background: var(--bg-card-hover); border: 1px solid var(--border); flex-shrink: 0;
  }
  .vagg-flag img { width: 100%; height: 100%; object-fit: cover; display: block; position: relative; z-index: 1; }
  /* provider logo slot: .dc-logo from cards.css */
  .vagg-marker-muted { width: 18px; height: 18px; border-radius: 50%; border: 1px dashed var(--border); }
  .vagg-empty { display: flex; align-items: center; justify-content: center; width: 150px; height: 150px; border-radius: 50%; border: 1px dashed var(--border); color: var(--text-muted); font-size: 0.72rem; }
  .vagg-more {
    padding: 0; background: none; border: 0; color: var(--cluster-accent); font-size: 0.74rem;
    cursor: pointer; font-family: inherit;
  }
  .vagg-more:hover { text-decoration: underline; }

  /* Version status (F-18): current has no accent; outdated amber; ancient red */
  .ver-tag {
    font-family: var(--font-mono); font-size: 0.58rem; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.05em; padding: 0.05rem 0.3rem; border-radius: 3px; flex-shrink: 0;
  }
  .ver-tag-outdated { color: var(--accent-amber); border: 1px solid color-mix(in srgb, var(--accent-amber) 45%, transparent); }
  .ver-tag-ancient { color: var(--status-critical); border: 1px solid color-mix(in srgb, var(--status-critical) 45%, transparent); }
  .cell-ver-main.ver-outdated { color: var(--accent-amber); }
  .cell-ver-main.ver-ancient { color: var(--status-critical); }

  /* Filters */
  .filters-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.8rem;
    flex-wrap: wrap;
  }
  .filter-search-wrap { flex: 1; min-width: 200px; }
  .filter-search {
    width: 100%;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.55rem 0.85rem;
    color: var(--text-primary);
    font-size: 0.9rem;
    font-family: inherit;
  }
  .filter-search:focus { outline: none; border-color: var(--cluster-accent); }
  .filter-chips { display: flex; gap: 0.45rem; flex-wrap: wrap; }
  .filter-chip {
    background: var(--bg-card-hover);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 0.3rem 0.65rem;
    font-size: 0.75rem;
    color: var(--text-secondary);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .filter-chip .chip-x {
    cursor: pointer;
    color: var(--text-muted);
    font-size: 0.9em;
    line-height: 1;
  }
  .filter-chip .chip-x:hover { color: var(--status-critical); }
  .filter-clear {
    background: color-mix(in srgb, var(--cluster-accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--cluster-accent) 55%, transparent);
    color: var(--text-primary);
    border-radius: 999px;
    padding: 0.4rem 0.85rem;
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
  }
  .filter-clear:hover { background: color-mix(in srgb, var(--cluster-accent) 22%, transparent); }

  .result-line {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--text-muted);
    font-size: 0.8rem;
    margin-bottom: 0.8rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .sort-controls { display: flex; align-items: center; gap: 0.5rem; }
  .sort-label { font-size: 0.78rem; }
  .sort-select {
    background: var(--bg-card);
    border: 1px solid var(--border);
    color: var(--text-primary);
    border-radius: 6px;
    padding: 0.3rem 0.5rem;
    font-size: 0.78rem;
    font-family: inherit;
  }

  /* Table */
  .vtable-wrap {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: visible;
  }
  .vtable {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }
  .vtable thead th {
    text-align: left;
    background: var(--bg-card-hover);
    color: var(--text-muted);
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-weight: 600;
    padding: 0.7rem 0.85rem;
    border-bottom: 1px solid var(--border);
