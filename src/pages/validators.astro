</style>

<script>
import {
  bootstrapCluster, getCluster, fetchValidators, fetchSummary,
  filterValidators, sortValidators, computeTvcRanks, aggregateByProvider, providerOf,
  providerLogoUrl, providerTagsText,
  isValidatorRecord, isInGossip, clientLabel,
  fmtStakeShort, concentrationLevel,
} from '../lib/data.js';
import { fmt, pct, shortenIdentity, fmtSol, clientColor, versionColor, displayClient, fmtCompact, bamRegionCode } from '../lib/formatters.js';
import { renderDonut } from '../lib/charts.js';
import { copyButtonHtml } from '../lib/ui.js';
import { startAutoRefresh, signatureMap, changedIdentities, preserveScroll } from '../lib/refresh.js';

const NO_GOSSIP_TIP = 'Vote account has stake but the node is not visible in gossip: no IP, version or client data this cycle';

const PAGE_SIZE = 50;
let allRecords = [];
let filtered = [];
let renderedCount = 0;
let latestSummary = null;
let lastSnapshotTs = null;   // meta.timestamp of the rendered validators.json

const params = new URLSearchParams(window.location.search);

function setUrlParam(key, value) {
  const url = new URL(window.location.href);
  if (value == null || value === '') url.searchParams.delete(key);
  else url.searchParams.set(key, value);
  window.history.replaceState(null, '', url.toString());
}

const FILTER_LABELS = {
  country: 'Country', city: 'City', provider: 'Provider', asn: 'ASN', client: 'Client', version: 'Version',
  dz: 'DZ', bam: 'BAM', rakurai: 'Rakurai',
  sfdp: 'SFDP', delinquent: 'Delinquent', superminority: 'Superminority', gossip: 'Gossip',
};
const LIST_FILTERS = ['country', 'city', 'provider', 'asn', 'client', 'version'];

function listParam(key) {
  return (params.get(key) || '').split(',').map(v => v.trim()).filter(Boolean);
}

// One chip per value so a single value of a multi-select can be removed alone.
function getActiveFilterChips() {
  const chips = [];
  for (const [key, label] of Object.entries(FILTER_LABELS)) {
    if (LIST_FILTERS.includes(key)) {
      listParam(key).forEach(v => chips.push({ key, label, value: v }));
    } else {
      const v = params.get(key);
      if (v) chips.push({ key, label, value: v });
    }
  }
  return chips;
}

// Toggle one value inside a list filter (country=NL,DE); other keys combine as AND.
function toggleFilterValue(key, value) {
  if (LIST_FILTERS.includes(key)) {
    const cur = listParam(key);
    const next = cur.includes(value) ? cur.filter(v => v !== value) : cur.concat(value);
    if (next.length > 0) params.set(key, next.join(',')); else params.delete(key);
    setUrlParam(key, next.join(','));
  } else {
    if (params.get(key) === value) { params.delete(key); setUrlParam(key, null); }
    else { params.set(key, value); setUrlParam(key, value); }
  }
  applyAndRender();
}

function removeFilterValue(key, value) {
  if (LIST_FILTERS.includes(key)) {
    const next = listParam(key).filter(v => v !== value);
    if (next.length > 0) params.set(key, next.join(',')); else params.delete(key);
    setUrlParam(key, next.join(','));
  } else {
    params.delete(key);
    setUrlParam(key, null);
  }
  applyAndRender();
}

// Human text for a chip: boolean-ish filters read as one word, list filters as key: value.
function chipText(key, value) {
  if (key === 'gossip') return value === 'no' ? 'Not in gossip' : 'In gossip';
  if (key === 'delinquent') return value === 'true' ? 'Delinquent' : 'Not delinquent';
  if (key === 'superminority') return 'Superminority';
  if (key === 'sfdp') return `SFDP ${value.toLowerCase()}`;
  if (key === 'bam') return 'Jito BAM';
  if (key === 'rakurai') return 'Rakurai';
  if (key === 'dz') return value === 'no' ? 'No DoubleZero' : value === 'multicast' ? 'DZ multicast' : 'DZ connected';
  return `${FILTER_LABELS[key] || key}: ${value}`;
}

function isFilterActive(key, value) {
  return LIST_FILTERS.includes(key) ? listParam(key).includes(value) : params.get(key) === value;
}

function clearAllFilters() {
  Object.keys(FILTER_LABELS).forEach(k => { params.delete(k); setUrlParam(k, null); });
  applyAndRender();
}

function renderFilterChips() {
  const wrap = document.getElementById('active-filters');
  const chips = getActiveFilterChips();
  wrap.innerHTML = chips.map(c =>
    `<span class="filter-chip">${escapeAttr(chipText(c.key, c.value))}<span class="chip-x" data-key="${c.key}" data-value="${escapeAttr(c.value)}">&times;</span></span>`
  ).join('');
  ['filter-clear', 'filter-clear-top'].forEach(id => {
    const b = document.getElementById(id);
    if (b) b.style.display = chips.length > 0 ? 'inline-block' : 'none';
  });
  wrap.querySelectorAll('.chip-x').forEach(x => {
    x.addEventListener('click', e => removeFilterValue(e.target.dataset.key, e.target.dataset.value));
  });
}

function shortAsnName(name) {
  if (!name) return '';
  if (name.length <= 22) return name;
  return name.substring(0, 20) + '…';
}

function renderTableRow(r, pos) {
  const cluster = getCluster();
  const voteHref = `/validator?id=${r.vote_account || r.identity_pubkey}&cluster=${cluster}`;
  const geo = r.geolocation || {};
  const cc = (geo.country_code || '??').toLowerCase();
  const flagSrc = cc !== '??' ? `https://flagcdn.com/w40/${cc}.png` : '';
  const skipRate = r.skip_rate;
  const skipClass = skipRate == null ? '' :
    skipRate < 1 ? 'perf-skip-good' : skipRate < 3 ? 'perf-skip-warn' : 'perf-skip-bad';
  const skipDisp = skipRate == null ? '—' : skipRate.toFixed(2) + '%';
  const inGossip = isInGossip(r);
  const credits = r.epoch_credits != null ? fmtCompact(r.epoch_credits) : '—';
  const creditsFull = r.epoch_credits != null ? fmt(r.epoch_credits) : '';
  const rankHtml = r._tvc_rank != null
    ? `<span class="perf-rank" data-tip="TVC rank ${r._tvc_rank} of ${r._tvc_total}">#${r._tvc_rank}</span>`
    : '';
  const ibrl = r.ibrl?.ibrl_score != null ? r.ibrl.ibrl_score.toFixed(0) : '—';
  const slot = r.slot_duration_median != null ? r.slot_duration_median.toFixed(0) + 'ms' : '—';
  const vlat = r.median_vote_latency != null ? r.median_vote_latency.toFixed(1) : '—';
  const stakeSol = fmtStakeShort(r.activated_stake_lamports);
  const commission = r.commission != null ? r.commission + '%' : '—';
  const mev = r.mev_commission != null ? (r.mev_commission / 100).toFixed(2) + '%' : '—';
  const ver = inGossip ? (r.version || '—') : '—';
  const verStatus = inGossip ? versionStatusInfo(r.version_status) : null;
  const clientInfo = inGossip ? displayClient(r.client_type, r.client_id_raw) : { label: '', tip: null };
  const cColor = clientColor(r.client_type);

  const initial = (r.name && r.name.trim()[0]) || (r.identity_pubkey && r.identity_pubkey[0]) || '?';
  const seedHash = (s) => { let h=0; for (let i=0;i<s.length;i++) h=((h<<5)-h+s.charCodeAt(i))|0; return Math.abs(h); };
  const h = seedHash(r.identity_pubkey || r.name || 'unknown');
  const hue = h % 360, sat = 35 + ((h >> 8) % 20);

  // Connection badges: DZ device, DZ Multicast (separate), BAM region
  let dzBadge = '';
  if (r.dz_connected) {
    const devName = r.dz_device_name || 'connected';
    const short = devName.length > 16 ? devName.substring(0, 14) + '…' : devName;
    dzBadge = `<span class="infra-badge infra-badge-dz" data-tip="DoubleZero device: ${devName}">DZ <span class="infra-badge-name">${short}</span></span>`;
  }
  let mcBadge = '';
  if (r.dz_multicast_publisher) {
    mcBadge = `<span class="infra-badge infra-badge-mc" data-tip="Publishes shreds via DZ multicast group">DZ Multicast</span>`;
  }
  let bamBadge = '';
  if (r.bam_node) {
    // bam_region carries the full node name in the data; the region is its first segment.
    const code = bamRegionCode(r.bam_region || r.bam_node);
    bamBadge = `<span class="infra-badge infra-badge-bam" data-tip="Jito BAM node: ${r.bam_node}">BAM <span class="infra-badge-name">${code || r.bam_node}</span></span>`;
  }

  // Flags column — only what is actually meaningful
  let flags = '';
  if (r.delinquent) flags += '<span class="vflag vflag-delinq" data-tip="Delinquent right now: the last vote is more than 128 slots (about a minute) behind the tip in this snapshot. How long it has lasted will come with the incidents history">Delinquent</span>';
  if (r.is_superminority) flags += '<span class="vflag vflag-sm" data-tip="Part of the superminority: the smallest set of validators holding 33% of stake">SM</span>';
  if (r.sfdp_state === 'Approved') flags += '<span class="vflag vflag-sfdp" data-tip="Solana Foundation Delegation Program: Approved">SFDP</span>';
  if (!inGossip) flags += `<span class="vflag vflag-gossip" data-tip="${NO_GOSSIP_TIP}">No gossip</span>`;

  return `
    <tr data-href="${voteHref}" data-id="${r.identity_pubkey}">
      <td class="cell-icon">
        <span style="display:inline-block;width:32px;height:32px;border-radius:50%;overflow:hidden;background:hsl(${hue},${sat}%,45%);position:relative;flex-shrink:0">
          ${r.icon_url ? `<img src="${r.icon_url}" width="32" height="32" loading="lazy" referrerpolicy="no-referrer" style="width:100%;height:100%;object-fit:cover;display:block" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"/>` : ''}
