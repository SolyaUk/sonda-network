          <div class="cell-key-row"><span class="cell-key-label">vt</span><span class="cell-key-val">${shortenIdentity(r.vote_account, 4, 4)}</span>${copyButtonHtml(r.vote_account, 'Copy vote account')}</div>
          ${r.bls_pubkey ? `<div class="cell-key-row"><span class="cell-key-label">bls</span><span class="cell-key-val">${shortenIdentity(r.bls_pubkey, 4, 4)}</span>${copyButtonHtml(r.bls_pubkey, 'Copy BLS pubkey')}</div>` : ''}
