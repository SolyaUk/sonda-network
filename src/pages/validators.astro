  /* Position in the current list (sorted + filtered), under the icon: quiet, mono */
  .row-pos { font-family: var(--font-mono); font-size: 0.6rem; color: var(--text-muted); text-align: center; margin-top: 0.2rem; letter-spacing: 0; }

