---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import StatusStrip from '../components/StatusStrip.astro';
import ClusterBanner from '../components/ClusterBanner.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Validators · SONDA">
  <Header activePage="validators" />
  <StatusStrip />
  <ClusterBanner />

  <div class="dev-banner">
    <div class="dev-banner-inner">
      <span class="dev-badge">BETA</span>
      SONDA is under active development. Some sections are incomplete.
      <a href="https://github.com/SolyaUk/sonda-network" target="_blank" rel="noopener" class="dev-link">View on GitHub</a>
    </div>
  </div>

  <main class="page-main">
    <a href="/" class="back-link" id="back-link">← Back to overview</a>

    <section class="page-hero">
      <h1 class="page-title">Validators</h1>
    </section>

    <!-- One-line cluster summary (replaced the 4 KPI tiles on 2026-09-10, F-A.1). -->
    <div class="vsummary-line" id="vsummary-line">Loading cluster summary…</div>

    <!-- Breakdown: aggregate cards in the homepage Insights language (story card, stacked
         stake bar, legend rows). Card set comes from VALIDATOR_CARDS in the script below and
         depends on the cluster. Hidden until data arrives; rolled out cluster by cluster
         (AGG_CARDS_CLUSTERS). Rows carry data-fkey/data-fval for the phase 2 filters. -->
    <section class="vagg" id="vagg" hidden>
      <div class="vagg-head">
        <button class="vagg-toggle" id="vagg-toggle" type="button" aria-expanded="true" aria-controls="vagg-grid">
          <span class="vagg-title">Breakdown</span>
          <span class="vagg-hint">click an entry to filter the table, click again to remove; filters combine</span>
        </button>
        <button class="filter-clear vagg-clear" id="filter-clear-top" type="button" style="display:none">Clear all filters &times;</button>
        <button class="vagg-toggle-pill" id="vagg-toggle-pill" type="button" aria-expanded="true" aria-controls="vagg-grid"><span class="vagg-toggle-txt">Hide</span><svg class="vagg-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg></button>
      </div>
      <div id="vagg-grid" class="vagg-body">
        <div class="vagg-block" data-group="software">
          <button class="vagg-block-title" type="button" aria-expanded="true"><svg class="vagg-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>Validator software</button>
          <div class="vagg-grid vagg-grid-software" id="vagg-group-software"></div>
        </div>
        <div class="vagg-block" data-group="decentralization">
          <button class="vagg-block-title" type="button" aria-expanded="true"><svg class="vagg-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>Validator decentralization</button>
          <div class="vagg-grid vagg-grid-3" id="vagg-group-decentralization"></div>
        </div>
      </div>
    </section>

    <!-- Filter bar -->
    <section class="filters-bar">
      <div class="filter-search-wrap">
        <span class="search-wrap"><input type="search" class="filter-search" id="filter-search" placeholder="Search name, identity or vote account…" /><button type="button" class="search-clear" data-for="filter-search" aria-label="Clear search" hidden>&times;</button></span>
      </div>
      <div class="filter-chips" id="active-filters"></div>
      <button class="filter-clear" id="filter-clear" style="display:none">Clear all filters &times;</button>
    </section>

    <!-- Active filter / sort indicator -->
    <div class="result-line">
      <span id="result-count">Loading…</span>
      <div class="sort-controls">
        <select id="sort-select" class="sort-select" hidden aria-hidden="true">
          <option value="rank-asc" selected>TVC rank, best first</option>
        </select>
        <div id="sort-menu"></div>
      </div>
    </div>

    <!-- Desktop table -->
    <div class="vtable-wrap" id="vtable-wrap">
      <table class="vtable" id="vtable"><tbody id="vtable-body"></tbody></table>
    </div>

    <!-- Mobile cards (collapsed by default) -->
    <div class="vcards-wrap" id="vcards-wrap"></div>

    <div class="load-more-wrap">
      <button class="load-more" id="load-more" style="display:none">Load more</button>
    </div>

    <p class="page-footnote">
      Recent changes (delinquency events, IP moves, version updates) and a synthetic centralization score
      are coming soon, derived from the backend timeseries.
    </p>
  </main>
  <Footer />
</BaseLayout>

<style is:global>
  .page-main {
    max-width: 1380px;
    margin: 0 auto;
    padding: 1rem 1.5rem 4rem;
  }
  .back-link {
    color: var(--text-muted);
    font-size: 0.85rem;
    text-decoration: none;
    display: inline-block;
    margin-bottom: 0.8rem;
  }
  .back-link:hover { color: var(--cluster-accent); }
  .dev-banner { background: rgba(59,130,246,0.08); border-bottom: 1px solid rgba(59,130,246,0.2); font-size: 0.78rem; color: var(--text-secondary); }
  .dev-banner-inner { max-width: 1280px; margin: 0 auto; padding: 0.5rem 1.5rem; display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
  .dev-badge { font-family: var(--font-mono); font-size: 0.65rem; font-weight: 600; background: var(--accent-blue); color: #fff; padding: 0.15rem 0.45rem; border-radius: 4px; letter-spacing: 0.08em; flex-shrink: 0; }
  .dev-link { color: var(--accent-blue); text-decoration: none; margin-left: auto; }
  .page-hero { margin-bottom: 1.5rem; }
  .page-title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--text-primary);
    margin: 0.5rem 0 0.4rem;
  }
  .page-sub {
    color: var(--text-secondary);
    font-size: 0.95rem;
    max-width: 760px;
    line-height: 1.5;
    margin: 0;
  }

  /* One-line cluster summary (same pattern as the stat rows on homepage cards) */
  .vsummary-line {
    margin: 1.25rem 0 1rem;
    font-size: 0.82rem;
    color: var(--text-muted);
    line-height: 1.7;
  }
  .vsummary-line b {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--text-primary);
  }
  .vsummary-line .vsl-sep { margin: 0 0.45rem; opacity: 0.6; }
  .vsummary-line .vsl-warn b { color: var(--status-critical); }

  /* Breakdown section: collapsible grid of story cards */
  /* Breakdown/filter cards: shared kit in src/styles/filter-cards.css */
  #vagg-group-software.vagg-grid-software.has-4 { grid-template-columns: 1.3fr 1.3fr 1fr 1fr; }
  @media (max-width: 1300px) { #vagg-group-software.vagg-grid-software.has-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { #vagg-group-software.vagg-grid-software.has-4 { grid-template-columns: 1fr; } }
  .filters-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.8rem;
    flex-wrap: wrap;
  }
  .filter-search-wrap { flex: 1; min-width: 200px; }
  .filter-search {
    width: 100%;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.55rem 0.85rem;
    color: var(--text-primary);
    font-size: 0.9rem;
    font-family: inherit;
  }
  .filter-search:focus { outline: none; border-color: var(--cluster-accent); }
  .filter-chips { display: flex; gap: 0.45rem; flex-wrap: wrap; }
  .filter-chip {
    background: var(--bg-card-hover);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 0.3rem 0.65rem;
    font-size: 0.75rem;
    color: var(--text-secondary);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .filter-chip .chip-x {
    cursor: pointer;
    color: var(--text-muted);
    font-size: 0.9em;
    line-height: 1;
  }
  .filter-chip .chip-x:hover { color: var(--status-critical); }
  .filter-clear {
    background: color-mix(in srgb, var(--cluster-accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--cluster-accent) 55%, transparent);
    color: var(--text-primary);
    border-radius: 999px;
    padding: 0.4rem 0.85rem;
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
  }
  .filter-clear:hover { background: color-mix(in srgb, var(--cluster-accent) 22%, transparent); }

  .result-line {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--text-muted);
    font-size: 0.8rem;
    margin-bottom: 0.8rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .sort-controls { display: flex; align-items: center; gap: 0.5rem; }
  .sort-label { font-size: 0.78rem; }
  .sort-select {
    background: var(--bg-card);
    border: 1px solid var(--border);
    color: var(--text-primary);
    border-radius: 6px;
    padding: 0.3rem 0.5rem;
    font-size: 0.78rem;
    font-family: inherit;
  }

  /* Table */
  /* Table and mobile cards: shared kit in src/styles/vtable.css (validator-table.js) */
  @media (max-width: 900px) {
    .page-main { padding: 0.85rem 1rem 3rem; }
    .filters-bar { gap: 0.5rem; }
  }
  .load-more-wrap { text-align: center; margin-top: 1.2rem; }
  .load-more {
    background: var(--bg-card);
    border: 1px solid var(--border);
    color: var(--text-primary);
    padding: 0.6rem 1.5rem;
    border-radius: 8px;
    font-size: 0.9rem;
    cursor: pointer;
    font-family: inherit;
  }
  .load-more:hover { background: var(--bg-card-hover); border-color: var(--cluster-accent); }

  .page-footnote {
    color: var(--text-muted);
    font-size: 0.78rem;
    text-align: center;
    margin-top: 2rem;
    font-style: italic;
  }

  /* Mobile cards */
</style>

<script>
import {
  bootstrapCluster, getCluster, fetchValidators, fetchSummary,
  filterValidators, sortValidators, computeTvcRanks, aggregateByProvider, providerOf,
  providerLogoUrl, providerTagsText,
  isValidatorRecord, isInGossip, clientLabel,
  fmtStakeShort, concentrationLevel,
} from '../lib/data.js';
import { fmt, pct, shortenIdentity, fmtSol, clientColor, versionColor, displayClient, fmtCompact, bamRegionCode } from '../lib/formatters.js';
import { renderDonut } from '../lib/charts.js';
import { copyButtonHtml, listValueState, nextListValues, initLongPress, NOT_BUTTON } from '../lib/ui.js';
import { renderRow, renderCard, tableHeadHtml, markSortedHeader, initHeaderSort, computeStakeTiers, tableAvailability, applyAvailability, circleFlagSvg, pinFlagSvg, computePerfBands } from '../lib/validator-table.js';
import { initSortMenu } from '../lib/sort-menu.js';
import { startAutoRefresh, signatureMap, changedIdentities, preserveScroll } from '../lib/refresh.js';

const NO_GOSSIP_TIP = 'Vote account has stake but the node is not visible in gossip: no IP, version or client data this cycle';

const PAGE_SIZE = 50;
let allRecords = [];
let filtered = [];
let renderedCount = 0;
let latestSummary = null;
let lastSnapshotTs = null;   // meta.timestamp of the rendered validators.json

const params = new URLSearchParams(window.location.search);

function setUrlParam(key, value) {
  const url = new URL(window.location.href);
  if (value == null || value === '') url.searchParams.delete(key);
  else url.searchParams.set(key, value);
  window.history.replaceState(null, '', url.toString());
}

const FILTER_LABELS = {
  country: 'Country', city: 'City', provider: 'Provider', asn: 'ASN', client: 'Client', version: 'Version',
  dz: 'DZ', bam: 'BAM', rakurai: 'Rakurai',
  sfdp: 'SFDP', delinquent: 'Delinquent', superminority: 'Superminority', gossip: 'Gossip',
};
const LIST_FILTERS = ['country', 'city', 'provider', 'asn', 'client', 'version', 'sfdp'];

function listParam(key) {
  return (params.get(key) || '').split(',').map(v => v.trim()).filter(Boolean);
}

// One chip per value so a single value of a multi-select can be removed alone.
function getActiveFilterChips() {
  const chips = [];
  for (const [key, label] of Object.entries(FILTER_LABELS)) {
    if (LIST_FILTERS.includes(key)) {
      listParam(key).forEach(v => chips.push({ key, label, value: v }));
    } else {
      const v = params.get(key);
      if (v) chips.push({ key, label, value: v });
    }
  }
  return chips;
}

// Toggle one value inside a list filter (country=NL,DE); other keys combine as AND.
// mode: 'include' (row click) or 'exclude' (the "not" button, long press on touch)
function toggleFilterValue(key, value, mode = 'include') {
  if (LIST_FILTERS.includes(key)) {
    const next = nextListValues(listParam(key), value, mode);
    if (next.length > 0) params.set(key, next.join(',')); else params.delete(key);
    setUrlParam(key, next.join(','));
  } else if (mode === 'exclude') {
    const want = `!${value}`;
    if (params.get(key) === want) { params.delete(key); setUrlParam(key, null); }
    else { params.set(key, want); setUrlParam(key, want); }
  } else {
    if (params.get(key) === value) { params.delete(key); setUrlParam(key, null); }
    else { params.set(key, value); setUrlParam(key, value); }
  }
  applyAndRender();
}

function removeFilterValue(key, value) {
  if (LIST_FILTERS.includes(key)) {
    const next = listParam(key).filter(v => v !== value && v !== `!${value}`);
    if (next.length > 0) params.set(key, next.join(',')); else params.delete(key);
    setUrlParam(key, next.join(','));
  } else {
    params.delete(key);
    setUrlParam(key, null);
  }
  applyAndRender();
}

// Human text for a chip: boolean-ish filters read as one word, list filters as key: value.
function chipText(key, value) {
  if (key === 'gossip') return value === 'no' ? 'Not in gossip' : 'In gossip';
  if (key === 'delinquent') return value === 'true' ? 'Delinquent' : 'Not delinquent';
  if (key === 'superminority') return 'Superminority';
  if (key === 'sfdp') return `SFDP ${value.replace(/([a-z])([A-Z])/g, '$1 $2').toLowerCase()}`;
  if (key === 'bam') return value === 'false' ? 'Not on BAM' : 'Jito BAM';
  if (key === 'rakurai') return 'Rakurai';
  if (key === 'dz') return value === 'no' ? 'Not on DoubleZero' : value === 'multicast' ? 'Multicast publisher' : value === 'unicast' ? 'DZ without multicast' : 'DZ connected';
  return `${FILTER_LABELS[key] || key}: ${value}`;
}

function isFilterActive(key, value) {
  return LIST_FILTERS.includes(key) ? listParam(key).includes(value) : params.get(key) === value;
}
function filterState(key, value) {
  if (LIST_FILTERS.includes(key)) return listValueState(listParam(key), value);
  const cur = params.get(key);
  return cur === value ? 'include' : cur === `!${value}` ? 'exclude' : null;
}

function clearAllFilters() {
  Object.keys(FILTER_LABELS).forEach(k => { params.delete(k); setUrlParam(k, null); });
  applyAndRender();
}

function renderFilterChips() {
  const wrap = document.getElementById('active-filters');
  const chips = getActiveFilterChips();
  wrap.innerHTML = chips.map(c => {
    const not = c.value.startsWith('!');
    const raw = not ? c.value.slice(1) : c.value;
    return `<span class="filter-chip${not ? ' is-not' : ''}">${not ? '<span class="chip-not">not</span>' : ''}${escapeAttr(chipText(c.key, raw))}<span class="chip-x" data-key="${c.key}" data-value="${escapeAttr(raw)}">&times;</span></span>`;
  }).join('');
  ['filter-clear', 'filter-clear-top'].forEach(id => {
    const b = document.getElementById(id);
    if (b) b.style.display = chips.length > 0 ? 'inline-block' : 'none';
  });
  wrap.querySelectorAll('.chip-x').forEach(x => {
    x.addEventListener('click', e => removeFilterValue(e.target.dataset.key, e.target.dataset.value));
  });
}

function shortAsnName(name) {
  if (!name) return '';
  if (name.length <= 22) return name;
  return name.substring(0, 20) + '…';
}

// Row and card renderers live in src/lib/validator-table.js (shared with /datacenter).
let stakeTiers = null;
let tableAvail = null;
let perfBands = null;
let sortMenu = null;
function rowCtx(pos) {
  return { cluster: getCluster(), pos, tiers: stakeTiers, summary: latestSummary, avail: tableAvail, bands: perfBands };
}
function renderTableRow(r, pos) { return renderRow(r, rowCtx(pos)); }
function renderMobileCard(r, pos) { return renderCard(r, rowCtx(pos)); }

function applyAndRender(opts = {}) {
  const sortVal = document.getElementById('sort-select').value;
  const [sortKey, sortDir] = sortVal.split('-');
  markSortedHeader(document.getElementById('vtable'), sortKey, sortDir);
  filtered = sortValidators(filterValidators(allRecords, params), sortKey, sortDir);
  const keep = opts.keepCount ? Math.max(PAGE_SIZE, renderedCount) : PAGE_SIZE;
  renderedCount = 0;
  document.getElementById('vtable-body').innerHTML = '';
  document.getElementById('vcards-wrap').innerHTML = '';
  renderNext(keep);
  document.getElementById('result-count').textContent =
    `${filtered.length} validator${filtered.length === 1 ? '' : 's'}`;
  renderFilterChips();
  renderAggCards(allRecords, filtered, getCluster(), latestSummary);
}

function renderNext(count = PAGE_SIZE) {
  const end = Math.min(renderedCount + count, filtered.length);
  const slice = filtered.slice(renderedCount, end);

  const tbody = document.getElementById('vtable-body');
  tbody.insertAdjacentHTML('beforeend', slice.map((r, i) => renderTableRow(r, renderedCount + i + 1)).join(''));

  const cwrap = document.getElementById('vcards-wrap');
  cwrap.insertAdjacentHTML('beforeend', slice.map((r, i) => renderMobileCard(r, renderedCount + i + 1)).join(''));

  renderedCount = end;
  const loadMore = document.getElementById('load-more');
  loadMore.style.display = renderedCount < filtered.length ? 'inline-block' : 'none';

  // Wire up new row clicks (desktop)
  tbody.querySelectorAll('tr').forEach(tr => {
    if (tr.dataset.wired) return;
    tr.dataset.wired = '1';
    tr.addEventListener('click', (e) => {
      if (e.target instanceof Element && e.target.closest('[data-copy]')) return;
      window.location.href = tr.dataset.href;
    });
  });
  // Wire up mobile card head toggle
  // New cards (validator-table.js) have no collapsed body: a tap anywhere except the
  // copy buttons and the go button opens the validator page.
  cwrap.querySelectorAll('.vcard').forEach(card => {
    if (card.dataset.wired) return;
    card.dataset.wired = '1';
    card.addEventListener('click', e => {
      if (e.target instanceof Element && e.target.closest('.vcard-go, [data-copy], [data-tip-ellipsis]')) return;
      const go = card.querySelector('.vcard-go');
      if (go) window.location.href = go.getAttribute('href');
    });
  });
}

// ----- Version status (F-18) -----
// Backend rates versions inside each client family: current / outdated / ancient / null.
function versionStatusInfo(status) {
  if (status === 'outdated') return { key: 'outdated', tip: 'Outdated: a newer release of this client family is current' };
  if (status === 'ancient') return { key: 'ancient', tip: 'Ancient: two or more releases behind the current one for this client' };
  return null;
}

// ----- One-line cluster summary -----
function renderSummaryLine(records) {
  const el = document.getElementById('vsummary-line');
  if (!el) return;
  const total = records.length;
  const active = records.filter(r => !r.delinquent).length;
  const delinq = total - active;
  const noGossip = records.filter(r => !isInGossip(r)).length;
  const totalStake = records.reduce((s, r) => s + (r.activated_stake_lamports || 0), 0);
  const countries = new Set(records.map(r => r.geolocation?.country_code).filter(c => c && c !== '??')).size;
  const cities = new Set(records.map(r => r.geolocation?.city).filter(c => c && c !== 'Unknown')).size;
  const asns = new Set(records.map(r => providerOf(r)).filter(Boolean)).size;
  const parts = [
    `<b>${fmt(total)}</b> validators`,
    `<b>${fmt(active)}</b> voting`,
    `<span class="${delinq > 0 ? 'vsl-warn' : ''}"><b>${fmt(delinq)}</b> delinquent</span>`,
  ];
  if (noGossip > 0) parts.push(`<span data-tip="${NO_GOSSIP_TIP}"><b>${fmt(noGossip)}</b> not in gossip</span>`);
  parts.push(`<b>${fmtStakeShort(totalStake)}</b> SOL`, `<b>${fmt(countries)}</b> countries`, `<b>${fmt(cities)}</b> cities`, `<b>${fmt(asns)}</b> providers`);
  el.innerHTML = parts.join('<span class="vsl-sep">·</span>');
}

// ----- Breakdown cards (F-A.1 + F-A.2) -----
// Registry: each card groups the validator universe (all vote accounts, same as the table)
// into segments {key, label, count, delinquent, stake, marker, special, status} via build(). Cards are
// rendered only for clusters in AGG_CARDS_CLUSTERS (rollout gate) and only when the card's
// `clusters` allows it ('*' = every cluster). Groups: 'software' (stacked bars, homepage
// Software-card layout) and 'decentralization' (big donuts). Every entry is a click filter:
// its key/value toggles a URL param (country=NL,DE), the table and the other cards
// re-aggregate on the filtered set, entries with nothing left are dimmed.
const AGG_CARDS_CLUSTERS = ['mainnet-beta', 'testnet', 'devnet', 'alpenglow-community'];
const AGG_ROWS_VISIBLE = 6;
const SEQ_PALETTE = ['#a78bfa', '#22d3ee', '#4ade80', '#fbbf24', '#f472b6', '#60a5fa', '#fb923c', '#2dd4bf', '#e879f9', '#facc15', '#38bdf8', '#a3e635'];
const NOT_IN_GOSSIP_KEY = '__nogossip';
const UNRESOLVED_KEY = '__unresolved';

// Cards the user expanded with "Show all": a filter click re-renders every card, and the
// expansion must survive that.
const expandedCards = new Set();

const CARD_GROUPS = [
  { id: 'software', title: 'Validator software' },
  { id: 'decentralization', title: 'Validator decentralization' },
];

function seqColor(i) { return SEQ_PALETTE[i % SEQ_PALETTE.length]; }

function escapeAttr(v) {
  return String(v ?? '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
}

// Generic grouping: keyFn(record) -> key or null (null = skipped); decorate(key) adds
// label/marker/special. Special keys are listed last regardless of stake.
function groupRecords(records, keyFn, decorate) {
  const map = new Map();
  for (const r of records) {
    const key = keyFn(r);
    if (key == null) continue;
    if (!map.has(key)) map.set(key, { key, count: 0, delinquent: 0, stake: 0 });
    const g = map.get(key);
    g.count++;
    if (r.delinquent) g.delinquent++;
    g.stake += r.activated_stake_lamports || 0;
  }
  return [...map.values()].map(g => Object.assign(g, decorate(g.key, g)));
}

const specialRow = (label, filter) => ({ label, special: true, marker: { type: 'muted' }, filter: filter || null });
const NOT_IN_GOSSIP_ROW = () => specialRow('Not in gossip', { key: 'gossip', val: 'no' });

const VALIDATOR_CARDS = [
  {
    id: 'clients', group: 'software', tag: 'Clients', title: 'Validator clients', clusters: '*',
    fkey: 'client', view: 'stacked', stat: 'share',
    build(records) {
      return groupRecords(records,
        r => (isInGossip(r) ? (clientLabel(r) || 'Unknown') : NOT_IN_GOSSIP_KEY),
        key => key === NOT_IN_GOSSIP_KEY ? NOT_IN_GOSSIP_ROW() : { label: key, marker: { type: 'dot', color: clientColor(key) } });
    },
  },
  {
    id: 'versions', group: 'software', tag: 'Versions', title: 'Client versions', clusters: '*',
    fkey: 'version', view: 'stacked', stat: 'stake',
    build(records) {
      const status = new Map();
      records.forEach(r => { if (r.version && r.version !== 'unknown' && r.version_status) status.set(r.version, r.version_status); });
      return groupRecords(records,
        r => (isInGossip(r) && r.version && r.version !== 'unknown' ? r.version : NOT_IN_GOSSIP_KEY),
        key => key === NOT_IN_GOSSIP_KEY ? NOT_IN_GOSSIP_ROW() : { label: key, marker: { type: 'dot', color: versionColor(key) }, status: versionStatusInfo(status.get(key)) });
    },
  },
  {
    // Status flags as click filters for the boolean keys. SFDP row appears only where the
    // cluster carries sfdp_state (mainnet; testnet once the backend links it).
    id: 'status', group: 'software', tag: 'Status', title: 'Validator status', clusters: '*',
    fkey: null, view: 'status',
    build(records) {
      const has = (fn) => records.some(fn);
      const rows = [
        { key: 'superminority', label: 'Superminority', filter: { key: 'superminority', val: 'true' }, fill: 'warn', count: records.filter(r => r.is_superminority).length },
        { key: 'delinquent', label: 'Delinquent', filter: { key: 'delinquent', val: 'true' }, fill: 'crit', count: records.filter(r => r.delinquent).length },
        { key: 'gossip', label: 'Not in gossip', filter: { key: 'gossip', val: 'no' }, fill: 'neutral', count: records.filter(r => !isInGossip(r)).length },
      ];
      // Every SFDP state that exists in the cluster is a filter (Approved first); only
      // Approved gets a badge in the table, the other states are too subjective to mark.
      if (has(r => r.sfdp_state)) {
        const states = ['Approved', 'TestnetOnboarded', 'Retired', 'Rejected'].concat([...new Set(records.map(r => r.sfdp_state).filter(Boolean))].filter(s => !['Approved', 'TestnetOnboarded', 'Retired', 'Rejected'].includes(s)));
        const labels = { Approved: 'SFDP approved', TestnetOnboarded: 'SFDP testnet onboarded', Retired: 'SFDP retired', Rejected: 'SFDP rejected' };
        const sfdpRows = states.filter(s => records.some(r => r.sfdp_state === s)).map(s => ({ key: `sfdp-${s}`, label: labels[s] || `SFDP ${s}`, filter: { key: 'sfdp', val: s }, fill: s === 'Approved' ? 'cluster' : 'neutral', count: records.filter(r => r.sfdp_state === s).length }));
        rows.unshift(...sfdpRows);
      }
      return rows.map(r => Object.assign(r, { delinquent: 0, stake: 0, special: true }));
    },
  },
  {
    // Connections: what the validators plug into. Only where the cluster has such data.
    id: 'connections', group: 'software', tag: 'Connections', title: 'Validator connections', clusters: '*',
    fkey: null, view: 'status',
    build(records) {
      const has = (fn) => records.some(fn);
      const rows = [];
      if (has(r => r.dz_connected)) {
        rows.push({ key: 'dz', label: 'DoubleZero', filter: { key: 'dz', val: 'connected' }, fill: 'cluster', count: records.filter(r => r.dz_connected).length });
        rows.push({ key: 'mc', label: 'Multicast publishers', filter: { key: 'dz', val: 'multicast' }, fill: 'cluster', count: records.filter(r => r.dz_multicast_publisher).length });
        rows.push({ key: 'uni', label: 'DZ without multicast', filter: { key: 'dz', val: 'unicast' }, fill: 'neutral', count: records.filter(r => r.dz_connected && !r.dz_multicast_publisher).length });
      }
      if (has(r => r.bam_node)) rows.push({ key: 'bam', label: 'Jito BAM', filter: { key: 'bam', val: 'true' }, fill: 'cluster', count: records.filter(r => !!r.bam_node).length });
      // "not on DZ / BAM" is the exclude of the row above, no separate rows
      return rows.map(r => Object.assign(r, { delinquent: 0, stake: 0, special: true }));
    },
  },
  {
    id: 'countries', group: 'decentralization', tag: 'Countries', title: 'Validators by country', clusters: '*',
    fkey: 'country', view: 'donut',
    build(records) {
      const names = new Map();
      records.forEach(r => { const g = r.geolocation; if (g?.country_code && g.country) names.set(g.country_code, g.country); });
      return groupRecords(records,
        r => (!r.geolocation ? NOT_IN_GOSSIP_KEY : (r.geolocation.country_code && r.geolocation.country_code !== '??' ? r.geolocation.country_code : UNRESOLVED_KEY)),
        key => key === NOT_IN_GOSSIP_KEY ? NOT_IN_GOSSIP_ROW()
          : key === UNRESOLVED_KEY ? specialRow('Unresolved location')
          : { label: names.get(key) || key, marker: { type: 'flag', cc: key } });
    },
  },
  {
    id: 'cities', group: 'decentralization', tag: 'Cities', title: 'Validators by city', clusters: '*',
    fkey: 'city', view: 'donut',
    build(records) {
      const cc = new Map();
      records.forEach(r => { const g = r.geolocation; if (g?.city && g.city !== 'Unknown' && g.country_code) cc.set(g.city, g.country_code); });
      return groupRecords(records,
        r => (!r.geolocation ? NOT_IN_GOSSIP_KEY : (r.geolocation.city && r.geolocation.city !== 'Unknown' ? r.geolocation.city : UNRESOLVED_KEY)),
        key => key === NOT_IN_GOSSIP_KEY ? NOT_IN_GOSSIP_ROW()
          : key === UNRESOLVED_KEY ? specialRow('Unresolved city')
          : { label: key, marker: { type: 'pin', cc: cc.get(key) || '' }, tip: cc.get(key) ? `${key}, ${cc.get(key)}` : key });
    },
  },
  {
    // Provider level (R11.2): the company the node is rented from, which may run several
    // ASNs (Cherry Servers: 7). The ASN list shows under each provider when the card is
    // expanded; the logo comes from the provider's most common ASN.
    id: 'providers', group: 'decentralization', tag: 'Providers', title: 'Validators by network provider', clusters: '*',
    fkey: 'provider', view: 'donut',
    build(records, ctx) {
      const asnNames = ctx?.summary?.metrics?.asn_names || {};
      const nameOf = (a) => asnNames[a.asn] || a.name || a.asn;
      const segs = aggregateByProvider(records).map(e => e.provider === 'unknown'
        ? Object.assign({ key: NOT_IN_GOSSIP_KEY, count: e.count, delinquent: e.delinquent, stake: e.stake_lamports }, NOT_IN_GOSSIP_ROW())
        : {
            key: e.provider, label: e.provider, count: e.count, delinquent: e.delinquent, stake: e.stake_lamports,
            // ASN details and provider tags (v3.12 metrics.providers) live in the tooltip only
            tip: [
              e.asns.length > 1
                ? `${e.provider}: ${e.asns.length} networks\n${e.asns.map(a => `${a.asn}${nameOf(a) !== e.provider ? ` ${nameOf(a)}` : ''} · ${a.count}`).join('\n')}`
                : (e.asns[0] ? `${e.provider} (${e.asns[0].asn}${nameOf(e.asns[0]) !== e.provider ? ` ${nameOf(e.asns[0])}` : ''})` : e.provider),
              ...providerTagsText(ctx?.summary, e.provider),
            ].join('\n'),
            marker: { type: 'logo', src: providerLogoUrl(ctx?.summary, e.provider, e.primary_asn), initial: (e.provider || '?').charAt(0).toUpperCase() },
          });
      return segs.filter(x => !x.special).concat(segs.filter(x => x.special));
    },
  },
];

function markerHtml(m, label = '') {
  if (!m) return '<span></span>';
  if (m.type === 'dot') return `<span class="vagg-dot" style="background:${m.color}"></span>`;
  // flags carry the name in a tooltip: on narrow cards the label next to them may be clipped
  if (m.type === 'flag') return circleFlagSvg(m.cc.toLowerCase(), { tip: label || m.cc.toUpperCase() });
  if (m.type === 'pin') return m.cc ? pinFlagSvg(m.cc.toLowerCase(), { extraClass: 'is-marker', tip: label ? `${label}, ${m.cc.toUpperCase()}` : m.cc.toUpperCase() }) : '<span class="vpin-none">?</span>';
  if (m.type === 'logo') return `<span class="dc-logo" data-initial="${escapeAttr(m.initial)}">${m.src ? `<img src="${m.src}" alt="" loading="lazy" onerror="this.remove()">` : ''}</span>`;
  return '<span class="vagg-marker-muted"></span>';
}

function segmentColor(seg, i) {
  if (seg.special) return 'var(--text-muted)';
  if (seg.marker?.type === 'dot') return seg.marker.color;
  return seqColor(i);
}

// Merge full-universe entries (labels, markers, order of existence) with counts from the
// filtered set. Entries absent from the filtered set keep zero counts and get dimmed.
// Order is the universe order (stake, then count over ALL validators), so a card never
// reshuffles when the reader clicks its rows; counts come from the facet set (below).
function mergeSegments(all, filteredSegs, byCurrent = false) {
  const f = new Map(filteredSegs.map(x => [x.key, x]));
  const merged = all.map(seg => {
    const m = f.get(seg.key);
    return Object.assign({}, seg, { count: m ? m.count : 0, delinquent: m ? m.delinquent : 0, stake: m ? m.stake : 0, all_stake: seg.stake, all_count: seg.count });
  });
  if (byCurrent) {
    // donut cards (countries, cities, providers): the rows that match the other filters
    // rise to the top, selected ones first, so a chosen country's cities are visible
    // without "Show all" (Viktor, 2026-09-27)
    const rank = (seg) => { const st = seg.filterKey ? filterState(seg.filterKey, seg.filterVal) : null; return st === 'include' ? 2 : st === 'exclude' ? 1 : 0; };
    merged.sort((a, b) => (a.special === b.special ? (rank(b) - rank(a) || b.stake - a.stake || b.count - a.count || b.all_stake - a.all_stake) : (a.special ? 1 : -1)));
  } else {
    merged.sort((a, b) => (a.special === b.special ? (b.all_stake - a.all_stake || b.all_count - a.all_count) : (a.special ? 1 : -1)));
  }
  return merged;
}

function delinqHtml(seg, withTip = true) {
  if (!(seg.delinquent > 0)) return '';
  return `<span class="vagg-delinq"${withTip ? ` data-tip="${seg.delinquent} of ${seg.count} delinquent"` : ''}>${seg.delinquent}</span>`;
}

// Filter pair for an entry: the card key by default, an explicit pair for special rows
// (Not in gossip -> gossip=no); null means the entry is not clickable.
function entryFilter(card, seg) {
  if (seg.special) return seg.filter || null;
  return { key: card.fkey, val: String(seg.key) };
}
function fattr(card, seg) {
  const f = entryFilter(card, seg);
  return f ? ` data-fkey="${f.key}" data-fval="${escapeAttr(f.val)}"` : '';
}
function rowClasses(card, seg) {
  const cls = [];
  const f = entryFilter(card, seg);
  const st = f ? filterState(f.key, f.val) : null;
  if (st === 'include') cls.push('is-selected');
  if (st === 'exclude') cls.push('is-excluded');
  else if (seg.count === 0) cls.push('is-dim');
  if (seg.special) cls.push('is-special');
  return cls.join(' ');
}

const SOFT_ROWS_VISIBLE = 8;

// Software cards (clients, versions): stacked bar and legend are stake-weighted, so one
// large validator on its own build counts as much as its stake says. Legend shows
// count|delinquent and the stake share; the top 8 entries plus an "Other" row are
// visible, "Show all" reveals the rest in a scrolling legend.
function renderSoftwareCard(card, segs, totals) {
  const { total, totalStake } = totals;
  const stakePct = seg => (totalStake > 0 ? (seg.stake / totalStake) * 100 : 0);
  const sharePct = seg => (total > 0 ? (seg.count / total) * 100 : 0);
  const live = segs.filter(x => !x.special);
  const specials = segs.filter(x => x.special);
  const top = live.slice(0, SOFT_ROWS_VISIBLE);
  const rest = live.slice(SOFT_ROWS_VISIBLE);
  const restAgg = { key: '__other', label: `Other (${rest.length})`, count: rest.reduce((a, x) => a + x.count, 0), delinquent: rest.reduce((a, x) => a + x.delinquent, 0), stake: rest.reduce((a, x) => a + x.stake, 0) };

  const segTip = (seg) => `${seg.label}: ${seg.count} validators (${sharePct(seg).toFixed(1)}%), ${stakePct(seg).toFixed(1)}% of stake`;
  const segHtml = (seg, color) => {
    const w = stakePct(seg);
    return w > 0 ? `<div class="stacked-segment" data-tip="${escapeAttr(segTip(seg))}" style="width:${w}%; background:${color};">${w >= 8 ? `${w.toFixed(0)}%` : ''}</div>` : '';
  };
  const barHtml = top.map((seg, i) => segHtml(seg, segmentColor(seg, i))).join('')
    + (rest.length ? segHtml(restAgg, '#4b4f63') : '')
    + specials.map(seg => segHtml(seg, 'var(--text-muted)')).join('');

  // Legend rows show the count only (stake share lives in the bar and the tooltip), which
  // keeps mainnet's 14+ versions readable. One tooltip per row carries everything.
  const rowTip = (seg) => `${seg.label}: ${seg.count} validators (${sharePct(seg).toFixed(1)}%)${seg.delinquent ? `, ${seg.delinquent} delinquent` : ''}, ${stakePct(seg).toFixed(1)}% of stake${seg.status ? `\n${seg.status.tip}` : ''}`;
  const item = (seg, i, extraCls, clickable) => {
    const status = seg.status ? ` ver-${seg.status.key}` : '';
    const fa = clickable ? fattr(card, seg) : '';
    const cls = clickable ? rowClasses(card, seg) : (seg.special ? 'is-special' : '');
    return `<span class="stacked-legend-item ${cls}${extraCls}"${fa} data-tip="${escapeAttr(rowTip(seg))}">
      <span class="stacked-legend-dot" style="background:${i == null ? 'var(--text-muted)' : segmentColor(seg, i)};"></span>
      <span class="stacked-legend-name${status}">${escapeAttr(seg.label)}</span>
      <span class="legend-leader"></span>
      <span class="stacked-legend-stat">${fmt(seg.count)}${delinqHtml(seg, false)}</span>${clickable && card.fkey && LIST_FILTERS.includes(card.fkey) ? NOT_BUTTON : ''}
    </span>`;
  };
  const legend = top.map((seg, i) => item(seg, i, '', true)).join('')
    + rest.map((seg, i) => item(seg, SOFT_ROWS_VISIBLE + i, ' is-extra', true)).join('')
    + (rest.length ? `<span class="stacked-legend-item is-special vagg-other" data-more="1" data-tip="${escapeAttr(rowTip(restAgg))}. Click to show all"><span class="stacked-legend-dot" style="background:#4b4f63;"></span><span class="stacked-legend-name">${restAgg.label}</span><span class="legend-leader"></span><span class="stacked-legend-stat">${fmt(restAgg.count)}${delinqHtml(restAgg, false)}</span></span>` : '')
    + specials.map(seg => item(seg, null, '', true)).join('');
  const more = rest.length ? `<button class="vagg-more" type="button" data-more="${live.length}">Show all ${live.length}</button>` : '';

  return `<div class="story vagg-card vagg-view-stacked" data-card="${card.id}">
    <div class="story-header">
      <span class="story-tag cluster-tag">${card.tag}</span>
      <span class="vagg-meta">${fmt(segs.length)} ${segs.length === 1 ? 'entry' : 'entries'} · by stake</span>
    </div>
    <div class="story-title">${card.title}</div>
    <div class="stacked-bar"><div class="stacked-bar-inner">${barHtml || '<div class="stacked-segment" style="width:100%;background:var(--bg-card-hover)"></div>'}</div></div>
    <div class="stacked-legend">${legend}</div>
    <div class="vagg-foot">${more}</div>
  </div>`;
}

function renderDonutCard(card, segs, totals) {
  const { total, totalStake } = totals;
  const stakePct = seg => (totalStake > 0 ? (seg.stake / totalStake) * 100 : 0);
  const live = segs.filter(x => !x.special && x.count > 0);
  const top = live.slice(0, AGG_ROWS_VISIBLE);
  const rest = live.slice(AGG_ROWS_VISIBLE);
  const restStake = rest.reduce((a, x) => a + x.stake, 0);
  const restCount = rest.reduce((a, x) => a + x.count, 0);
  const items = top.map((seg, i) => ({ label: seg.label, value: seg.stake, color: segmentColor(seg, i), title: `${seg.label}: ${seg.count} validators, ${stakePct(seg).toFixed(1)}% stake` }));
  if (restStake > 0) items.push({ label: 'Other', value: restStake, color: '#4b4f63', title: `Other (${rest.length}): ${restCount} validators, ${((restStake / totalStake) * 100).toFixed(1)}% stake` });
  const donut = items.length > 0 ? renderDonut(items, { size: 150, ringR: 70, innerR: 44 }).svg : '<div class="vagg-empty">no match</div>';
  const colorOf = new Map(top.map((seg, i) => [seg.key, segmentColor(seg, i)]));

  const rowsHtml = segs.map((seg, i) => {
    const name = `<span class="vagg-name"><span${seg.tip ? ` data-tip="${escapeAttr(seg.tip)}"` : ' data-tip-ellipsis'}>${escapeAttr(seg.label)}</span><span class="legend-leader"></span></span>`;
    return `<div class="vagg-row ${rowClasses(card, seg)}${i >= AGG_ROWS_VISIBLE ? ' is-extra' : ''}"${fattr(card, seg)}>
      ${markerHtml(seg.marker, seg.label)}
      ${name}
      <span class="vagg-count">${fmt(seg.count)}${delinqHtml(seg)}</span>
      <span class="vagg-stake"${colorOf.has(seg.key) ? ` style="color:${colorOf.get(seg.key)}"` : ''}>${stakePct(seg).toFixed(1)}%</span>${card.fkey && LIST_FILTERS.includes(card.fkey) ? NOT_BUTTON : ''}
    </div>`;
  }).join('');
  const more = segs.length > AGG_ROWS_VISIBLE ? `<button class="vagg-more" type="button" data-more="${segs.length}">Show all ${segs.length}</button>` : '';
  return `<div class="story vagg-card vagg-view-donut" data-card="${card.id}">
    <div class="story-header">
      <span class="story-tag cluster-tag">${card.tag}</span>
      <span class="vagg-meta">${fmt(segs.length)} ${segs.length === 1 ? 'entry' : 'entries'}</span>
    </div>
    <div class="story-title">${card.title}</div>
    <div class="vagg-donut"><div class="donut-svg">${donut}</div><div class="vagg-rows">${rowsHtml}</div></div>
    <div class="vagg-foot">${more}</div>
  </div>`;
}

function renderStatusCard(card, rowsAll, rowsFiltered, totals, facetCount, facetSize) {
  const f = new Map(rowsFiltered.map(x => [x.key, x]));
  const denomOf = (row) => Math.max(1, facetSize ? facetSize(row) : totals.total);
  // Bars are relative to the largest row, like the DZ/BAM cards on the homepage: the
  // rows compare with each other, the share of all validators is in the tooltip.
  const countOf = (row) => (facetCount ? facetCount(card, row) : (f.get(row.key)?.count ?? 0));
  const maxRow = Math.max(1, ...rowsAll.map(r => countOf(r)));
  const rows = rowsAll.map(row => {
    const cur = countOf(row);
    const active = isFilterActive(row.filter.key, row.filter.val);
    const st = row.filter ? filterState(row.filter.key, row.filter.val) : null;
    const cls = st === 'include' ? 'is-selected' : st === 'exclude' ? 'is-excluded' : (cur === 0 ? 'is-dim' : '');
    const numCls = (row.fill === 'crit' || row.fill === 'cluster') ? row.fill : '';
    return `<div class="bar-row ${cls}" data-fkey="${row.filter.key}" data-fval="${escapeAttr(row.filter.val)}" data-tip="${row.label}: ${cur} of ${fmt(denomOf(row))} validators matching the other filters (${((cur / denomOf(row)) * 100).toFixed(1)}%)">
      <div class="bar-row-label">${row.label}</div>
      <div class="bar-row-track"><div class="bar-row-fill ${row.fill}" style="width:${cur > 0 ? Math.max(3, (cur / maxRow) * 100) : 0}%"></div></div>
      <div class="bar-row-num ${numCls}">${fmt(cur)}</div>${NOT_BUTTON}
    </div>`;
  }).join('');
  return `<div class="story vagg-card vagg-view-status" data-card="${card.id}">
    <div class="story-header">
      <span class="story-tag cluster-tag">${card.tag}</span>
    </div>
    <div class="story-title">${card.title}</div>
    <div class="vagg-status-head"><span class="story-big mono">${fmt(totals.total)}</span><span class="story-sub">validators in view</span></div>
    <div class="bar-rows-wrap with-divider${rowsAll.length > 8 ? ' is-two-col' : ''}">${rows}</div>
  </div>`;
}

function renderAggCards(records, filteredRecords, cluster, summary) {
  const section = document.getElementById('vagg');
  if (!section) return;
  const grids = CARD_GROUPS.map(g => document.getElementById(`vagg-group-${g.id}`));
  if (!AGG_CARDS_CLUSTERS.includes(cluster) || records.length === 0) {
    section.hidden = true;
    grids.forEach(g => { if (g) g.innerHTML = ''; });
    return;
  }
  const ctx = { summary, cluster };
  const totals = { total: filteredRecords.length, totalStake: filteredRecords.reduce((s, r) => s + (r.activated_stake_lamports || 0), 0) };
  const cards = VALIDATOR_CARDS.filter(c => c.clusters === '*' || c.clusters.includes(cluster));
  // Faceted counting: a card's numbers come from the records matching every OTHER filter,
  // so its own selections never zero out its sibling rows ("how many if I add this one").
  const facetCache = new Map();
  const facetSet = (key) => {
    if (!key) return filteredRecords;
    if (!facetCache.has(key)) {
      const p = new URLSearchParams(params.toString());
      p.delete(key);
      facetCache.set(key, filterValidators(records, p));
    }
    return facetCache.get(key);
  };
  const facetCount = (card, row) => {
    const set = facetSet(row.filter?.key);
    const built = card.build(set, ctx);
    return built.find(x => x.key === row.key)?.count ?? 0;
  };
  CARD_GROUPS.forEach((g, gi) => {
    const grid = grids[gi];
    if (!grid) return;
    const html = cards.filter(c => c.group === g.id).map(card => {
      if (card.view === 'status') {
        const rowsAll = card.build(records, ctx);
        if (rowsAll.length === 0) return '';   // no such data on this cluster: no card (11.36)
        return renderStatusCard(card, rowsAll, card.build(filteredRecords, ctx), totals, facetCount, (row) => facetSet(row.filter?.key).length);
      }
      // percentages are relative to the card's own facet set (records passing every other
      // filter), so a row never reads "2700%" against a narrower current view
      const fs = facetSet(card.fkey);
      const cardTotals = { total: fs.length, totalStake: fs.reduce((s, r) => s + (r.activated_stake_lamports || 0), 0) };
      const withKeys = (list) => list.map(seg => { const ef = entryFilter(card, seg); return ef ? Object.assign(seg, { filterKey: ef.key, filterVal: ef.val }) : seg; });
      const segs = mergeSegments(withKeys(card.build(records, ctx)), card.build(fs, ctx), card.view === 'donut');
      return card.view === 'donut' ? renderDonutCard(card, segs, cardTotals) : renderSoftwareCard(card, segs, cardTotals);
    }).join('');
    grid.innerHTML = html;
    grid.classList.toggle('has-4', grid.children.length === 4);
    const block = grid.closest('.vagg-block');
    if (block) block.hidden = html === '';
  });
  const setExpanded = (cardEl, expanded) => {
    cardEl.classList.toggle('is-expanded', expanded);
    const btn = cardEl.querySelector('.vagg-more');
    if (btn) btn.textContent = expanded ? 'Show less' : `Show all ${btn.dataset.more}`;
    if (expanded) expandedCards.add(cardEl.dataset.card); else expandedCards.delete(cardEl.dataset.card);
  };
  const toggleExpand = (cardEl) => setExpanded(cardEl, !cardEl.classList.contains('is-expanded'));
  section.querySelectorAll('.vagg-card').forEach(cardEl => { if (expandedCards.has(cardEl.dataset.card)) setExpanded(cardEl, true); });
  section.querySelectorAll('.vagg-more, .vagg-other').forEach(el => {
    el.addEventListener('click', (e) => { e.stopPropagation(); toggleExpand(el.closest('.vagg-card')); });
  });
  section.hidden = false;
}

// One delegated click handler for every filterable entry in the cards.
function initAggFilterClicks() {
  const section = document.getElementById('vagg');
  if (!section) return;
  section.addEventListener('click', (e) => {
    const t = e.target instanceof Element ? e.target.closest('[data-fkey]') : null;
    if (!t || !section.contains(t)) return;
    const not = e.target instanceof Element && e.target.closest('.vagg-not');
    toggleFilterValue(t.dataset.fkey, t.dataset.fval, not ? 'exclude' : 'include');
  });
  // touch: a long press on a row excludes it
  initLongPress(section, '[data-fkey]', (t) => toggleFilterValue(t.dataset.fkey, t.dataset.fval, 'exclude'));
}

// Block toggles (software / decentralization), remembered per block.
function initAggBlockToggles() {
  document.querySelectorAll('.vagg-block').forEach(block => {
    const btn = block.querySelector('.vagg-block-title');
    if (!btn) return;
    const key = `sonda-vcards-block-${block.dataset.group}`;
    const apply = (open) => { block.classList.toggle('is-collapsed', !open); btn.setAttribute('aria-expanded', String(open)); };
    apply(localStorage.getItem(key) !== '0');
    btn.addEventListener('click', () => {
      const nowOpen = block.classList.contains('is-collapsed');
      apply(nowOpen);
      localStorage.setItem(key, nowOpen ? '1' : '0');
    });
  });
}

// Section toggle: remembered per browser; default open on desktop, collapsed on mobile.
function initAggToggle() {
  const section = document.getElementById('vagg');
  const btns = [document.getElementById('vagg-toggle'), document.getElementById('vagg-toggle-pill')].filter(Boolean);
  if (!section || btns.length === 0) return;
  const txt = section.querySelector('.vagg-toggle-txt');
  const apply = (open) => {
    section.classList.toggle('is-collapsed', !open);
    btns.forEach(b => b.setAttribute('aria-expanded', String(open)));
    if (txt) txt.textContent = open ? 'Hide' : 'Show';
  };
  // Narrow screens always start collapsed (the list is what a phone user came for);
  // on desktop the last choice is remembered.
  const stored = localStorage.getItem('sonda-vcards-open');
  apply(window.innerWidth <= 900 ? false : (stored != null ? stored === '1' : true));
  btns.forEach(b => b.addEventListener('click', () => {
    const nowOpen = section.classList.contains('is-collapsed');
    apply(nowOpen);
    localStorage.setItem('sonda-vcards-open', nowOpen ? '1' : '0');
  }));
}

async function loadAndRender() {
  document.getElementById('result-count').textContent = 'Loading…';
  const cluster = getCluster();

  // Activate cluster banner (sticky, top of page)
  if (window.sondaSetClusterBanner) window.sondaSetClusterBanner(cluster);

  // Clear cluster-specific summary and cards right away: stale cards recoloured in the new
  // accent and then vanishing was disorienting when switching clusters.
  const aggSection = document.getElementById('vagg');
  if (aggSection) { aggSection.hidden = true; aggSection.querySelectorAll('.vagg-grid').forEach(g => { g.innerHTML = ''; }); }
  latestSummary = null;
  const sumLine = document.getElementById('vsummary-line');
  if (sumLine) sumLine.textContent = 'Loading cluster summary…';

  // Summary fetch in parallel with validators: feeds StatusStrip/footer/header pill via
  // sondaUpdateStrip and provides metrics.asn_names for the breakdown cards.
  const summaryPromise = fetchSummary(cluster).then(s => {
    if (s && window.sondaUpdateStrip) window.sondaUpdateStrip(s);
    return s;
  }).catch(() => null);

  try {
    const data = await fetchValidators(cluster);
    allRecords = (data?.records || []).filter(isValidatorRecord);
    lastSnapshotTs = data?.meta?.timestamp || null;
    computeTvcRanks(allRecords);
    stakeTiers = computeStakeTiers(allRecords);
    perfBands = computePerfBands(allRecords);

    // Cluster-aware visibility: columns/badges/sort keys with no data in this cluster are not shown
    tableAvail = tableAvailability(allRecords);
    applyAvailability(document.getElementById('vtable-wrap'), tableAvail);
    if (sortMenu) sortMenu.update(tableAvail);

    // Summary line + breakdown cards
    renderSummaryLine(allRecords);
    // Cards need metrics.asn_names (analyzer v3.11) for provider labels when available;
    // the summary fetch runs in parallel, wait for it here (small file) before the first render.
    latestSummary = await summaryPromise;
    applyAndRender();
  } catch (e) {
    document.getElementById('result-count').textContent = 'Failed to load data.';
    console.error('fetchValidators failed:', e);
  }
}

// In-place refresh (F-6): fetch again, skip if the snapshot did not change, otherwise
// re-render the same number of rows at the same scroll position and glow the rows whose
// key fields changed (delinquent, version, client, stake, location, DZ/BAM, SFDP).
async function refreshValidators() {
  const cluster = getCluster();
  const [data, summary] = await Promise.all([
    fetchValidators(cluster),
    fetchSummary(cluster).catch(() => null),
  ]);
  if (summary && window.sondaUpdateStrip) window.sondaUpdateStrip(summary);
  const ts = data?.meta?.timestamp || null;
  if (!data?.records || (ts && ts === lastSnapshotTs)) return;
  if (getCluster() !== cluster) return;   // cluster switched while fetching
  const before = signatureMap(allRecords);
  allRecords = data.records.filter(isValidatorRecord);
  lastSnapshotTs = ts;
  computeTvcRanks(allRecords);
  stakeTiers = computeStakeTiers(allRecords);
  perfBands = computePerfBands(allRecords);
  tableAvail = tableAvailability(allRecords);
  applyAvailability(document.getElementById('vtable-wrap'), tableAvail);
  if (summary) latestSummary = summary;
  const changed = changedIdentities(before, signatureMap(allRecords));
  preserveScroll(() => {
    renderSummaryLine(allRecords);
    applyAndRender({ keepCount: true });
  });
  if (changed.size > 0) {
    document.querySelectorAll('#vtable-body tr[data-id], #vcards-wrap .vcard[data-id]').forEach(el => {
      if (changed.has(el.getAttribute('data-id'))) el.classList.add('is-changed');
    });
  }
}

function initTableHead() {
  const table = document.getElementById('vtable');
  if (!table) return;
  table.insertAdjacentHTML('afterbegin', tableHeadHtml());
  // Header click = sort; the select stays the source of truth and is kept in sync
  initHeaderSort(table, () => {
    const [key, dir] = document.getElementById('sort-select').value.split('-');
    return { key, dir };
  }, (key, dir) => {
    if (sortMenu) sortMenu.set(key, dir);   // fires the select change -> URL + render
  });
}

function initSortControl() {
  const host = document.getElementById('sort-menu');
  const select = document.getElementById('sort-select');
  if (!host || !select) return;
  // sort from the URL (the option is created on demand by the menu)
  const fromUrl = params.get('sort');
  if (fromUrl && /^[a-z]+-(asc|desc)$/.test(fromUrl)) {
    if (![...select.options].some(o => o.value === fromUrl)) {
      const opt = document.createElement('option'); opt.value = fromUrl; opt.textContent = fromUrl; select.appendChild(opt);
    }
    select.value = fromUrl;
  }
  sortMenu = initSortMenu(host, select, { avail: tableAvail || {} });
}

document.addEventListener('DOMContentLoaded', () => {
  initSortControl();
  initTableHead();
  initAggToggle();
  initAggBlockToggles();
  initAggFilterClicks();
  bootstrapCluster();
  startAutoRefresh(refreshValidators, { intervalMs: 60000 });

  // Pre-fill search from URL
  const q = params.get('q') || '';
  document.getElementById('filter-search').value = q;


  document.getElementById('filter-search').addEventListener('input', e => {
    const v = e.target.value.trim();
    if (v) params.set('q', v); else params.delete('q');
    setUrlParam('q', v || null);
    applyAndRender();
  });

  document.getElementById('sort-select').addEventListener('change', e => {
    const v = e.target.value;
    setUrlParam('sort', v);
    applyAndRender();
  });

  document.getElementById('load-more').addEventListener('click', () => renderNext());

  ['filter-clear', 'filter-clear-top'].forEach(id => {
    const b = document.getElementById(id);
    if (b) b.addEventListener('click', clearAllFilters);
  });

  loadAndRender();

  // Re-fetch on cluster change
  window.addEventListener('sonda:cluster-change', loadAndRender);
});
</script>
