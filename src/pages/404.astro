---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Not found · SONDA">
  <Header />
  <main class="not-found-main">
    <div class="nf-content">
      <div class="nf-code">404</div>
      <h1 class="nf-title">This page does not exist yet</h1>
      <p class="nf-text">
        It may be under active development or the URL may be incorrect.
        SONDA is a beta project and many sections will appear in the coming weeks.
      </p>
      <div class="nf-links">
        <a href="/" class="nf-btn nf-btn-primary">Back to overview</a>
        <a href="/validators" class="nf-btn">Validators</a>
        <a href="/datacenters" class="nf-btn">Datacenters</a>
      </div>
      <p class="nf-pathline">
        Path you tried: <code id="nf-path"></code>
      </p>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .not-found-main {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 1.5rem 6rem;
  }
  .nf-content {
    text-align: center;
    max-width: 560px;
  }
  .nf-code {
    font-family: var(--font-display);
    font-size: clamp(3rem, 9vw, 5rem);
    font-weight: 700;
    color: var(--cluster-accent);
    line-height: 1;
    margin-bottom: 0.6rem;
    opacity: 0.7;
  }
  .nf-title {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.5vw, 1.6rem);
    font-weight: 600;
    color: var(--text-primary);
    margin: 0 0 0.85rem;
  }
  .nf-text {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.55;
    margin: 0 0 1.6rem;
  }
  .nf-links {
    display: flex;
    justify-content: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }
  .nf-btn {
    background: var(--bg-card);
    border: 1px solid var(--border);
    color: var(--text-primary);
    padding: 0.55rem 1.1rem;
    border-radius: 8px;
    font-size: 0.88rem;
    text-decoration: none;
    transition: border-color 0.15s ease;
  }
  .nf-btn:hover { border-color: var(--cluster-accent); }
  .nf-btn-primary {
    background: var(--cluster-accent);
    border-color: var(--cluster-accent);
    color: white;
  }
  .nf-btn-primary:hover { opacity: 0.9; }
  .nf-pathline {
    font-size: 0.78rem;
    color: var(--text-muted);
    margin: 0;
  }
  .nf-pathline code {
    font-family: var(--font-mono);
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    font-size: 0.78rem;
  }
</style>

<script>
  const el = document.getElementById('nf-path');
  if (el) el.textContent = window.location.pathname;
</script>
