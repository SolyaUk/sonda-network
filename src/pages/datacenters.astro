// ----- filter cards -----
function renderCards(all, filtered) {
  const grid = document.getElementById('dcs-cards');
  // Faceted counting: a card's numbers ignore its own filter key, so selecting one row
  // never zeroes its siblings and the rows never reshuffle.
  const facet = (key) => { const p = new URLSearchParams(params.toString()); p.delete(key); return filterProviders(all, p); };
  const fCountry = facet('country'), fLevel = facet('level'), fInfra = facet('infra'), fTag = facet('tag'), fSize = facet('size'), fCity = facet('city'), fPerf = facet('perf');
  const totalStake = fCountry.reduce((s, e) => s + e.stake_lamports, 0);
  // Countries: stake hosted per country across the filtered providers
  const byCc = new Map();
  for (const e of fCountry) for (const c of e.countries) {
    const x = byCc.get(c.cc) || { cc: c.cc, country: c.country, count: 0, stake: 0, providers: 0 };
    x.count += c.count; x.stake += c.stake_lamports; x.providers++; byCc.set(c.cc, x);
  }
  const allCc = new Map();
  for (const e of all) for (const c of e.countries) { if (!allCc.has(c.cc)) allCc.set(c.cc, { cc: c.cc, country: c.country }); }
  // universe order (all providers), so the list is stable whatever is selected
  const uCc = new Map();
  for (const e of all) for (const c of e.countries) { const x = uCc.get(c.cc) || 0; uCc.set(c.cc, x + c.stake_lamports); }
  const stRank = (key, val) => { const st = filterState(key, val); return st === 'include' ? 2 : st === 'exclude' ? 1 : 0; };
  // donut rows: selected first, then by the current facet counts (a chosen filter brings its matches up)
  const rows = [...allCc.values()].map(x => Object.assign(x, byCc.get(x.cc) || { count: 0, stake: 0, providers: 0 })).sort((a, b) => stRank('country', b.cc) - stRank('country', a.cc) || b.stake - a.stake || (uCc.get(b.cc) || 0) - (uCc.get(a.cc) || 0));
  const top = rows.filter(x => x.count > 0).slice(0, 6);
  const rest = rows.filter(x => x.count > 0).slice(6);
  const items = top.map((x, i) => ({ label: x.country, value: x.stake, color: SEQ[i % SEQ.length], title: `${x.country}: ${x.providers} providers, ${x.count} validators` }));
  const restStake = rest.reduce((s, x) => s + x.stake, 0);
  if (restStake > 0) items.push({ label: 'Other', value: restStake, color: '#4b4f63', title: `Other (${rest.length})` });
  const colorOf = new Map(top.map((x, i) => [x.cc, SEQ[i % SEQ.length]]));
  const stCls = (key, val, count) => { const st = filterState(key, val); return st === 'include' ? 'is-selected' : st === 'exclude' ? 'is-excluded' : (count === 0 ? 'is-dim' : ''); };
  const countryRows = rows.map((x, i) => `<div class="vagg-row ${stCls('country', x.cc, x.count)}${i >= 6 ? ' is-extra' : ''}" data-fkey="country" data-fval="${x.cc}">
      ${circleFlagSvg(x.cc.toLowerCase(), { tip: x.country })}<span class="vagg-name"><span data-tip-ellipsis>${esc(x.country)}</span><span class="legend-leader"></span></span>
      <span class="vagg-count">${fmt(x.providers)}<span class="p-more">prov</span></span>
      <span class="vagg-stake"${colorOf.has(x.cc) ? ` style="color:${colorOf.get(x.cc)}"` : ''}>${totalStake ? ((x.stake / totalStake) * 100).toFixed(1) : '0.0'}%</span>${NOT_BUTTON}
    </div>`).join('');
  const countriesCard = `<div class="story vagg-card vagg-view-donut${expandedCards.has('countries') ? ' is-expanded' : ''}" data-card="countries">
    <div class="story-header"><span class="story-tag cluster-tag">Countries</span><span class="vagg-meta">${rows.length} entries</span></div>
    <div class="story-title">Hosted stake by country</div>
    <div class="vagg-donut"><div class="donut-svg">${items.length ? renderDonut(items, { size: 150, ringR: 70, innerR: 44 }).svg : '<div class="vagg-empty">no match</div>'}</div><div class="vagg-rows">${countryRows}</div></div>
    <div class="vagg-foot">${rows.length > 6 ? `<button class="vagg-more" type="button" data-more="${rows.length}">${expandedCards.has('countries') ? 'Show less' : `Show all ${rows.length}`}</button>` : ''}</div>
  </div>`;

  // Cities: hosted stake by city across the filtered providers (same shape as Countries)
  const byCity = new Map();
  for (const e of fCity) for (const c of e.cities) {
    const k = `${c.city}|${c.cc || '??'}`;
    const x = byCity.get(k) || { key: k, city: c.city, cc: c.cc, count: 0, stake: 0, providers: 0 };
    x.count += c.count; x.stake += c.stake_lamports; x.providers++; byCity.set(k, x);
  }
  const uCity = new Map();
  for (const e of all) for (const c of e.cities) { const k = `${c.city}|${c.cc || '??'}`; uCity.set(k, (uCity.get(k) || 0) + c.stake_lamports); }
  const cityRowsAll = [...uCity.keys()].map(k => byCity.get(k) || { key: k, city: k.split('|')[0], cc: k.split('|')[1], count: 0, stake: 0, providers: 0 }).sort((a, b) => stRank('city', b.key) - stRank('city', a.key) || b.stake - a.stake || (uCity.get(b.key) || 0) - (uCity.get(a.key) || 0));
  const cityStake = fCity.reduce((s, e) => s + e.stake_lamports, 0);
  const cityTop = cityRowsAll.filter(x => x.count > 0).slice(0, 6);
  const cityRest = cityRowsAll.filter(x => x.count > 0).slice(6);
  const cityItems = cityTop.map((x, i) => ({ label: x.city, value: x.stake, color: SEQ[i % SEQ.length], title: `${x.city}: ${x.providers} providers, ${x.count} validators` }));
  const cityRestStake = cityRest.reduce((s, x) => s + x.stake, 0);
  if (cityRestStake > 0) cityItems.push({ label: 'Other', value: cityRestStake, color: '#4b4f63', title: `Other (${cityRest.length})` });
  const cityColorOf = new Map(cityTop.map((x, i) => [x.key, SEQ[i % SEQ.length]]));
  const cityRowsHtml = cityRowsAll.map((x, i) => `<div class="vagg-row ${stCls('city', x.key, x.count)}${i >= 6 ? ' is-extra' : ''}" data-fkey="city" data-fval="${esc(x.key)}">
      ${x.cc && x.cc !== '??' ? pinFlagSvg(x.cc.toLowerCase(), { extraClass: 'is-marker', tip: `${x.city}, ${x.cc}` }) : '<span class="vpin-none">?</span>'}<span class="vagg-name"><span data-tip-ellipsis>${esc(x.city)}</span><span class="legend-leader"></span></span>
      <span class="vagg-count">${fmt(x.providers)}<span class="p-more">prov</span></span>
      <span class="vagg-stake"${cityColorOf.has(x.key) ? ` style="color:${cityColorOf.get(x.key)}"` : ''}>${cityStake ? ((x.stake / cityStake) * 100).toFixed(1) : '0.0'}%</span>${NOT_BUTTON}
    </div>`).join('');
  const citiesCard = `<div class="story vagg-card vagg-view-donut${expandedCards.has('cities') ? ' is-expanded' : ''}" data-card="cities">
    <div class="story-header"><span class="story-tag cluster-tag">Cities</span><span class="vagg-meta">${cityRowsAll.length} entries</span></div>
    <div class="story-title">Hosted stake by city</div>
    <div class="vagg-donut"><div class="donut-svg">${cityItems.length ? renderDonut(cityItems, { size: 150, ringR: 70, innerR: 44 }).svg : '<div class="vagg-empty">no match</div>'}</div><div class="vagg-rows">${cityRowsHtml}</div></div>
    <div class="vagg-foot">${cityRowsAll.length > 6 ? `<button class="vagg-more" type="button" data-more="${cityRowsAll.length}">${expandedCards.has('cities') ? 'Show less' : `Show all ${cityRowsAll.length}`}</button>` : ''}</div>
  </div>`;

  // Concentration + infrastructure as status-style bar rows (provider counts in the filtered set)
  const cntIn = (set, fn) => set.filter(fn).length;
  const cnt = (fn) => filtered.filter(fn).length;
  const cntAll = (fn) => all.filter(fn).length;
  const barRows = (rowsDef) => {
    const max = Math.max(1, ...rowsDef.map(r => r.cur));
    return rowsDef.map(r => `<div class="bar-row ${stCls(r.key, r.val, r.cur)}" data-fkey="${r.key}" data-fval="${r.val}" data-tip="${esc(r.tip)}">
      <div class="bar-row-label">${r.label}</div><div class="bar-row-track"><div class="bar-row-fill ${r.fill}" style="width:${r.cur > 0 ? Math.max(3, (r.cur / max) * 100) : 0}%"></div></div><div class="bar-row-num ${r.fill === 'crit' ? 'crit' : r.fill === 'cluster' ? 'cluster' : ''}">${fmt(r.cur)}</div>${NOT_BUTTON}
    </div>`).join('');
  };
  const concRows = [
    { key: 'level', val: 'critical', label: 'Critical (> 25%)', fill: 'crit', cur: cntIn(fLevel, e => e.level === 'critical'), tip: 'Providers holding more than a quarter of cluster stake' },
    { key: 'level', val: 'warning', label: 'Elevated (15 to 25%)', fill: 'warn', cur: cntIn(fLevel, e => e.level === 'warning'), tip: 'Providers between 15% and 25% of cluster stake' },
    { key: 'level', val: 'ok', label: 'Healthy (< 15%)', fill: 'neutral', cur: cntIn(fLevel, e => e.level === 'ok'), tip: 'Providers below 15% of cluster stake' },
  ];
  const sizeRows = [
    { key: 'size', val: '21+', label: '21+ validators', fill: 'cluster', cur: cntIn(fSize, e => e.count >= 21), tip: 'Large providers: 21 or more validators' },
    { key: 'size', val: '6-20', label: '6 to 20 validators', fill: 'cluster', cur: cntIn(fSize, e => e.count >= 6 && e.count <= 20), tip: 'Mid-size providers' },
    { key: 'size', val: '2-5', label: '2 to 5 validators', fill: 'neutral', cur: cntIn(fSize, e => e.count >= 2 && e.count <= 5), tip: 'Small providers' },
    { key: 'size', val: '1', label: 'Single validator', fill: 'neutral', cur: cntIn(fSize, e => e.count === 1), tip: 'One validator only: medians here are one node\'s numbers' },
  ];
  if (all.some(e => e.net_only)) sizeRows.push({ key: 'size', val: '0', label: 'Network nodes only', fill: 'neutral', cur: cntIn(fSize, e => e.count === 0), tip: 'Carriers and hosts with DoubleZero devices, BAM nodes or endpoints but no validators' });
  // Performance: providers by quarter of median TVC rank (1 = best quarter)
  const perfRows = [
    { key: 'perf', val: '1', label: 'Best performers', fill: 'cluster', cur: cntIn(fPerf, e => e.perf_quarter === 1), tip: 'Providers with the best median TVC rank' },
    { key: 'perf', val: '2', label: 'Good', fill: 'cluster', cur: cntIn(fPerf, e => e.perf_quarter === 2), tip: 'Median TVC rank above the middle of all providers' },
    { key: 'perf', val: '3', label: 'Average', fill: 'neutral', cur: cntIn(fPerf, e => e.perf_quarter === 3), tip: 'Median TVC rank below the middle of all providers' },
    { key: 'perf', val: '4', label: 'Weakest', fill: 'neutral', cur: cntIn(fPerf, e => e.perf_quarter === 4), tip: 'Providers with the worst median TVC rank' },
  ];
  const bestProv = [...fPerf].filter(e => e.rank_median != null && e.count >= 2).sort((a, b) => a.rank_median - b.rank_median)[0];
  const perfCard = `<div class="story vagg-card vagg-view-status" data-card="perf">
    <div class="story-header"><span class="story-tag cluster-tag">Performance</span></div>
    <div class="story-title">Median TVC rank by provider</div>
    <div class="vagg-status-head"><span class="story-big mono">${bestProv ? `#${fmt(Math.round(bestProv.rank_median))}` : '—'}</span><span class="story-sub">${bestProv ? `best median, ${esc(bestProv.provider)} (${fmt(bestProv.count)} validators)` : 'no ranked providers in view'}</span></div>
    <div class="bar-rows-wrap with-divider">${barRows(perfRows)}</div>
  </div>`;
  const sizeCard = `<div class="story vagg-card vagg-view-status" data-card="size">
    <div class="story-header"><span class="story-tag cluster-tag">Size</span></div>
    <div class="story-title">Validators per provider</div>
    <div class="vagg-status-head"><span class="story-big mono">${fmt(cntIn(fSize, e => e.count >= 6))}</span><span class="story-sub">providers with 6+ validators</span></div>
    <div class="bar-rows-wrap with-divider">${barRows(sizeRows)}</div>
  </div>`;
  const concCard = `<div class="story vagg-card vagg-view-status" data-card="concentration">
    <div class="story-header"><span class="story-tag cluster-tag">Concentration</span></div>
    <div class="story-title">Stake concentration</div>
    <div class="vagg-status-head"><span class="story-big mono">${fmt(filtered.length)}</span><span class="story-sub">providers in view</span></div>
    <div class="bar-rows-wrap with-divider">${barRows(concRows)}</div>
  </div>`;
  // three separate cards: what the hosted validators use (Infrastructure), what the provider
  // hosts for the network (Network), and provider tags (Tags); each only when the cluster has data
  const infraRows = [];
  const sfdpRow = availability.sfdp ? { key: 'infra', val: 'sfdp', label: 'Hosts SFDP', fill: 'cluster', cur: cntIn(fInfra, e => e.sfdp > 0), tip: 'Providers hosting SFDP-approved validators' } : null;
  if (availability.connections) {
    infraRows.push({ key: 'infra', val: 'dz', label: 'DoubleZero', fill: 'cluster', cur: cntIn(fInfra, e => e.dz > 0), tip: 'Providers with at least one validator on DoubleZero' });
    infraRows.push({ key: 'infra', val: 'mc', label: 'Multicast', fill: 'cluster', cur: cntIn(fInfra, e => e.multicast > 0), tip: 'Providers with validators publishing DoubleZero multicast' });
    infraRows.push({ key: 'infra', val: 'bam', label: 'Jito BAM', fill: 'cluster', cur: cntIn(fInfra, e => e.bam > 0), tip: 'Providers with at least one validator on Jito BAM' });
    if (sfdpRow) infraRows.push(sfdpRow);
    infraRows.push({ key: 'infra', val: 'none', label: 'No DZ or BAM', fill: 'neutral', cur: cntIn(fInfra, e => e.dz === 0 && e.bam === 0), tip: 'Providers whose validators use neither DoubleZero nor Jito BAM' });
  }
  const fNet = facet('net');
  const netRows = [];
  if (availability.net) {
    const split = all.some(e => (e.net?.block_engines || 0) + (e.net?.shred_receivers || 0) > 0);
    const defs = split
      ? [['bam_nodes', 'BAM nodes'], ['block_engines', 'Block engines'], ['shred_receivers', 'Shred receivers'], ['harmonic', 'Harmonic'], ['dz_devices', 'DZ devices'], ['solana', 'Official RPC']]
      : [['bam_nodes', 'BAM nodes'], ['jito', 'Jito endpoints'], ['harmonic', 'Harmonic'], ['dz_devices', 'DZ devices'], ['solana', 'Official RPC']];
    for (const [k, label] of defs) {
      const cur = cntIn(fNet, e => (e.net?.[k] || 0) > 0);
      if (all.some(e => (e.net?.[k] || 0) > 0)) netRows.push({ key: 'net', val: k, label, fill: 'cluster', cur, tip: `Providers hosting ${label.toLowerCase()}` });
    }
  }
  const tagSet = [...new Set(all.flatMap(e => e.tags))];
  const tagRows = tagSet.map(t => ({ key: 'tag', val: t, label: t, fill: t === 'banned' ? 'crit' : 'neutral', cur: cntIn(fTag, e => e.tags.includes(t)), tip: TAG_TIP[t] || t }));
  // clusters without DZ/BAM keep the SFDP filter in the Tags card ("Tags and status")
  if (!availability.connections && sfdpRow) tagRows.unshift(sfdpRow);
  const statusCard = (id, tag, title, head, rows) => rows.length ? `<div class="story vagg-card vagg-view-status" data-card="${id}">
    <div class="story-header"><span class="story-tag cluster-tag">${tag}</span></div>
    <div class="story-title">${title}</div>
    <div class="vagg-status-head">${head}</div>
    <div class="bar-rows-wrap with-divider${rows.length > 8 ? ' is-two-col' : ''}">${barRows(rows)}</div>
  </div>` : '';
  const infraHead = availability.connections
    ? `<span class="story-big mono">${fmt(cnt(e => e.dz > 0 || e.bam > 0))}</span><span class="story-sub">providers on DZ or BAM</span>`
    : `<span class="story-big mono">${fmt(cnt(e => e.sfdp > 0))}</span><span class="story-sub">providers hosting SFDP validators</span>`;
  const infraCard = statusCard('infra', 'Infrastructure', 'What the validators here use', infraHead, infraRows);
  const netCard = statusCard('net', 'Network', 'Network infrastructure hosted', `<span class="story-big mono">${fmt(cnt(e => e.net_total > 0))}</span><span class="story-sub">providers hosting network nodes</span>`, netRows);
  const tagsCard = statusCard('tags', 'Tags', availability.connections ? 'Provider tags' : 'Tags and status', `<span class="story-big mono">${fmt(cnt(e => e.tags.length > 0))}</span><span class="story-sub">providers with tags</span>`, tagRows);
  grid.innerHTML = countriesCard + citiesCard + concCard + sizeCard + perfCard + infraCard + netCard + tagsCard;
  grid.classList.toggle('has-8', grid.children.length >= 8);
  grid.classList.toggle('has-7', grid.children.length === 7);
  grid.querySelectorAll('.vagg-more').forEach(btn => btn.addEventListener('click', (ev) => {
    ev.stopPropagation();
    const card = btn.closest('.vagg-card'); const id = card.dataset.card;
    if (expandedCards.has(id)) expandedCards.delete(id); else expandedCards.add(id);
    card.classList.toggle('is-expanded', expandedCards.has(id));
    btn.textContent = expandedCards.has(id) ? 'Show less' : `Show all ${btn.dataset.more}`;
  }));
}
const SEQ = ['#a78bfa', '#22d3ee', '#4ade80', '#fbbf24', '#f472b6', '#60a5fa', '#fb923c', '#2dd4bf'];
const expandedCards = new Set();

function renderSummary(all) {
  const totalStake = all.reduce((s, e) => s + e.stake_lamports, 0);
  const asns = new Set(all.flatMap(e => e.asns.map(a => a.asn))).size;
  const countries = new Set(all.flatMap(e => e.countries.map(c => c.cc))).size;
  const cities = new Set(all.flatMap(e => e.cities.map(c => `${c.city}|${c.cc}`))).size;
  const hostingList = all.filter(e => !e.net_only);
  const top = hostingList[0];
  // Nakamoto by provider: fewest providers whose stake reaches a third of the cluster
  let acc = 0, nak = 0;
  const clusterStake = allRecords.reduce((s, r) => s + (r.activated_stake_lamports || 0), 0);
  for (const e of hostingList) { acc += e.stake_lamports; nak++; if (acc > clusterStake / 3) break; }
  const hosting = hostingList;
  const netOnly = all.length - hosting.length;
  const parts = [`<b>${fmt(hosting.length)}</b> providers${netOnly ? ` <span class="muted">(+${fmt(netOnly)} with network nodes only)</span>` : ''}`, `<b>${fmt(asns)}</b> networks`, `<b>${fmt(countries)}</b> countries`, `<b>${fmt(cities)}</b> cities`];
  if (top) parts.push(`top share <b class="${top.level === 'critical' ? 'warn' : ''}">${pct(top.stake_pct, 1)}</b> (${esc(top.provider)})`);
  parts.push(`<b>${fmt(nak)}</b> providers hold a third of stake`);
  document.getElementById('dcs-summary').innerHTML = parts.join('<span class="sep">·</span>');
}

function applyAndRender() {
  const [key, dir] = (document.getElementById('dcs-sort-select').value || 'stake-desc').split('-');
  const filtered = sortProviders(filterProviders(providers, params), key, dir);
  const maxCount = Math.max(1, ...filtered.map(e => e.count));
  document.getElementById('dcs-body').innerHTML = filtered.map((e, i) => renderRowP(e, i + 1, maxCount)).join('');
  document.getElementById('dcs-cards-wrap').innerHTML = filtered.map((e, i) => renderCardP(e, i + 1)).join('');
  document.getElementById('dcs-count').textContent = `${filtered.length} provider${filtered.length === 1 ? '' : 's'}`;
  document.querySelectorAll('#dcs-body tr[data-href]').forEach(tr => tr.addEventListener('click', (e) => {
    if (e.target instanceof Element && e.target.closest('[data-copy], .p-expand, a, .p-face')) return;
    window.location.href = tr.dataset.href;
  }));
  document.querySelectorAll('#dcs-cards-wrap .pcard').forEach(card => card.addEventListener('click', (e) => {
    if (e.target instanceof Element && e.target.closest('[data-copy], a')) return;
    window.location.href = card.dataset.href;
  }));
  document.querySelectorAll('#dcs-body .p-expand').forEach(btn => btn.addEventListener('click', (e) => {
    e.stopPropagation();
    const p = btn.dataset.expand;
    if (expandedProviders.has(p)) expandedProviders.delete(p); else expandedProviders.add(p);
    applyAndRender();
  }));
  renderChips();
  renderCards(providers, filtered);
  document.getElementById('dcs-agg').hidden = providers.length === 0;
  const table = document.getElementById('dcs-table');
  table.querySelectorAll('th.th-sort').forEach(th => {
    const active = th.dataset.sort === key;
    th.classList.toggle('is-active', active);
    const arrow = th.querySelector('.th-arrow');
    if (arrow) arrow.textContent = active ? (dir === 'asc' ? '\u2191' : '\u2193') : '\u2195';
  });
}

const HEAD = [
  { cls: 'c-pos', label: '' },
  { cls: 'p-provider', label: 'Provider', sort: 'name', dir: 'asc' },
  { cls: 'p-networks', label: 'Networks', sort: 'asns', dir: 'desc' },
  { cls: 'p-validators', label: 'Validators', sort: 'validators', dir: 'desc' },
  { cls: 'p-stake', label: 'Stake', sort: 'stake', dir: 'desc' },
  { cls: 'p-locations', label: 'Locations', sort: 'cities', dir: 'desc' },
  { cls: 'p-infra', label: 'Infrastructure', sort: 'net', dir: 'desc' },
  { cls: 'p-perf', label: 'Performance', sort: 'rank', dir: 'asc' },
];
function initHead() {
  const table = document.getElementById('dcs-table');
  table.insertAdjacentHTML('afterbegin', `<colgroup>${HEAD.map(c => `<col class="${c.cls}">`).join('')}</colgroup><thead><tr>${HEAD.map(c => c.sort
    ? `<th class="${c.cls} th-sort" data-sort="${c.sort}" data-dir="${c.dir}">${c.label}<span class="th-arrow" aria-hidden="true"></span>${c.hint ? `<span class="th-hint">${c.hint}</span>` : ''}</th>`
    : `<th class="${c.cls}">${c.label}</th>`).join('')}</tr></thead>`);
  table.addEventListener('click', (e) => {
    const th = e.target instanceof Element ? e.target.closest('th.th-sort') : null;
    if (!th) return;
    const [ck, cd] = document.getElementById('dcs-sort-select').value.split('-');
    const dir = ck === th.dataset.sort ? (cd === 'asc' ? 'desc' : 'asc') : th.dataset.dir;
    sortMenu.set(th.dataset.sort, dir);
  });
}

function initSort() {
  const select = document.getElementById('dcs-sort-select');
  const fromUrl = params.get('sort');
  if (fromUrl && /^[a-z]+-(asc|desc)$/.test(fromUrl)) {
    const opt = document.createElement('option'); opt.value = fromUrl; opt.textContent = fromUrl; select.appendChild(opt); select.value = fromUrl;
  }
  sortMenu = initSortMenu(document.getElementById('dcs-sort-menu'), select, { groups: PROVIDER_SORT_GROUPS, defaultValue: 'stake-desc', avail: availability });
  select.addEventListener('change', () => { setUrlParam('sort', select.value); applyAndRender(); });
}

function initToggles() {
  const section = document.getElementById('dcs-agg');
  const btns = [document.getElementById('dcs-toggle'), document.getElementById('dcs-toggle-pill')];
  const txt = section.querySelector('.vagg-toggle-txt');
  const apply = (open) => { section.classList.toggle('is-collapsed', !open); btns.forEach(b => b.setAttribute('aria-expanded', String(open))); txt.textContent = open ? 'Hide' : 'Show'; };
  const stored = localStorage.getItem('sonda-dccards-open');
  apply(window.innerWidth <= 900 ? false : (stored != null ? stored === '1' : true));
  btns.forEach(b => b.addEventListener('click', () => { const open = section.classList.contains('is-collapsed'); apply(open); localStorage.setItem('sonda-dccards-open', open ? '1' : '0'); }));
  section.addEventListener('click', (e) => {
    const t = e.target instanceof Element ? e.target.closest('[data-fkey]') : null;
    if (!t) return;
    const not = e.target instanceof Element && e.target.closest('.vagg-not');
    toggleFilter(t.dataset.fkey, t.dataset.fval, not ? 'exclude' : 'include');
  });
  initLongPress(section, '[data-fkey]', (t) => toggleFilter(t.dataset.fkey, t.dataset.fval, 'exclude'));
  ['dcs-clear', 'dcs-clear-top'].forEach(id => document.getElementById(id).addEventListener('click', clearFilters));
}

let infraRecords = null;   // infrastructure.json records, when the file is available
function ingest(data, summary) {
  allRecords = (data?.records || []).filter(isValidatorRecord);
  computeTvcRanks(allRecords);
  latestSummary = summary;
  providers = aggregateProviders(allRecords, summary);
  providerBands = computeProviderBands(providers);
  if (infraRecords) {
    const asnToProvider = new Map();
    for (const e of providers) for (const a of e.asns) asnToProvider.set(a.asn, e.provider);
    applyNetworkInfra(providers, networkInfraFromRecords(infraRecords, asnToProvider).byProvider);
    // carriers with infrastructure but no validators join the list with 0 validators
    providers = providers.concat(networkOnlyProviders(providers, infraRecords, summary, asnToProvider));
  }
  availability = {
    connections: allRecords.some(r => r.dz_connected || r.bam_node),
    sfdp: allRecords.some(r => r.sfdp_state),
    skip: allRecords.some(r => r.skip_rate != null),
    ibrl: allRecords.some(r => r.ibrl?.ibrl_score != null),
    slot: allRecords.some(r => r.slot_duration_median != null),
    vlat: allRecords.some(r => r.mean_vote_latency != null || r.median_vote_latency != null),
    votes: allRecords.some(r => r.vote_credits_ratio_prev != null),
    net: providers.some(e => e.net_total > 0),
  };
  if (sortMenu) sortMenu.update(availability);
  // the Infrastructure column stays whenever there is anything to show: validator
  // connections or network nodes hosted (SFDP lives in the Validators column)
  document.getElementById('dcs-table-wrap').classList.toggle('hide-infra', !availability.connections && !availability.net);
}

async function loadAndRender() {
  const cluster = getCluster();
  document.getElementById('back-link').href = `/?cluster=${cluster}`;
  if (window.sondaSetClusterBanner) window.sondaSetClusterBanner(cluster);
  document.getElementById('dcs-summary').textContent = 'Loading providers…';
  document.getElementById('dcs-agg').hidden = true;
  try {
    const [data, summary, infra] = await Promise.all([fetchValidators(cluster), fetchSummary(cluster).catch(() => null), fetchInfrastructure(cluster).catch(() => null)]);
    if (summary && window.sondaUpdateStrip) window.sondaUpdateStrip(summary);
    lastSnapshotTs = data?.meta?.timestamp || null;
    infraRecords = Array.isArray(infra?.records) ? infra.records : null;
    ingest(data, summary);
    renderSummary(providers);
    applyAndRender();
  } catch (e) {
    console.error('datacenters:', e);
    document.getElementById('dcs-summary').textContent = 'Could not load providers.';
  }
}

async function refreshProviders() {
  const cluster = getCluster();
  const [data, summary] = await Promise.all([fetchValidators(cluster), fetchSummary(cluster).catch(() => null)]);
  if (summary && window.sondaUpdateStrip) window.sondaUpdateStrip(summary);
  const ts = data?.meta?.timestamp || null;
  if (!data?.records || (ts && ts === lastSnapshotTs) || getCluster() !== cluster) return;
  lastSnapshotTs = ts;
  ingest(data, summary || latestSummary);
  preserveScroll(() => { renderSummary(providers); applyAndRender(); });
}

document.addEventListener('DOMContentLoaded', () => {
  initHead();
  initSort();
  initToggles();
  const search = document.getElementById('dcs-search');
  search.value = params.get('q') || '';
  search.addEventListener('input', () => { const v = search.value.trim(); if (v) params.set('q', v); else params.delete('q'); setUrlParam('q', v || null); applyAndRender(); });
  bootstrapCluster();
  loadAndRender();
  window.addEventListener('sonda:cluster-change', () => { loadAndRender(); });
  startAutoRefresh(refreshProviders, { intervalMs: 60000 });
});
</script>
