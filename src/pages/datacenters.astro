const NET_LABELS = [
  ['bam_nodes', 'BAM node', 'BAM nodes', 'Jito BAM nodes run at this provider'],
  ['block_engines', 'block engine', 'block engines', 'Jito block engines hosted here'],
  ['shred_receivers', 'shred receiver', 'shred receivers', 'Jito shred receivers hosted here'],
  ['ntp', 'NTP', 'NTP', 'Jito NTP servers hosted here'],
  ['harmonic', 'Harmonic', 'Harmonic', 'Harmonic endpoints (auction, TPU relayer, shred receiver, bundles) hosted here'],
  ['dz_devices', 'DZ device', 'DZ devices', 'DoubleZero devices on this provider\'s networks'],
  ['solana', 'RPC', 'RPC', 'Official Solana RPC / entrypoints hosted here'],
];
function netBadges(e) {
  const n = e.net || {};
  const out = [];
  const split = (n.block_engines || 0) + (n.shred_receivers || 0) + (n.ntp || 0) > 0;
  for (const [key, one, many, tip] of NET_LABELS) {
    const v = n[key] || 0;
    if (!v) continue;
    out.push(`<span class="vbadge vbadge-net" data-tip="${esc(netBadgeTip(n, key, tip))}"><b>${fmt(v)}</b> ${v === 1 ? one : many}</span>`);
  }
  // summary-only fallback: Jito endpoints as one badge when the split is unknown
  const jitoRest = (n.jito || 0) - (n.block_engines || 0) - (n.shred_receivers || 0) - (n.ntp || 0) - (split ? 0 : (n.bam_nodes || 0) * 0);
  if (!split && (n.jito || 0) > 0) out.push(`<span class="vbadge vbadge-net" data-tip="Jito endpoints (block engines, shred receivers, relays) hosted here"><b>${fmt(n.jito)}</b> Jito</span>`);
  return out.join('');
}
function facesHtml(e) {
  const top = e.top || [];
  if (!top.length) return '';
  const shown = top.slice(0, 4);
  const rest = e.count - shown.length;
  const label = (v) => v.name || `${v.identity.slice(0, 6)}...${v.identity.slice(-6)}`;
  return `<div class="p-faces">${shown.map(v => `<a class="p-face" href="${esc(validatorHref({ vote_account: v.vote, identity_pubkey: v.identity }, getCluster(), `provider:${e.slug}`))}" data-tip="${esc(label(v))}\n${fmtStakeSol(v.stake)} SOL">${vLogoHtml({ identity_pubkey: v.identity, icon_url: v.icon_url, name: v.name }, 18)}</a>`).join('')}${rest > 0 ? `<span class="p-more">+${fmt(rest)}</span>` : ''}</div>`;
}
// bands across providers (thirds), pale tints like the validator table
let providerBands = null;
function computeProviderBands(list) {
  const defs = [['skip', e => e.skip_avg, 'low'], ['ibrl', e => e.ibrl_median, 'high'], ['slot', e => e.slot_median, 'low'], ['votes', e => e.votes_mean, 'high'], ['vlat', e => e.vlat_mean, 'low']];
  const out = {};
  const minSpread = { skip: 0.5, ibrl: 5, slot: 15, votes: 0.003, vlat: 0.1 };
  const linked = creditsFollowStake(allRecords);
  for (const [k, get, better] of defs) {
    if (k === 'votes' && linked) continue;
    const vals = list.map(get).filter(v => v != null && !Number.isNaN(v)).sort((a, b) => a - b);
    if (vals.length < 8) continue;
    const q = p => vals[Math.min(vals.length - 1, Math.floor(p * vals.length))];
    const lo = q(0.2), hi = q(0.8);
    if (hi - lo < minSpread[k]) continue;
    out[k] = { lo, hi, better };
  }
  return out;
}
function bandCls(k, v) {
  const b = providerBands?.[k];
  if (!b || v == null || b.lo === b.hi) return '';
  if (b.better === 'low') return v <= b.lo ? ' is-good' : v >= b.hi ? ' is-poor' : '';
  return v >= b.hi ? ' is-good' : v <= b.lo ? ' is-poor' : '';
}
function perfBadgesP(e, opts = {}) {
  const out = [];
  if (e.rank_median != null) out.push(`<span class="vperf vperf-rank" data-tip="Median TVC rank of this provider's validators\nbest validator here: #${e.rank_best}"><b>#${fmt(Math.round(e.rank_median))}</b><i>median TVC</i></span>`);
  if (availability.skip && e.skip_avg != null) out.push(`<span class="vperf${bandCls('skip', e.skip_avg)}" data-tip="Average skip rate across the provider's validators"><b>${e.skip_avg.toFixed(2)}%</b><i>skip</i></span>`);
  if (!opts.short) {
    if (availability.ibrl && e.ibrl_median != null) out.push(`<span class="vperf${bandCls('ibrl', e.ibrl_median)}" data-tip="Median IBRL score of the validators here"><b>${e.ibrl_median.toFixed(0)}</b><i>ibrl</i></span>`);
    if (availability.slot && e.slot_median != null) out.push(`<span class="vperf${bandCls('slot', e.slot_median)}" data-tip="Median slot time of the validators here"><b>${e.slot_median.toFixed(0)}</b><i>ms</i></span>`);
    if (availability.votes && e.votes_mean != null) out.push(`<span class="vperf${bandCls('votes', e.votes_mean)}" data-tip="Average vote credits of the validators here vs the best validator, last full epoch${availability.vlat && e.vlat_mean != null ? `\nAverage vote latency ${e.vlat_mean.toFixed(2)} slots` : ''}"><b>${(e.votes_mean * 100).toFixed(2)}%</b><i>votes</i></span>`);
    else if (availability.vlat && e.vlat_mean != null) out.push(`<span class="vperf${bandCls('vlat', e.vlat_mean)}" data-tip="Average vote latency of the validators here, slots"><b>${e.vlat_mean.toFixed(2)}</b><i>vlat</i></span>`);
  }
  return out.join('');
}
function asnChip(a, e, cls = '') {
