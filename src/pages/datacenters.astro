---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import StatusStrip from '../components/StatusStrip.astro';
import ClusterBanner from '../components/ClusterBanner.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Datacenters · SONDA" description="Hosting providers behind Solana validators: stake concentration, locations, DoubleZero and Jito BAM participation, SFDP delegation and performance per provider.">
  <Header activePage="datacenters" />
  <StatusStrip />
  <ClusterBanner />

  <div class="dev-banner">
    <div class="dev-banner-inner">
      <span class="dev-badge">BETA</span>
      <span class="dev-text">SONDA is under active development. Some sections are incomplete.</span>
      <a href="https://github.com/SolyaUk/sonda-network" target="_blank" rel="noopener" class="dev-link">View on GitHub</a>
    </div>
  </div>

  <main class="page-main">
    <a href="/" class="back-link" id="back-link">&larr; Back to overview</a>

    <section class="page-hero">
      <h1 class="page-title">Datacenters</h1>
    </section>

    <!-- one-line summary of the cluster's hosting picture -->
    <div class="vsummary-line" id="dcs-summary">Loading providers…</div>

    <!-- filter cards, same kit as the validators Breakdown -->
    <section class="vagg" id="dcs-agg" hidden>
      <div class="vagg-head">
        <button class="vagg-toggle" id="dcs-toggle" type="button" aria-expanded="true" aria-controls="dcs-grid">
          <span class="vagg-title">Breakdown</span>
          <span class="vagg-hint">click an entry to filter the providers, click again to remove; filters combine</span>
        </button>
        <button class="filter-clear vagg-clear" id="dcs-clear-top" type="button" style="display:none">Clear all filters &times;</button>
        <button class="vagg-toggle-pill" id="dcs-toggle-pill" type="button" aria-expanded="true" aria-controls="dcs-grid"><span class="vagg-toggle-txt">Hide</span><svg class="vagg-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg></button>
      </div>
      <div id="dcs-grid" class="vagg-body">
        <div class="vagg-grid vagg-grid-3" id="dcs-cards"></div>
      </div>
    </section>

    <section class="filters-bar">
      <span class="search-wrap"><input type="search" id="dcs-search" class="filter-search" placeholder="Search provider, ASN or city…" autocomplete="off" /><button type="button" class="search-clear" data-for="dcs-search" aria-label="Clear search" hidden><svg viewBox="0 0 20 20" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15"/></svg></button></span>
      <div class="active-filters" id="dcs-active-filters"></div>
      <button class="filter-clear" id="dcs-clear" type="button" style="display:none">Clear all filters &times;</button>
    </section>

    <section class="results-bar">
      <div class="result-count" id="dcs-count">—</div>
      <div class="sort-controls">
        <select id="dcs-sort-select" hidden aria-hidden="true"><option value="stake-desc" selected>Stake, high to low</option></select>
        <div id="dcs-sort-menu"></div>
      </div>
    </section>

    <div class="vtable-wrap" id="dcs-table-wrap">
      <table class="vtable ptable" id="dcs-table"><tbody id="dcs-body"></tbody></table>
    </div>
    <div class="vcards-wrap" id="dcs-cards-wrap"></div>

    <p class="page-footnote">Provider = the company validators rent from, counted across all of its networks (ASNs). Stake share is measured against the whole cluster; SFDP asks validators to avoid providers above 25%.</p>
  </main>
  <Footer />
</BaseLayout>

<style is:global>
  /* BETA banner (same as the other pages) */
  .dev-banner { background: rgba(59,130,246,0.08); border-bottom: 1px solid rgba(59,130,246,0.2); font-size: 0.78rem; color: var(--text-secondary); }
  .dev-banner-inner { max-width: 1280px; margin: 0 auto; padding: 0.5rem 1.5rem; display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
  .dev-badge { font-family: var(--font-mono); font-size: 0.65rem; font-weight: 600; background: var(--accent-blue); color: #fff; padding: 0.15rem 0.45rem; border-radius: 4px; letter-spacing: 0.08em; flex-shrink: 0; }
  .dev-link { color: var(--accent-blue); text-decoration: none; margin-left: auto; }
  .page-main { max-width: 1400px; margin: 0 auto; padding: 1.5rem 2rem 4rem; }
  .back-link { display: inline-block; color: var(--text-muted); font-size: 0.85rem; text-decoration: none; margin-bottom: 1.2rem; }
  .back-link:hover { color: var(--cluster-accent); }
  .page-hero { margin-bottom: 1.2rem; }
  .page-title { font-family: var(--font-display); font-size: 2rem; font-weight: 700; margin: 0; }
  .vsummary-line { font-size: 0.86rem; color: var(--text-secondary); margin: 0 0 1.4rem; line-height: 1.7; }
  .vsummary-line b { color: var(--text-primary); font-family: var(--font-mono); font-weight: 600; }
  .vsummary-line .sep { color: var(--text-muted); margin: 0 0.45rem; }
  .vsummary-line .warn { color: var(--status-critical); }
  .vsummary-line .muted { color: var(--text-muted); font-weight: 400; }
  .filters-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; margin-bottom: 0.8rem; }
  .filter-search { flex: 1 1 320px; min-width: 200px; background: var(--bg-card); border: 1px solid var(--border); border-radius: 8px; padding: 0.55rem 0.8rem; color: var(--text-primary); font-size: 0.9rem; font-family: inherit; }
  .filter-search:focus { outline: none; border-color: var(--border-accent); }
  .active-filters { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .filter-chip { display: inline-flex; align-items: center; gap: 0.35rem; background: color-mix(in srgb, var(--cluster-accent) 12%, transparent); border: 1px solid color-mix(in srgb, var(--cluster-accent) 45%, transparent); color: var(--text-primary); border-radius: 999px; padding: 0.25rem 0.6rem; font-size: 0.76rem; }
  .filter-chip .chip-x { cursor: pointer; color: var(--text-muted); font-size: 0.9rem; line-height: 1; }
  .filter-chip .chip-x:hover { color: var(--text-primary); }
  .filter-clear { background: color-mix(in srgb, var(--cluster-accent) 12%, transparent); border: 1px solid color-mix(in srgb, var(--cluster-accent) 55%, transparent); color: var(--text-primary); border-radius: 999px; padding: 0.4rem 0.85rem; font-size: 0.78rem; font-weight: 600; cursor: pointer; font-family: inherit; }
  .filter-clear:hover { background: color-mix(in srgb, var(--cluster-accent) 22%, transparent); }
  .results-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.8rem; gap: 1rem; }
  .result-count { font-size: 0.85rem; color: var(--text-muted); }
  .sort-controls { display: flex; align-items: center; gap: 0.5rem; }
  .page-footnote { margin-top: 1.4rem; font-size: 0.78rem; color: var(--text-muted); line-height: 1.5; }
  /* cards flow four per row from 1200px; an incomplete last row stretches to fill it, so
     seven cards never leave a hole (4 + 3), six go 3 + 3, eight 4 + 4 */
  #dcs-cards.vagg-grid-3 { display: flex; flex-wrap: wrap; gap: 0.9rem; }
  #dcs-cards.vagg-grid-3 > .vagg-card { flex: 1 1 calc(33.333% - 0.9rem); min-width: 260px; }
  /* 7 cards: three on top (the two donuts need room), four below; 8: four and four */
  @media (min-width: 1200px) {
    #dcs-cards.vagg-grid-3.has-8 > .vagg-card { flex-basis: calc(25% - 0.9rem); }
    #dcs-cards.vagg-grid-3.has-7 > .vagg-card:nth-child(-n+3) { flex-basis: calc(33.333% - 0.9rem); }
    #dcs-cards.vagg-grid-3.has-7 > .vagg-card:nth-child(n+4) { flex-basis: calc(25% - 0.9rem); }
  }
  @media (max-width: 700px) { #dcs-cards.vagg-grid-3 > .vagg-card { flex-basis: 100%; min-width: 0; } }
  @media (max-width: 1000px) { #dcs-cards.vagg-grid-3 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { #dcs-cards.vagg-grid-3 { grid-template-columns: 1fr; } }
  /* validator faces in the Validators column */
  .p-faces { display: flex; align-items: center; gap: 2px; margin-top: 0.35rem; }
  .p-face { display: inline-flex; border-radius: 50%; line-height: 0; }
  .p-face .vlogo-wrap { border-color: var(--bg-card); }
  .p-face:hover { outline: 2px solid var(--cluster-accent); outline-offset: 1px; }
  .p-faces .p-more { margin-left: 0.2rem; }

  /* providers table: own column set on top of the shared vtable kit */
  .ptable col.c-pos { width: 52px; }
  .ptable col.p-provider { width: 22%; }
  .ptable col.p-networks { width: 11%; }
  .ptable col.p-validators { width: 11%; }
  .ptable col.p-stake { width: 12%; }
  .ptable col.p-locations { width: 12%; }
  .ptable col.p-infra { width: 19%; }
  .ptable col.p-perf { width: 13%; }
  .ptable th { white-space: normal; }
  .p-provider-cell { display: flex; align-items: center; gap: 0.7rem; min-width: 0; }
  .p-logo { width: 40px; height: 40px; }
  .p-logo::before { font-size: 0.9rem; }
  .p-main { min-width: 0; display: flex; flex-direction: column; gap: 0.25rem; }
  .p-name-row { display: flex; align-items: center; gap: 0.4rem; min-width: 0; }
  .p-name { font-family: var(--font-display); font-size: 1.05rem; font-weight: 600; color: var(--text-primary); text-decoration: none; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  .p-name:hover { color: var(--cluster-accent); }
  .p-tags { display: flex; flex-wrap: wrap; gap: 0.25rem; }
  .p-networks { font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-primary); }
  .p-networks-sub { font-family: var(--font-mono); font-size: 0.66rem; color: var(--text-muted); }
  .p-asn-chips { display: flex; flex-direction: column; gap: 0.2rem; margin-top: 0.3rem; }
  .p-asn-chip { display: inline-flex; align-items: center; gap: 0.35rem; font-family: var(--font-mono); font-size: 0.66rem; color: var(--text-secondary); border: 1px solid var(--border); border-radius: 6px; padding: 0.12rem 0.4rem; background: var(--bg-primary); width: fit-content; max-width: 100%; text-decoration: none; transition: border-color 0.12s, color 0.12s; }
  .p-asn-chip b { color: var(--text-primary); font-weight: 600; }
  .p-asn-chip .n { color: var(--text-muted); }
  .p-asn-chip:hover { border-color: color-mix(in srgb, var(--cluster-accent) 60%, transparent); color: var(--text-primary); }
  .p-expand { background: none; border: 1px solid var(--border); border-radius: 6px; color: var(--text-secondary); font-family: var(--font-mono); font-size: 0.66rem; padding: 0.15rem 0.45rem; cursor: pointer; margin-top: 0.3rem; }
  .p-expand:hover { border-color: var(--border-accent); color: var(--text-primary); }
  .p-sub-chips { display: flex; flex-wrap: wrap; gap: 0.3rem; padding-left: calc(40px + 0.7rem); }
  .p-sub-chips .p-asn-chip { font-size: 0.7rem; padding: 0.25rem 0.55rem; }
  .p-count { font-family: var(--font-mono); font-size: 0.92rem; font-weight: 600; color: var(--text-primary); display: inline-flex; align-items: baseline; }
  .p-count .vagg-delinq { font-size: 0.7rem; }
  .p-share { height: 5px; background: color-mix(in srgb, var(--text-muted) 25%, transparent); border-radius: 3px; margin-top: 0.35rem; overflow: hidden; max-width: 120px; }
  .p-share i { display: block; height: 100%; background: var(--cluster-accent); border-radius: 3px; }
  .p-stake-pct { font-family: var(--font-mono); font-size: 0.78rem; color: var(--text-secondary); margin-top: 0.15rem; }
  .p-stake-pct.is-critical { color: var(--status-critical); font-weight: 600; }
  .p-stake-pct.is-warning { color: var(--accent-amber); font-weight: 600; }
  .p-stake-cell .stake-meter { margin-bottom: 0.3rem; }
  /* all country flags, up to two rows, each a link to the provider filtered by country */
  .p-flags-row { display: flex; align-items: center; gap: 3px; flex-wrap: wrap; max-width: 118px; }
  .p-flag-link { display: inline-flex; border-radius: 50%; line-height: 0; }
  .p-flag-link:hover { outline: 2px solid var(--cluster-accent); outline-offset: 1px; }
  .p-more { font-family: var(--font-mono); font-size: 0.64rem; color: var(--text-muted); margin-left: 0.35rem; }
  .p-cities { font-size: 0.76rem; color: var(--text-secondary); margin-top: 0.3rem; }
  .p-sub td { background: color-mix(in srgb, var(--bg-primary) 60%, var(--bg-card)); padding: 0.4rem 0.75rem 0.7rem; }
  .p-sub-inner { display: flex; flex-wrap: wrap; gap: 0.35rem 1.2rem; font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-secondary); padding-left: calc(40px + 0.7rem); }
  .p-sub-inner .asn { color: var(--text-primary); }
  .p-sub-inner .muted { color: var(--text-muted); }
  .p-sub-inner a { color: var(--cluster-accent); text-decoration: none; }
  .vbadge-level-critical { color: var(--status-critical); border-color: rgba(239,68,68,0.45); background: rgba(239,68,68,0.1); }
  .vbadge-level-warning { color: var(--accent-amber); border-color: rgba(251,191,36,0.45); background: rgba(251,191,36,0.08); }
  /* tags are provider classes, not warnings: neutral, except banned; so transit no longer
     reads like the amber Elevated badge */
  .vbadge-tag { color: var(--text-secondary); border-color: var(--border); background: var(--bg-primary); }
  .vbadge-tag-banned { color: var(--status-critical); border-color: rgba(239,68,68,0.45); }
  .vbadge-tag-isp, .vbadge-tag-transit { border-style: dashed; }
  .p-sfdp { margin-top: 0.35rem; }
  .vtable-wrap.hide-infra col.p-infra, .vtable-wrap.hide-infra .p-infra { display: none; }
  .vtable-wrap.hide-infra col.p-provider { width: 26%; }
  .vtable-wrap.hide-infra col.p-locations { width: 20%; }
  .vtable-wrap.hide-infra col.p-perf { width: 20%; }
  .p-infra .vbadges-group + .vbadges-group { margin-top: 0.3rem; }
  @media (max-width: 1200px) { .ptable col.p-perf, .ptable .p-perf { display: none; } .ptable col.p-provider { width: 26%; } .ptable col.p-infra { width: 19%; } .ptable col.p-locations { width: 17%; } }
  /* provider cards (mobile) */
  .pcard { border: 1px solid var(--border); border-radius: 12px; background: var(--bg-card); padding: 0.75rem 0.85rem; display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 0.45rem 0.8rem; align-items: start; }
  .pcard .p-logo { width: 48px; height: 48px; }
  .pcard-main { min-width: 0; display: flex; flex-direction: column; gap: 0.3rem; }
  .pcard-line { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem 0.6rem; font-size: 0.8rem; color: var(--text-secondary); }
  @media (max-width: 900px) { .page-main { padding: 0.85rem 1rem 3rem; } }
</style>

<script>
import { bootstrapCluster, getCluster, fetchValidators, fetchSummary, fetchInfrastructure, computeTvcRanks, isValidatorRecord } from '../lib/data.js';
import { aggregateProviders, sortProviders, filterProviders, networkInfraFromRecords, applyNetworkInfra, networkOnlyProviders, netBadgeTip } from '../lib/providers.js';
import { fmt, pct } from '../lib/formatters.js';
import { copyButtonHtml, listValueState, nextListValues, initLongPress, NOT_BUTTON } from '../lib/ui.js';
import { renderDonut } from '../lib/charts.js';
import { circleFlagSvg, pinFlagSvg, fmtStakeSol, slugOf, logoHtml as vLogoHtml, validatorHref, creditsFollowStake } from '../lib/validator-table.js';
import { initSortMenu, PROVIDER_SORT_GROUPS } from '../lib/sort-menu.js';
import { startAutoRefresh, preserveScroll } from '../lib/refresh.js';

const params = new URLSearchParams(window.location.search);
let allRecords = [];
let providers = [];
let latestSummary = null;
let lastSnapshotTs = null;
let sortMenu = null;
const expandedProviders = new Set();
let availability = { connections: false, sfdp: false, skip: false, ibrl: false, slot: false, vlat: false, votes: false, net: false };

function esc(v) { return String(v ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
function setUrlParam(key, value) {
  const url = new URL(window.location.href);
  if (value == null || value === '') url.searchParams.delete(key); else url.searchParams.set(key, value);
  window.history.replaceState(null, '', url.toString());
}
const LIST_FILTERS = ['country', 'tag', 'city'];
const FILTER_LABELS = { country: 'Country', tag: 'Tag', level: 'Concentration', infra: 'Infrastructure', size: 'Size', net: 'Network', city: 'City', perf: 'Performance' };
function listParam(key) { return (params.get(key) || '').split(',').map(v => v.trim()).filter(Boolean); }
function isActive(key, val) { return filterState(key, val) === 'include'; }
// 'include' | 'exclude' | null; single-value keys store "!value" for exclude
function filterState(key, val) {
  if (LIST_FILTERS.includes(key)) return listValueState(listParam(key), val);
  const cur = params.get(key);
  return cur === val ? 'include' : cur === `!${val}` ? 'exclude' : null;
}
function toggleFilter(key, val, mode = 'include') {
  if (LIST_FILTERS.includes(key)) {
    const next = nextListValues(listParam(key), val, mode);
    if (next.length) params.set(key, next.join(',')); else params.delete(key);
    setUrlParam(key, next.join(','));
  } else {
    const want = mode === 'exclude' ? `!${val}` : val;
    if (params.get(key) === want) { params.delete(key); setUrlParam(key, null); }
    else { params.set(key, want); setUrlParam(key, want); }
  }
  applyAndRender();
}
function removeFilter(key, val) {
  if (LIST_FILTERS.includes(key)) {
    const next = listParam(key).filter(v => v !== val && v !== `!${val}`);
    if (next.length) params.set(key, next.join(',')); else params.delete(key);
    setUrlParam(key, next.join(','));
  } else { params.delete(key); setUrlParam(key, null); }
  applyAndRender();
}
function clearFilters() {
  Object.keys(FILTER_LABELS).forEach(k => { params.delete(k); setUrlParam(k, null); });
  applyAndRender();
}
function chipText(key, val) {
  if (key === 'level') return val === 'critical' ? 'Critical concentration' : val === 'warning' ? 'Elevated concentration' : 'Healthy concentration';
  if (key === 'infra') return { dz: 'DoubleZero connected', mc: 'Multicast publishers', bam: 'Jito BAM connected', sfdp: 'Hosts SFDP validators', none: 'No DZ or BAM', net: 'Hosts network infrastructure' }[val] || val;
  if (key === 'net') return { bam_nodes: 'Hosts BAM nodes', jito: 'Hosts Jito endpoints', block_engines: 'Hosts block engines', shred_receivers: 'Hosts shred receivers', harmonic: 'Hosts Harmonic', dz_devices: 'Hosts DZ devices', solana: 'Hosts official RPC' }[val] || val;
  if (key === 'size') return { '0': 'Network nodes only', '1': 'Single validator', '2-5': '2 to 5 validators', '6-20': '6 to 20 validators', '21+': '21+ validators' }[val] || val;
  if (key === 'city') return `City: ${val.split('|')[0]}`;
  if (key === 'perf') return { '1': 'Best performers', '2': 'Good performers', '3': 'Average performers', '4': 'Weakest performers' }[val] || val;
  return `${FILTER_LABELS[key] || key}: ${val}`;
}
function renderChips() {
  const chips = [];
  for (const key of Object.keys(FILTER_LABELS)) {
    if (LIST_FILTERS.includes(key)) listParam(key).forEach(v => chips.push({ key, v }));
    else if (params.get(key)) chips.push({ key, v: params.get(key) });
  }
  document.getElementById('dcs-active-filters').innerHTML = chips.map(c => {
    const not = c.v.startsWith('!');
    const raw = not ? c.v.slice(1) : c.v;
    return `<span class="filter-chip${not ? ' is-not' : ''}">${not ? '<span class="chip-not">not</span>' : ''}${esc(chipText(c.key, raw))}<span class="chip-x" data-key="${c.key}" data-value="${esc(raw)}">&times;</span></span>`;
  }).join('');
  ['dcs-clear', 'dcs-clear-top'].forEach(id => { const b = document.getElementById(id); if (b) b.style.display = chips.length ? 'inline-block' : 'none'; });
  document.querySelectorAll('#dcs-active-filters .chip-x').forEach(x => x.addEventListener('click', () => removeFilter(x.dataset.key, x.dataset.value)));
}

// ----- badges shared by rows and cards -----
const TAG_TIP = {
  isp: 'Internet access provider: validators here run on residential or office connections, not in a datacenter',
  transit: 'Backbone carrier that owns the IP range but rents no servers; the datacenter is unknown',
  private: 'The validator operator\'s own network (own ASN)',
  'solana-focused': 'Solana-focused hosting provider',
  'DZ-partner': 'DoubleZero partner',
  banned: 'Listed as banned for SFDP delegation',
};
function tagBadges(e) {
  return e.tags.map(t => `<span class="vbadge vbadge-tag vbadge-tag-${esc(t).replace(/[^a-z-]/gi, '')}" data-tip="${esc(TAG_TIP[t] || t)}">${esc(t)}</span>`).join('');
}
function levelBadge(e) {
  if (e.level === 'critical') return `<span class="vbadge vbadge-level-critical" data-tip="More than 25% of cluster stake: above the SFDP threshold">Critical</span>`;
  if (e.level === 'warning') return `<span class="vbadge vbadge-level-warning" data-tip="15 to 25% of cluster stake: approaching the SFDP threshold">Elevated</span>`;
  return '';
}
// Validator infrastructure (what the hosted validators connect to) is tinted; network
// infrastructure (Jito, Harmonic, BAM nodes, DZ devices, official RPC hosted AT this
// provider) is outlined. Two lines when both exist.
function infraBadges(e, opts = {}) {
  // validator infrastructure: DZ, multicast publishers, BAM (SFDP is a status, it lives in
  // the Validators column); network infrastructure below, dashed
  const val = [];
  if (e.dz) val.push(`<span class="vbadge vbadge-dz" data-tip="${e.dz} validators connected to DoubleZero">DZ ${fmt(e.dz)}</span>`);
  if (e.multicast) val.push(`<span class="vbadge vbadge-mc" data-tip="${e.multicast} validators publish shreds via DoubleZero multicast">MC ${fmt(e.multicast)}</span>`);
  if (e.bam) val.push(`<span class="vbadge vbadge-bam" data-tip="${e.bam} validators connected to Jito BAM">BAM ${fmt(e.bam)}</span>`);
  const net = netBadges(e);
  if (opts.flat) return val.join('') + net;
  const parts = [];
  if (val.length) parts.push(`<div class="vbadges-group">${val.join('')}</div>`);
  if (net) parts.push(`<div class="vbadges-group">${net}</div>`);
  return parts.join('');
}
function sfdpBadge(e) {
