}
function stakeMeterP(e) {
  const labels = { 1: 'Low stake', 2: 'Mid stake', 3: 'High stake', 4: 'Top stake' };
  const t = e.stake_tier || 1;
  return `<span class="stake-meter t${t}" data-tip="${labels[t]} among providers">${[1, 2, 3, 4].map(k => `<i class="${k <= t ? 'on' : ''}"></i>`).join('')}</span>`;
}
function logoHtml(e, cls = 'p-logo') {
