---
// Country flag in circular frame.
// Uses 1x1 flag.gg API or local SVG (flagcdn.com is reliable, free, CORS-friendly).
// Fallback: ? in circle for unknown country (??).

interface Props {
  countryCode?: string | null;
  size?: number;
  title?: string;
}

const { countryCode, size = 20, title } = Astro.props;
const cc = (countryCode || '').toLowerCase();
const isValid = cc.length === 2 && cc !== '??';
const flagUrl = isValid
  ? `https://flagcdn.com/w40/${cc}.png`
  : null;
---

<span class="cf-wrap" style={`width:${size}px;height:${size}px`} title={title || countryCode || ''}>
  {flagUrl ? (
    <img class="cf-img" src={flagUrl} alt={countryCode || ''} width={size} height={size} loading="lazy" />
  ) : (
    <span class="cf-unknown">?</span>
  )}
</span>

<style>
.cf-wrap {
  display: inline-block;
  border-radius: 50%;
  overflow: hidden;
  background: var(--bg-card-hover);
  border: 1px solid var(--border);
  flex-shrink: 0;
  position: relative;
}
.cf-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.cf-unknown {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  color: var(--text-muted);
  font-size: 0.7em;
  font-weight: 600;
}
</style>
