---
const { activePage = 'overview' } = Astro.props;
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo-link">
      <img src="/logo-500.png" alt="SONDA" class="logo-img" />
      <span class="logo-text">SONDA</span>
    </a>

    <nav class="site-nav" aria-label="Main navigation">
      <a href="/" class:list={['nav-link', activePage === 'overview' && 'active']}>Overview</a>
      <a href="/validators" data-stub class:list={['nav-link', activePage === 'validators' && 'active']}>Validators</a>
      <a href="/endpoints" data-stub class:list={['nav-link', activePage === 'endpoints' && 'active']}>Endpoints</a>
      <a href="/datacenters" data-stub class:list={['nav-link', activePage === 'datacenters' && 'active']}>Datacenters</a>
      <a href="/#about" class="nav-link">About</a>
    </nav>

    <div class="header-controls">
      <span class="updated-pill" id="updated-pill" title="Last data update">
        <span class="updated-dot"></span>
        <span id="updated-ago">--</span>
      </span>

      <div class="cluster-switcher" role="group" aria-label="Select cluster">
        <button class="cluster-btn" data-cluster="mainnet-beta">mainnet</button>
        <button class="cluster-btn" data-cluster="testnet">testnet</button>
        <button class="cluster-btn" data-cluster="devnet">devnet</button>
        <button class="cluster-btn" data-cluster="alpenglow-community" title="Alpenglow community cluster">alpenglow</button>
      </div>

      <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">
        <span class="toggle-track">
          <span class="toggle-icon icon-moon">
            <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          </span>
          <span class="toggle-icon icon-sun">
            <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
              <circle cx="12" cy="12" r="4"/>
              <line x1="12" y1="2" x2="12" y2="5"/><line x1="12" y1="19" x2="12" y2="22"/>
              <line x1="4.22" y1="4.22" x2="6.34" y2="6.34"/><line x1="17.66" y1="17.66" x2="19.78" y2="19.78"/>
              <line x1="2" y1="12" x2="5" y2="12"/><line x1="19" y1="12" x2="22" y2="12"/>
              <line x1="4.22" y1="19.78" x2="6.34" y2="17.66"/><line x1="17.66" y1="6.34" x2="19.78" y2="4.22"/>
            </svg>
          </span>
          <span class="toggle-thumb"></span>
        </span>
      </button>

      <a href="https://x.com/SondaNetwork" target="_blank" rel="noopener" class="icon-link" aria-label="@SondaNetwork on X">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.746l7.73-8.835L1.254 2.25H8.08l4.259 5.63L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"/></svg>
      </a>

      <a href="https://t.me/sonda_network_events" target="_blank" rel="noopener" class="icon-link" aria-label="Telegram">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M9.78 18.65l.28-4.23 7.68-6.92c.34-.31-.07-.46-.52-.19L7.74 13.3 3.64 12c-.88-.25-.89-.86.2-1.3l15.97-6.16c.73-.33 1.43.18 1.15 1.3l-2.72 12.81c-.19.91-.74 1.13-1.5.71L12.6 16.3l-1.99 1.93c-.23.23-.42.42-.83.42z"/></svg>
      </a>

      <a href="https://github.com/SolyaUk/sonda-network" target="_blank" rel="noopener" class="icon-link" aria-label="GitHub">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
      </a>

      <button class="mobile-menu-toggle" id="mobile-menu-toggle" aria-label="Open menu">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu">
    <a href="/" class:list={['mobile-link', activePage === 'overview' && 'active']}>Overview</a>
    <a href="/validators" data-stub class:list={['mobile-link', activePage === 'validators' && 'active']}>Validators</a>
    <a href="/endpoints" data-stub class:list={['mobile-link', activePage === 'endpoints' && 'active']}>Endpoints</a>
    <a href="/datacenters" data-stub class:list={['mobile-link', activePage === 'datacenters' && 'active']}>Datacenters</a>
    <a href="/#about" class="mobile-link">About</a>
  </div>
</header>

<style>
.site-header {
  position: sticky; top: 0; z-index: 100;
  background-color: var(--bg-primary);
  border-bottom: 1px solid var(--border);
  backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
}
.header-inner {
  max-width: 1280px; margin: 0 auto; padding: 0 1.5rem;
  height: 60px; display: flex; align-items: center; gap: 1.5rem;
}

.logo-link { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; color: var(--text-primary); flex-shrink: 0; }
.logo-img { width: 32px; height: 32px; border-radius: 7px; }
.logo-text { font-family: var(--font-display); font-size: 1.05rem; font-weight: 700; letter-spacing: 0.06em; color: var(--text-primary); }

.site-nav { display: flex; align-items: center; gap: 0.25rem; flex: 1; }
.nav-link { font-size: 0.82rem; font-weight: 500; color: var(--text-muted); text-decoration: none; padding: 0.3rem 0.65rem; border-radius: 6px; transition: color 0.15s, background 0.15s; }
.nav-link:hover { color: var(--text-primary); background: var(--bg-card); }
.nav-link.active { color: var(--cluster-accent); background: color-mix(in srgb, var(--cluster-accent) 10%, transparent); }

.header-controls { display: flex; align-items: center; gap: 0.5rem; flex-shrink: 0; }

.updated-pill { display: flex; align-items: center; gap: 0.3rem; font-family: var(--font-mono); font-size: 0.68rem; color: var(--text-muted); padding: 0.2rem 0.5rem; border-radius: 20px; background: var(--bg-card); border: 1px solid var(--border); white-space: nowrap; }
.updated-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--status-good); animation: pulse-dot 3s infinite; flex-shrink: 0; }
@keyframes pulse-dot { 0%,100% { opacity: 1; } 50% { opacity: 0.35; } }

.cluster-switcher { display: flex; align-items: center; gap: 2px; background: var(--bg-card); border: 1px solid var(--border); border-radius: 8px; padding: 3px; }
.cluster-btn { font-family: var(--font-mono); font-size: 0.7rem; font-weight: 500; padding: 0.22rem 0.55rem; border-radius: 5px; border: none; cursor: pointer; transition: all 0.15s; background: transparent; color: var(--text-muted); white-space: nowrap; }
.cluster-btn.active { background: var(--cluster-accent); color: #fff; cursor: default; }
.cluster-btn:not(.active):hover { background: var(--bg-card-hover); color: var(--text-primary); }

.theme-toggle { background: none; border: none; cursor: pointer; padding: 2px; display: flex; align-items: center; }
.toggle-track { position: relative; width: 52px; height: 28px; border-radius: 14px; border: 1.5px solid var(--border); background: var(--bg-card); display: block; transition: border-color 0.15s, background 0.2s; overflow: hidden; }
.theme-toggle:hover .toggle-track { border-color: var(--accent-blue); }
.toggle-icon { position: absolute; top: 50%; transform: translateY(-50%); width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; pointer-events: none; z-index: 1; }
.icon-moon { left: 2px; color: #a78bfa; }
.icon-sun { right: 2px; color: #f59e0b; }
.toggle-thumb { position: absolute; width: 22px; height: 22px; border-radius: 50%; top: 2px; background: var(--cluster-accent); transition: left 0.2s; z-index: 2; box-shadow: 0 1px 4px rgba(0,0,0,0.25); }

:global([data-theme="dark"]) .toggle-thumb { left: 2px; }
:global([data-theme="light"]) .toggle-thumb { left: 26px; }
:global([data-theme="light"]) .toggle-track { background: #dbeafe; border-color: #bfdbfe; }

.icon-link { display: flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 7px; border: 1px solid var(--border); background: var(--bg-card); color: var(--text-secondary); text-decoration: none; transition: all 0.15s; flex-shrink: 0; }
.icon-link:hover { border-color: var(--cluster-accent); color: var(--cluster-accent); }

.mobile-menu-toggle { display: none; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 7px; border: 1px solid var(--border); background: var(--bg-card); color: var(--text-secondary); cursor: pointer; }
.mobile-menu-toggle:hover { border-color: var(--cluster-accent); color: var(--cluster-accent); }

.mobile-menu { display: none; flex-direction: column; background: var(--bg-secondary); border-bottom: 1px solid var(--border); padding: 0.5rem 1rem; }
.mobile-menu.open { display: flex; }
.mobile-link { font-size: 0.92rem; font-weight: 500; color: var(--text-secondary); text-decoration: none; padding: 0.7rem 0.5rem; border-radius: 6px; }
.mobile-link.active { color: var(--cluster-accent); background: color-mix(in srgb, var(--cluster-accent) 10%, transparent); }

@media (max-width: 900px) {
  .site-nav { display: none; }
  .mobile-menu-toggle { display: flex; }
}
@media (max-width: 600px) {
  .logo-text { display: none; }
  /* Allow header to grow when cluster-switcher wraps to row 2.
     align-items: flex-start keeps the logo at the top of row 1 alongside the
     controls — without it, the logo centers vertically across the full
     2-row height of header-controls and visually drifts toward the middle. */
  .header-inner {
    min-height: 60px; height: auto;
    padding: 0.5rem 0.85rem;
    gap: 0.45rem;
    align-items: flex-start;
  }
  .logo-link { padding-top: 0.15rem; }
  /* Tighter icons + pill so everything fits on 360-412px viewports without hiding socials */
  .icon-link { width: 32px; height: 32px; }
  .updated-pill { font-size: 0.62rem; padding: 0.18rem 0.4rem; }
  .theme-toggle .toggle-track { width: 44px; height: 24px; }
  .theme-toggle .toggle-thumb { width: 18px; height: 18px; }
  :global([data-theme="light"]) .toggle-thumb { left: 22px; }
  .toggle-icon { width: 20px; height: 20px; }
  /* Controls flex container ITSELF wraps. cluster-switcher inside it
     gets order: 99 + flex-basis: 100% so it becomes a full second row beneath
     the theme-toggle and icons (which stay on the first row). */
  .header-controls {
    gap: 0.3rem;
    flex: 1;
    justify-content: flex-end;
    flex-wrap: wrap;
    align-items: center;
  }
  .cluster-switcher {
    order: 99; flex-basis: 100%;
    width: 100%;
    margin-top: 0.5rem; margin-bottom: 0;
    padding: 4px;
  }
  .cluster-switcher .cluster-btn {
    flex: 1 1 0; min-width: 0;
    padding: 0.4rem 0.3rem; font-size: 0.7rem;
    text-align: center;
  }
}

/* Very narrow viewports (≤360px — small Android phones).
   updated-pill drops out (same info shown one scroll down on StatusStrip).
   Padding tightens further so "alpenglow" button doesn't get clipped. */
@media (max-width: 360px) {
  .updated-pill { display: none; }
  .header-inner { padding: 0.5rem 0.6rem; gap: 0.35rem; }
  .header-controls { gap: 0.25rem; }
  .cluster-switcher .cluster-btn { padding: 0.35rem 0.18rem; font-size: 0.65rem; }
}
/* Note: X (Twitter), Telegram, and GitHub icons are kept visible on all screen sizes.
   Earlier we hid X and GitHub at ≤480px to save space; now we keep them and rely on
   the compact mobile sizing above to fit everything on 360px viewports. */
</style>

<script>
import { CLUSTERS, bootstrapCluster, setCluster as setClusterShared, getCluster } from '../lib/data.js';

const initialCluster = bootstrapCluster();

function updateClusterButtons(active: string) {
  document.querySelectorAll('.cluster-btn').forEach(btn => {
    const b = btn as HTMLElement;
    b.classList.toggle('active', b.dataset.cluster === active);
  });
}

updateClusterButtons(initialCluster);

document.querySelectorAll('.cluster-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const cluster = (btn as HTMLElement).dataset.cluster;
    if (!cluster || cluster === getCluster()) return;
    setClusterShared(cluster);
    updateClusterButtons(cluster);
  });
});

const toggle = document.getElementById('theme-toggle');
toggle?.addEventListener('click', () => {
  const html = document.documentElement;
  const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
  html.setAttribute('data-theme', next);
  localStorage.setItem('sonda-theme', next);
});

const mobileToggle = document.getElementById('mobile-menu-toggle');
const mobileMenu = document.getElementById('mobile-menu');
mobileToggle?.addEventListener('click', () => mobileMenu?.classList.toggle('open'));
document.querySelectorAll('.mobile-link').forEach(link => {
  link.addEventListener('click', () => mobileMenu?.classList.remove('open'));
});

let lastUpdateTime: number | null = null;
function updateAgoText() {
  const el = document.getElementById('updated-ago');
  if (!el || !lastUpdateTime) return;
  const sec = Math.floor((Date.now() - lastUpdateTime) / 1000);
  if (sec < 60) el.textContent = `${sec}s ago`;
  else if (sec < 3600) el.textContent = `${Math.floor(sec/60)}m ago`;
  else el.textContent = `${Math.floor(sec/3600)}h ago`;
}
setInterval(updateAgoText, 5000);
(window as any).sondaSetUpdateTime = (ts: string) => {
  lastUpdateTime = new Date(ts).getTime();
  updateAgoText();
};
</script>